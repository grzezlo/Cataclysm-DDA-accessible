#: src/activity_actor.cpp
msgid ""
"You left one corpse unpulped, for you have no tool heavy enough to deal with "
"it."
msgid_plural ""
"You left some corpses unpulped, for you have no tool heavy enough to deal "
"with it."
msgstr[0] "Zostawiłeś jednego niezmiażdżonego trupa, bo nie masz dość ciężkiego narzędzia, by się z nim rozprawić."
msgstr[1] "Zostawiłeś kilka niezmiażdżonych trupów, bo nie masz dość ciężkiego narzędzia, by się z nimi rozprawić."
msgstr[2] "Zostawiłeś kilka niezmiażdżonych trupów, bo nie masz dość ciężkiego narzędzia, by się z nimi rozprawić."
msgstr[3] "Zostawiłeś kilka niezmiażdżonych trupów, bo nie masz dość ciężkiego narzędzia, by się z nimi rozprawić."

