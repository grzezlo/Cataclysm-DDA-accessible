#. ~ Monster attack message
#: data/json/monster_special_attacks/feral_weapon_attacks.json
#, c-format
msgid "%1$s hits <npcname>'s %2$s with a knife!"
msgstr "%1$s wbija nóż w ciało <npcname>, raniąc %2$s!"

#. ~ Monster attack message
#: data/json/monster_special_attacks/monster_attacks.json
#, c-format
msgid "%1$s attempts to push you away with its arms."
msgstr "%1$s próbuje odepchnąć cię ramionami."

#. ~ Monster attack message
#: data/json/monster_special_attacks/monster_attacks.json
#, c-format
msgid "%1$s claws at your %2$s while holding you!"
msgstr "%1$s szarpie twoje %2$s, gdy cię trzyma!"

#. ~ Monster attack message
#: data/json/monster_special_attacks/monster_attacks.json
#, c-format
msgid "%1$s slashes at <npcname>, covering them in acid!"
msgstr "%1$s tnie <npcname>, oblewając go kwasem!"

#. ~ Monster attack message
#: data/json/monster_special_attacks/monster_attacks.json
#, c-format
msgid "%1$s tries to sting <npcname>, but they dodge!"
msgstr "%1$s próbuje ukłuć <npcname>, ale ten unika ciosu!"

#. ~ Monster attack message
#: data/json/monster_special_attacks/monster_attacks.json
#, c-format
msgid ""
"%1$s's barbed tentacle lashes out at <npcname> without doing any damage."
msgstr "%1$s wystrzeliwuje kolczastą mackę w stronę <npcname>, nie zadając mu obrażeń."

#. ~ Monster attack message
#: data/json/monster_special_attacks/monster_attacks.json
#, c-format
msgid "%s flicks its horns at <npcname>, but they dodge!"
msgstr "%s uderza rogami w <npcname>, ale ten robi unik!"

#. ~ Player sees monster spawns in nested effect in then statement in nested
#. effect in switch statement in nested effect in switch statement in effect in
