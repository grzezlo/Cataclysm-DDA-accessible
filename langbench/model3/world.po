msgstr "%1$s trzyma cię i drapie pazurami: %2$s!"

#. ~ Monster attack message
#: data/json/monster_special_attacks/monster_attacks.json
#, c-format
msgid "%1$s slashes at <npcname>, covering them in acid!"
msgstr "%1$s tnie postać <npcname>, oblewając ją kwasem!"

#. ~ Monster attack message
#: data/json/monster_special_attacks/monster_attacks.json
#, c-format
msgid "%1$s tries to sting <npcname>, but they dodge!"
msgstr "%1$s próbuje użądlić postać <npcname>, ale ta robi unik!"

#. ~ Monster attack message
#: data/json/monster_special_attacks/monster_attacks.json
#, c-format
msgid ""
"%1$s's barbed tentacle lashes out at <npcname> without doing any damage."
msgstr "Kolczasta macka (%1$s) smaga postać <npcname>, nie zadając obrażeń."

#. ~ Monster attack message
#: data/json/monster_special_attacks/monster_attacks.json
#, c-format
msgid "%s flicks its horns at <npcname>, but they dodge!"
msgstr "%s zamachuje się rogami na postać <npcname>, ale ta robi unik!"

