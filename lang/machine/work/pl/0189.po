msgstr ""

#. ~ Message in effect in EoC "EOC_CHANGELING_EFFECTS_REMOVED_BY_MOVEMENT"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "You moved and effects are being removed"
msgstr ""

#. ~ Player message in effect in EoC "EOC_CHANGELING_DISGUISE_AS_NATURE"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "You wrap yourself up in a glamour."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_CHANGELING_DISGUISE_AS_NATURE"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "You need to be among nature to disguise yourself within nature."
msgstr ""

#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_CHANGELING_DISGUISE_AS_NATURE_END"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "The glamour disguising you fades."
msgstr ""

#. ~ Player message in effect in EoC "EOC_CHANGELING_NOBLE_BURNING_WEAPON"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "Your weapon kindles into white-gold flame."
msgstr ""

#. ~ Player message in false effect in EoC
#. "EOC_CHANGELING_NOBLE_BURNING_WEAPON"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "Fires of Bealtaine requires a weapon to affect in order to take hold."
msgstr ""

#. ~ Player message in false effect in EoC
#. "EOC_CHANGELING_NOBLE_MOVEMENT_BUFFS"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "Your stretch your limbs and bounce on your heels."
msgstr ""

#. ~ Player message in false effect in EoC
#. "EOC_CHANGELING_NOBLE_RIGHT_OF_PASSAGE_ON"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "After your actions you may not invoke the right of passage."
msgstr ""

#. ~ Player message in effect in EoC "EOC_BROWNIE_INDOOR_BLINK_SUCCESS" in
#. nested EOCs on true condition in effect in EoC "EOC_BROWNIE_INDOOR_BLINK"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "You carefully slip through the cracks."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_BROWNIE_INDOOR_BLINK"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "You must be indoors to slip through the cracks."
msgstr ""

#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_BROWNIE_HOME_TELEPORT_ACTUAL_TELEPORT"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "You slip through the door and head straight home."
msgstr ""

#. ~ Player message in nested effect in else statement in effect in EoC
#. "EOC_BROWNIE_HOME_TELEPORT_ACTUAL_TELEPORT"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "You must be unobserved to hurry home!"
msgstr ""

#. ~ Player message in false effect in EoC
#. "EOC_BROWNIE_HOME_TELEPORT_ACTUAL_TELEPORT"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "You must be in a doorway to hurry home."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_POOKA_SHAPESHIFTING_MANA_CHECK"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "You do not have enough mana to maintain all of your shapeshifts!"
msgstr ""

#. ~ Player message in false effect in EoC "EOC_POOKA_ANTLERS_ON"
#. ~ Player message in false effect in EoC "EOC_POOKA_HORNS_ON"
#. ~ Player message in false effect in EoC "EOC_POOKA_FANGS_ON"
#. ~ Player message in false effect in EoC "EOC_POOKA_SABER_TEETH_ON"
#. ~ Player message in false effect in EoC "EOC_POOKA_WOLF_EARS_ON"
#. ~ Player message in false effect in EoC "EOC_POOKA_FELINE_EARS_ON"
#. ~ Player message in false effect in EoC "EOC_POOKA_CLAWS_ON"
#. ~ Player message in false effect in EoC "EOC_POOKA_STAINLESS_CLAWS_ON"
#. ~ Player message in false effect in EoC "EOC_POOKA_BIRD_WINGS_ON"
#. ~ Player message in false effect in EoC "EOC_POOKA_URSINE_FUR_ON"
#. ~ Player message in false effect in EoC "EOC_POOKA_CHITIN_ON"
#. ~ Player message in false effect in EoC "EOC_POOKA_QUADRUPED_ON"
#. ~ Player message in false effect in EoC "EOC_POOKA_LEAPING_LEGS_ON"
#. ~ Player message in false effect in EoC "EOC_POOKA_WOLF_TAIL_ON"
#. ~ Player message in false effect in EoC "EOC_POOKA_TAIL_LONG_ON"
#. ~ Player message in false effect in EoC "EOC_POOKA_TAIL_STING_ON"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid ""
"You are in the form of an animal.  You must turn back before shapeshifting "
"individual parts of your body."
msgstr ""

#. ~ EOC option description in effect in EoC
#. "EOC_POOKIE_GAIN_PINNACLE_OF_FORMS_TRAIT"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "You will be able to assume the form of a bat."
msgstr ""

#. ~ EOC option description in effect in EoC
#. "EOC_POOKIE_GAIN_PINNACLE_OF_FORMS_TRAIT"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "You will be able to assume the form of a raven."
msgstr ""

#. ~ EOC option description in effect in EoC
#. "EOC_POOKIE_GAIN_PINNACLE_OF_FORMS_TRAIT"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "You will be able to assume the form of a bear."
msgstr ""

#. ~ EOC option description in effect in EoC
#. "EOC_POOKIE_GAIN_PINNACLE_OF_FORMS_TRAIT"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "You will be able to assume the form of a deer."
msgstr ""

#. ~ EOC option description in effect in EoC
#. "EOC_POOKIE_GAIN_PINNACLE_OF_FORMS_TRAIT"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "You will be able to assume the form of a wolf."
msgstr ""

#. ~ EOC option description in effect in EoC
#. "EOC_POOKIE_GAIN_PINNACLE_OF_FORMS_TRAIT"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "You will be able to assume the form of a cougar."
msgstr ""

#. ~ EOC selection title in effect in EoC
#. "EOC_POOKIE_GAIN_PINNACLE_OF_FORMS_TRAIT"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "What form will you be able to assume?"
msgstr ""

#. ~ Player message in effect in EoC
#. "EOC_POOKA_SHAPESHIFT_FULL_BAT_activated_2" in nested EOCs in effect in EoC
#. "EOC_POOKA_SHAPESHIFT_FULL_BAT_activated"
#. ~ Player message in effect in EoC "EOC_VAMPIRE_BAT_FORM_activated_2" in
#. nested EOCs in effect in EoC "EOC_VAMPIRE_BAT_FORM_activated"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
msgid ""
"Your fingers lengthen as flaps of skin grow between them and as your legs "
"shorten, you take to the air."
msgstr ""

#. ~ Player message in false effect in EoC
#. "EOC_POOKA_SHAPESHIFT_FULL_BAT_activated_2" in nested EOCs in effect in EoC
#. "EOC_POOKA_SHAPESHIFT_FULL_BAT_activated"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "You don't have enough mana to transform into a bat."
msgstr ""

#. ~ Player message in effect in EoC
#. "EOC_POOKA_SHAPESHIFT_FULL_BAT_deactivated" in nested EOCs in false effect
#. in EoC "EOC_POOKA_SHAPESHIFT_FULL_BAT_activated"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid ""
"Your body shifts and your fingers separate as you return to your previous "
"form."
msgstr ""

#. ~ Player message in effect in EoC
#. "EOC_POOKA_SHAPESHIFT_FULL_RAVEN_activated_2" in nested EOCs in effect in
#. EoC "EOC_POOKA_SHAPESHIFT_FULL_RAVEN_activated"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid ""
"Your body shifts and warps as your fingers extend into wings and feathers "
"burst from your skin as you take to the air."
msgstr ""

#. ~ Player message in effect in EoC
#. "EOC_POOKA_SHAPESHIFT_FULL_RAVEN_deactivated" in nested EOCs in false effect
#. in EoC "EOC_POOKA_SHAPESHIFT_FULL_RAVEN_activated"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid ""
"Your body shifts and your feathers vanish as you return to your previous "
"form."
msgstr ""

#. ~ Player message in effect in EoC
#. "EOC_POOKA_SHAPESHIFT_FULL_WOLF_activated_2" in nested EOCs in effect in EoC
#. "EOC_POOKA_SHAPESHIFT_FULL_WOLF_activated"
#. ~ Player message in effect in EoC "EOC_VAMPIRE_WOLF_FORM_activated_2" in
#. nested EOCs in effect in EoC "EOC_VAMPIRE_WOLF_FORM_activated"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
msgid ""
"Your nose pushes out into a muzzle as you fall forward on all fours and let "
"out a snarl."
msgstr ""

#. ~ Player message in effect in EoC
#. "EOC_POOKA_SHAPESHIFT_FULL_WOLF_deactivated" in nested EOCs in false effect
#. in EoC "EOC_POOKA_SHAPESHIFT_FULL_WOLF_activated"
#. ~ Player message in effect in EoC "EOC_VAMPIRE_WOLF_FORM_deactivated" in
#. nested EOCs in false effect in EoC "EOC_VAMPIRE_WOLF_FORM_activated"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
#: data/mods/Xedra_Evolved/mutations/vampire_trait_eocs.json
msgid "Your fur disappears and you walk once again on two legs."
msgstr ""

#. ~ Player message in effect in EoC
#. "EOC_POOKA_SHAPESHIFT_FULL_COUGAR_activated_2" in nested EOCs in effect in
#. EoC "EOC_POOKA_SHAPESHIFT_FULL_COUGAR_activated"
