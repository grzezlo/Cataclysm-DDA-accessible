msgid "Cultivate Goblin Fruit"
msgstr ""

#. ~ Description of mutation "Cultivate Goblin Fruit"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"Upon gaining this ability the Selkie gains the ability to grow a goblin fruit"
" when near water or under the rain."
msgstr ""

#. ~ Description of mutation "Cultivate Goblin Fruit"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"Upon gaining this ability the Brownie gains the ability to grow a goblin "
"fruit when indoors and unobserved."
msgstr ""

#. ~ Description of mutation "Cultivate Goblin Fruit"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"Upon gaining this ability the Pooka gains the ability to grow a goblin fruit "
"when near animals."
msgstr ""

#. ~ Description of mutation "Cultivate Goblin Fruit"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"Upon gaining this ability the Trow gains the ability to grow a goblin fruit "
"when underground or at night."
msgstr ""

#. ~ Description of mutation "Cultivate Goblin Fruit"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"Upon gaining this ability the Noble gains the ability to grow a goblin fruit "
"when near humans or Fae."
msgstr ""

#. ~ Message in effect in EoC "EOC_CHANGELING_EFFECTS_REMOVED_BY_SPELLCASTING"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
msgid "You cast a spell and effects are being removed"
msgstr ""

#. ~ Message in effect in EoC "EOC_CHANGELING_EFFECTS_REMOVED_LOSE_EFFECTS"
#: data/mods/Xedra_Evolved/mutations/playable_changeling_eocs.json
