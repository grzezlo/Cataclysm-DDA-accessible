#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Chant of Concealing Mists"
msgstr ""

#. ~ Description of mutation "Chant of Concealing Mists"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Call up a thick mist, shrouding the nearby landscape."
msgstr ""

#. ~ Mutation name
#. ~ Name of spell "selkie_change_weather_rains_spell"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "Aria of the Droplets"
msgstr ""

#. ~ Description of mutation "Aria of the Droplets"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Call a rain shower, letting the rains water the earth."
msgstr ""

#. ~ Mutation name
#. ~ Name of spell "selkie_change_weather_rainstorm_spell"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "Canticle of Rainstorms"
msgstr ""

#. ~ Description of mutation "Canticle of Rainstorms"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Call a heavy rainstorm, soaking everything."
msgstr ""

#. ~ Mutation name
#. ~ Name of spell "selkie_change_weather_lightningstorm_spell"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "Symphony of Levin"
msgstr ""

#. ~ Description of mutation "Symphony of Levin"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Call a lightning storm, ."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Breathing Water"
msgstr ""

#. ~ Description of mutation "Breathing Water"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"You can breathe water just as easily as you can breathe air, and have no "
"trouble switching between them."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "At Home in the Water"
msgstr ""

#. ~ Description of mutation "At Home in the Water"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"You can breathe water just as easily as you can breathe air, and have no "
"trouble switching between them.  In addition, being wet is pleasant in a way "
"it never was before."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "The Waves my Bed"
msgstr ""

#. ~ Description of mutation "The Waves my Bed"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"Falling asleep underwater is easy for you, and you spend less time asleep "
"when you rest there."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Cutting Through the Waves"
msgstr ""

#. ~ Description of mutation "Cutting Through the Waves"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"Your hands and feet haven't changed at all, but they seem to be much better "
"at swimming than before.  You gain a speed bonus when in water, increased "
"when not wearing shoes."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Conductor of Storms"
msgstr ""

#. ~ Description of mutation "Conductor of Storms"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"You are a master of meteorological enchantments, and your weather "
"manipulations will last much longer."
msgstr ""

#. ~ Mutation name
#. ~ Name of spell "trow_make_noise_spell"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "The One Who Knocks"
msgstr ""

#. ~ Description of mutation "The One Who Knocks"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"Create a loud knocking sound within the glamour's range, to distract or lure "
"your enemies away."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/paraclesians/ierde_mutations.json
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Fists of Stone"
msgstr ""

#. ~ Description of mutation "Fists of Stone"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"Your tough skin and thick nails allow you to use yours hands to replace some "
"simple tools.  Your punches hit harder as well."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Stone-Eater"
msgstr ""

#. ~ Description of mutation "Stone-Eater"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"The trow don't literally eat stones, but merely being underground fills you "
"with strength and vigor.  You need half as much food and water while you're "
"underground, and cold underground does not affect you."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Deep-Delver"
msgstr ""

#. ~ Description of mutation "Deep-Delver"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"Once you begin mining, you can do it for hours without rest or sleep.  You "
"need neither food nor drink nor rest for as long as you continue mining."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Amongst the Stones"
msgstr ""

#. ~ Description of mutation "Amongst the Stones"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"While on rock or underground, you seem to subtly blend into your "
"surroundings.  You are harder to spot on rocks or underground."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Resilience of the Stones"
msgstr ""

#. ~ Description of mutation "Resilience of the Stones"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"You are as hardy as the rock.  When underground, you suffer much less pain."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Shaping the Tears"
msgstr ""

#. ~ Description of mutation "Shaping the Tears"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"You have learned the secrets of forging moon's tears.  Sometimes in your "
"dreams, a new recipe might be revealed to you."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Unwavering Resilience of the Stones"
msgstr ""

#. ~ Description of mutation "Unwavering Resilience of the Stones"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"You are as hardy as the rock.  When underground you suffer much less pain, "
"and your strength is not reduced by the pain you suffer."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Unveiling the Night"
msgstr ""

#. ~ Description of mutation "Unveiling the Night"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Your sharp eyes can pierce the darkness."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Pierce the Shadows"
msgstr ""

#. ~ Description of mutation "Pierce the Shadows"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"Whether woods under trees or the cavern depths, you can see through the murk."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "None Here but the Stones"
msgstr ""

#. ~ Description of mutation "None Here but the Stones"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"The Fair Folk can remain hidden among rocks or trees or whispers of wind, and"
" now you can too."
msgstr ""

#. ~ Description of mutation "Hidden from Mortal Eyes"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Like the Fair Folk of legend, you can remain unseen when you wish."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Call Will o' the Wisp"
msgstr ""

#. ~ Description of mutation "Call Will o' the Wisp"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"You can conjure up bobbing lights in the distance that will lead your enemies"
" astray."
msgstr ""

#. ~ Mutation name
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid "Faerie Eternity"
msgstr ""

#. ~ Description of mutation "Faerie Eternity"
#: data/mods/Xedra_Evolved/mutations/playable_changeling.json
msgid ""
"You seem to have stopped aging.  That would have been an amazing gift before "
"the Cataclysm, but now at least you might live long enough to find some way "
"back to your birthplace Under the Hill."
msgstr ""

#. ~ Mutation name
#. ~ Name of spell "arvore_cultivate_goblin_fruit"
#. ~ Name of spell "ierde_cultivate_goblin_fruit"
#. ~ Name of spell "salamander_cultivate_goblin_fruit"
#. ~ Name of spell "sylph_cultivate_goblin_fruit"
#. ~ Name of spell "undine_cultivate_goblin_fruit"
