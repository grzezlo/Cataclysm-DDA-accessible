msgid_plural "catoblepases"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "catoblepas"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"A terrible stench is the first sign of this monster's presence.  It has an "
"ox-like body and warthog-like head, with a neck almost as long as a "
"giraffe's.  It keeps its head low to the ground, but there's something odd "
"about its eyes."
msgstr ""

#. ~ Monster message of special attack of monster "catoblepas"
#: data/mods/Magiclysm/monsters/monsters.json
#, c-format
msgid "The catoblepas looks at %3$s!"
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/nature_spirits.json
