msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "thunder pillar"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"They look like a giant floating stone shard, but are actually an intelligent "
"creature that can use electric branches as their own bodies."
msgstr ""

#. ~ Monster message of special attack of monster "thunder pillar"
#: data/mods/Magiclysm/monsters/monsters.json
msgid "The pillar weaves electricity around themself!"
msgstr ""

