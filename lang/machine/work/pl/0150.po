msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "mossling"
#: data/mods/Magiclysm/monsters/nature_spirits.json
msgid ""
"A dog-sized mass of lichen and plant matter, ambling about on a series of "
"short limbs.  It looks around the forest floor for fallen leaves to eat."
msgstr ""

#. ~ Death message of monster "mossling"
#: data/mods/Magiclysm/monsters/nature_spirits.json
#, c-format
msgid "The %s collapses into a pile of moss."
msgstr ""

