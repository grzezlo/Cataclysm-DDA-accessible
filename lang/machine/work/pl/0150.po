msgid_plural "blood orcs"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "blood orc"
#: data/mods/Magiclysm/monsters/orcs.json
msgid ""
"Like a goblin, but stretched and exaggerated until they're as tall as a human"
" but much more heavily muscled, wearing improvised armor and carrying an "
"enormous metallic club.  There are red streaks all over their skin, like they"
" had bathed themselves in blood."
msgstr ""

