msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "ankheg"
#: data/mods/Magiclysm/monsters/monsters.json
msgid ""
"A huge, segmented, burrowing insect, two meters long and pale greenish-yellow"
" in color."
msgstr ""

#. ~ Monster message of special attack of monster "ankheg"
#: data/mods/Magiclysm/monsters/monsters.json
#, c-format
msgid "The ankheg spits a stream of acid at %3$s!"
msgstr ""

