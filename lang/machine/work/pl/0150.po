msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "brackenwight"
#: data/mods/Magiclysm/monsters/nature_spirits.json
msgid ""
"An animate pile of moss, leaves, sticks, and other forest detritus, towering "
"almost three meters high.  Three pits near the top with a lambent green glow "
"might be eyes.  It slowly walks on massive limbs."
msgstr ""

#. ~ Death message of monster "brackenwight"
#: data/mods/Magiclysm/monsters/nature_spirits.json
#, c-format
msgid "The %s collapses into a massive pile of leaves and sticks."
msgstr ""

#. ~ Monster message of special attack of monster "brackenwight"
#: data/mods/Magiclysm/monsters/nature_spirits.json
#, c-format
msgid "Questing roots explode out of %1$s toward %3$s!"
msgstr ""

