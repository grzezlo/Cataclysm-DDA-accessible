#. ~ Description of JSON flag "TURRET"
#: data/json/vehicleparts/vp_flags.json
msgid ""
"This weapon is mounted in a turret.  It can be fired from the vehicle "
"controls."
msgstr ""

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "WIND_TURBINE"
#: data/json/vehicleparts/vp_flags.json
#, no-c-format
