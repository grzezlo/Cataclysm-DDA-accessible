#: data/json/mutations/appearance_hair_styles.json
msgid "Natural Beard Growth"
msgstr ""

#. ~ Description of mutation "Natural Beard Growth"
#: data/json/mutations/appearance_hair_styles.json
msgid ""
"Your beard will naturally grow out into various forms, getting longer over "
"time.  Turning this off will prevent it from growing and changing."
msgstr ""

#. ~ Description of mutation "Exodii cyborg framework - style 2a"
#: data/json/mutations/cybernetic_traits.json
msgid ""
"Your brain and some of your organs are shielded in a shiny gold bipedal "
"walker frame."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/labyrinth_mutations_passcodes.json
msgid "Alpha Test Labyrinths 0.1"
msgstr ""

#. ~ Description of mutation "Alpha Test Labyrinths 0.1"
#: data/json/mutations/labyrinth_mutations_passcodes.json
msgid ""
"Taking this mutation will allow you to talk to the Exodii Merchant Rubik and "
"ask to travel to the early playtest version of the Labyrinthine Structure, an"
" in-development dungeon set inside an alternate dimension.  This version is "
"still very low on content, but your early feedback is highly valued!"
msgstr ""

#. ~ Mutation name
#: data/json/mutations/labyrinth_mutations_passcodes.json
msgid "Passcode: Thief's Pass"
msgstr ""

#. ~ Description of mutation "Passcode: Thief's Pass"
#: data/json/mutations/labyrinth_mutations_passcodes.json
msgid ""
"There's a symbol etched into your skin.  Somehow you implicitly understand "
"that it is a type of password, it just looks like a tattoo, though how you "
"know this isn't clear.  The symbol itself is your own face, with a clever "
"smirk."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/labyrinth_mutations_passcodes.json
msgid "Passcode: Circle of Wings"
msgstr ""

#. ~ Description of mutation "Passcode: Circle of Wings"
#: data/json/mutations/labyrinth_mutations_passcodes.json
msgid ""
"There's a symbol etched into your skin.  Somehow you implicitly understand "
"that it is a type of password, it just looks like a tattoo, though how you "
"know this isn't clear.  The symbol itself looks like bird wings, circling "
"around themselves in an ouroboros-like shape."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/labyrinth_mutations_passcodes.json
msgid "Passcode: Hard Nails"
msgstr ""

#. ~ Description of mutation "Passcode: Hard Nails"
#: data/json/mutations/labyrinth_mutations_passcodes.json
msgid ""
"There's a symbol etched into your skin.  Somehow you implicitly understand "
"that it is a type of password, it just looks like a tattoo, though how you "
"know this isn't clear.  The symbol itself is of a stylized hand dragging its "
"fingernails down a piece of sheet metal, leaving five deep gouges."
msgstr ""

#. ~ Mutation name
#: data/json/mutations/labyrinth_mutations_passcodes.json
msgid "Passcode: Laughing Man"
msgstr ""

#. ~ Description of mutation "Passcode: Laughing Man"
#: data/json/mutations/labyrinth_mutations_passcodes.json
msgid ""
"There's a symbol etched into your skin.  Somehow you implicitly understand "
"that it is a password, not a tattoo, though how you know this isn't clear.  "
"The symbol itself is of a handsome man's face, laughing.  At first glance it "
"appears charming and friendly, but the longer you examine it, the more it "
"appears to be inhumanly cold and cruel.  It fills you with a feeling of dread"
" that seems to originate from outside your own mind."
msgstr ""

#. ~ Description of mutation "Facial hair: circle beard"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a mustache and a short beard, that both form a circle around your "
"lips."
msgstr ""

#. ~ Description of mutation "Facial hair: royale beard"
#: data/json/mutations/mutation_appearance.json
msgid "You have a mustache and a short beard forming a patch under your lips."
msgstr ""

#. ~ Description of mutation "Facial hair: anchor beard"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a mustache and a beard starting with a strip going down from the "
"bottom lip, then tracing the jaw lines.  It looks a bit like an anchor, thus "
"the name."
msgstr ""

#. ~ Description of mutation "Facial hair: short boxed beard"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a mustache and a short beard with trimmed sides.  Thin patches "
"connect them both, forming a 'box' around the lips, thus the name."
msgstr ""

#. ~ Description of mutation "Facial hair: chevron mustache"
#: data/json/mutations/mutation_appearance.json
msgid "You have a mustache that covers your entire top lip."
msgstr ""

#. ~ Description of mutation "Facial hair: 3-day stubble"
#: data/json/mutations/mutation_appearance.json
msgid "You have a short trimmed mustache and beard imitating a 3-day stubble."
msgstr ""

#. ~ Description of mutation "Facial hair: horseshoe"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a mustache with patches going down the chin from both ends, thus the"
" name."
msgstr ""

#. ~ Description of mutation "Facial hair: original mustache"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a mustache with shortened ends, that covers only the skin above your"
" upper lip."
msgstr ""

#. ~ Description of mutation "Facial hair: mutton chops beard"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have long sideburns that connect to your mustache, with the tip of the "
"chin shaven clean."
msgstr ""

#. ~ Description of mutation "Facial hair: gunslinger beard"
#: data/json/mutations/mutation_appearance.json
msgid "You have a horseshoe mustache and disconnected sideburns."
msgstr ""

#. ~ Description of mutation "Facial hair: chin curtain"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a full beard without a mustache, restricted to the chin, sometimes "
"called a 'lion's mane'. Much like Abraham Lincoln's beard."
msgstr ""

#. ~ Description of mutation "Facial hair: chin strap"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a beard along the jaw lines, circling the chin, and no mustache."
msgstr ""

#. ~ Description of mutation "Facial hair: beard"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a mustache and a long beard, both formed by allowing free growth of "
"hair, with no particular styling."
msgstr ""

#. ~ Description of mutation "Facial hair: handlebar mustache"
#: data/json/mutations/mutation_appearance.json
msgid "You have a mustache with long flared out ends."
msgstr ""

#. ~ Description of mutation "Facial hair: neckbeard"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a beard formed from hair grown on neck below the chin line.  No "
"mustache included."
msgstr ""

#. ~ Description of mutation "Facial hair: pencil mustache"
#: data/json/mutations/mutation_appearance.json
msgid "You have a very thin mustache just above the line of the upper lip."
msgstr ""

#. ~ Description of mutation "Facial hair: shenandoah"
#: data/json/mutations/mutation_appearance.json
msgid ""
"Long full beard with no mustache, popular among Amish community, often with "
"two pointed ends."
msgstr ""

#. ~ Description of mutation "Facial hair: toothbrush mustache"
#: data/json/mutations/mutation_appearance.json
msgid ""
"Charlie Chaplin used to have this short patch of hair just under the nose, "
"but then that other guy used it as a characteristic, and it became unwelcome."
msgstr ""

#. ~ Description of mutation "Facial hair: Van Dyke"
#: data/json/mutations/mutation_appearance.json
msgid "You have a handlebar mustache with a chin strip or a small goatee."
msgstr ""

#. ~ Description of mutation "Facial hair: walrus"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a long thick mustache, overshadowing your lips, that somewhat "
"resembles the facial hair of a walrus."
msgstr ""

#. ~ Description of mutation "Facial hair: The Zappa"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a wide soul patch and a full mustache that extends a bit downwards "
"at the corners of your lips."
msgstr ""

#. ~ Description of mutation "Facial hair: long beard"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a long beard, that goes down to your chest.  Somewhat reminiscent of"
" Santa's mustache."
msgstr ""

#. ~ Description of mutation "Facial hair: very long beard"
#: data/json/mutations/mutation_appearance.json
msgid ""
"You have a very long beard, that goes down to your waist, like wise old "
"mentors have."
msgstr ""

#. ~ "mutagen_message" of mutation class "Crustacean"
#: data/json/mutations/mutation_category.json
msgid ""
"You suddenly want to burrow under some sand or find some nice rocky alcove to"
" hide behind."
msgstr ""

#. ~ Memorial message of mutation class "Crustacean" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Dreamed of walking along the sea floor."
msgstr ""

#. ~ Memorial message of mutation class "Crustacean" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Dreamed of walking along the sea floor."
msgstr ""

#. ~ "mutagen_message" of mutation class "Chiropteran"
#: data/json/mutations/mutation_category.json
msgid "Your ears ring and you taste iron."
msgstr ""

#. ~ Memorial message of mutation class "Chiropteran" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Became the night."
msgstr ""

#. ~ Memorial message of mutation class "Chiropteran" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Became the night."
msgstr ""

#. ~ Memorial message of mutation class "Mycus" for male
#: data/json/mutations/mutation_category.json
msgctxt "memorial_male"
msgid "Dissolved into the collective."
msgstr ""

#. ~ Memorial message of mutation class "Mycus" for female
#: data/json/mutations/mutation_category.json
msgctxt "memorial_female"
msgid "Dissolved into the collective."
msgstr ""

#. ~ Name of spell "spell_avian_leap"
#: data/json/mutations/mutation_spells.json
msgid "Talon Leap"
msgstr ""

#. ~ Name of spell "ink_gland_spray_primer"
#: data/json/mutations/mutation_spells.json
msgid "Blinding spray primer"
msgstr ""

#. ~ Description of spell "ink_gland_spray_primer ( Blinding spray primer )"
#: data/json/mutations/mutation_spells.json
msgid ""
"Blinds a random nearby enemy for a short duration and up an ink_gland_ink "
"status charge."
msgstr ""

