#. ~ Description of monster "fungal bulk"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This terrifying fungal construct seems to have lost all facial features, its "
"face covered in thick fungal sprouts.  Its arms end in jagged points as "
"fungal tendrils burst forth."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "dusted brute zombie"
msgid_plural "dusted brute zombies"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "dusted brute zombie"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This zombie's entire body bulges with distended muscles heavily dusted with a"
" thick gray powder."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "fungal stalk brute"
msgid_plural "fungal stalk brutes"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "fungal stalk brute"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This inhumanly muscular corpse has numerous festering wounds and has grown a "
"short stalk of gray fungus bursting from the skull."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "fungal brute"
msgid_plural "fungal brutes"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "fungal brute"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This bulky fungal construct seems to have lost all facial features, its chest"
" and face covered in thick fungal sprouts.  Its arms and legs are grotesquely"
" swollen."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "dusted zombie hulk"
msgid_plural "dusted zombie hulks"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "dusted zombie hulk"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This zombie's muscular body has swollen to six times the size of an average "
"person and has been heavily dusted with a thick gray powder."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "fungal stalk hulk"
msgid_plural "fungal stalk hulks"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "fungal stalk hulk"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This enormous muscular corpse has swollen six times larger and has grown a "
"short stalk of gray fungus bursting from the skull."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "fungal hulk"
msgid_plural "fungal hulks"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "fungal hulk"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This inhumanly warped and swollen fungal construct is entirely covered in "
"thick fungal sprouts.  The body shape is still roughly humanoid but the size "
"is too large, about the size of six people combined."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "dusted crawling zombie"
msgid_plural "dusted crawling zombies"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "dusted crawling zombie"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This moving corpse with badly damaged legs has been heavily dusted with a "
"thick gray powder."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "fungal stalk crawler"
msgid_plural "fungal stalk crawlers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "fungal stalk crawler"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This moving corpse with badly damaged legs has grown a short stalk of gray "
"fungus bursting from the skull."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "fungal zombie crawler"
msgid_plural "fungal zombie crawlers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "fungal zombie crawler"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This fungal monster struggles to move as bulbous mushrooms grow from its "
"exposed back.  Its leg seems to be wrapped in sturdy tendrils, and its arms "
"visibly swell and pop gruesomely with each drag along the ground."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "dusted fat zombie"
msgid_plural "dusted fat zombies"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "dusted fat zombie"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This heavy moving corpse has been heavily dusted with a thick gray powder."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "fungal stalk feeder"
msgid_plural "fungal stalk feeders"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "fungal stalk feeder"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This heavy corpse has grown a short stalk of gray fungus bursting from the "
"skull."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "fungal feeder"
msgid_plural "fungal feeders"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "fungal feeder"
#: data/json/monsters/fungus_zombie.json
msgid ""
"Thousands upon thousands of fungal bulbs, sprouts and tendrils jut out from "
"every angle of this walking carcass.  Large patches of yellow pulsating mold "
"seem to be growing in the zombie's fat folds."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "dusted scarred zombie"
msgid_plural "dusted scarred zombies"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "dusted scarred zombie"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This heavily scarred moving corpse has been covered with a thick gray powder."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "fungalizing scarred zombie"
msgid_plural "fungalizing scarred zombies"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "fungalizing scarred zombie"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This heavily scarred moving corpse has grown a short stalk of gray fungus "
"bursting from the skull."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "scarred fungal zombie"
msgid_plural "scarred fungal zombies"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "scarred fungal zombie"
#: data/json/monsters/fungus_zombie.json
msgid ""
"The tough callouses and scar tissue of this unfortunate corpse are the only "
"remaining signs of something once made of flesh; any spot seemingly soft "
"enough has been thoroughly punctured by thick fungal tendrils that have "
"started to creep over this disfigured husk."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "dusted acidic zombie"
msgid_plural "dusted acidic zombies"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "dusted acidic zombie"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This acrid smelling moving corpse has been covered with a thick gray powder."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "fungalizing acid zombie"
msgid_plural "fungalizing acid zombies"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "fungalizing acid zombie"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This sickly looking moving corpse with prominent yellow veins has grown a "
"short stalk of gray fungus bursting from the skull."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "acidic fungal zombie"
msgid_plural "acidic fungal zombies"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "acidic fungal zombie"
#: data/json/monsters/fungus_zombie.json
msgid ""
"A grotesque fusion of rot and mycelium, this zombie's flesh is pocked with "
"open sores that lazily drool a strange yellow-green acid.  Pale fungal stalks"
" have burst through its corroded skin, their slimy caps dripping with what "
"seems to be the same fluid.  The air around it is thick with the scent of rot"
" and acrid chemicals."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "fungal dog"
msgid_plural "fungal dogs"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "fungal dog"
#: data/json/monsters/fungus_zombie.json
msgid ""
"The deformed, animated, and again reanimated corpse of a what looked like the"
" concept of a canine.  It has lost almost all of its dog-like features, "
"except for its constant aggressive growling, and tendency to bite.  It shakes"
" its fur like a wet dog, sending tiny spore clouds everywhere."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "antlered fungal horror"
msgid_plural "antlered fungal horrors"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "antlered fungal horror"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This formerly-majestic beast has lost any semblance of what a moose is, aside"
" from its outgrown antlers, now covered in writhing fungal tendrils, "
"seemingly trying to break into the cracking bone.  The animated corpse seems "
"to be in a state of constant disrepair, held together by strange, sticky blue"
" orbs."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "fungal pouncer"
msgid_plural "fungal pouncers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "fungal pouncer"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This four legged, oversized cat seems to spew spores from its pawpads with "
"each clumsy landing, as if constantly gaining and losing balance in air."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid " rotten fungal horse"
msgid_plural " rotten fungal horses"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster " rotten fungal horse"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This hulking horse-figure seems to re-learn galloping with every step, as "
"large fungi cling and sprout off of its mane.  It travels towards anything "
"moving, even though in the center of each eye lies multiple fungal blooms."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "tiger fungal wight"
msgid_plural "tiger fungal wights"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "tiger fungal wight"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This rotting tiger has lost its stumble, as large fungal bulbs seem to have "
"extended its pawpads thoroughly.  Its head crackles when trying to turn, "
"seemingly stuck facing forward."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "fungal wight"
msgid_plural "fungal wights"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "fungal wight"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This deer's thick fur is spotted with blue orbs that seem to pop and ooze "
"every few minutes, and its rotten skin seems unable to fall off, held "
"together by thick fungal bedding underneath."
msgstr ""

#. ~ Monster name
#: data/json/monsters/fungus_zombie.json
msgid "fungal reindeer"
msgid_plural "fungal reindeer"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "fungal reindeer"
#: data/json/monsters/fungus_zombie.json
msgid ""
"This bumpy, discolored reindeer resembles a malformed Rudolph, its nose "
"having a faintly glowing red fungal sprout.  It'd look almost comical if it "
"wasn't mutilating bodies with its innate strength."
msgstr ""

#. ~ Description of monster "graboid"
#: data/json/monsters/insect_spider.json
msgid ""
"This huge subterranean creature is a far cry from its earthworm ancestors.  "
"Despite only seeing its head, you can tell its grown to a mind-boggling size."
"  While the image may be quite unsettling, it doesn't appear to pay you any "
"mind."
msgstr ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "graboid half worm"
msgid_plural "graboid half worms"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "graboid half worm"
#: data/json/monsters/insect_spider.json
msgid "A squiggling severed portion of a wounded graboid."
msgstr ""

#. ~ Description of monster "giant earthworm"
#: data/json/monsters/insect_spider.json
msgid ""
"A huge, mutated garden worm peeking out from the earth - pink, ringed, and "
"most importantly docile.  Despite its size and looks, it appears to be "
"peaceful."
msgstr ""

#. ~ Description of monster "oversized earthworm"
#: data/json/monsters/insect_spider.json
msgid ""
"A disturbingly large wriggling earthworm with the moist earth still clinging "
"to its slimy body.  Despite its size it appears to be peaceful, a refreshing "
"change for once."
msgstr ""

#. ~ Description of monster "oversized half worm"
#: data/json/monsters/insect_spider.json
msgid "A squiggling severed portion of a wounded oversized worm."
msgstr ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "earthworm larva"
msgid_plural "earthworm larvae"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "earthworm larva"
#: data/json/monsters/insect_spider.json
msgid "A white wriggling worm."
msgstr ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "centipede larva"
msgid_plural "centipede larvae"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "centipede larva"
#: data/json/monsters/insect_spider.json
msgid ""
"A juvenile centipede.  Despite its young age it is still quite large and you "
"reckon these mandibles could pack quite a bite."
msgstr ""

#. ~ Description of monster "armored centipede"
#: data/json/monsters/insect_spider.json
msgid ""
"A huge mutated centipede covered in interlocking chitinous plates of metallic"
" gray, reminding you more of a runaway train car than any living animal.  Its"
" mandibles end in jagged points, seemingly specialized to hunt prey at least "
"as well-armored as itself.  You really don't want to try if you'd fare "
"better."
msgstr ""

#. ~ Description of monster "oversized house centipede"
#: data/json/monsters/insect_spider.json
msgid ""
"A mass of spindly legs the size of a large dog.  It is watching you intently,"
" but doesn't go out of its way to hunt you."
msgstr ""

#. ~ Description of monster "giant house centipede"
#: data/json/monsters/insect_spider.json
msgid ""
"A house centipede grown to immense size, with a slender body the size of a "
"child held up by a constantly-twitching mess of legs.  Already a fearsome "
"hunter at its normal scale, both its hunger and range of acceptable prey grew"
" to match its new size."
msgstr ""

#. ~ Description of monster "giant house centipede larva"
#: data/json/monsters/insect_spider.json
msgid "A baby house centipede about the size of a rat."
msgstr ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "firefly larva"
msgid_plural "firefly larvae"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "firefly larva"
#: data/json/monsters/insect_spider.json
msgid ""
"An oversized larva of a firefly.  Shockingly large when compared to the "
"adults of its kind."
msgstr ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "giant grub"
msgid_plural "giant grubs"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "giant grub"
#: data/json/monsters/insect_spider.json
msgid "A grub the size of a small dog."
msgstr ""

#. ~ Description of monster "giant mosquito larva"
#: data/json/monsters/insect_spider.json
msgid ""
"A large mosquito larva.  A bit more unsettling now that it isn't microscopic."
msgstr ""

#. ~ Description of monster "oversized cellar spider"
#: data/json/monsters/insect_spider.json
msgid ""
"A cellar spider - also known as \"daddy long-legs\" - grown to distressing "
"size.  Its body is about the size of your head, with the long, spindly legs "
"raising it up to your knee.  It tries getting away from you with an "
"unnervingly fluid run."
msgstr ""

#. ~ Description of monster "giant cellar spider"
#: data/json/monsters/insect_spider.json data/mods/Defense_Mode/monsters.json
msgid ""
"A huge brown spider in constant movement, with a small body the size of a "
"child held up at chest level by a set of spindly legs that branch into three-"
"pronged graspers at the end.  Unlike the smaller variant it obviously decided"
" hunting you is worth a try, and follows you with mandibles chittering in "
"anticipation."
msgstr ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "cellar spiderling"
msgid_plural "cellar spiderlings"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "cellar spiderling"
#: data/json/monsters/insect_spider.json
msgid "A juvenile cellar spider, about the size of a beer bottle."
msgstr ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "mommy long-legs"
msgid_plural "mommy long legs"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "mommy long-legs"
#: data/json/monsters/insect_spider.json
msgid ""
"This surprisingly shy giant cellar spider holds a head-sized ball of crawling"
" spiderlings of different ages in its mandibles, carefully balancing on her "
"long legs not to drop the precious cargo.  She seems uninterested in you."
msgstr ""

#. ~ Death message of monster "mommy long-legs"
#: data/json/monsters/insect_spider.json
msgid "The spiderlings fall to the ground!"
msgstr ""

#. ~ Description of monster "warehouse spider"
#: data/json/monsters/insect_spider.json
msgid ""
"A tangle of branching chitinous legs operating seemingly independently, "
"somehow still managing to carry a cow-sized central body.  A number of "
"malformed, twitching legs hang from the cephalothorax, but the head -and "
"especially the mandibles- still seem to be in working order."
msgstr ""

#. ~ Monster message of special attack of monster "warehouse spider"
#: data/json/monsters/insect_spider.json
msgid "The maimed legs start twitching erratically!"
msgstr ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "detached spider leg"
msgid_plural "detached spider legs"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "detached spider leg"
#: data/json/monsters/insect_spider.json
msgid ""
"The strangely branching leg of a mutated cellar spider that… fell?  crawled?"
"  off of the main body when hurt.  It now flails about blindly, irregular "
"clawed appendages grasping at anything that comes close."
msgstr ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "jumping spiderling"
msgid_plural "jumping spiderlings"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "jumping spiderling"
#: data/json/monsters/insect_spider.json
msgid "A juvenile jumping spider, about the size of a beer bottle."
msgstr ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "trapdoor spiderling"
msgid_plural "trapdoor spiderlings"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "trapdoor spiderling"
#: data/json/monsters/insect_spider.json
msgid "A juvenile trapdoor spider, about the size of a beer bottle."
msgstr ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "web spiderling"
msgid_plural "web spiderlings"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "web spiderling"
#: data/json/monsters/insect_spider.json
msgid ""
"A juvenile giant grass spider, about the size of a beer bottle.  Too young to"
" be venomous, or to walk proficiently for that matter."
msgstr ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "black widow spiderling"
msgid_plural "black widow spiderlings"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "black widow spiderling"
#: data/json/monsters/insect_spider.json
msgid ""
"The horrid spawn of a giant black widow spider.  Though, given the size that "
"it currently is, it appears relatively harmless."
msgstr ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "wolf spiderling"
msgid_plural "wolf spiderlings"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "wolf spiderling"
#: data/json/monsters/insect_spider.json
msgid "A juvenile wolf spider, about the size of a beer bottle."
msgstr ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "giant acidic queen ant"
msgid_plural "giant acidic queen ants"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "giant acidic soldier ant"
msgid_plural "giant acidic soldier ants"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "super soldier acidic ant"
msgid_plural "super soldier acidic ants"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "super soldier acidic ant"
#: data/json/monsters/insect_spider.json
msgid ""
"A cow-sized, woolly brown ant.  Corrosive liquid seeping from her huge "
"mandibles.  Given the relative strength of ants to their body size, you don't"
" doubt that this one could shove cars around or rip through solid walls."
msgstr ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "giant queen ant"
msgid_plural "giant queen ants"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "giant soldier ant"
msgid_plural "giant soldier ants"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "praying mantis nymph"
msgid_plural "praying mantis nymphs"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "praying mantis nymph"
#: data/json/monsters/insect_spider.json
msgid ""
"A mantis nymph about the size of a dog.  Even though its far smaller than the"
" adults, you have a feeling it wouldn't take kindly to you coming too close."
msgstr ""

#. ~ Monster name
#: data/json/monsters/insect_spider.json
msgid "mole cricket nymph"
msgid_plural "mole cricket nymphs"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "mole cricket nymph"
#: data/json/monsters/insect_spider.json
msgid "A whitish mole cricket nymph the size of a dog."
msgstr ""

