#: src/activity_actor.cpp
#, c-format
msgid "Your %s is little more than an awkward club now."
msgstr "Przedmiot %s jest teraz niewiele więcej niż niezgrabną pałką."

#: src/activity_actor.cpp
#, c-format
msgid "Your %s is too hot, and little screen signalizes the gun is inoperable."
msgstr ""
"Przedmiot %s jest zbyt gorący, a mały ekranik sygnalizuje, że broń nie "
"działa."

#: src/activity_actor.cpp
msgid "You're no longer able to make progress smashing here."
msgstr "Nie możesz już robić postępów w rozbijaniu w tym miejscu."

#: src/activity_actor.cpp
#, c-format
msgid "You deftly maneuver around %s."
msgstr "Zręcznie omijasz: %s."

#: src/activity_actor.cpp
#, c-format
msgid "<npcname> deftly maneuvers around %s."
msgstr "<npcname> zręcznie omija: %s."

#: src/activity_actor.cpp
msgid ""
"You lose track of some hauled items as they didn't fit on the current tile."
msgstr ""
"Gubisz z oczu część ciągniętych przedmiotów, bo nie zmieściły się na bieżącym"
" polu."

#: src/activity_actor.cpp
#, c-format
msgid "You scan %d %s into your device."
msgstr "Skanujesz do urządzenia: %d %s."

#: src/activity_actor.cpp
#, c-format
msgid "%s scans %d %s into their device."
msgstr "%s skanuje do urządzenia: %d %s."

#: src/activity_actor.cpp
#, c-format
msgid "%s stops scanning books."
msgstr "%s przestaje skanować książki."

#: src/activity_actor.cpp
#, c-format
msgid "The %s ran out of batteries!"
msgstr "W urządzeniu %s skończyły się baterie!"

#: src/activity_actor.cpp
msgid "No devices needed to be processed."
msgstr "Żadne urządzenie nie wymagało przetworzenia."

#: src/activity_actor.cpp
#, c-format
msgid "You failed to %s %d device(s)."
msgstr "Nie udało się wykonać akcji „%s” (urządzenia: %d)."

#: src/activity_actor.cpp
#, c-format
msgid "You successfully %s %d/%d device(s)."
msgstr "Pomyślnie %s %d/%d urządzeń."

#: src/activity_actor.cpp
msgid "File size exceeds available memory; canceling file move."
msgstr ""
"Rozmiar pliku przekracza dostępną pamięć; anulowanie przenoszenia pliku."

#: src/activity_actor.cpp
msgid "You stop processing the remaining devices."
msgstr "Przestajesz przetwarzać pozostałe urządzenia."

#: src/activity_actor.cpp
#, c-format
msgid "%s stops processing devices."
msgstr "%s przestaje przetwarzać urządzenia."

#: src/activity_actor.cpp
msgid " files off of"
msgstr " pliki z"

#: src/activity_actor.cpp
msgid " files onto"
msgstr " pliki na"

#: src/activity_actor.cpp
msgid "The grabbed furniture has been lost."
msgstr "Chwycony mebel został utracony."

#: src/activity_actor.cpp
msgid "Can't drag to there."
msgstr "Nie można tam przeciągnąć."

#: src/activity_actor.cpp
msgid "item would spill"
msgstr "przedmiot by się wysypał"

#: src/activity_actor.cpp
#, c-format
msgid ""
"The parent container does not have enough space to fit more items.  Would you"
" like to first wield %s to fit more?"
msgstr ""
"W pojemniku nadrzędnym nie ma dość miejsca na więcej przedmiotów. Czy chcesz "
"najpierw wziąć do ręki: %s, by zmieścić więcej?"

#: src/activity_actor.cpp
#, c-format
msgid ""
"The parent container does not have enough space to fit more than %i %s.  "
"Would you like to first wield %s to fit more?"
msgstr ""
"W pojemniku nadrzędnym nie ma dość miejsca na więcej niż %i %s. Czy chcesz "
"najpierw wziąć do ręki: %s, by zmieścić więcej?"

#: src/activity_actor.cpp
#, c-format
msgid ""
"Your %1$s doesn't have enough charges to complete the job.  Continue anyway?"
msgstr ""
"Przedmiot %1$s nie ma dość ładunków, by dokończyć zadanie. Kontynuować mimo "
"to?"

#: src/activity_actor.cpp src/item.cpp
#, c-format
msgid "You reel in the %s and wind it up."
msgstr "Ściągasz i zwijasz: %s."

#: src/activity_actor.cpp
msgid "You'll need the outfit in your hands before you can change outfits."
msgstr "Musisz trzymać strój w rękach, zanim go zmienisz."

#: src/activity_actor.cpp
#, c-format
msgid "Your %s seems to enjoy the interaction, but you feel nothing."
msgstr ""
"Przedmiot %s wydaje się cieszyć z tej interakcji, ale ty nic nie czujesz."

#: src/activity_actor.cpp
#, c-format
msgid "%s can't reach the source tile."
msgstr "%s nie może dosięgnąć pola źródłowego."

#: src/activity_actor.cpp src/iuse.cpp
msgid "You need more energy to heat these items."
msgstr "Potrzebujesz więcej energii, by podgrzać te przedmioty."

#: src/activity_actor.cpp
msgid "Some of the food you selected is gone."
msgstr "Części wybranego jedzenia już nie ma."

#: src/activity_actor.cpp
msgid ""
"You cannot pulp acid-filled corpses, and need to be slowly dismembered to "
"prevent acid spraying on your skin."
msgstr ""
"Nie możesz zmiażdżyć zwłok wypełnionych kwasem; trzeba je powoli "
"rozczłonkować, by kwas nie opryskał ci skóry."

#: src/activity_actor.cpp
msgid ""
"You cannot pulp this corpse, for you have no tool heavy enough to deal with "
"it quickly."
msgid_plural ""
"You cannot pulp these corpses, for you have no tool heavy enough to deal with"
" it quickly."
msgstr[0] ""
"Nie możesz zmiażdżyć tego ciała, bo nie masz narzędzia dość ciężkiego, by "
"szybko sobie z nim poradzić."
msgstr[1] ""
"Nie możesz zmiażdżyć tych ciał, bo nie masz narzędzia dość ciężkiego, by "
"szybko sobie z nimi poradzić."
msgstr[2] ""
"Nie możesz zmiażdżyć tych ciał, bo nie masz narzędzia dość ciężkiego, by "
"szybko sobie z nimi poradzić."
msgstr[3] ""
"Nie możesz zmiażdżyć tych ciał, bo nie masz narzędzia dość ciężkiego, by "
"szybko sobie z nimi poradzić."

#: src/activity_actor.cpp
msgid "<npcname> cannot pulp this corpse without a heavier tool."
msgid_plural "<npcname> cannot pulp these corpses without a heavier tool."
msgstr[0] "<npcname> nie może zmiażdżyć tego ciała bez cięższego narzędzia."
msgstr[1] "<npcname> nie może zmiażdżyć tych ciał bez cięższego narzędzia."
msgstr[2] "<npcname> nie może zmiażdżyć tych ciał bez cięższego narzędzia."
msgstr[3] "<npcname> nie może zmiażdżyć tych ciał bez cięższego narzędzia."

#: src/activity_actor.cpp
msgid ""
"You interrupted pulping of this corpse, for you have no tool heavy enough to "
"deal with it quickly."
msgid_plural ""
"You interrupted pulping of these corpses, for you have no tool heavy enough "
"to deal with it quickly."
msgstr[0] ""
"Przerywasz miażdżenie tego ciała, bo nie masz narzędzia dość ciężkiego, by "
"szybko sobie z nim poradzić."
msgstr[1] ""
"Przerywasz miażdżenie tych ciał, bo nie masz narzędzia dość ciężkiego, by "
"szybko sobie z nimi poradzić."
msgstr[2] ""
"Przerywasz miażdżenie tych ciał, bo nie masz narzędzia dość ciężkiego, by "
"szybko sobie z nimi poradzić."
msgstr[3] ""
"Przerywasz miażdżenie tych ciał, bo nie masz narzędzia dość ciężkiego, by "
"szybko sobie z nimi poradzić."

#: src/activity_actor.cpp
#, c-format
msgid ""
"<npcname> left one corpse unpulped, for %1$s has no tool heavy enough to deal"
" with it."
msgid_plural ""
"<npcname> left some corpses unpulped, for %1$s has no tool heavy enough to "
"deal with it."
msgstr[0] ""
"<npcname> zostawia jedno ciało niezmiażdżone, bo %1$s nie ma narzędzia dość "
"ciężkiego, by sobie z nim poradzić."
msgstr[1] ""
"<npcname> zostawia kilka ciał niezmiażdżonych, bo %1$s nie ma narzędzia dość "
"ciężkiego, by sobie z nimi poradzić."
msgstr[2] ""
"<npcname> zostawia kilka ciał niezmiażdżonych, bo %1$s nie ma narzędzia dość "
"ciężkiego, by sobie z nimi poradzić."
msgstr[3] ""
"<npcname> zostawia kilka ciał niezmiażdżonych, bo %1$s nie ma narzędzia dość "
"ciężkiego, by sobie z nimi poradzić."

#: src/activity_actor.cpp
msgid "You finished pulping the corpse."
msgid_plural "You finished pulping the corpses."
msgstr[0] "Kończysz miażdżenie ciała."
msgstr[1] "Kończysz miażdżenie ciał."
msgstr[2] "Kończysz miażdżenie ciał."
msgstr[3] "Kończysz miażdżenie ciał."

#: src/activity_actor.cpp
#, c-format
msgid "It took you some time, messing corpses with your trusty %1$s."
msgstr ""
"Zajęło ci to trochę czasu, rozwalanie ciał niezawodnym narzędziem: %1$s."

#: src/activity_actor.cpp
#, c-format
msgid ""
"It took you some time, stomping corpses with nothing but your %1$s, and "
"occasionally cutting it with a %2$s."
msgstr ""
"Zajęło ci to trochę czasu, deptanie ciał, mając do dyspozycji tylko: %1$s, i "
"od czasu do czasu cięcie ich narzędziem: %2$s."

#: src/activity_actor.cpp
#, c-format
msgid ""
"It took you some time, bashing corpses with your %1$s, with occasional cuts "
"with a %2$s."
msgstr ""
"Zajęło ci to trochę czasu, tłuczenie ciał narzędziem: %1$s, i od czasu do "
"czasu cięcie ich narzędziem: %2$s."

#: src/activity_actor.cpp
#, c-format
msgid ""
"It took you some time, mixing your %1$s with powerful stomps, and occasional "
"cuts with a %2$s."
msgstr ""
"Zajęło ci to trochę czasu, mieszanie ciosów narzędziem %1$s z potężnymi "
"tupnięciami i od czasu do czasu cięcie narzędziem: %2$s."

#: src/activity_actor.cpp
#, c-format
msgid "It took you some time, stomping corpses with nothing but your %1$s."
msgstr ""
"Zajęło ci to trochę czasu, deptanie ciał, mając do dyspozycji tylko: %1$s."

#: src/activity_actor.cpp
#, c-format
msgid "It took you some time, bashing corpses with just your %1$s."
msgstr ""
"Zajęło ci to trochę czasu, tłuczenie ciał samym tylko narzędziem: %1$s."

#: src/activity_actor.cpp
msgid ""
"Heavy breathing, you think your form is far from perfect for such activities."
msgstr ""
"Ciężko dysząc, myślisz, że twoja forma jest daleka od idealnej do takich "
"zajęć."

#: src/activity_actor.cpp
#, c-format
msgid ""
"You praise yourself for bringing %1$s, it helped a lot with more armoured "
"bits."
msgstr ""
"Chwalisz się w duchu, że wziąłeś ze sobą przedmiot %1$s – bardzo pomógł przy "
"lepiej opancerzonych kawałkach."

#: src/activity_actor.cpp
msgid ""
"You also consider finding something like a crowbar, you had a really hard "
"time without it."
msgstr ""
"Rozważasz też znalezienie czegoś w rodzaju łomu – bez niego było ci naprawdę "
"ciężko."

#: src/activity_actor.cpp
msgid ""
"You left one corpse unpulped, for you have no tool heavy enough to deal with "
"it."
msgid_plural ""
"You left some corpses unpulped, for you have no tool heavy enough to deal "
"with it."
msgstr[0] ""
"Zostawiasz jedno ciało niezmiażdżone, bo nie masz narzędzia dość ciężkiego, "
"by sobie z nim poradzić."
msgstr[1] ""
"Zostawiasz kilka ciał niezmiażdżonych, bo nie masz narzędzia dość ciężkiego, "
"by sobie z nimi poradzić."
msgstr[2] ""
"Zostawiasz kilka ciał niezmiażdżonych, bo nie masz narzędzia dość ciężkiego, "
"by sobie z nimi poradzić."
msgstr[3] ""
"Zostawiasz kilka ciał niezmiażdżonych, bo nie masz narzędzia dość ciężkiego, "
"by sobie z nimi poradzić."

#: src/activity_handlers.cpp src/iexamine.cpp
#, c-format
msgid "You squeeze the last drops of %s from the tank."
msgstr "Wyciskasz ze zbiornika ostatnie krople: %s."

#: src/activity_handlers.cpp
msgid "Select tinder to use for lighting a fire"
msgstr "Wybierz podpałkę do rozpalenia ognia"

#: src/activity_handlers.cpp
#, c-format
msgid "<npcname> learns a little about the spell: %s"
msgstr "<npcname> uczy się nieco o zaklęciu: %s"

#: src/activity_handlers.cpp
msgid "You can no longer find the item to repair."
msgstr "Nie możesz już znaleźć przedmiotu do naprawy."

#: src/activity_handlers.cpp
msgid "You cannot reach that destination."
msgstr "Nie możesz dotrzeć do tego celu."

#. ~ %1$s is item name, %2$s is vehicle name, %3$s is vehicle part name
#: src/activity_item_handling.cpp
#, c-format
msgid "Unable to fit %1$s in the %2$s's %3$s."
msgstr "Nie można zmieścić: %1$s w %3$s (%2$s)."

#: src/activity_item_handling.cpp
#, c-format
msgid "You put some of your %1$s in the %2$s's %3$s."
msgid_plural "You put some of your %1$s in the %2$s's %3$s."
msgstr[0] "Wkładasz część: %1$s do %3$s (%2$s)."
msgstr[1] "Wkładasz część: %1$s do %3$s (%2$s)."
msgstr[2] "Wkładasz część: %1$s do %3$s (%2$s)."
msgstr[3] "Wkładasz część: %1$s do %3$s (%2$s)."

#: src/activity_item_handling.cpp
#, c-format
msgid "<npcname> puts some of their %1$s in the %2$s's %3$s."
msgid_plural "<npcname> puts some of their %1$s in the %2$s's %3$s."
msgstr[0] "<npcname> wkłada część: %1$s do %3$s (%2$s)."
msgstr[1] "<npcname> wkłada część: %1$s do %3$s (%2$s)."
msgstr[2] "<npcname> wkłada część: %1$s do %3$s (%2$s)."
msgstr[3] "<npcname> wkłada część: %1$s do %3$s (%2$s)."

#: src/activity_item_handling.cpp
msgid ""
"There's a human corpse there.  You wouldn't want to butcher it by accident."
msgstr "Leżą tam ludzkie zwłoki. Nie chcesz ich przypadkiem poćwiartować."

#: src/activity_item_handling.cpp
#, c-format
msgid "You don't have the skill for the %1$s task at zone %2$s."
msgstr "Nie masz umiejętności do zadania %1$s w strefie %2$s."

#: src/activity_item_handling.cpp
#, c-format
msgid "You don't have the skill for the %s task."
msgstr "Nie masz umiejętności do zadania %s."

#: src/activity_item_handling.cpp
#, c-format
msgid ""
"There is something blocking the location for the %1$s task at zone %2$s."
msgstr "Coś blokuje miejsce zadania %1$s w strefie %2$s."

#: src/activity_item_handling.cpp
#, c-format
msgid "There is something blocking the location for the %s task."
msgstr "Coś blokuje miejsce zadania %s."

#: src/activity_item_handling.cpp
#, c-format
msgid ""
"%s is trying to find necessary items to do the %s job on zone %s, reason %s"
msgstr ""
"%s próbuje znaleźć przedmioty potrzebne do zadania %s w strefie %s, powód: %s"

#: src/activity_item_handling.cpp
#, c-format
msgid "%s is trying to find necessary items to do the %s job, reason %s"
msgstr "%s próbuje znaleźć przedmioty potrzebne do zadania %s, powód: %s"

#: src/activity_item_handling.cpp
#, c-format
msgid ""
"The required items are not available to complete the %s task at zone %s."
msgstr "Brak wymaganych przedmiotów do wykonania zadania %s w strefie %s."

#: src/activity_item_handling.cpp
#, c-format
msgid "The required items are not available to complete the %s task."
msgstr "Brak wymaganych przedmiotów do wykonania zadania %s."

#: src/activity_item_handling.cpp
msgid ""
"%1s failed to perform the %2$s activity because no suitable locations were "
"found."
msgstr ""
"%1$s: nie udało się wykonać czynności %2$s, bo nie znaleziono odpowiednich "
"miejsc."

#: src/activity_item_handling.cpp
#, c-format
msgid ""
"%1$s failed to perform the %2$s activity because no path to a suitable "
"location could be found."
msgstr ""
"%1$s: nie udało się wykonać czynności %2$s, bo nie znaleziono drogi do "
"odpowiedniego miejsca."

#: src/activity_item_handling.cpp
#, c-format
msgid ""
"%1$s failed to perform the %2$s activity because no required zone was found."
msgstr ""
"%1$s: nie udało się wykonać czynności %2$s, bo nie znaleziono wymaganej "
"strefy."

#: src/activity_item_handling.cpp
#, c-format
msgid ""
"%1$s failed to perform the %2$s activity because the target location is "
"blocked or cannot be reached."
msgstr ""
"%1$s: nie udało się wykonać czynności %2$s, bo miejsce docelowe jest "
"zablokowane lub nieosiągalne."

#: src/activity_item_handling.cpp
#, c-format
msgid ""
