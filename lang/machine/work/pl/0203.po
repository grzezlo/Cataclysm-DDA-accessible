#: data/mods/innawood/professions.json
msgctxt "profession_male"
msgid "Spear Hunter"
msgstr ""

#. ~ Description of profession "Spear Hunter" for male
#: data/mods/innawood/professions.json
msgctxt "prof_desc_male"
msgid ""
"Ever since you were a child you loved hunting, and quickly developed a talent"
" for chasing down your prey with a spear.  Why, if the world ended, there's "
"nothing you'd want at your side more than your trusty spear.  So, when it "
"did, you made sure to bring it along."
msgstr ""

