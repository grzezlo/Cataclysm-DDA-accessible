#. ~ Furniture name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/funiture_heavy_industry.json
msgid "metal vapor forge"
msgstr ""

#. ~ Description of furniture "metal vapor forge"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/funiture_heavy_industry.json
msgid ""
"An automated robotic arm capable of precisely depositing metal atoms into any"
" desired shape.  All manufacturing processes of interstellar significance "
"require units such as this, and they are extremely difficult to replace."
msgstr ""

#. ~ Furniture name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/funiture_heavy_industry.json
msgid "high-pressure pumping station"
msgstr ""

#. ~ Description of furniture "high-pressure pumping station"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/funiture_heavy_industry.json
msgid ""
"A high-pressure pump used to move fluids through industrial systems.  Complex"
" but relatively mundane it construction, it can be salvaged for low grade "
"scrap."
msgstr ""

#. ~ Furniture name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/funiture_heavy_industry.json
msgid "catalytic core"
msgstr ""

#. ~ Description of furniture "catalytic core"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/funiture_heavy_industry.json
msgid ""
"A great pillar of gleaming alloy, used in a variety of industrial "
"metalworking processes.  A critical and near irreplaceable component of "
"interstellar industry."
msgstr ""

#. ~ Description of furniture "metal table"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_habitat.json
msgid ""
"A serviceable but simple table made completely out of metal.  Spartan in "
"appearance and commonly found within habitats and spaceships."
msgstr ""

#. ~ Furniture name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_habitat.json
msgid "foam sofa"
msgstr ""

#. ~ Description of furniture "foam sofa"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_habitat.json
msgid ""
"The classic corporate-style sofa, modular foam cushions mounted over a "
"minimalist stainless steel frame.  A mainstay of frontier design since before"
" the discontinuity."
msgstr ""

#. ~ Furniture name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_habitat.json
msgid "atomic backup generator"
msgstr ""

#. ~ Description of furniture "atomic backup generator"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_habitat.json
msgid ""
"Backup analog dials remain functional, and some latent heat is still present "
"in its aged core.  It will not be long until the cold snuffs it out "
"completely."
msgstr ""

#. ~ Furniture name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_habitat.json
msgid "ancient controller"
msgstr ""

#. ~ Description of furniture "ancient controller"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_habitat.json
msgid ""
"Some of its components remain viable, but most has decayed into useless "
"scrap."
msgstr ""

#. ~ Description of furniture "habitat kitchenette"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_spaceship.json
msgid ""
"A tiny cooking surface only big enough to fit an induction top, placed above "
"and below many integrated storage units.  The minimal space in which you "
"could technically cook."
msgstr ""

#. ~ Description of furniture "fridge"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_spaceship.json
msgid ""
"A compact refrigerator and freezer unit.  Its plugged into a ship's power "
"supply, so it should be expected to work for a very long time."
msgstr ""

#. ~ Furniture name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_spaceship.json
msgid "hydraulic cylinder"
msgstr ""

#. ~ Description of furniture "hydraulic cylinder"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_spaceship.json
msgid ""
"A large cylindrical actuator that extends and retracts the landing gear of "
"the ship."
msgstr ""

#. ~ Furniture name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_spaceship.json
msgid "landing skid"
msgstr ""

#. ~ Description of furniture "landing skid"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/furniture_spaceship.json
msgid ""
"Retractable landing gear for a spaceship, hydraulically actuated and designed"
" to absorb the impact of landing."
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_groundxeno.json
msgid "toxic snow"
msgstr ""

#. ~ Description of terrain "toxic snow"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_groundxeno.json
msgid ""
"Snow freely mingles with industrial runoff, forming orange patches of toxic "
"slush."
msgstr ""

#. ~ Furniture name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_groundxeno.json
msgid "snow bowl"
msgstr ""

#. ~ Description of furniture "snow bowl"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_groundxeno.json
msgid ""
"A small depression dug from mostly clean snow.  Can hold small amounts of "
"liquid."
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_groundxeno.json
msgid "toxic sewage"
msgstr ""

#. ~ Description of terrain "toxic sewage"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_groundxeno.json
msgid ""
"A pond of rust colored water, a thin sheen of iridescent murk reflects light "
"across its surface.  Even brief immersion is likely to prove fatal."
msgstr ""

#. ~ Description of terrain "metal floor"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_habitat_floor.json
msgid ""
"Prefab steel flooring for habitats in hazardous environments.  Its covered "
"with a heavy layer of highly toxic industrial precipitate."
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "starship hull"
msgstr ""

#. ~ Description of terrain "starship hull"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid ""
"A hull segment from a civilian starship.  Only sufficiently armored to defend"
" against the vacuum and radiation of space, the only dangers you'd expect to "
"find on the other side."
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "THI-14 StarCrane instrument panel"
msgstr ""

#. ~ Description of terrain "THI-14 StarCrane instrument panel"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid ""
"A large console, instrument panels and control surfaces.  You can fly the "
"ship from here."
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "cargo bay ramp control"
msgstr ""

#. ~ Description of terrain "cargo bay ramp control"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid ""
"A large console used to lower and raise the cargo bay ramp.  The ramp needs "
"to be retracted before you can take off."
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "retracted bay ramp"
msgstr ""

#. ~ Description of terrain "retracted bay ramp"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid ""
"The closed cargo bay ramp of the ship.  It needs to be lowered before you can"
" disembark."
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "landing stair control"
msgstr ""

#. ~ Description of terrain "landing stair control"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid ""
"A wall mounted control panel for the ship's landing stairs.  Traditionally, "
"its poorly seen for the ship's captain to disembark using the cargo bay ramp "
"instead of these stairs."
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "diamond-matrix canopy"
msgstr ""

#. ~ Description of terrain "diamond-matrix canopy"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid ""
"A massive near-unbreakable starship canopy.  Most nanofabricators would "
"struggle to produce a replacement nowadays."
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "diamond-matrix canopy (floor)"
msgstr ""

#. ~ Description of terrain "diamond-matrix canopy (floor)"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid ""
"A giant pane of diamond-matrix glass, angled to allow viewing beneath the "
"ship's hull."
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "downward loading bay ramp"
msgstr ""

#. ~ Description of terrain "downward loading bay ramp"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "A deployed loading bay ramp, leading downwards and out of the ship."
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "loading bay ramp"
msgstr ""

#. ~ Description of terrain "loading bay ramp"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "A deployed loading bay ramp, leading up into the ship."
msgstr ""

#. ~ Description of terrain "stairs"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "A flight of stairs leading down and out of the ship."
msgstr ""

#. ~ Description of terrain "stairs"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "A flight of stairs leading up and into the ship."
msgstr ""

#. ~ Description of terrain "starship hull"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid ""
"A hull segment from a combat rated civilian starship.  Provides some defense "
"against weapons fire."
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "closed starship hatch"
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "starship corridor"
msgstr ""

#. ~ Description of terrain "starship corridor"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "Large metal plates with access panels to the conduits hiding beneath."
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "starship loading bay"
msgstr ""

#. ~ Description of terrain "starship loading bay"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid ""
"A great slab of carbide, printed as a single piece.  It could withstand "
"centuries of abuse, and indeed it has done so."
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "VENTR aerospike"
msgstr ""

#. ~ Description of terrain "VENTR aerospike"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid ""
"One of eight powerful aerospike engines that allow the StarCrane to reach "
"orbit."
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "StarCrane nacelle"
msgstr ""

#. ~ Description of terrain "StarCrane nacelle"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid ""
"Twin nacelles house independent reactors and fuel supply units.  Hundreds of "
"thousands of StarCranes were built during the 22nd century, and back then you"
" could easily swap a malfunctioning nacelle for a new one in a matter of "
"hours."
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "locked starship hatch"
msgstr ""

#. ~ Description of terrain "locked starship hatch"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid ""
"An armored and airtight spaceship hatch.  Its locked shut, and can only be "
"opened from a control panel."
msgstr ""

#. ~ Description of terrain "sink"
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid ""
"A stainless steel kitchen sink.  Its connected to the ships water supply."
msgstr ""

#. ~ Terrain name
#: data/mods/aftershock_exoplanet/maps/furniture_and_terrain/terrain_spaceship.json
msgid "open starship hatch"
msgstr ""

