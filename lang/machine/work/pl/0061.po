#. ~ Description of effect type "Drank blood"
#: data/json/effects.json
msgid "The star vampire has drunk blood and is now visible."
msgstr "Gwiezdny wampir napił się krwi i jest teraz widoczny."

#. ~ Name of effect type id "star_vampire_blood_drink_feral"
#. ~ Name of effect type id "star_vampire_blood_drink"
#: data/json/effects.json
#: data/json/obsoletion_and_migration_0.I/obsolete_effect.json
msgid "Exsanguination"
msgstr "Wykrwawienie"

#. ~ Description of effect type "Exsanguination"
#: data/json/effects.json
msgid "The monster is drinking your blood, you vile feral!"
msgstr "Potwór pije twoją krew, ty podły dzikusie!"

#. ~ Name of effect type id "ink_gland_ink"
#: data/json/effects.json
msgid "Depleted ink"
msgstr "Wyczerpany atrament"

#. ~ Name of effect type id "ink_gland_ink"
#: data/json/effects.json
msgid "Deflated ink glands"
msgstr "Opróżnione atramentowe gruczoły"

#. ~ Name of effect type id "ink_gland_ink"
#: data/json/effects.json
msgid "Inky glands"
msgstr "Atrament w gruczołach"

#. ~ Name of effect type id "ink_gland_ink"
#: data/json/effects.json
msgid "Bulged ink glands"
msgstr "Nabrzmiałe atramentowe gruczoły"

#. ~ Description of effect type "Depleted ink"
#: data/json/effects.json
msgid ""
"Your ink glands are empty.  Given some time and hydration they will recharge."
msgstr ""
"Twoje atramentowe gruczoły są puste. Z czasem i przy odpowiednim nawodnieniu "
"znów się napełnią."

#. ~ Description of effect type "Deflated ink glands"
#: data/json/effects.json
msgid ""
"Your ink glands are almost empty.  Given some time and hydration they will "
"recharge."
msgstr ""
"Twoje atramentowe gruczoły są niemal puste. Z czasem i przy odpowiednim "
"nawodnieniu znów się napełnią."

#. ~ Description of effect type "Inky glands"
#: data/json/effects.json
msgid ""
"Your ink glands have some ink inside.  Given some time and hydration, more "
"ink will be generated."
msgstr ""
"W twoich atramentowych gruczołach jest trochę atramentu. Z czasem i przy "
"odpowiednim nawodnieniu powstanie go więcej."

#. ~ Description of effect type "Bulged ink glands"
#: data/json/effects.json
msgid "Your ink glands are bulged and full.  No more ink is being created."
msgstr ""
"Twoje atramentowe gruczoły są nabrzmiałe i pełne. Nie wytwarzają już więcej "
"atramentu."

#. ~ Name of effect type id "cramped_space"
#: data/json/effects.json
msgid "Cramped Space"
msgstr "Ciasna przestrzeń"

#. ~ Description of effect type "Cramped Space"
#. ~ Apply message of effect type "Cramped Space"
#: data/json/effects.json
msgid "Your movements are restricted by the surroundings."
msgstr "Otoczenie ogranicza twoje ruchy."

#. ~ Remove message of effect type "Cramped Space"
#: data/json/effects.json
msgid "You are able to move freely again."
msgstr "Znów możesz swobodnie się poruszać."

#. ~ Miss message of effect type "Cramped Space"
#: data/json/effects.json
msgid "You don't have any room to move!"
msgstr "Nie masz miejsca na ruch!"

#. ~ Name of effect type id "gliding"
#: data/json/effects.json
msgid "Gliding"
msgstr "Szybowanie"

#. ~ Description of effect type "Gliding"
#: data/json/effects.json
msgid "You are gliding through the air."
msgstr "Szybujesz w powietrzu."

#. ~ Name of effect type id "slow_descent"
#: data/json/effects.json
msgid "Slow Descent"
msgstr "Powolne opadanie"

#. ~ Description of effect type "Slow Descent"
#: data/json/effects.json
msgid "You are descending at a safe speed."
msgstr "Opadasz z bezpieczną prędkością."

#. ~ Description of effect type "Mute"
#: data/json/effects.json
msgid "You can't talk."
msgstr "Nie możesz mówić."

#. ~ Name of effect type id "social_satisfied"
#: data/json/effects.json
msgid "Good Company"
msgstr "Dobre towarzystwo"

#. ~ Description of effect type "Good Company"
#: data/json/effects.json
msgid "It feels good to spend time around others."
msgstr "Dobrze jest spędzać czas wśród innych."

#. ~ Name of effect type id "social_dissatisfied"
#: data/json/effects.json
msgid "Very Lonely"
msgstr "Wielka samotność"

#. ~ Name of effect type id "social_dissatisfied"
#: data/json/effects.json
msgid "All Alone"
msgstr "Zupełna samotność"

#. ~ Description of effect type "Lonely"
#: data/json/effects.json
msgid "You feel a little lonely."
msgstr "Czujesz się trochę samotny."

#. ~ Description of effect type "Very Lonely"
#: data/json/effects.json
msgid "You could really use a friend right now."
msgstr "Naprawdę przydałby ci się teraz przyjaciel."

#. ~ Description of effect type "All Alone"
#: data/json/effects.json
msgid "What's the point of surviving if you're all alone?"
msgstr "Jaki sens ma przetrwanie, jeśli jesteś zupełnie sam?"

#. ~ Name of effect type id "asocial_satisfied"
#: data/json/effects.json
msgid "Alone"
msgstr "Sam"

#. ~ Description of effect type "Alone"
#: data/json/effects.json
msgid "Being on your own makes you feel good."
msgstr "Dobrze się czujesz, gdy jesteś sam."

#. ~ Name of effect type id "asocial_dissatisfied"
#: data/json/effects.json
msgid "Irritable"
msgstr "Drażliwość"

#. ~ Name of effect type id "asocial_dissatisfied"
#: data/json/effects.json
msgid "Annoyed"
msgstr "Irytacja"

#. ~ Description of effect type "Irritable"
#: data/json/effects.json
msgid "Being around others has left you feeling drained."
msgstr "Przebywanie wśród innych wyczerpało cię."

#. ~ Description of effect type "Annoyed"
#: data/json/effects.json
msgid "OK, that's enough social time.  You'd really rather be alone now."
msgstr ""
"Dobra, wystarczy już tego towarzystwa. Teraz naprawdę wolałbyś być sam."

#. ~ Description of effect type "Crowded"
#: data/json/effects.json
msgid ""
"Your nerves are frayed from all this socializing.  You need some alone time "
"to recharge."
msgstr ""
"Całe to życie towarzyskie zszargało ci nerwy. Musisz pobyć trochę sam, by "
"odzyskać siły."

#. ~ Name of effect type id "natural_stance"
#: data/json/effects.json
msgid "Natural Stance"
msgstr "Naturalna postawa"

#. ~ Description of effect type "Natural Stance"
#: data/json/effects.json
msgid ""
"You are positioned to take advantage of your mutated anatomy, and will "
"receive no penalties for crouching in melee combat.  Wielding a weapon will "
"cause you to lose this effect."
msgstr ""
"Przyjąłeś postawę wykorzystującą twoją zmutowaną anatomię i nie otrzymasz kar"
" za kucanie podczas walki w zwarciu. Wzięcie broni do ręki spowoduje utratę "
"tego efektu."

#. ~ Name of effect type id "subaquatic_sonar"
#: data/json/effects.json
msgid "Subaquatic SONAR"
msgstr "Podwodny SONAR"

#. ~ Description of effect type "Subaquatic SONAR"
#: data/json/effects.json
msgid ""
"Every few seconds, an ultrasonic pulse is broadcast from your location.  If "
"you're underwater and your hearing is good enough, you may be able to "
"navigate by the pings that come back."
msgstr ""
"Co kilka sekund wysyłasz impuls ultradźwiękowy. Jeśli jesteś pod wodą i masz "
"dostatecznie dobry słuch, możesz orientować się w otoczeniu dzięki "
"powracającym sygnałom."

#. ~ Blood analysis description of effect type "anticoagulant_draculin"
#: data/json/effects.json
msgid "Draculin"
msgstr "Drakulina"

#. ~ Name of effect type id "a_winner_is_u"
#: data/json/effects.json
msgid "Winning!"
msgstr "Zwycięstwo!"

#. ~ Name of effect type id "triffid_fiber_indigestion"
#: data/json/effects.json
msgid "Uneasy stomach"
msgstr "Dolegliwości żołądkowe"

#. ~ Name of effect type id "triffid_fiber_indigestion"
#: data/json/effects.json
msgid "Bloated stomach"
msgstr "Wzdęty żołądek"

#. ~ Name of effect type id "triffid_fiber_indigestion"
#: data/json/effects.json
msgid "Strained stomach"
msgstr "Przeciążony żołądek"

#. ~ Name of effect type id "triffid_fiber_indigestion"
#: data/json/effects.json
msgid "Overloaded stomach"
msgstr "Przepełniony żołądek"

#. ~ Description of effect type "Uneasy stomach, Bloated stomach, Strained
#. stomach, Overloaded stomach"
#: data/json/effects.json
msgid ""
"Your stomach constantly feels like it's full, even when you haven't eaten in "
"awhile."
msgstr ""
"Ciągle czujesz pełność w żołądku, nawet gdy od pewnego czasu nic nie jadłeś."

#. ~ Apply message of effect type "Uneasy stomach, Bloated stomach, Strained
#. stomach, Overloaded stomach"
#: data/json/effects.json
msgid "Your stomach starts to feel strange and bloated."
msgstr "Zaczynasz odczuwać dziwne wzdęcie w żołądku."

#. ~ Remove message of effect type "Uneasy stomach, Bloated stomach, Strained
#. stomach, Overloaded stomach"
#: data/json/effects.json
msgid "Your stomach feels normal again."
msgstr "Twój żołądek znów czuje się normalnie."

#. ~ Decay message of effect type "Uneasy stomach, Bloated stomach, Strained
#. stomach, Overloaded stomach"
#: data/json/effects.json
msgid "Your gut feels less bloated."
msgstr "Wzdęcie w brzuchu słabnie."

#. ~ Decay message of effect type "Uneasy stomach, Bloated stomach, Strained
#. stomach, Overloaded stomach"
#: data/json/effects.json
msgid "You feel the strain in your stomach lessen."
msgstr "Czujesz, że przeciążenie żołądka się zmniejsza."

#. ~ Description of creature revealed by special vision
#. "infrared_creature_tiny"
#: data/json/enchantments.json
msgid "You see a tiny figure radiating heat."
msgstr "Widzisz maleńką postać promieniującą ciepłem."

#. ~ Description of creature revealed by special vision
#. "infrared_creature_small"
#: data/json/enchantments.json
msgid "You see a small figure radiating heat."
msgstr "Widzisz małą postać promieniującą ciepłem."

#. ~ Description of creature revealed by special vision
#. "infrared_creature_medium"
#: data/json/enchantments.json
msgid "You see a medium figure radiating heat."
msgstr "Widzisz postać średniej wielkości promieniującą ciepłem."

#. ~ Description of creature revealed by special vision
#. "infrared_creature_large"
#: data/json/enchantments.json
msgid "You see a large figure radiating heat."
msgstr "Widzisz dużą postać promieniującą ciepłem."

#. ~ Description of creature revealed by special vision
#. "infrared_creature_huge"
#: data/json/enchantments.json
msgid "You see a huge figure radiating heat."
msgstr "Widzisz ogromną postać promieniującą ciepłem."

#. ~ Description of creature revealed by special vision
#. "infrared_creature_medium"
#: data/json/enchantments.json
msgid "You sense a creature with your thermal nostrils."
msgstr "Wyczuwasz stworzenie nozdrzami wrażliwymi na ciepło."

#. ~ Description of creature revealed by special vision
#. "electric_creature_sense"
#: data/json/enchantments.json data/mods/Aftershock/effects_esper.json
#: data/mods/BombasticPerks/perks.json
#: data/mods/MindOverMatter/effects/effects_psionic.json
#: data/mods/aftershock_exoplanet/effects_esper.json
msgid "You sense something emitting electricity here."
msgstr "Wyczuwasz tu coś emitującego elektryczność."

#. ~ Name of a enchantment
#: data/json/enchantments.json
msgid "Night Vision Goggles"
msgstr "Gogle noktowizyjne"

#. ~ Description of enchantment "Night Vision Goggles"
#: data/json/enchantments.json
msgid ""
"You are wearing night vision goggles which allow you to see really well in "
"the dark."
msgstr ""
"Nosisz gogle noktowizyjne, które pozwalają ci bardzo dobrze widzieć w "
"ciemności."

#. ~ Description of enchantment "Night Vision Goggles"
#: data/json/enchantments.json
msgid ""
"You are wearing night vision goggles which allow you to see quite well in the"
" dark."
msgstr ""
"Nosisz gogle noktowizyjne, które pozwalają ci całkiem dobrze widzieć w "
"ciemności."

#. ~ Description of enchantment "Night Vision Goggles"
#: data/json/enchantments.json
msgid ""
"You are wearing night vision goggles which allow you to see in the dark."
msgstr "Nosisz gogle noktowizyjne, które pozwalają ci widzieć w ciemności."

#. ~ Description of enchantment "Night Vision Goggles"
#: data/json/enchantments.json
msgid ""
"You are wearing night vision goggles which allow you to poorly see in the "
"dark."
msgstr ""
"Nosisz gogle noktowizyjne, które pozwalają ci słabo widzieć w ciemności."

#. ~ Name of a enchantment
#: data/json/enchantments.json data/mods/Aftershock/items/item_enchants.json
#: data/mods/aftershock_exoplanet/items/item_enchants.json
msgid "Cold Climate Control"
msgstr "Ochrona przed zimnem"

#. ~ Description of enchantment "Cold Climate Control"
#. ~ Description of enchantment "Complete Climate Control"
#. ~ Description of enchantment "Cold Climate Control Helmet"
#: data/json/enchantments.json data/mods/Aftershock/items/item_enchants.json
#: data/mods/aftershock_exoplanet/items/item_enchants.json
msgid "You are wearing equipment that helps handle harsh climates."
msgstr "Nosisz sprzęt, który pomaga znosić surowy klimat."

#. ~ Name of a enchantment
#: data/json/enchantments.json
msgid "Complete Climate Control"
msgstr "Pełna ochrona przed warunkami klimatycznymi"

#. ~ Name of a enchantment
#: data/json/enchantments.json
msgid "EXO Frame Strength"
msgstr "Siła ramy egzokombinezonu"

#. ~ Description of enchantment "EXO Frame Strength"
#: data/json/enchantments.json
msgid "You are wearing equipment that gives 10 strength."
msgstr "Nosisz sprzęt, który zapewnia 10 punktów siły."

#. ~ Name of a enchantment
#: data/json/enchantments.json
msgid "Hyperdense"
msgstr "Niezwykła gęstość"

#. ~ Description of enchantment "Hyperdense"
#: data/json/enchantments.json
msgid ""
"Your armor's massive weight makes it nearly impossible to be knocked over or "
"pushed back."
msgstr ""
"Ogromna masa twojej zbroi sprawia, że niemal nie da się cię przewrócić ani "
"odepchnąć."

#. ~ Name of a enchantment
#: data/json/enchantments.json
msgid "Detect Evil"
msgstr "Wykrywanie zła"

#. ~ Description of enchantment "Detect Evil"
#: data/json/enchantments.json
msgid "Your armor lets you detect otherworldly presence with ease."
msgstr ""
"Twoja zbroja pozwala ci z łatwością wykrywać obecność istot z innych światów."

#. ~ Description of creature revealed by special vision "nether_creature_sense"
#. ~ Description of creature revealed by special vision "moving_creature"
#: data/json/enchantments.json
#: data/mods/BombasticPerks/perkdata/sight_beyond_sight.json
#: data/mods/Magiclysm/effects/effects.json
#: data/mods/MindOverMatter/mutations/psi_passives.json
#: data/mods/Xedra_Evolved/effects/effects.json
#: data/mods/Xedra_Evolved/enchantments/mutations.json
msgid "You sense an otherworldy danger here."
msgstr "Wyczuwasz tu niebezpieczeństwo z innego świata."

#. ~ Name of a enchantment
#: data/json/enchantments.json
msgid "Dampened Steps"
msgstr "Wytłumione kroki"

#. ~ Description of enchantment "Dampened Steps"
#: data/json/enchantments.json
msgid "You are wearing equipment that muffles your footsteps."
msgstr "Nosisz sprzęt, który tłumi odgłosy twoich kroków."

#. ~ Description of enchantment "Insect Wings (Buzzing)"
#: data/json/enchantments.json
msgid "Your rapidly buzzing wings propel you with extra speed."
msgstr "Twoje szybko brzęczące skrzydła zapewniają ci dodatkową prędkość."

#. ~ Name of a enchantment
#: data/json/enchantments.json
msgid "Inactive exoskeleton"
msgstr "Nieaktywny egzoszkielet"

#. ~ Description of enchantment "Inactive exoskeleton"
#: data/json/enchantments.json
msgid ""
"The exoskeleton is inactive and makes moving in it difficult and exhausting."
msgstr ""
"Egzoszkielet jest nieaktywny, przez co poruszanie się w nim jest trudne i "
"wyczerpujące."

#. ~ Name of a enchantment
#: data/json/enchantments.json
msgid "Active combat exoskeleton mk.1"
msgstr "Aktywny bojowy egzoszkielet mk.1"

#. ~ Description of enchantment "Active combat exoskeleton mk.1"
#: data/json/enchantments.json
msgid ""
"Now powered, the exoskeleton provides <color_white>significant</color> "
"improvements to your carry weight and movement exertion while the life "
"support system shields you against harmful gas, cools you down, and dampens "
"harmful sounds."
msgstr ""
"Zasilany egzoszkielet <color_white>znacznie</color> zwiększa twój udźwig i "
"zmniejsza wysiłek związany z ruchem, a system podtrzymywania życia chroni cię"
" przed szkodliwymi gazami, chłodzi i tłumi szkodliwe dźwięki."

#. ~ Name of a enchantment
#: data/json/enchantments.json
msgid "Active combat exoskeleton mk.2"
msgstr "Aktywny bojowy egzoszkielet mk.2"

#. ~ Description of enchantment "Active combat exoskeleton mk.2"
#: data/json/enchantments.json
msgid ""
"Now powered, the exoskeleton provides <color_white>moderate</color> "
"improvements to your carry weight and movement exertion while the life "
"support system shields you against harmful gas, cools you down, and dampens "
"harmful sounds."
msgstr ""
"Zasilany egzoszkielet <color_white>umiarkowanie</color> zwiększa twój udźwig "
"i zmniejsza wysiłek związany z ruchem, a system podtrzymywania życia chroni "
"cię przed szkodliwymi gazami, chłodzi i tłumi szkodliwe dźwięki."

#. ~ Name of a enchantment
#: data/json/enchantments.json
msgid "Active combat exoskeleton mk.3"
msgstr "Aktywny bojowy egzoszkielet mk.3"

#. ~ Description of enchantment "Active combat exoskeleton mk.3"
#: data/json/enchantments.json
msgid ""
"Now powered, the exoskeleton provides <color_white>slight</color> "
"improvements to your carry weight and movement exertion while the life "
"support system shields you against harmful gas, cools you down, and dampens "
"harmful sounds."
msgstr ""
"Zasilany egzoszkielet <color_white>nieznacznie</color> zwiększa twój udźwig i"
" zmniejsza wysiłek związany z ruchem, a system podtrzymywania życia chroni "
"cię przed szkodliwymi gazami, chłodzi i tłumi szkodliwe dźwięki."

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "In memory of: <u_name>"
msgstr "Pamięci: <u_name>"

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "Survived: <time_survived>"
msgstr "Czas życia: <time_survived>"

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "Kills: <total_kills>"
msgstr "Zabójstwa: <total_kills>"

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "In memory of: <color_green><u_name></color>"
msgstr "Pamięci: <color_green><u_name></color>"

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "You <color_pink>won</color>"
msgstr "<color_pink>Wygrałeś</color>"

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "<u_name>..."
msgstr "<u_name>…"

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "...<u_name>, who's that?"
msgstr "…<u_name>, kto to?"

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "Not your problem anymore."
msgstr "To już nie twój problem."

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "What a <color_pink>success</color>."
msgstr "Co za <color_pink>sukces</color>."

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "Something struggled for: <time_survived>"
msgstr "Coś walczyło przez: <time_survived>"

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "...<u_name>, do you feel complete?"
msgstr "…<u_name>, czujesz się kompletny?"

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "Of course you do."
msgstr "Oczywiście, że tak."

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "It was <color_pink>beautiful</color>."
msgstr "To było <color_pink>piękne</color>."

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "You spread joy for: <time_survived>"
msgstr "Szerzyłeś radość przez: <time_survived>"

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "...<u_name>, do you feel incomplete?"
msgstr "…<u_name>, czujesz się niekompletny?"

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "what a <color_red>waste</color>."
msgstr "co za <color_red>marnotrawstwo</color>."

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "You wandered for: <time_survived>"
msgstr "Wędrowałeś przez: <time_survived>"

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "Subject: <color_green><u_name></color>"
msgstr "Obiekt: <color_green><u_name></color>"

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "Patient: <color_blue><u_name></color>"
msgstr "Pacjent: <color_blue><u_name></color>"

#. ~ String from the end screen, used in ASCII-art, so be aware of the string
#. length.
#: data/json/end_screen.json
msgid "In memory of: <color_light_blue><u_name></color>"
msgstr "Pamięci: <color_light_blue><u_name></color>"

#. ~ Field intensity level
#: data/json/field_type.json
msgid "thin cobwebs"
msgstr "cienkie pajęczyny"

#. ~ Field intensity level
#: data/json/field_type.json
msgid "thin webs"
msgstr "cienkie sieci"

#. ~ Field intensity level
#: data/json/field_type.json
