#: data/json/flags.json
msgid ""
"This clothing <info>won't let water through</info>.  Even if you jump into a "
"river."
msgstr ""
"Ta odzież <info>nie przepuszcza wody</info>. Nawet jeśli wskoczysz do rzeki."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "ALWAYS_TWOHAND"
#: data/json/flags.json
msgid "<bad>You must</bad> have two free hands to wield this item."
msgstr "<bad>Musisz</bad> mieć dwie wolne ręce, by trzymać ten przedmiot."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "REMOVED_STOCK"
#: data/json/flags.json
msgid "This item has had its stock removed, it will be hard to shoot with."
msgstr ""
"Ten przedmiot ma usuniętą kolbę, przez co trudno będzie z niego strzelać."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "MORPHIC"
#: data/json/flags.json
msgid "This is <info>naturally sized to the body</info>."
msgstr ""
"Ten przedmiot <info>naturalnie dopasowuje się do rozmiarów ciała</info>."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "MOUNTED_GUN"
#: data/json/flags.json
msgid ""
"This weapon is <bad>too unwieldy</bad> to fire on its own and <info>must be "
"mounted</info> on a vehicle or furniture (window, table, mound of dirt, etc.)"
" before use."
msgstr ""
"Ta broń jest <bad>zbyt nieporęczna</bad>, by strzelać z niej bez podparcia, i"
" przed użyciem <info>musi być zamontowana</info> na pojeździe lub elemencie "
"otoczenia (oknie, stole, kopcu ziemi itp.)."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "SPEEDLOADER"
#: data/json/flags.json
msgid ""
"This item can quickly reload rounds into gun or magazine that <info>have "
"enough space</info>."
msgstr ""
"Ten przedmiot pozwala szybko załadować naboje do broni palnej lub magazynka, "
"które <info>mają wystarczająco dużo miejsca</info>."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "SPEEDLOADER_CLIP"
#: data/json/flags.json
msgid ""
"This item can quickly reload rounds into gun or magazine that <info>don't "
"have enough space</info>."
msgstr ""
"Ten przedmiot pozwala szybko załadować naboje do broni palnej lub magazynka, "
"które <info>nie mają wystarczająco dużo miejsca</info>."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "FIRE_TWOHAND"
#: data/json/flags.json
msgid "<bad>You must</bad> have two free hands to fire this item."
msgstr "<bad>Musisz</bad> mieć dwie wolne ręce, by strzelać z tego przedmiotu."

#. ~ Description of restriction of JSON flag "GRENADE"
#: data/json/flags.json
msgid "Item must be a grenade"
msgstr "Przedmiot musi być granatem"

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "BATTERY_HEAVY"
#: data/json/flags.json
msgid "This item fits in items that use tool batteries."
msgstr ""
"Ten przedmiot pasuje do przedmiotów korzystających z akumulatorów "
"narzędziowych."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "METHANOL_TANK"
#: data/json/flags.json
msgid "This item fits in items that use methanol fuel cells."
msgstr ""
"Ten przedmiot pasuje do przedmiotów korzystających z metanolowych ogniw "
"paliwowych."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "LASER_SIGHT"
#: data/json/flags.json
msgid ""
"Laser sights are invalid when the target position is <bad>too far</bad> or "
"<bad>too bright</bad>."
msgstr ""
"Celowniki laserowe nie działają, gdy cel jest <bad>zbyt daleko</bad> lub w "
"<bad>zbyt jasnym miejscu</bad>."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "ALL_TERRAIN_NAVIGATION"
#: data/json/flags.json
msgid "Allows movement over rough and sharp terrain without penalty."
msgstr ""
"Pozwala poruszać się po nierównym terenie i ostrych powierzchniach bez kar."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "EXO_UNDERLAYER"
#: data/json/flags.json
msgid "This is meant for exosuit underlayers."
msgstr "Ten przedmiot jest przeznaczony do warstw spodnich egzokombinezonu."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "EXO_HELMET_PLATE"
#: data/json/flags.json
msgid "This is meant for exoskeleton helmet plating."
msgstr "Ten przedmiot jest przeznaczony do opancerzenia hełmu egzoszkieletu."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "EXO_TORSO_PLATE"
#: data/json/flags.json
msgid "This is meant for exoskeleton torso plating."
msgstr "Ten przedmiot jest przeznaczony do opancerzenia tułowia egzoszkieletu."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "EXO_ARM_PLATE"
#. ~ Description of JSON flag "EXO_GLOVE_PLATE"
#: data/json/flags.json
msgid "This is meant for exoskeleton arm plating."
msgstr "Ten przedmiot jest przeznaczony do opancerzenia rąk egzoszkieletu."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "EXO_LEG_PLATE"
#: data/json/flags.json
msgid "This is meant for exoskeleton leg plating."
msgstr "Ten przedmiot jest przeznaczony do opancerzenia nóg egzoszkieletu."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "EXO_BOOT_PLATE"
#: data/json/flags.json
msgid "This is meant for exoskeleton foot plating."
msgstr "Ten przedmiot jest przeznaczony do opancerzenia stóp egzoszkieletu."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "ENERGY_SHIELD"
#: data/json/flags.json
msgid ""
"This piece of armor is an energy barrier and will break after absorbing a "
"certain amount of damage."
msgstr ""
"Ten element zbroi jest barierą energetyczną i pęknie po pochłonięciu "
"określonej ilości obrażeń."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "ROBOFAC_ROBOT_MEDIUM"
#: data/json/flags.json
msgid "A medium drone sold by Hub 01."
msgstr "Średni dron sprzedawany przez Hub 01."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "ROBOFAC_ROBOT_SMALL"
#: data/json/flags.json
msgid "A small drone sold by Hub 01."
msgstr "Mały dron sprzedawany przez Hub 01."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "SHREDDED"
#: data/json/flags.json
msgid "This is a small fragment."
msgstr "To mały fragment."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "SINGLE_USE"
#: data/json/flags.json
msgid "This item is removed after use."
msgstr "Ten przedmiot znika po użyciu."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "BIONIC_FUEL_SOURCE"
#: data/json/flags.json
msgid "Contents of this item are used for fueling bionics."
msgstr "Zawartość tego przedmiotu służy jako paliwo dla bioniki."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "AFS_CS_LOCKER_CARD"
#: data/json/flags.json
msgid "ID card granting access to the crashing ship's locker room."
msgstr "Karta identyfikacyjna umożliwiająca dostęp do szatni rozbitego statku."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "AFS_CS_ARMORY_CARD"
#: data/json/flags.json
msgid "ID card granting access to the crashing ship's armory."
msgstr ""
"Karta identyfikacyjna umożliwiająca dostęp do zbrojowni rozbitego statku."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "AFS_CS_EXOBAY_CARD"
#: data/json/flags.json
msgid "ID card granting access to the crashing ship's exobay."
msgstr ""
"Karta identyfikacyjna umożliwiająca dostęp do hangaru egzokombinezonów "
"rozbitego statku."

#. ~ Description of restriction of JSON flag "PAPER_SHAPED"
#: data/json/flags.json
msgid "Item must be shaped like paper"
msgstr "Przedmiot musi mieć kształt arkusza papieru"

#. ~ Description of restriction of JSON flag "CREDIT_CARD_SHAPED"
#: data/json/flags.json
msgid "Item must be shaped like a credit card"
msgstr "Przedmiot musi mieć kształt karty kredytowej"

#. ~ Description of restriction of JSON flag "BANK_NOTE_SHAPED"
#: data/json/flags.json
msgid "Item must be shaped like a bank note"
msgstr "Przedmiot musi mieć kształt banknotu"

#. ~ Description of restriction of JSON flag "COIN_SHAPED"
#: data/json/flags.json
msgid "Item must be shaped like a coin"
msgstr "Przedmiot musi mieć kształt monety"

#. ~ Description of restriction of JSON flag "BANK_NOTE_STRAP_SHAPED"
#: data/json/flags.json
msgid "Item must be shaped like a bank note strap"
msgstr "Przedmiot musi mieć kształt paczki banknotów spiętych banderolą"

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "GASFILTER_SM"
#: data/json/flags.json
msgid "A small-sized gasmask filter."
msgstr "Mały filtr do maski przeciwgazowej."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "GASFILTER_MED"
#: data/json/flags.json
msgid "A medium-sized gasmask filter."
msgstr "Średni filtr do maski przeciwgazowej."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "PANORAMIC_OUTSERT"
#: data/json/flags.json
msgid ""
"This item is meant to be externally attached to the eyepiece of a single-lens"
" gas mask."
msgstr ""
"Ten przedmiot jest przeznaczony do mocowania na zewnątrz wizjera maski "
"przeciwgazowej z jedną szybą."

#. ~ Description of restriction of JSON flag "PANORAMIC_OUTSERT"
#: data/json/flags.json
msgid ""
"Item must be designed to clip onto the external Lenz brackets of a panoramic-"
"view gas mask."
msgstr ""
"Przedmiot musi być przystosowany do zatrzaskiwania na zewnętrznych uchwytach "
"Lenz panoramicznej maski przeciwgazowej."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "PANORAMIC_INSERT"
#: data/json/flags.json
msgid ""
"This item is intended to be inserted behind the visor of a single-lens gas "
"mask."
msgstr ""
"Ten przedmiot jest przeznaczony do wkładania za wizjer maski przeciwgazowej z"
" jedną szybą."

#. ~ Description of restriction of JSON flag "PANORAMIC_INSERT"
#: data/json/flags.json
msgid ""
"Item must be able to clip into place within a gas mask that has a single, "
"panoramic eyepiece."
msgstr ""
"Przedmiot musi dać się zatrzasnąć wewnątrz maski przeciwgazowej z pojedynczym"
" panoramicznym wizjerem."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "REBREATHER_CART"
#: data/json/flags.json
msgid "A filter for a rebreather."
msgstr "Filtr do aparatu oddechowego."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "USE_POWER_WHEN_HIT"
#: data/json/flags.json
msgid "This armor <info>expends energy when hit</info>."
msgstr "Ta zbroja <info>zużywa energię po trafieniu</info>."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "ETHEREAL"
#: data/json/flags.json
msgid ""
"You feel like you would keep all your items if you somehow became "
"incorporeal."
msgstr ""
"Masz wrażenie, że zachowałbyś wszystkie swoje przedmioty, gdybyś jakimś "
"sposobem stał się niematerialny."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "CLIMB_FLYING"
#: data/json/flags.json
msgid "You can ascend straight up even with no physical surface to climb on."
msgstr ""
"Możesz wznieść się pionowo w górę, nawet bez fizycznej powierzchni, po której"
" dałoby się wspinać."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "TREE_COMMUNION_PLUS"
#: data/json/flags.json
msgid ""
"You gain greatly enhanced effects from the Mycorrhizal Communion mutation"
msgstr "Efekty mutacji Wspólnota mikoryzowa są u ciebie znacznie silniejsze"

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "ROOTS2"
#: data/json/flags.json
msgid "The character has roots, which helps with the TREE_COMMUNION mutation."
msgstr "Postać ma korzenie, co pomaga w działaniu mutacji TREE_COMMUNION."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "ROOTS3"
#: data/json/flags.json
msgid ""
"The character has extensive roots, which helps with the TREE_COMMUNION "
"mutation."
msgstr ""
"Postać ma rozbudowane korzenie, co pomaga w działaniu mutacji TREE_COMMUNION."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "VINE_RAPPEL"
#: data/json/flags.json
msgid "The character can use vines to safely rappel down sheer drops."
msgstr ""
"Postać może używać pnączy, by bezpiecznie opuszczać się wzdłuż stromych "
"urwisk."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "ANIMALDISCORD"
#: data/json/flags.json
msgid "The character is disliked by natural animals."
msgstr "Zwykłe zwierzęta nie lubią tej postaci."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "ANIMALDISCORD2"
#: data/json/flags.json
msgid "The character is intensely disliked by natural animals."
msgstr "Zwykłe zwierzęta bardzo nie lubią tej postaci."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "ANIMALEMPATH"
#: data/json/flags.json
msgid "The character is liked by natural animals."
msgstr "Zwykłe zwierzęta lubią tę postać."

#. ~ Please leave anything in <angle brackets> unchanged.
#. ~ Description of JSON flag "ANIMALEMPATH2"
#: data/json/flags.json
msgid "The character is intensely liked by natural animals."
msgstr "Zwykłe zwierzęta bardzo lubią tę postać."
