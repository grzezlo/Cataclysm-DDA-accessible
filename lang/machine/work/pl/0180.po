#. ~ Player message in effect in EoC
#. "EOC_ATTEMPT_TO_MAKE_STORMWROUGHT_BLOOD_SUCCESS"
#: data/mods/Xedra_Evolved/eocs/misc_eoc.json
msgid ""
"The ritual harnesses the energies of the tear to infuse some blood with it, "
"leaving behind a small ball of almost-solid blood.  It only needs to bath in "
"the energies of the storms until it is fully charged and it will be ready to "
"use."
msgstr ""

#. ~ Player message in effect in EoC
#. "EOC_ATTEMPT_TO_MAKE_STORMWROUGHT_BLOOD_FAIL"
#: data/mods/Xedra_Evolved/eocs/misc_eoc.json
msgid ""
"Without the proximity of a tear in reality, the ritual fails to harness any "
"energy and the blood boils away."
msgstr ""

#. ~ Player message in effect in EoC "STORMWROUGHT_BLOOD_FULL_CHARGE" in nested
#. EOCs in effect in EoC "CHARGE_STORMWROUGHT_BLOOD"
#: data/mods/Xedra_Evolved/eocs/misc_eoc.json
msgid "As the stormwrought blood becomes fully charged, it starts simmering."
msgstr ""

#. ~ Player message in effect in EoC "STORMWROUGHT_BLOOD_HIGH_CHARGE" in nested
#. EOCs in false effect in EoC "STORMWROUGHT_BLOOD_FULL_CHARGE" in nested EOCs
#. in effect in EoC "CHARGE_STORMWROUGHT_BLOOD"
#: data/mods/Xedra_Evolved/eocs/misc_eoc.json
msgid ""
"The stormwrought blood boils intensely for a moment before returning to its "
"inert state."
msgstr ""

#. ~ Player message in effect in EoC "STORMWROUGHT_BLOOD_LOW_CHARGE" in nested
#. EOCs in false effect in EoC "STORMWROUGHT_BLOOD_HIGH_CHARGE" in nested EOCs
#. in false effect in EoC "STORMWROUGHT_BLOOD_FULL_CHARGE" in nested EOCs in
#. effect in EoC "CHARGE_STORMWROUGHT_BLOOD"
#: data/mods/Xedra_Evolved/eocs/misc_eoc.json
msgid "The stormwrought blood boils a little, then becomes inert again."
msgstr ""

#. ~ NPC message in effect in EoC "EOC_SUMMON_DREAM_DRAINER_2" in nested EOCs
#. in effect in EoC "EOC_SUMMON_DREAM_DRAINER"
#: data/mods/Xedra_Evolved/eocs/misc_eoc.json
msgid ""
"The mosquito consumes the catalyst and suddenly starts filling with air as it"
" reshapes itself."
msgstr ""

#. ~ Player message in effect in EoC
#. "EOC_CHECK_TO_SUMMON_REVENANT_MOON_DARK_OUTSIDE" in nested EOCs in effect in
#. EoC "EOC_CHECK_TO_SUMMON_REVENANT"
