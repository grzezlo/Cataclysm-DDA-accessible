"Your unarmed melee attacks will redeal damage to their targets after 4 turns."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/perks.json
msgid "Flowing Retreat"
msgstr ""

#. ~ Description of mutation "Flowing Retreat"
#: data/mods/Perk_melee/PERKS/perks.json
