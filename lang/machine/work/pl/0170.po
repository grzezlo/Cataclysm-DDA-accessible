msgstr ""

#. ~ Description of mutation "Combat Tempo I"
#: data/mods/Perk_melee/PERKS/tempo.json
msgid ""
"Perfect.  Now do it again.\n"
"Attacks generate stacks of combat tempo.  Tempo greatly favors the strong."
msgstr ""

#. ~ Description of mutation "Perfect Tempo"
#: data/mods/Perk_melee/PERKS/tempo.json
