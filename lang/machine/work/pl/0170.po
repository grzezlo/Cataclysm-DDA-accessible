msgid "Insight I"
msgstr ""

#. ~ Description of mutation "Insight I"
#: data/mods/Perk_melee/PERKS/insight.json
msgid ""
"You passively accumulate up to 20 insight stacks while near enemies.  Each "
"insight stack increases all damage dealt by 1 until your next attack.  "
"Insight greatly favors perceptive warriors."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/insight.json
msgid "Like Water"
msgstr ""

#. ~ Description of mutation "Like Water"
#: data/mods/Perk_melee/PERKS/insight.json
msgid "You gain a +25 dodge chance if you have at least 10 insight stacks."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/insight.json
msgid "Sixth Sense"
msgstr ""

#. ~ Description of mutation "Sixth Sense"
#: data/mods/Perk_melee/PERKS/insight.json
msgid ""
"You accumulate up to 20 insight stacks even from enemies you can't see.  You "
"can perceive unseen enemies within 10 tiles if you have at least 10 insight "
"stacks."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/insight.json
msgid "The Psychic Sea"
msgstr ""

#. ~ Description of mutation "The Psychic Sea"
#: data/mods/Perk_melee/PERKS/insight.json
msgid "You can accumulate an infinite number of insight stacks."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/insight.json
msgid "Twilight Form"
msgstr ""

#. ~ Description of mutation "Twilight Form"
#: data/mods/Perk_melee/PERKS/insight.json
#, no-c-format
msgid ""
"Whenever you kill an enemy in melee, you retain 50% of your insight stacks."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/insight.json
msgid "Blind Calculus"
msgstr ""

#. ~ Description of mutation "Blind Calculus"
#: data/mods/Perk_melee/PERKS/insight.json
msgid ""
"If you have been blind for at least 15 turns, every time you would gain an "
"insight stack you instead gain 5."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/insight.json
msgid "Mystic Shot I"
msgstr ""

#. ~ Description of mutation "Mystic Shot I"
#: data/mods/Perk_melee/PERKS/insight.json
#, no-c-format
msgid ""
"Insight stacks also increase the accuracy of ranged bow and crossbow attacks "
"by 2% per stack.  Ranged attacks will consume insight stacks."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/insight.json
msgid "Mystic Shot II"
msgstr ""

#. ~ Description of mutation "Mystic Shot II"
#: data/mods/Perk_melee/PERKS/insight.json
#, no-c-format
msgid ""
"Insight stacks also increase the damage of ranged bow and crossbow attacks by"
" 1% per stack."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/momentum.json
msgid "Momentum I"
msgstr ""

#. ~ Description of mutation "Momentum I"
#: data/mods/Perk_melee/PERKS/momentum.json
msgid ""
"Rapid movement generates momentum stacks.  Momentum greatly favors dextrous "
"warriors."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/momentum.json
msgid "Momentum II"
msgstr ""

#. ~ Description of mutation "Momentum II"
#: data/mods/Perk_melee/PERKS/momentum.json
#, no-c-format
msgid ""
"Rapid movement generates momentum stacks.  As long as momentum is active your"
" attacks gain extra physical damage equal to 10% of your dexterity.  You gain"
" a point of dexterity for every 2 momentum stacks."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/momentum.json
msgid "Ballistic Evasion"
msgstr ""

#. ~ Description of mutation "Ballistic Evasion"
#: data/mods/Perk_melee/PERKS/momentum.json
#, no-c-format
msgid ""
"If you have at least 4 momentum stacks, gain a 5% chance to dodge any ranged "
"attack for every point of dexterity you have.  If you have less than 4 "
"momentum stacks, gain a 1% chance to dodge any ranged attack for every point "
"of dexterity you have."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/momentum.json
msgid "Duelist Form"
msgstr ""

#. ~ Description of mutation "Duelist Form"
#: data/mods/Perk_melee/PERKS/momentum.json
msgid ""
"If you have more than 1 momentum stack, your momentum will be set to 1 "
"whenever you wait a turn."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/perks.json
msgid "Practice Martial Arts"
msgstr ""

#. ~ Description of mutation "Practice Martial Arts"
#: data/mods/Perk_melee/PERKS/perks.json
msgid "Learn new martial arts techniques and perks."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/perks.json
msgid "Carefree Stance"
msgstr ""

#. ~ Description of mutation "Carefree Stance"
#: data/mods/Perk_melee/PERKS/perks.json
