"You'll attempt to move away from your attackers when you successfully dodge "
"an attack.  You'll gain a momentum stack if you can normally gain them."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/perks.json
msgid "Counter Strikes"
msgstr ""

#. ~ Description of mutation "Counter Strikes"
#: data/mods/Perk_melee/PERKS/perks.json
msgid "You gain +1 accuracy for two turns after a successful block."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/perks.json
msgid "Stalwart"
msgstr ""

#. ~ Description of mutation "Stalwart"
#: data/mods/Perk_melee/PERKS/perks.json
msgid "You have an extra block attempt per turn."
msgstr ""

#. ~ Description of mutation "Shrug it off"
#: data/mods/Perk_melee/PERKS/perks.json
msgid "Automatically block the first attack that hits you every 15 turns."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/perks.json
msgid "Spry footwork"
msgstr ""

#. ~ Description of mutation "Spry footwork"
#: data/mods/Perk_melee/PERKS/perks.json
msgid "You have an extra dodge attempt per turn."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/tempo.json
