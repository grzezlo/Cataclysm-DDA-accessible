#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/tempo.json
msgid "Tempo Shift"
msgstr ""

#. ~ Description of mutation "Tempo Shift"
#: data/mods/Perk_melee/PERKS/tempo.json
msgid "Gain a stack of combat tempo whenever you successfully block an attack."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/tempo.json
msgid "Unrelenting Assault"
msgstr ""

#. ~ Description of mutation "Unrelenting Assault"
#: data/mods/Perk_melee/PERKS/tempo.json
msgid ""
"Whenever you kill an enemy in melee, you'll advance into their position and "
"automatically attack an adjacent enemy.  You'll gain a momentum stack if you "
"can normally gain them."
msgstr ""

#. ~ Mutation name
#: data/mods/Perk_melee/PERKS/tempo.json
msgid "Zoning"
msgstr ""

#. ~ Description of mutation "Zoning"
#: data/mods/Perk_melee/PERKS/tempo.json
msgid ""
"If you have the maximum number of combat tempo stacks, killing an enemy will "
"move you away from any other adjacent enemies.  This movement action will "
"consume all of your combat tempo stacks, and grant you a momentum stack if "
"can normally gain them."
msgstr ""

