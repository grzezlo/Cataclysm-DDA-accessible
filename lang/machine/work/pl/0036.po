#. ~ Description of "dehydrated chili pepper"
#: data/json/items/comestibles/veggy_dishes.json
msgid ""
"A dehydrated chili pepper.  Still not great, but you can easily ground or "
"mill it into powder."
msgstr ""
"Suszona papryczka chili. Nadal nie zachwyca, ale łatwo ją utłuc lub zmielić "
"na proszek."

#. ~ Item name
#: data/json/items/comestibles/veggy_dishes.json
msgid "dehydrated garlic clove"
msgid_plural "dehydrated garlic cloves"
msgstr[0] "suszony ząbek czosnku"
msgstr[1] "suszone ząbki czosnku"
msgstr[2] "suszonych ząbków czosnku"
msgstr[3] "suszonego ząbka czosnku"

#. ~ Description of "dehydrated garlic clove"
#: data/json/items/comestibles/veggy_dishes.json
msgid ""
"Dehydrated garlic.  You definitely don't want to eat these like this, but "
"they can be milled or grounded into garlic powder."
msgstr ""
"Suszony czosnek. Zdecydowanie nie chcesz go jeść w tej postaci, ale można go "
"zmielić lub utłuc na czosnek w proszku."

