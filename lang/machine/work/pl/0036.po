msgid_plural "succotash deluxe"
msgstr[0] "luksusowy succotash"
msgstr[1] "porcje luksusowego succotash"
msgstr[2] "porcji luksusowego succotash"
msgstr[3] "porcji luksusowego succotash"

#. ~ Description of "succotash deluxe"
#: data/json/items/comestibles/veggy_dishes.json
msgid ""
"Succotash, but made more modern and tasty by adding some flavorful "
"ingredients."
msgstr ""
"Succotash, ale unowocześniony i smaczniejszy dzięki dodatkowi aromatycznych "
"składników."

#. ~ Description of "tofu stirfry"
#: data/json/items/comestibles/veggy_dishes.json
msgid ""
"A tofu stirfry with rice and a sweet, bold flavor sure to stay on your mind "
"through these dark days."
msgstr ""
"Podsmażane tofu z ryżem o słodkim, wyrazistym smaku, które na pewno zapadnie "
"ci w pamięć w te mroczne dni."

#. ~ Description of "baked potato"
#: data/json/items/comestibles/veggy_dishes.json
msgid "A delicious baked potato or other tuber.  Got any sour cream?"
msgstr ""
