#. ~ Snippet of item "book of fairy tales"
#: data/json/items/book/young.json
msgid ""
"This book of folk tales is titled \"The Girl with the Ugly Name, and Other "
"Stories.\""
msgstr ""
"Ta książka z ludowymi opowieściami nosi tytuł „Dziewczyna o brzydkim imieniu "
"i inne historie”."

#. ~ Item name
#: data/json/items/book/young.json
