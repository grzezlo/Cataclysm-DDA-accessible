#. ~ Description of gun "Glock duty pistol"
#. ~ Description of "Glock duty pistol"
#: data/json/items/gun/9mm.json
msgid ""
"Designed for all shooters, this offering from the Glock gun company is a "
"full-sized 9x19mm pistol marketed towards law-enforcement and military users."
"  Because of the long magazine well, it can't fit magazines shorter than the "
"standard 17-round ones."
msgstr ""

#. ~ Variant name of gun "Glock duty pistol"
#. ~ Variant name of item "Glock duty pistol"
#: data/json/items/gun/9mm.json
msgid "Glock 17 pistol"
msgid_plural "Glock 17 pistols"
msgstr[0] ""
