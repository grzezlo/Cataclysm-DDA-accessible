#. ~ Description of variant "mech figurine" of item "large figurine"
#: data/json/items/toy.json
msgid ""
"A large figurine of a humanoid robot, armed with a rifle, with a smaller "
"figure sitting inside the head."
msgstr ""
"Duża figurka humanoidalnego robota uzbrojonego w karabin, z mniejszą postacią"
" siedzącą w jego głowie."

#. ~ Variant name of item "large figurine"
#: data/json/items/toy.json
msgid "knight figurine"
msgid_plural "knight figurines"
msgstr[0] "figurka rycerza"
msgstr[1] "figurki rycerza"
msgstr[2] "figurek rycerza"
msgstr[3] "figurki rycerza"

#. ~ Description of variant "knight figurine" of item "large figurine"
#: data/json/items/toy.json
msgid ""
"A large figurine of a knight in shining armor standing watch, with its sword "
"planted at the ground at its feet."
msgstr ""
"Duża figurka rycerza w lśniącej zbroi, trzymającego wartę z mieczem wbitym w "
"ziemię u stóp."

#. ~ Variant name of item "large figurine"
#: data/json/items/toy.json
msgid "robot figurine"
msgid_plural "robot figurines"
msgstr[0] "figurka robota"
msgstr[1] "figurki robota"
msgstr[2] "figurek robota"
msgstr[3] "figurki robota"

#. ~ Description of variant "robot figurine" of item "large figurine"
#: data/json/items/toy.json
msgid ""
"A very intricate looking model of a robotic skeleton with red eyes and a "
"futuristic weapon in its hand."
msgstr ""
"Bardzo misternie wyglądający model robotycznego szkieletu z czerwonymi oczami"
" i futurystyczną bronią w dłoni."

#. ~ Variant name of item "large figurine"
#: data/json/items/toy.json
