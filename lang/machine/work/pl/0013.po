msgid_plural "anime figurines"
msgstr[0] "figurka anime"
msgstr[1] "figurki anime"
msgstr[2] "figurek anime"
msgstr[3] "figurki anime"

#. ~ Description of variant "anime figurine" of item "large figurine"
#: data/json/items/toy.json
msgid "An expensive figurine of a cartoon woman in flashy clothing."
msgstr "Droga figurka kreskówkowej kobiety w krzykliwym stroju."

#. ~ Variant name of item "large figurine"
#: data/json/items/toy.json
