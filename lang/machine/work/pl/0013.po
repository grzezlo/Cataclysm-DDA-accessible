msgstr[3] "dużej figurki"

#. ~ Description of "large figurine"
#: data/json/items/toy.json
msgid ""
"A large manufactured figurine.  This is the default variant, if you see it "
"something went wrong."
msgstr ""
"Duża fabryczna figurka. To domyślny wariant – jeśli go widzisz, coś poszło "
"nie tak."

