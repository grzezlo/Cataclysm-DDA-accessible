msgstr[2] "podwozi betoniarki"
msgstr[3] "podwozia betoniarki"

#. ~ Description of "concrete mixer chassis"
#. ~ Description of vehicle part "concrete mixer chassis"
#: data/json/items/vehicle/frames.json data/json/vehicleparts/frames.json
msgid "The chassis of a concrete mixer."
msgstr "Podwozie betoniarki."

#. ~ Description of magazine "fuel bunker"
#. ~ Description of "fuel bunker"
#: data/json/items/vehicle/fuel_storage.json
msgid ""
"A bin for holding solid fuel.  Contains up to 50 liters of coal or charcoal."
msgstr ""
"Pojemnik na paliwo stałe. Mieści do 50 litrów węgla kamiennego lub drzewnego."

#. ~ Description of "emergency vehicle light (red)"
#: data/json/items/vehicle/lights.json
msgid ""
"A red light from the top of an emergency services vehicle.  When turned on, "
"the light rotates to shine in all directions."
msgstr ""
"Czerwone światło z dachu pojazdu służb ratunkowych. Po włączeniu obraca się, "
"świecąc we wszystkich kierunkach."

#. ~ Description of "emergency vehicle light (blue)"
#: data/json/items/vehicle/lights.json
msgid ""
"A blue light from the top of an emergency services vehicle.  When turned on, "
"the light rotates to shine in all directions."
msgstr ""
"Niebieskie światło z dachu pojazdu służb ratunkowych. Po włączeniu obraca "
"się, świecąc we wszystkich kierunkach."

#. ~ Description of "floodlight"
#: data/json/items/vehicle/lights.json
msgid "A large, heavy light designed to illuminate wide areas."
msgstr ""
"Duży, ciężki reflektor przeznaczony do oświetlania rozległych obszarów."

#. ~ Description of "directed floodlight"
#: data/json/items/vehicle/lights.json
msgid ""
"A large, heavy light designed to illuminate a wide area in a half-circular "
"cone."
msgstr ""
"Duży, ciężki reflektor przeznaczony do oświetlania rozległego obszaru w "
"półkolistym stożku."

#. ~ Description of "set of hand rims"
#: data/json/items/vehicle/manual.json
msgid "A set of hand rims for use on a wheelchair."
msgstr "Zestaw obręczy ręcznych do wózka inwalidzkiego."

#. ~ Description of "foot crank"
#: data/json/items/vehicle/manual.json
msgid "A pedal and gear assembly from a bicycle."
msgstr "Zespół pedałów i przekładni z roweru."

#. ~ Description of "water wheel"
#: data/json/items/vehicle/mills.json
msgid ""
"A water wheel that will slowly recharge electrical power when built over "
"shallow moving water."
msgstr ""
"Koło wodne, które powoli wytwarza energię elektryczną, gdy zostanie zbudowane"
" nad płytką płynącą wodą."

#. ~ Description of "large water wheel"
#: data/json/items/vehicle/mills.json
msgid ""
"A large water wheel with wooden supports.  It will recharge electrical power "
"when built over shallow moving water."
msgstr ""
"Duże koło wodne z drewnianymi wspornikami. Wytwarza energię elektryczną, gdy "
"zostanie zbudowane nad płytką płynącą wodą."

#. ~ Description of "electric motor"
#: data/json/items/vehicle/motors.json
msgid "A standard electric motor.  Suitable for use in ultra-light vehicles."
msgstr "Standardowy silnik elektryczny. Nadaje się do pojazdów ultralekkich."

#. ~ Description of "enhanced electric motor"
#: data/json/items/vehicle/motors.json
msgid ""
"A powerful electric motor, as found in those consumer electric sports cars "
"with ridiculous or ludicrous acceleration options."
msgstr ""
"Mocny silnik elektryczny, jak te w konsumenckich elektrycznych samochodach "
"sportowych z absurdalnymi lub niedorzecznymi trybami przyspieszania."

#. ~ Description of "super electric motor"
#: data/json/items/vehicle/motors.json
msgid ""
"An extremely powerful electric motor.  This delivers massive torque and would"
" be well suited to an electric racing car."
msgstr ""
"Niezwykle mocny silnik elektryczny. Zapewnia ogromny moment obrotowy i "
"świetnie nadawałby się do elektrycznego samochodu wyścigowego."

#. ~ Description of "large electric motor"
#: data/json/items/vehicle/motors.json
msgid "A large electric motor.  Could be used to power a full-size car or SUV."
msgstr ""
"Duży silnik elektryczny. Mógłby napędzać pełnowymiarowy samochód lub SUV-a."

#. ~ Description of "small electric motor"
#: data/json/items/vehicle/motors.json
msgid ""
"A light-duty electric motor.  Strong enough for an electric moped or golf "
"cart."
msgstr ""
"Silnik elektryczny do lekkich zastosowań. Wystarczająco mocny dla "
"elektrycznego motoroweru lub wózka golfowego."

#. ~ Description of "tiny electric motor"
#: data/json/items/vehicle/motors.json
msgid ""
"A small electric motor, suitable for powering a bicycle or a hedge trimmer."
msgstr ""
"Mały silnik elektryczny, odpowiedni do napędzania roweru lub nożyc do "
"żywopłotu."

#. ~ Item name
#. ~ Vehicle part name
#: data/json/items/vehicle/motors.json data/json/vehicleparts/motor.json
msgid "1,300 HP electric train engine"
msgid_plural "1,300 HP electric train engines"
msgstr[0] "silnik lokomotywy elektrycznej 1300 KM"
msgstr[1] "silniki lokomotywy elektrycznej 1300 KM"
msgstr[2] "silników lokomotywy elektrycznej 1300 KM"
msgstr[3] "silnika lokomotywy elektrycznej 1300 KM"

#. ~ Description of "steel plating"
#: data/json/items/vehicle/plating.json
msgid "A piece of vehicle armor plating made of steel."
msgstr "Płyta pancerza pojazdu wykonana ze stali."

#. ~ Description of "superalloy plating"
#: data/json/items/vehicle/plating.json
msgid "A piece of vehicle armor plating made of sturdy superalloy."
msgstr "Płyta pancerza pojazdu wykonana z wytrzymałego superstopu."

#. ~ Description of "spiked plating"
#: data/json/items/vehicle/plating.json
msgid ""
"A piece of vehicle armor plating made of steel.  It is covered with menacing "
"spikes."
msgstr ""
"Płyta pancerza pojazdu wykonana ze stali. Pokrywają ją groźnie wyglądające "
"kolce."

#. ~ Description of "hard plating"
#: data/json/items/vehicle/plating.json
msgid ""
"A piece of very thick vehicle armor plating made of tempered steel.  Can be "
"used as a makeshift anvil."
msgstr ""
"Bardzo gruba płyta pancerza pojazdu wykonana ze stali hartowanej. Może "
"posłużyć jako prowizoryczne kowadło."

#. ~ Description of "military composite plating"
#: data/json/items/vehicle/plating.json
msgid ""
"A thick sheet of military-grade armor; the best bullet-stopper you can stick "
"on a vehicle."
msgstr ""
"Gruba płyta pancerza klasy wojskowej; najlepsze, co możesz zamontować na "
"pojeździe, by zatrzymywać pociski."
