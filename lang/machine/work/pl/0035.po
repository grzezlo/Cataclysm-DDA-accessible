msgstr[2] "snopów dzikiego ryżu"
msgstr[3] "snopa dzikiego ryżu"

#. ~ Description of "wild rice stalks"
#: data/json/items/comestibles/raw_grain.json
msgid "A sheaf of wild rice stalks, ready for drying."
msgstr "Snop źdźbeł dzikiego ryżu, gotowy do suszenia."

#. ~ Item name
#: data/json/items/comestibles/raw_grain.json
msgid "dried wild rice stalks"
msgid_plural "dried wild rice stalks"
msgstr[0] "suszony snop dzikiego ryżu"
msgstr[1] "suszone snopy dzikiego ryżu"
msgstr[2] "suszonych snopów dzikiego ryżu"
msgstr[3] "suszonego snopa dzikiego ryżu"

#. ~ Description of "dried wild rice stalks"
#: data/json/items/comestibles/raw_grain.json
msgid ""
"A bunch of dry wild rice stalks.  Threshing these would knock the grains "
"loose."
msgstr "Pęk suchych źdźbeł dzikiego ryżu. Wymłócenie ich uwolniłoby ziarna."

#. ~ Description of "wild rice"
#: data/json/items/comestibles/raw_grain.json
msgid ""
"Raw wild rice, still in its fibrous shell.  It'll need to be milled before "
"it's edible for humans."
msgstr ""
"Surowy dziki ryż, wciąż we włóknistej łusce. Zanim będzie jadalny dla ludzi, "
"trzeba go obłuskać w młynie."

#. ~ Description of "buckwheat"
#: data/json/items/comestibles/raw_grain.json
msgid ""
"Dry seeds from a wild buckwheat plant.  Inedible in their present state, they"
" are commonly cooked or ground into flour."
msgstr ""
"Suche nasiona dzikiej gryki. W obecnej postaci niejadalne; zwykle się je "
"gotuje albo miele na mąkę."

#. ~ Item name
#: data/json/items/comestibles/raw_grain.json
msgid "canola stalks"
msgid_plural "canola stalks"
msgstr[0] "snop rzepaku"
msgstr[1] "snopy rzepaku"
msgstr[2] "snopów rzepaku"
msgstr[3] "snopa rzepaku"

#. ~ Description of "canola stalks"
#: data/json/items/comestibles/raw_grain.json
msgid ""
"A sheaf of tall grass with slender little seed pods, now ready for drying."
msgstr "Snop wysokich łodyg z wąskimi strączkami nasion, gotowy do suszenia."

#. ~ Item name
#: data/json/items/comestibles/raw_grain.json
msgid "dried canola stalks"
msgid_plural "dried canola stalks"
msgstr[0] "suszony snop rzepaku"
msgstr[1] "suszone snopy rzepaku"
msgstr[2] "suszonych snopów rzepaku"
msgstr[3] "suszonego snopa rzepaku"

#. ~ Description of "dried canola stalks"
#: data/json/items/comestibles/raw_grain.json
msgid "A sheaf of dry grass, it must be threshed to separate out the seeds."
msgstr "Snop suchych łodyg. Trzeba go wymłócić, żeby oddzielić nasiona."

#. ~ Item name
#: data/json/items/comestibles/raw_grain.json
msgid "threshed canola"
msgid_plural "threshed canola"
msgstr[0] "wymłócony rzepak"
msgstr[1] "porcje wymłóconego rzepaku"
msgstr[2] "porcji wymłóconego rzepaku"
msgstr[3] "porcji wymłóconego rzepaku"

#. ~ Description of "threshed canola"
#: data/json/items/comestibles/raw_grain.json
msgid "Round black seeds mixed in with dry chaff."
msgstr "Okrągłe czarne nasiona zmieszane z suchymi plewami."

#. ~ Description of "canola seeds"
#: data/json/items/comestibles/raw_grain.json
msgid ""
"A heap of round black seeds, typically milled and pressed for their oil."
msgstr ""
"Kupka okrągłych czarnych nasion, zwykle mielonych i tłoczonych na olej."

#. ~ Item name
#: data/json/items/comestibles/raw_grain.json
msgid "dried lentil stalks"
msgid_plural "dried lentil stalks"
msgstr[0] "pęk suszonych łodyg soczewicy"
msgstr[1] "pęki suszonych łodyg soczewicy"
msgstr[2] "pęków suszonych łodyg soczewicy"
msgstr[3] "pęku suszonych łodyg soczewicy"

#. ~ Description of "dried lentil stalks"
#: data/json/items/comestibles/raw_grain.json
msgid ""
"A pile of short stalks with lentils rattling in their pods.  These plants "
"dried in the field and didn't need a tool to harvest, but they'll still need "
"to be threshed and winnowed."
msgstr ""
"Stos krótkich łodyg z soczewicą grzechoczącą w strąkach. Te rośliny wyschły "
"na polu i do ich zbioru nie było potrzebne żadne narzędzie, ale wciąż trzeba "
"je wymłócić i przewiać."

#. ~ Item name
#: data/json/items/comestibles/raw_grain.json
msgid "threshed lentils"
msgid_plural "threshed lentils"
msgstr[0] "wymłócona soczewica"
msgstr[1] "porcje wymłóconej soczewicy"
msgstr[2] "porcji wymłóconej soczewicy"
msgstr[3] "porcji wymłóconej soczewicy"

#. ~ Description of "threshed lentils"
#: data/json/items/comestibles/raw_grain.json
msgid ""
"Lentils with chaff mixed in.  These will have to be winnowed before they're "
"usable."
msgstr "Soczewica zmieszana z plewami. Przed użyciem trzeba ją przewiać."

#. ~ Description of "dried lentils"
#: data/json/items/comestibles/raw_grain.json
msgid ""
"A humble but nutrient-rich legume.  They should be cooked prior to "
"consumption, unless you're planning to plant them."
msgstr ""
"Skromna, ale bogata w składniki odżywcze roślina strączkowa. Przed spożyciem "
"należy ją ugotować, chyba że zamierzasz ją zasiać."

#. ~ Item name
#: data/json/items/comestibles/raw_grain.json
msgid "buckwheat stalks"
msgid_plural "buckwheat stalks"
msgstr[0] "snop gryki"
msgstr[1] "snopy gryki"
msgstr[2] "snopów gryki"
msgstr[3] "snopa gryki"

#. ~ Description of "buckwheat stalks"
#: data/json/items/comestibles/raw_grain.json
msgid ""
"These leafy stalks only get about waist-high and technically aren't a grass, "
"but thanks to their long stems and nutritious seeds, they can still be farmed"
" like any other cereal crop."
msgstr ""
"Te ulistnione łodygi dorastają mniej więcej do pasa i technicznie rzecz "
"biorąc nie są trawą, ale dzięki długim łodygom i pożywnym nasionom można je "
"uprawiać jak każde inne zboże."

#. ~ Item name
#: data/json/items/comestibles/raw_grain.json
msgid "dried buckwheat stalks"
msgid_plural "dried buckwheat stalks"
msgstr[0] "suszony snop gryki"
msgstr[1] "suszone snopy gryki"
msgstr[2] "suszonych snopów gryki"
msgstr[3] "suszonego snopa gryki"

#. ~ Description of "dried buckwheat stalks"
#: data/json/items/comestibles/raw_grain.json
msgid ""
"A heap of dried buckwheat.  It'll need to be threshed before eating, unless "
"you're a cow."
msgstr ""
"Stos suszonej gryki. Przed jedzeniem trzeba ją wymłócić, chyba że jesteś "
"krową."

#. ~ Item name
#: data/json/items/comestibles/raw_grain.json
msgid "threshed buckwheat"
msgid_plural "threshed buckwheat"
msgstr[0] "wymłócona gryka"
msgstr[1] "porcje wymłóconej gryki"
msgstr[2] "porcji wymłóconej gryki"
msgstr[3] "porcji wymłóconej gryki"

#. ~ Description of "threshed buckwheat"
#: data/json/items/comestibles/raw_grain.json
msgid ""
"A pile of buckwheat seeds with some chaff still mixed in.  Once it's "
"winnowed, it'll be ready for use."
msgstr ""
"Kupka nasion gryki z resztkami plew. Po przewianiu będzie gotowa do użycia."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "handful of ground nuts"
msgid_plural "handfuls of ground nuts"
msgstr[0] "garść bulw apiosu"
msgstr[1] "garście bulw apiosu"
msgstr[2] "garści bulw apiosu"
msgstr[3] "garści bulw apiosu"

#. ~ Description of "handful of ground nuts"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"An almost forgotten staple of the native tribes, called the Indian potato by "
"some.  Very nutritious, but mildly toxic unless cooked."
msgstr ""
"Niemal zapomniany podstawowy pokarm rdzennych plemion, przez niektórych "
"nazywany indiańskim ziemniakiem. Bardzo pożywny, ale lekko toksyczny, dopóki "
"się go nie ugotuje."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "Jerusalem artichoke"
msgid_plural "Jerusalem artichokes"
msgstr[0] "słonecznik bulwiasty"
msgstr[1] "słoneczniki bulwiaste"
msgstr[2] "słoneczników bulwiastych"
msgstr[3] "słonecznika bulwiastego"

#. ~ Description of "broccoli"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A big stalk of broccoli.  It's a bit tough, but rich in Vitamin C and quite "
"delicious when properly cooked."
msgstr ""
"Duża łodyga brokułu. Jest nieco twarda, ale bogata w witaminę C i całkiem "
"pyszna, gdy się ją dobrze przyrządzi."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "cabbage head"
msgid_plural "cabbage head"
msgstr[0] "główka kapusty"
msgstr[1] "główki kapusty"
msgstr[2] "główek kapusty"
msgstr[3] "główki kapusty"

#. ~ Description of "cabbage head"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A head of crisp white cabbage.  You should probably prepare it before eating."
msgstr ""
"Główka chrupiącej białej kapusty. Przed zjedzeniem lepiej ją jakoś "
"przyrządzić."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "handful of shredded cabbage"
msgid_plural "handfuls of shredded cabbage"
msgstr[0] "garść poszatkowanej kapusty"
msgstr[1] "garście poszatkowanej kapusty"
msgstr[2] "garści poszatkowanej kapusty"
msgstr[3] "garści poszatkowanej kapusty"

#. ~ Description of "handful of shredded cabbage"
#: data/json/items/comestibles/raw_veggy.json
msgid "A handful of shredded cabbage."
msgstr "Garść poszatkowanej kapusty."

#. ~ Description of "grape leaves"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"Edible leaves of the grape vine.  Typically used in salads or as a food "
"wrapping."
msgstr ""
"Jadalne liście winorośli. Zwykle używane w sałatkach lub do zawijania potraw."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "handful of radish taproots"
msgid_plural "handfuls of radish taproots"
msgstr[0] "garść rzodkiewek"
msgstr[1] "garście rzodkiewek"
msgstr[2] "garści rzodkiewek"
msgstr[3] "garści rzodkiewek"

#. ~ Description of "handful of radish taproots"
#: data/json/items/comestibles/raw_veggy.json
msgid "A handful of crunchy red radish taproots."
msgstr "Garść chrupiących czerwonych rzodkiewek."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "handful of spinach"
msgid_plural "handfuls of spinach"
msgstr[0] "garść szpinaku"
msgstr[1] "garście szpinaku"
msgstr[2] "garści szpinaku"
msgstr[3] "garści szpinaku"

#. ~ Description of "handful of spinach"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A bunch of spinach leaves.  Their ability to provide one with superhuman "
"strength has been greatly exaggerated by popular media."
msgstr ""
"Pęczek liści szpinaku. Ich zdolność do obdarzania nadludzką siłą została "
"mocno przesadzona przez popkulturę."

#. ~ Description of "cattail rhizome"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A stout, branching rhizome from a cattail plant.  Its crisp white flesh is "
"very starchy and fibrous, but you really ought to cook it before you attempt "
"to eat it."
msgstr ""
"Grube, rozgałęzione kłącze pałki wodnej. Jego chrupiący biały miąższ jest "
"bardzo skrobiowy i włóknisty, ale naprawdę lepiej go ugotować, zanim "
"spróbujesz go zjeść."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "lotus root"
msgid_plural "lotus roots"
msgstr[0] "korzeń lotosu"
msgstr[1] "korzenie lotosu"
msgstr[2] "korzeni lotosu"
msgstr[3] "korzenia lotosu"

#. ~ Description of "lotus root"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"The rhizome of the lotus, which has many tubular cavities inside, can be "
"eaten both raw and cooked."
msgstr ""
"Kłącze lotosu, w którego wnętrzu jest wiele rurkowatych komór. Można je jeść "
"zarówno na surowo, jak i po ugotowaniu."

#. ~ Description of "cattail stalk"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A stiff, green stalk from a cattail plant.  It is starchy and fibrous, but it"
" would be much better if you cooked it."
msgstr ""
"Sztywna, zielona łodyga pałki wodnej. Jest skrobiowa i włóknista, ale byłaby "
"znacznie lepsza po ugotowaniu."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "plant stalk"
msgid_plural "plant stalks"
msgstr[0] "łodyga rośliny"
msgstr[1] "łodygi roślin"
msgstr[2] "łodyg roślin"
msgstr[3] "łodygi rośliny"

#. ~ Description of "plant stalk"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A stiff, green stalk from a plant.  It is starchy and fibrous, but it would "
"be much better if you cooked it."
msgstr ""
"Sztywna, zielona łodyga rośliny. Jest skrobiowa i włóknista, ale byłaby "
"znacznie lepsza po ugotowaniu."

#. ~ Description of "celery"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A single stalk of celery.  Neither tasty nor very nutritious, but it goes "
"well with salad."
msgstr ""
"Pojedyncza łodyga selera. Ani smaczna, ani szczególnie pożywna, ale dobrze "
"pasuje do sałatki."

#. ~ Description of "cotton boll"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A tough protective capsule bulging with densely-packed fibers and seeds, this"
" cotton boll can be processed into usable material with the right tools."
msgstr ""
"Twarda torebka ochronna wypchana gęsto upakowanymi włóknami i nasionami. Z "
"odpowiednimi narzędziami tę kulę nasienną bawełny można przerobić na "
"użyteczny materiał."

#. ~ Description of "chili pepper"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A spicy chili pepper.  Not the best on its own, but adds great flavor when "
"used in cooking."
msgstr ""
"Ostra papryczka chili. Sama w sobie nie najlepsza, ale dodana podczas "
"gotowania daje świetny smak."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "cut chili pepper"
msgid_plural "cut chili peppers"
msgstr[0] "pokrojona papryczka chili"
msgstr[1] "pokrojone papryczki chili"
msgstr[2] "pokrojonych papryczek chili"
msgstr[3] "pokrojonej papryczki chili"

#. ~ Description of "cut chili pepper"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A chili pepper that's been cut into pieces.  The seeds have been removed."
msgstr "Papryczka chili pokrojona na kawałki. Nasiona zostały usunięte."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "salad cucumber"
msgid_plural "salad cucumbers"
msgstr[0] "ogórek sałatkowy"
msgstr[1] "ogórki sałatkowe"
msgstr[2] "ogórków sałatkowych"
msgstr[3] "ogórka sałatkowego"

#. ~ Description of "salad cucumber"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"The larger cousin of a pickle.  A vegetable from the gourd family.  Not "
"especially flavorful, but very refreshing."
msgstr ""
"Większy kuzyn korniszona. Warzywo z rodziny dyniowatych. Niezbyt aromatyczny,"
" ale bardzo orzeźwiający."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "cut salad cucumber"
msgid_plural "cut salad cucumbers"
msgstr[0] "pokrojony ogórek sałatkowy"
msgstr[1] "pokrojone ogórki sałatkowe"
msgstr[2] "pokrojonych ogórków sałatkowych"
msgstr[3] "pokrojonego ogórka sałatkowego"

#. ~ Description of "cut salad cucumber"
#: data/json/items/comestibles/raw_veggy.json
msgid "A chopped-up salad cucumber."
msgstr "Posiekany ogórek sałatkowy."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "gherkin cucumber"
msgid_plural "gherkin cucumbers"
msgstr[0] "ogórek konserwowy"
msgstr[1] "ogórki konserwowe"
msgstr[2] "ogórków konserwowych"
msgstr[3] "ogórka konserwowego"

#. ~ Description of "gherkin cucumber"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A pickle before it becomes a pickle.  Gherkins are smaller cucumbers that - "
"you guessed it - are used to make pickles."
msgstr ""
"Korniszon, zanim stanie się korniszonem. Ogórki konserwowe to mniejsze "
"ogórki, których - zgadłeś - używa się do robienia korniszonów."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "cut gherkin cucumber"
msgid_plural "cut gherkin cucumbers"
msgstr[0] "pokrojony ogórek konserwowy"
msgstr[1] "pokrojone ogórki konserwowe"
msgstr[2] "pokrojonych ogórków konserwowych"
msgstr[3] "pokrojonego ogórka konserwowego"

#. ~ Description of "cut gherkin cucumber"
#: data/json/items/comestibles/raw_veggy.json
msgid "A chopped-up gherkin cucumber."
msgstr "Posiekany ogórek konserwowy."

#. ~ Description of "salsify root"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A highly nutritious root, it is tough and bland until cooked, at which point "
"it tastes strangely similar to oysters."
msgstr ""
"Bardzo pożywny korzeń, twardy i mdły, dopóki się go nie ugotuje; wtedy w "
"smaku dziwnie przypomina ostrygi."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "chicory root"
msgid_plural "chicory roots"
msgstr[0] "korzeń cykorii"
msgstr[1] "korzenie cykorii"
msgstr[2] "korzeni cykorii"
msgstr[3] "korzenia cykorii"

#. ~ Description of "chicory root"
#: data/json/items/comestibles/raw_veggy.json
msgid "A very bitter root, not meant to be eaten raw."
msgstr "Bardzo gorzki korzeń, nie nadaje się do jedzenia na surowo."

#. ~ Item name
#: data/json/items/comestibles/raw_veggy.json
msgid "dogbane"
msgid_plural "dogbane"
msgstr[0] "łodyga psitruja"
msgstr[1] "łodygi psitruja"
msgstr[2] "łodyg psitruja"
msgstr[3] "łodygi psitruja"

#. ~ Description of "garlic bulb"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A pungent garlic bulb.  Popular as a seasoning for its strong flavor.  Can be"
" disassembled into cloves."
msgstr ""
"Ostra w zapachu główka czosnku. Popularna przyprawa ze względu na intensywny "
"smak. Można ją zdemontować na ząbki."

#. ~ Description of "garlic clove"
#: data/json/items/comestibles/raw_veggy.json
msgid "Cloves of garlic.  Useful as a seasoning."
msgstr "Ząbki czosnku. Przydatne jako przyprawa."

#. ~ Description of "horseradish root"
#: data/json/items/comestibles/raw_veggy.json
msgid ""
"A large white tapered root of a horseradish plant.  Way too spicy to eat in "
"this form, but can be used for making condiments."
msgstr ""
"Duży, biały, stożkowaty korzeń chrzanu. W tej postaci zdecydowanie zbyt ostry"
" do jedzenia, ale można z niego robić przyprawy."
