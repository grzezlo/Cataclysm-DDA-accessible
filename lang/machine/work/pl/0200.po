msgstr ""

#. ~ NPC message in nested effect in then statement in false effect in EoC
#. "EOC_LILIN_BLINDING_TARGET_2" in nested EOCs in effect in EoC
#. "EOC_LILIN_BLINDING_TARGET"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You cannot call up the darkness while the sun is in the sky."
msgstr ""

#. ~ NPC message in nested effect in then statement in nested effect in else
#. statement in false effect in EoC "EOC_LILIN_BLINDING_TARGET_2" in nested
#. EOCs in effect in EoC "EOC_LILIN_BLINDING_TARGET"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
