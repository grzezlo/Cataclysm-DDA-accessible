msgstr ""

#. ~ NPC message in false effect in EoC "EOC_LILIN_BLINDING_TARGET"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You don't have enough ruach to call the darkness on your target."
msgstr ""

#. ~ NPC message in nested effect in then statement in effect in EoC
#. "EOC_LILIN_MESMERIZE_TARGET_2" in nested EOCs in effect in EoC
#. "EOC_LILIN_MESMERIZE_TARGET"
