#. ~ Description of spell "dream_dagger ( Dream Dagger )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid ""
"This ephemeral dagger is powered with your own inner reality connections, and"
" is deadlier the larger your mana pool."
msgstr ""

#. ~ Name of spell "dream_armor"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Dream Armor"
msgstr ""

#. ~ Description of spell "dream_armor ( Dream Armor )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid ""
"Armor that sits lightly on your body with little in the way of encumbrance "
"and rests on top of whatever you are wearing."
msgstr ""

#. ~ Name of spell "create_dream_dross"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Bring Forth Dreamdross"
msgstr ""

#. ~ Name of spell "banish_nether_monsters"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Banish Interdimensional Horrors"
msgstr ""

#. ~ Description of spell "banish_nether_monsters ( Banish Interdimensional
#. Horrors )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid ""
"Attempts to banish things clearly inimical to local physics back to their "
"home dimension."
msgstr ""

#. ~ Name of spell "banish_dark_monsters"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Banish Darkness Made Flesh"
msgstr ""

#. ~ Description of spell "banish_dark_monsters ( Banish Darkness Made Flesh )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Attempts to banish monsters crafted from the darkest of nights."
msgstr ""

#. ~ Name of spell "spell_summon_twin"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Twin"
msgstr ""

#. ~ Description of spell "spell_summon_twin ( Twin )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Make a fake copy of yourself to disrupt your enemies."
msgstr ""

#. ~ Name of spell "spell_summon_twin_flood"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Twin Flood"
msgstr ""

#. ~ Description of spell "spell_summon_twin_flood ( Twin Flood )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Fill the reality with your own copies."
msgstr ""

#. ~ Description of spell "spell_dreamer_clairvoyance ( Unfold )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "All walls are obliterated before your eyes."
msgstr ""

#. ~ Name of spell "spell_dreamer_clairvoyance_eff"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Spatial Awareness"
msgstr ""

#. ~ Description of spell "spell_dreamer_clairvoyance_eff ( Spatial Awareness
#. )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Feel them.  See them.  Connect to them."
msgstr ""

#. ~ Name of spell "summon_shifter"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Summon Shifter"
msgstr ""

#. ~ Description of spell "summon_shifter ( Summon Shifter )"
#. ~ Description of spell "summon_duplicator ( Summon Duplicator )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Summon a portal creature to help in a dangerous situation."
msgstr ""

#. ~ Name of spell "summon_sapient_light"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Summon Light"
msgstr ""

#. ~ Description of spell "summon_sapient_light ( Summon Light )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid ""
"Summon a disturbed sapient entity of another reality with a hatred for living"
" creatures.  It won't attack you.  At least for now."
msgstr ""

#. ~ Name of spell "make_constructed_hammer"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Hammering"
msgstr ""

#. ~ Description of spell "make_constructed_hammer ( Hammering )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid ""
"Using your energy you construct an oddly shaped hammer.  You can use it to "
"smash your enemies, or breach different obstacles."
msgstr ""

#. ~ Sound description of spell "constructed_hammer_attack ( Smash A Target )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "a smash"
msgstr ""

#. ~ Name of spell "summon_duplicator"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Summon Duplicator"
msgstr ""

#. ~ Name of spell "xedra_dreamer_time_bubble"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Summon Time Bubble"
msgstr ""

#. ~ Description of spell "xedra_dreamer_time_bubble ( Summon Time Bubble )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid ""
"Summon an impenetrable bubble of frozen time at your chosen location, "
"freezing everything within."
msgstr ""

#. ~ Name of spell "teleport_coin"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Toss a Coin"
msgstr ""

#. ~ Description of spell "teleport_coin ( Toss a Coin )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Toss a coin.  On which side are you?"
msgstr ""

#. ~ Name of spell "summon_ophanim"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Summon Angel"
msgstr ""

#. ~ Description of spell "summon_ophanim ( Summon Angel )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid ""
"Summon a creature that looks pretty similar to how angels are described in "
"the Bible - a giant flying mess of wings, eyes and rings."
msgstr ""

#. ~ Name of spell "summon_winch"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Construct a Winch"
msgstr ""

#. ~ Description of spell "summon_winch ( Construct a Winch )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid ""
"Create a small token.  When used, it'll pull you back to the place you "
"created it."
msgstr ""

#. ~ Name of spell "dreamer_artifact"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Pull From Beyond"
msgstr ""

#. ~ Description of spell "dreamer_artifact ( Pull From Beyond )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid ""
"Using your abilities, you compress the gap between your hands with pure "
"energy, attempting to construct…  something."
msgstr ""

#. ~ Name of spell "xedra_dreamer_generate_accelerated_time"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Generate Accelerated Time"
msgstr ""

#. ~ Description of spell "xedra_dreamer_generate_accelerated_time ( Generate
#. Accelerated Time )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid ""
"Continuously generate short-lived bubbles of accelerated time around you, "
"allowing you and anything else that enters to act far quicker than normal."
msgstr ""

#. ~ Description of spell "spell_ethereal_wings ( Ethereal Wings )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid ""
"Two ethereal wings sprout out of your back indefinitely until toggled off.  "
"They work as phantasmal pair of wings that can somehow lift your weight even "
"without conscious effort."
msgstr ""

#. ~ Name of spell "spell_karma_arms"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Karma Arms"
msgstr ""

#. ~ Description of spell "spell_karma_arms ( Karma Arms )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid ""
"Four transparent arms emit out of your body indefinitely until toggled off.  "
"They work as a desirable additional pair of arms, and who knows what power "
"they contain?"
msgstr ""

#. ~ Name of spell "spell_stalker_eyes"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Stalker's Oculars"
msgstr ""

#. ~ Description of spell "spell_stalker_eyes ( Stalker's Oculars )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid ""
"Your own eyes are replaced with the eyeballs of an unknown creature, "
"indefinitely, until you toggle them off.  Compounded from billions of red "
"crosses inside void-dark sclera, they can see much more clearly than any "
"natural creature."
msgstr ""

#. ~ Description of spell "spell_devil_tail ( Devil's Tail )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid ""
"A stretchy tail appears from the base of your spine, instinctively aiding you"
" in battle or moving to defend you, indefinitely, until toggled off."
msgstr ""

#. ~ Name of spell "dreamer_lucid_dreams"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Lucid Dreams"
msgstr ""

#. ~ Description of spell "dreamer_lucid_dreams ( Lucid Dreams )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid ""
"The line between reality and your dreams shrinks enormously.  In this dream "
"you are barely affected by reality, with most changes to your body reverting "
"when you wake up.  While it may end your dream, not even death can touch you."
msgstr ""

#. ~ Name of spell "spell_oneiric_hammer"
#: data/mods/Xedra_Evolved/spells/dreamsmithing.json
msgid "Call Oneiric Hammer"
msgstr ""

#. ~ Description of spell "spell_oneiric_hammer ( Call Oneiric Hammer )"
#: data/mods/Xedra_Evolved/spells/dreamsmithing.json
msgid ""
"Creates a crystal blacksmith's hammer with which to build a new reality.  You"
" need all your magic force to hold it, and you are unable to do any magic "
"while using it."
msgstr ""

#. ~ Name of spell "eat_dreamdross"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Eat dreamdross"
msgstr ""

#. ~ Description of spell "eat_dreamdross ( Eat dreamdross )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "You consume dreamdross to regain mana.  Pretty tasty."
msgstr ""

#. ~ Name of spell "eat_more_dreamdross"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Eat more dreamdross"
msgstr ""

#. ~ Description of spell "eat_more_dreamdross ( Eat more dreamdross )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid ""
"You can consume more dreamdross to regain mana in one sitting.  Delicious."
msgstr ""

#. ~ Name of spell "eat_dreamdross_ingot"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Eat dreamdross ingots"
msgstr ""

#. ~ Description of spell "eat_dreamdross_ingot ( Eat dreamdross ingots )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid ""
"You can't really process so much dreamdross at once, and additionally to "
"restoring your mana pool, it directly improves your body, making your "
"stronger and healthier.  It is probably the most delicious thing in your "
"life."
msgstr ""

#. ~ Name of spell "blood_boil"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Blood Boil"
msgstr ""

#. ~ Description of spell "blood_boil ( Blood Boil )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid ""
"With a shouted ancient word, the target's blood temperature begins to "
"increase dangerously."
msgstr ""

#. ~ Name of spell "self_healing"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Trade dreams for health"
msgstr ""

#. ~ Description of spell "self_healing ( Trade dreams for health )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Absorbs some dross and heals damage to yourself."
msgstr ""

#. ~ Name of spell "supercoffee"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Recover fatigue for dreams"
msgstr ""

#. ~ Description of spell "supercoffee ( Recover fatigue for dreams )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Absorbs some dross and heals fatigue to yourself."
msgstr ""

#. ~ Name of spell "spring_heeled_leap"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Spring-heeled Leap"
msgstr ""

#. ~ Description of spell "spring_heeled_leap ( Spring-heeled Leap )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Force pushes your feet off the ground and launches you several meters."
msgstr ""

#. ~ Description of spell "spell_rage ( Blind Rage )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Perfect hatred."
msgstr ""

#. ~ Description of spell "spell_stamina_wonder ( Circulatory )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Don't stop."
msgstr ""

#. ~ Name of spell "spell_night_vision"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Dark Vision"
msgstr ""

#. ~ Description of spell "spell_night_vision ( Dark Vision )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Enhance your eyes to see at night as clearly as in daylight."
msgstr ""

#. ~ Description of spell "spell_dodge ( Dodge )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Shun their attacks."
msgstr ""

#. ~ Description of spell "spell_endurance ( Endurance )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Take the blows.  Don't let the world kill you."
msgstr ""

#. ~ Description of spell "spell_invisibility ( Hide )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Don't let them spot you."
msgstr ""

#. ~ Name of spell "spell_clairvoyance"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Open Mind"
msgstr ""

#. ~ Description of spell "spell_melee_damage ( Physical Instrument )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Your body is a tool of destruction.  Use it effectively."
msgstr ""

#. ~ Description of spell "spell_spear ( Pierce )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Throw a long ethereal spear out of your hand."
msgstr ""

#. ~ Description of spell "spell_speed_wonder ( Rush )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Run.  Run as fast as you can.  Don't stop."
msgstr ""

#. ~ Description of spell "spell_weak ( Weakening )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Make enemies around you more vulnerable."
msgstr ""

#. ~ Description of spell "spell_unbreakable ( Unbreakable )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Nothing can move you from your path."
msgstr ""

#. ~ Name of spell "xedra_eater_stabilize_reality"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Stabilize in Reality"
msgstr ""

#. ~ Description of spell "xedra_eater_stabilize_reality ( Stabilize in Reality
#. )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Prevent hostile adjustments to your personal reality and timeline."
msgstr ""

#. ~ Description of spell "xedra_eater_erosion ( Erosion )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid ""
"Generate an unstable field of time close to your body that erodes creatures "
"you attack in melee over time."
msgstr ""

#. ~ Name of spell "xedra_eater_erosion_attack"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Erosion - Attack"
msgstr ""

#. ~ Description of spell "xedra_eater_erosion_attack ( Erosion - Attack )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid ""
"This causes the dot when attacking targets with the erosion buff.  Having the"
" spell is a bug."
msgstr ""

#. ~ Name of spell "point_blank"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid "Point Blank"
msgstr ""

#. ~ Description of spell "point_blank ( Point Blank )"
#: data/mods/Xedra_Evolved/spells/eater_spells.json
msgid ""
"A straight hit with your arm.  Using additional energy you could probably "
"break a wall with such a powerful strike."
msgstr ""

#. ~ Player message in effect in EoC "EOC_ITEM_HEDGE_WITCHLIGHT_DISMISS_ACTUAL"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "The witchlight vanishes without a sound."
msgstr ""

#. ~ Player message in effect in EoC "EOC_HEDGE_MAKE_PLANTS_GROW_2" in nested
#. EOCs in effect in EoC "EOC_HEDGE_MAKE_PLANTS_GROW"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid ""
"As you finish the words of the charm, the magic takes hold.  (E)xamine a "
"nearby crop to fertilize it."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_HEDGE_MAKE_PLANTS_GROW_2" in
#. nested EOCs in effect in EoC "EOC_HEDGE_MAKE_PLANTS_GROW"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid ""
"You must complete the charm within one hour of noon for it to be effective."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_HEDGE_MAKE_PLANTS_GROW"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "You must be standing on soil for the charm to be effective."
msgstr ""

#. ~ Player message in effect in EoC "EOC_HEDGE_SEE_NETHER_EYE_PASTE"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "You rub the paste on your eyes and feel it tingle."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_HEDGE_STUNNING_SPELL"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "You must be outside to use the charm."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_HEDGE_HIDE_IN_FOREST"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "Without being in a forest, the charm has no effect."
msgstr ""

#. ~ Player message in effect in EoC "EOC_HEDGE_TURN_INTO_BEAR_WEAR_ITEM"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid ""
"As you put the mantle on, your skin writhes, your limbs twist, and thick fur "
"sprouts from your body as you fall onto all fours."
msgstr ""

#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_HEDGE_TURN_INTO_BEAR_SIDE_EFFECTS"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid ""
"It would be so easy to walk off into the forest and forget you had ever been "
"human."
msgstr ""

#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_HEDGE_TURN_INTO_BEAR_SIDE_EFFECTS_CURE_FAST"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid ""
"You remember your childhood.  The sound of your mother's voice.  You are not "
"a wild beast!"
msgstr ""

#. ~ Player message in effect in EoC "EOC_HEDGE_TURN_INTO_BEAR_REMOVE_ITEM"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid ""
"Your nonexistence arms somehow remove the mantle and return to your old "
"shape."
msgstr ""

#. ~ Player message in effect in EoC "EOC_HEDGE_WALK_ON_WATER"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid ""
"You drop the bark on the water and recite the words of the charm, and as you "
"take your first step, the water feels firm under your feet."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_HEDGE_WALK_ON_WATER"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "You must be standing on water or the charm will have no effect."
msgstr ""

#. ~ Player message in false effect in EoC
#. "EOC_HEDGE_WALK_ON_WATER_CONTINUANCE_2" in nested EOCs in effect in EoC
#. "EOC_HEDGE_WALK_ON_WATER_CONTINUANCE"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "As you step on solid ground again, the charm fades."
msgstr ""

#. ~ Player message in effect in EoC "EOC_HEDGE_BLESS_STEEL_WEAPON_EFFECT" in
#. nested EOCs on true condition in effect in EoC
#. "EOC_HEDGE_BLESS_STEEL_WEAPON"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid ""
"You pass the weapon through the candleflame after rubbing the mixture of salt"
" and herbs on it while slowly reciting the words of the charm, and when you "
"have finished you feel a sense of surety while holding it"
msgstr ""

#. ~ Player message in effect in EoC
#. "EOC_HEDGE_BLESS_STEEL_WEAPON_ATTACKS_CHECK_DAMAGE" in nested EOCs on true
#. condition in effect in EoC "EOC_HEDGE_BLESSED_WEAPON_LOSE_CHARM"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "You no longer feel a sense of purity from your weapon"
msgstr ""

#. ~ Player message in effect in EoC
#. "EOC_HEDGE_PROTECT_THE_MIND_FROM_PSYCHIC_ASSAULT"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "Your mental defenses break under the pain!"
msgstr ""

#. ~ EOC option name in effect in EoC "EOC_HEDGE_FOOD_OR_DRINK_SELECTOR"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "Summon meat"
msgstr ""

#. ~ EOC option name in effect in EoC "EOC_HEDGE_FOOD_OR_DRINK_SELECTOR"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "Summon cheese"
msgstr ""

#. ~ EOC option name in effect in EoC "EOC_HEDGE_FOOD_OR_DRINK_SELECTOR"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "Summon fish"
msgstr ""

#. ~ EOC option name in effect in EoC "EOC_HEDGE_FOOD_OR_DRINK_SELECTOR"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "Summon bread"
msgstr ""

#. ~ EOC option name in effect in EoC "EOC_HEDGE_FOOD_OR_DRINK_SELECTOR"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "Summon wine"
msgstr ""

#. ~ EOC option description in effect in EoC "EOC_HEDGE_FOOD_OR_DRINK_SELECTOR"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "Ask the spirits to summon some meat for you to eat."
msgstr ""

#. ~ EOC option description in effect in EoC "EOC_HEDGE_FOOD_OR_DRINK_SELECTOR"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "Ask the spirits to summon some cheese for you to eat."
msgstr ""

#. ~ EOC option description in effect in EoC "EOC_HEDGE_FOOD_OR_DRINK_SELECTOR"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "Ask the spirits to summon some fish for you to eat."
msgstr ""

#. ~ EOC option description in effect in EoC "EOC_HEDGE_FOOD_OR_DRINK_SELECTOR"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "Ask the spirits to summon some bread for you to eat."
msgstr ""

#. ~ EOC option description in effect in EoC "EOC_HEDGE_FOOD_OR_DRINK_SELECTOR"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "Ask the spirits to summon a bottle of wine for you to drink."
msgstr ""

#. ~ EOC selection title in effect in EoC "EOC_HEDGE_FOOD_OR_DRINK_SELECTOR"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid "Conjure which victuals?"
msgstr ""

#. ~ Player message in effect in EoC "EOC_HEDGE_FOOD_OR_DRINK_SELECTOR_MEAT"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid ""
"There is a gust of wind, a sparkle in the air, and a faint murmur of sound, "
"and some cooked meat appears before you."
msgstr ""

#. ~ Player message in effect in EoC "EOC_HEDGE_FOOD_OR_DRINK_SELECTOR_CHEESE"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid ""
"There is a gust of wind, a sparkle in the air, and a faint murmur of sound, "
"and some hard cheese appears before you."
msgstr ""

#. ~ Player message in effect in EoC "EOC_HEDGE_FOOD_OR_DRINK_SELECTOR_FISH"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid ""
"There is a gust of wind, a sparkle in the air, and a faint murmur of sound, "
"and some cooked fish appears before you."
msgstr ""

#. ~ Player message in effect in EoC "EOC_HEDGE_FOOD_OR_DRINK_SELECTOR_BREAD"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid ""
"There is a gust of wind, a sparkle in the air, and a faint murmur of sound, "
"and some fresh bread appears before you."
msgstr ""

#. ~ Player message in effect in EoC "EOC_HEDGE_FOOD_OR_DRINK_SELECTOR_WINE"
#: data/mods/Xedra_Evolved/spells/hedge_magic_eocs.json
msgid ""
"There is a gust of wind, a sparkle in the air, and a faint murmur of sound, "
"and a bottle of wine appears before you."
msgstr ""

#. ~ Name of spell "hedge_ward_off_rain"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Keep Off the Rain and the Damp"
msgstr ""

#. ~ Description of spell "hedge_ward_off_rain ( To Keep Off the Rain and the
#. Damp )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"Keep yourself from getting wet in the rain.  The charm will not keep you dry "
"if you step into a water source."
msgstr ""

#. ~ Message of spell "hedge_ward_off_rain ( To Keep Off the Rain and the Damp
#. )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"You crush the leaves and wrap them in the cloth, touching it to you forehead,"
" the crown of your head, both shoulders, and the backs of both wrists as you "
"recite the words of the charm."
msgstr ""

#. ~ Name of spell "hedge_summon_witchlight"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Bring Light to Dark Places"
msgstr ""

#. ~ Description of spell "hedge_summon_witchlight ( To Bring Light to Dark
#. Places )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"Summon up a bobbing ball of light, just bright enough to read by.  You may "
"activate the witchlight to dismiss it."
msgstr ""

#. ~ Message of spell "hedge_summon_witchlight ( To Bring Light to Dark Places
#. )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"Takin a bit of oil on your fingertips, you trace a pattern in the air while "
"reciting the words of the charm, and a glowing ball of light forms in the "
"air."
msgstr ""

#. ~ Name of spell "hedge_make_plants_grow"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Bring Health to the Soil and Life to the Crops"
msgstr ""

#. ~ Description of spell "hedge_make_plants_grow ( To Bring Health to the Soil
#. and Life to the Crops )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"While standing on soil or turned earth, perform a ritual to increase the "
"bounty of the crops.  The casting of this charm must end within one hour of "
"noon."
msgstr ""

#. ~ Message of spell "hedge_make_plants_grow ( To Bring Health to the Soil and
#. Life to the Crops )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"You dance slowly over the living earth, letting the seeds fall at the "
"appropriate time, and as the sun climbs to its zenith you recite the last "
"words of the charm."
msgstr ""

#. ~ Description of spell "hedge_light_fire ( To Kindle the Flames )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "Call forth the remnants of a fire from some ash to light a new flame."
msgstr ""

#. ~ Message of spell "hedge_light_fire ( To Kindle the Flames )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"You sprinkle the wood ash over the kindling as you recite the words of the "
"charm."
msgstr ""

#. ~ Name of spell "hedge_see_fae_necklace"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Spot the Goodly Folk"
msgstr ""

#. ~ Description of spell "hedge_see_fae_necklace ( To Spot the Goodly Folk )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"Using wild herbs and hawthorn berries, create an amulet that will tell you if"
" any of the Fair Folk are nearby."
msgstr ""

#. ~ Message of spell "hedge_see_fae_necklace ( To Spot the Goodly Folk )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"You laboriously sew the square of leather into a pouch and place the herbs "
"and hawthorn berries inside.  Chanting softly, you seal the bag and attach "
"the string to it so it can be worn around your neck."
msgstr ""

#. ~ Name of spell "hedge_see_nether_eye_paste"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Perceive the Mazzikin"
msgstr ""

#. ~ Description of spell "hedge_see_nether_eye_paste ( To Perceive the
#. Mazzikin )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"Using blood and ashes and certain herbs, create a paste that when rubbed on "
"the eyes, will allow you to perceive otherworldly beings even in darkness or "
"through walls.  It will inhibit your mundane sight, however."
msgstr ""

#. ~ Message of spell "hedge_see_nether_eye_paste ( To Perceive the Mazzikin )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"You grind the bones to powder and mix in the blood and herbs while "
"rhythmically chanting the words of the charm, and when you're done you have a"
" dark, foul-smelling paste as the reward of your labors."
msgstr ""

#. ~ Name of spell "hedge_changeling_snare"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "Maze the Little Folk"
msgstr ""

#. ~ Description of spell "hedge_changeling_snare ( Maze the Little Folk )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"A spell to create a snare for catching one of the little folk, a changeling."
"  Has no effect on the elder spirits of wood and water, fire and earth, nor "
"plant or man."
msgstr ""

#. ~ Message of spell "hedge_changeling_snare ( Maze the Little Folk )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"You skein a complicated cat's cradle with splinters of wood guiding the way "
"in to blackberries at each of the focus points in your design."
msgstr ""

#. ~ Name of spell "hedge_stunning_spell"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Befuddle As the Thunderstrike"
msgstr ""

#. ~ Description of spell "hedge_stunning_spell ( To Befuddle As the
#. Thunderstrike )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"While outdoors, recite a quick charm to produce a flash of light like unto a "
"thunderbolt, bedazzling anyone around you."
msgstr ""

#. ~ Message of spell "hedge_stunning_spell ( To Befuddle As the Thunderstrike
#. )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"You call out the words of the charm to the sky and there is a burst of light."
msgstr ""

#. ~ Name of spell "hedge_cure_cold_or_flu"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Purge the Most Virulent Grippe"
msgstr ""

#. ~ Description of spell "hedge_cure_cold_or_flu ( To Purge the Most Virulent
#. Grippe )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"By adding particular herbs and a bit of iron to your tea while you recite the"
" words of the charm over it, you can brew a tea that will prove a sovereign "
"remedy to a cold or a flu."
msgstr ""

#. ~ Message of spell "hedge_cure_cold_or_flu ( To Purge the Most Virulent
#. Grippe )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"You brew the tea, adding in a bit of scrap iron and herbs to mix in, while "
"you recite a chant as you stir, and eventually the tea is ready."
msgstr ""

#. ~ Name of spell "hedge_evil_eye_ward"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Ward Off the Evil Eye"
msgstr ""

#. ~ Description of spell "hedge_evil_eye_ward ( To Ward Off the Evil Eye )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"With a bit of salt and some muttered words, deflect the gaze of the evil eye."
msgstr ""

#. ~ Message of spell "hedge_evil_eye_ward ( To Ward Off the Evil Eye )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"You toss a bit of salt over your left shoulder with your right hand and spit "
"three times into the folds of your clothing as you say, \"Keneinahora\"."
msgstr ""

#. ~ Name of spell "hedge_extra_lock_door"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Thrice-Bar the Portal"
msgstr ""

#. ~ Description of spell "hedge_extra_lock_door ( To Thrice-Bar the Portal )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"With some string and the words of the charm, lock a door firmly, even one "
"that doesn't have a locking mechanism."
msgstr ""

#. ~ Message of spell "hedge_extra_lock_door ( To Thrice-Bar the Portal )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"You wind the cord several times around your fingers, muttering the words of "
"the charm, and as the pattern ends you hear a soft thud."
msgstr ""

#. ~ Name of spell "hedge_luck_spell"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "The Coin of Gad"
msgstr ""

#. ~ Description of spell "hedge_luck_spell ( The Coin of Gad )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"With a candle, a penny, and paper, this will create a short lived luck charm "
"upon oneself."
msgstr ""

#. ~ Message of spell "hedge_luck_spell ( The Coin of Gad )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"You write the words upon the paper, place the penny on the ground, place the "
"paper upon the penny, light the candle then the paper and firmly place the "
"candle in the ashes on top of the penny, let the candle burn down melting all"
" over the penny.  You will find your steps slightly lucky for the several "
"hours to potentially a full day."
msgstr ""

#. ~ Name of spell "hedge_clairvoyance_cone"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To See Beyond the Barriers"
msgstr ""

#. ~ Description of spell "hedge_clairvoyance_cone ( To See Beyond the Barriers
#. )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "Gain a brief vision of what lies beyond a wall or a doorway."
msgstr ""

#. ~ Message of spell "hedge_clairvoyance_cone ( To See Beyond the Barriers )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"You close your eyes and place the shards of glass over them and press, just "
"slightly.  As the pain blooms and the blood trickles, you see beyond."
msgstr ""

#. ~ Name of spell "hedge_increase_healing_rate"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Sooth the Pains and Injuries of the Flesh"
msgstr ""

#. ~ Description of spell "hedge_increase_healing_rate ( To Sooth the Pains and
#. Injuries of the Flesh )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"Mix a paste of herbs, water, and willow bark and rub it on the target's "
"wounds.  The charm increases the speed at which wounds heal, as long as the "
"target does not engage in any strenuous activity."
msgstr ""

#. ~ Message of spell "hedge_increase_healing_rate ( To Sooth the Pains and
#. Injuries of the Flesh )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"You grind the herbs and willowbark together with the water, making a thick, "
"woody-smelling paste, and rub it on the target."
msgstr ""

#. ~ Name of spell "hedge_increase_bandaging_rate"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Halt the Scarlet Flow"
msgstr ""

#. ~ Description of spell "hedge_increase_bandaging_rate ( To Halt the Scarlet
#. Flow )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"With some whispered words and a mixture of iron, salt, and herbs, increase "
"your ability to stop the flow of blood.  Best recited right before bandaging "
"a wound."
msgstr ""

#. ~ Message of spell "hedge_increase_bandaging_rate ( To Halt the Scarlet Flow
#. )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"You face toward the east and recite the words of the charm as you rub the "
"iron and salt and herbs on your hands."
msgstr ""

#. ~ Description of spell "hedge_hide_in_forest ( To Vanish Amidst the Leaves
#. )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"While standing in a forest, conceal your presence.  For a brief time after "
"using the charm, anything looking at you will only see another bit of "
"foliage.  Movement or taking any hostile action will cancel the charm."
msgstr ""

#. ~ Message of spell "hedge_hide_in_forest ( To Vanish Amidst the Leaves )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"You wrap the beans in the leaf and, with a slight grimace, recite the words "
"of the charm before you put them in your mouth and hold them there."
msgstr ""

#. ~ Name of spell "hedge_no_nightmares"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Sail on the River of Dreams"
msgstr ""

#. ~ Description of spell "hedge_no_nightmares ( To Sail on the River of Dreams
#. )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"With lavender and thyme, weave a barrier around your sleeping space to keep "
"bad dreams away.  You must perform the charm directly before trying to sleep;"
" moving will breach the barrier and allow the nightmares to find a way in "
"again."
msgstr ""

#. ~ Message of spell "hedge_no_nightmares ( To Sail on the River of Dreams )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"You place the herbs under your pillow and, while chanting the words of the "
"charm, paint some thyme oil on the four corners of your sleeping space."
msgstr ""

#. ~ Name of spell "hedge_turn_into_bear"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Walk the Forests with the Brown One"
msgstr ""

#. ~ Description of spell "hedge_turn_into_bear ( To Walk the Forests with the
#. Brown One )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"Over the freshly-slain and butchered corpse of a bear, recite a paean to its "
"spirit while using its fur and sinew and skull to create a garment.  Putting "
"the garment on will take the spirit of the bear into yourself, allowing you "
"to assume its form until the garment is removed."
msgstr ""

#. ~ Message of spell "hedge_turn_into_bear ( To Walk the Forests with the
#. Brown One )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"As you recite the words of the charm, you sew the bits of fur together into a"
" rough mantle with the bear skull at the top."
msgstr ""

#. ~ Name of spell "hedge_walk_on_water"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Walk Across the Flowing Waters"
msgstr ""

#. ~ Description of spell "hedge_walk_on_water ( To Walk Across the Flowing
#. Waters )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"While standing with your feet in the water, recite this charm to have the "
"water bear you up.  You must keep moving at a steady pace, without running or"
" stopping for more than a few moments, or the charm will fade."
msgstr ""

#. ~ Name of spell "hedge_bless_steel_weapon"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Bless the Sacred Weapon"
msgstr ""

#. ~ Description of spell "hedge_bless_steel_weapon ( To Bless the Sacred
#. Weapon )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"Ensorcell an iron or steel weapon that you are holding so it does additional "
"damage to unholy creatures when used in melee combat.  If the weapon is too "
"damaged, the charm will cease to function."
msgstr ""

#. ~ Name of spell "hedge_astral_projection"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Project the Etheric Form"
msgstr ""

#. ~ Description of spell "hedge_astral_projection ( To Project the Etheric
#. Form )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"After a period of trance and meditation, send out your disembodied spirit to "
"wander the world.  Use of this ritual is <color_yellow>very tiring</color> "
"and you will become increasingly more weary the longer you remain out of your"
" body."
msgstr ""

#. ~ Message of spell "hedge_astral_projection ( To Project the Etheric Form )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "You settle down and slip into a trance."
msgstr ""

#. ~ Name of spell "hedge_protect_the_mind"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Shield the Mind from Assault"
msgstr ""

#. ~ Description of spell "hedge_protect_the_mind ( To Shield the Mind from
#. Assault )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"The first principle of psychic self-defense is to make sure your mind is in "
"proper order so there is no foothold an assault can take advantage of.  While"
" in effect, your mind is protected against psychic attack.  <color_red>Too "
"much pain</color> will disrupt your concentration."
msgstr ""

#. ~ Message of spell "hedge_protect_the_mind ( To Shield the Mind from Assault
#. )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "You settle down and begin ordering your mind."
msgstr ""

#. ~ Name of spell "hedge_astral_projection_return"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "Follow the Silver Cord"
msgstr ""

#. ~ Name of spell "hedge_walk_on_water_magic_square"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Walk Upon the Water"
msgstr ""

#. ~ Description of spell "hedge_walk_on_water_magic_square ( To Walk Upon the
#. Water )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"Create a magic square that can later be used in a short ritual to walk across"
" the surface of the water."
msgstr ""

#. ~ Message of spell "hedge_walk_on_water_magic_square ( To Walk Upon the
#. Water )"
#. ~ Message of spell "hedge_breathe_water_magic_square ( To Operate Under the
#. Water )"
#. ~ Message of spell "hedge_bash_terrain_magic_square ( To Demolish Buildings
#. and Strongholds )"
#. ~ Message of spell "hedge_armed_men_magic_square ( To Cause Armed Men to
#. Appear )"
#. ~ Message of spell "hedge_food_or_drink_magic_square ( To Cause the Spirits
#. to Bring us Anything We May Wish to Eat or to Drink )"
#. ~ Message of spell "hedge_invisibility_magic_square ( To Render Oneself
#. Invisible Unto Every Person )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"Focusing your mind and muttering the charms and spells under your breath, you"
" carefully write down the patterns of the magic square."
msgstr ""

#. ~ Name of spell "hedge_breathe_water_magic_square"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Operate Under the Water"
msgstr ""

#. ~ Description of spell "hedge_breathe_water_magic_square ( To Operate Under
#. the Water )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"Create a magic square that can later be used in a short ritual to breathe "
"underwater."
msgstr ""

#. ~ Name of spell "hedge_bash_terrain_magic_square"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Demolish Buildings and Strongholds"
msgstr ""

#. ~ Description of spell "hedge_bash_terrain_magic_square ( To Demolish
#. Buildings and Strongholds )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"Create a magic square that can later be used in a short ritual to do massive "
"damage to a nearby structure."
msgstr ""

#. ~ Name of spell "hedge_armed_men_magic_square"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Cause Armed Men to Appear"
msgstr ""

#. ~ Description of spell "hedge_armed_men_magic_square ( To Cause Armed Men to
#. Appear )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"Create a magic square to summon an ethereal group of soldiers who will attack"
" your enemies."
msgstr ""

#. ~ Name of spell "hedge_food_or_drink_magic_square"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"To Cause the Spirits to Bring us Anything We May Wish to Eat or to Drink"
msgstr ""

#. ~ Description of spell "hedge_food_or_drink_magic_square ( To Cause the
#. Spirits to Bring us Anything We May Wish to Eat or to Drink )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"Create a magic square to cause an ethereal spirit to bring wine, meat, "
"cheese, or bread to you."
msgstr ""

#. ~ Name of spell "hedge_invisibility_magic_square"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid "To Render Oneself Invisible Unto Every Person"
msgstr ""

#. ~ Description of spell "hedge_invisibility_magic_square ( To Render Oneself
#. Invisible Unto Every Person )"
#: data/mods/Xedra_Evolved/spells/hedge_magic_spells.json
msgid ""
"Create a magic square to that will cause you to turn completely invisible.  "
"Violent action will reveal your presence."
msgstr ""

#. ~ Description of enchantment "Salamander"
#. ~ Description of enchantment "Salamonstrous"
#: data/mods/Xedra_Evolved/spells/integrated_armor_spells.json
msgid ""
"Your Fire Elemental abilities grant you good resistance to temperature "
"conditions and heat damage.  Also your body emits streams of heat into anyone"
" who attack you."
msgstr ""

#. ~ Message in effect "integrated_coal_skin_burnback"
#: data/mods/Xedra_Evolved/spells/integrated_armor_spells.json
msgid "Flames and heat flash out from where you've been hit."
msgstr ""

#. ~ Name of a enchantment
#: data/mods/Xedra_Evolved/spells/integrated_armor_spells.json
msgid "Salamonstrous"
msgstr ""

#. ~ Description of enchantment "cloud skin"
#: data/mods/Xedra_Evolved/spells/integrated_armor_spells.json
msgid ""
"Your cloud skin grant you good resistance to temperature conditions.  Also "
"your hands emit a small amount of electricity, increasing your damage in "
"melee."
msgstr ""

#. ~ Description of enchantment "storm skin"
#: data/mods/Xedra_Evolved/spells/integrated_armor_spells.json
msgid ""
"Your storm skin grant you good resistance to temperature conditions.  Also "
"your hands emit a moderate amount of electricity, increasing your damage in "
"melee."
msgstr ""

#. ~ Name of spell "firmament_driver"
#: data/mods/Xedra_Evolved/spells/inventor_spells.json
msgid "Firmament-Driver"
msgstr ""

#. ~ Description of spell "firmament_driver ( Firmament-Driver )"
#: data/mods/Xedra_Evolved/spells/inventor_spells.json
msgid ""
"Push the target.  It's not really effective, but sometimes comes in handy."
msgstr ""

#. ~ Name of spell "cable_whip"
