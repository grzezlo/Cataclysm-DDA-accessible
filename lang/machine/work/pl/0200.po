msgstr ""

#. ~ NPC message in nested effect in then statement in nested effect in else
#. statement in nested effect in else statement in nested effect in else
#. statement in nested effect in else statement in false effect in EoC
#. "EOC_LILIN_RUACH_DRAIN_REAL"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid ""
"You feel a brief tingle as you absorb the animal's ruach.  Weak, but better "
"than nothing."
msgstr ""

#. ~ NPC message in nested effect in then statement in nested effect in else
#. statement in nested effect in else statement in nested effect in else
#. statement in nested effect in else statement in nested effect in else
#. statement in false effect in EoC "EOC_LILIN_RUACH_DRAIN_REAL"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid ""
"You feel a slight prickling as you absorb the insect's ruach.  Barely worth "
"bothering with."
msgstr ""

#. ~ NPC message in nested effect in else statement in nested effect in else
#. statement in nested effect in else statement in nested effect in else
#. statement in nested effect in else statement in nested effect in else
#. statement in false effect in EoC "EOC_LILIN_RUACH_DRAIN_REAL"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
