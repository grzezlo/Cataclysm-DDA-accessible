msgstr ""

#. ~ Player message in nested effect in then statement in nested effect in else
#. statement in nested effect in else statement in false effect in EoC
#. "EOC_LILIN_INSTANT_HEAL"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
