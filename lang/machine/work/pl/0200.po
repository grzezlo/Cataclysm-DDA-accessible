"You try to absorb the <u_name>'s ruach but get only fragments.  Not enough to"
" for a mouthful."
msgstr ""

#. ~ NPC message in effect in EoC "EOC_LILIN_EVIL_EYE"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid ""
"You glare balefully at <u_name> and project all of your malice into your "
"gaze."
msgstr ""

#. ~ NPC message in false effect in EoC "EOC_LILIN_EVIL_EYE"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You don't have enough ruach for your malice to affect your target."
msgstr ""

#. ~ NPC message in effect in EoC "EOC_LILIN_BLINDING_TARGET_2" in nested EOCs
#. in effect in EoC "EOC_LILIN_BLINDING_TARGET"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
