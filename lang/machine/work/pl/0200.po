msgstr ""

#. ~ NPC message in effect in EoC "EOC_LILIN_DISEASE_ENHANCEMENT_DAMAGE"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You infuse your ruach into the plague-infected <u_name>."
msgstr ""

#. ~ NPC message in false effect in EoC "EOC_LILIN_DISEASE_ENHANCEMENT_DAMAGE"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You don't have enough ruach to enhance the miasma around <u_name>!"
msgstr ""

#. ~ Player message in effect in EoC "EOC_LILIN_AVOID_SLEEP"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "As a cool breeze touches your skin, you feel much more awake."
