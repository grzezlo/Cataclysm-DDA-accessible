"Your target's protective charm means the beguilement fails to take effect!"
msgstr ""

#. ~ Player message in false effect in EoC "EOC_LILIN_AOE_DAZE"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You don't have enough ruach to let out the night-cry!"
msgstr ""

#. ~ NPC message in nested effect in then statement in effect in EoC
#. "EOC_LILIN_AOE_LINE_DISEASE"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You summon a wind filled with pestilence."
msgstr ""

#. ~ NPC message in nested effect in else statement in effect in EoC
#. "EOC_LILIN_AOE_LINE_DISEASE"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
