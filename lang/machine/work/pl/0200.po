#. ~ NPC message in nested effect in then statement in nested effect in then
#. statement in nested effect in else statement in nested effect in else
#. statement in false effect in EoC "EOC_LILIN_RUACH_DRAIN_REAL"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
