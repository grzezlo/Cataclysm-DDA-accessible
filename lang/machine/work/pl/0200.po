msgid "Electric Brandish"
msgstr ""

#. ~ Description of spell "cable_whip ( Electric Brandish )"
#: data/mods/Xedra_Evolved/spells/inventor_spells.json
msgid "A small whip attack that uses energized cables as a conductor."
msgstr ""

#. ~ Message of spell "nine_second_time_stop ( Nine more seconds )"
#. ~ Message of spell "xedra_dreamsmith_time_stop ( Pocketwatch stop )"
#: data/mods/Xedra_Evolved/spells/item_spells.json
msgid "Time suddenly stops for everything but you."
msgstr ""

#. ~ Message of spell "cosmic_dagwood_regeneration ( rejuvenation )"
#: data/mods/Xedra_Evolved/spells/item_spells.json
msgid ""
"The sandwich is a flavor beyond time and space, and as you lick your fingers "
"clean you feel your youth return to you - Wait, no, Your wounds are just "
"healing."
msgstr ""

#. ~ Message of spell "netherium_warp_grenade_detonation ( Netherium Warp
#. Detonation )"
#: data/mods/Xedra_Evolved/spells/item_spells.json
msgid ""
"The location the grenade occupied is instantly overwhelmed with sounds and "
"colors you've never felt before as space warps in impossible ways.  Whatever "
"used to be there is now gone."
msgstr ""

#. ~ Message of spell "inventor_portal_closer_spell ( Netherium-Reality Smooth
#. )"
#: data/mods/Xedra_Evolved/spells/item_spells.json
msgid ""
"The two halves of the smoother surge together, forcing the teleporters "
"together with a massive clang!  Due to your precise engineering the "
"teleporters activate at the exact moment of impact, temporarily shunting them"
" into the nether and unleashing a massive cascade of netherium energy that "
"ripples around you."
msgstr ""

#. ~ Name of spell "xedra_inventor_time_pierce"
#: data/mods/Xedra_Evolved/spells/item_spells.json
msgid "Inventor Time Pierce"
msgstr ""

#. ~ Description of spell "xedra_inventor_time_pierce ( Inventor Time Pierce )"
#: data/mods/Xedra_Evolved/spells/item_spells.json
msgid ""
"Used by a time piercer to fix frozen time areas.  Having this spell is a bug."
msgstr ""

#. ~ Name of spell "xedra_inventor_time_pierce_creature"
#: data/mods/Xedra_Evolved/spells/item_spells.json
msgid "Inventor Time Pierce - Creature"
msgstr ""

#. ~ Description of spell "xedra_inventor_time_pierce_creature ( Inventor Time
#. Pierce - Creature )"
#: data/mods/Xedra_Evolved/spells/item_spells.json
msgid ""
"Used by a time piercer to fix time frozen creatures.  Having this spell is a "
"bug."
msgstr ""

#. ~ Description of spell "xedra_dreamsmith_time_trap_freeze ( Time Freeze )"
#: data/mods/Xedra_Evolved/spells/item_spells.json
msgid "Freezes the target in time.  Having this spell is a bug."
msgstr ""

#. ~ Name of spell "xedra_dreamsmith_time_trap_freeze_spawn_trap"
#: data/mods/Xedra_Evolved/spells/item_spells.json
msgid "Time Freeze - Spawn Trap"
msgstr ""

#. ~ Description of spell "xedra_dreamsmith_time_trap_freeze_spawn_trap ( Time
#. Freeze - Spawn Trap )"
#: data/mods/Xedra_Evolved/spells/item_spells.json
msgid "Spawns the trap after it is used.  Having this spell is a bug."
msgstr ""

#. ~ Name of spell "goblin_fruit_blind_flash"
#: data/mods/Xedra_Evolved/spells/item_spells.json
msgid "Flash fruit"
msgstr ""

#. ~ Message of spell "goblin_fruit_heat_blasts ( Fruit blast )"
#: data/mods/Xedra_Evolved/spells/item_spells.json
msgid ""
"Fiery needles emerge from your body and surge towards anything vaguely "
"hostile."
msgstr ""

#. ~ NPC message in false effect in EoC "EOC_LILIN_RUACH_DRAIN"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You cannot absorb ruach in this form."
