#. ~ Player message in false effect in EoC "EOC_LILIN_AVOID_SLEEP"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You don't have enough ruach to spare any to alleviate your tiredness."
msgstr ""

#. ~ Player message in false effect in EoC
#. "EOC_LILIN_CHANGE_WEATHER_DENSE_FOG_2" in nested EOCs in effect in EoC
#. "EOC_LILIN_CHANGE_WEATHER_DENSE_FOG"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You don't have enough ruach to call a fog."
msgstr ""

#. ~ Player message in effect in EoC "EOC_LILIN_SPEED_BOOST"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "The world around you slows down immensely."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_LILIN_SPEED_BOOST"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You don't have enough ruach to reap the whirlwind."
