#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "Your wounded flesh knits together in moments."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_LILIN_INSTANT_HEAL_2" in nested
#. EOCs in effect in EoC "EOC_LILIN_INSTANT_HEAL"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You don't have enough ruach to heal yourself!"
msgstr ""

#. ~ Player message in nested effect in then statement in false effect in EoC
#. "EOC_LILIN_INSTANT_HEAL"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "You cannot heal yourself during the new moon!"
msgstr ""

#. ~ Player message in nested effect in then statement in nested effect in else
#. statement in false effect in EoC "EOC_LILIN_INSTANT_HEAL"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
