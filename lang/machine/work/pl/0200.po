#. ~ Player message in nested effect in else statement in nested effect in else
#. statement in nested effect in else statement in false effect in EoC
#. "EOC_LILIN_INSTANT_HEAL"
#: data/mods/Xedra_Evolved/spells/lilin_spell_eocs.json
msgid "[Debug] For some unknown reason you cannot heal yourself."
msgstr ""

#. ~ Name of spell "lilin_drain_ruach_melee_spell"
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
msgid "Essence Drain"
msgstr ""

#. ~ Description of spell "lilin_drain_ruach_melee_spell ( Essence Drain )"
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
msgid ""
"Touch your victim and drain away a part of their ruach to fuel you.  It only "
"works on living creatures, and animals provide barely any ruach compared to "
"humans."
msgstr ""

#. ~ Description of spell "lilin_drain_ruach_short_ranged_spell ( Ruach Drinker
#. )"
#. ~ Description of spell "lilin_drain_ruach_long_ranged_spell ( Ruach Drinker
#. )"
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
msgid ""
"Drain the ruach from a target at range.  It only works on living creatures, "
"and animals provide barely any ruach compared to humans."
msgstr ""

#. ~ Description of spell "lilin_evil_eye_spell ( The Evil Eye )"
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
msgid "Curse a single nearby target with misfortune."
msgstr ""

#. ~ Name of spell "lilin_aoe_daze_spell"
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
msgid "Cry of the Night-bird"
msgstr ""

#. ~ Description of spell "lilin_aoe_daze_spell ( Cry of the Night-bird )"
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
msgid ""
"Let out a piercing cry, disorienting all nearby enemies and allies.  Of "
"necessity, this is a very loud course of action."
msgstr ""

#. ~ Description of spell "lilin_blinding_target_spell ( Dwelling in Deep
#. Darkness )"
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
msgid ""
"Cut a single target off from the light.  It works only at night, and only "
"either indoors or outside away from the cities."
msgstr ""

#. ~ Description of spell "lilin_mesmerize_target_spell ( Senseless and Without
#. Knowledge )"
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
msgid ""
"Beguile a single human, fey, or avian target, causing them to stand in a "
"stupor or wander aimlessly.  Any damage taken will break the effect."
msgstr ""
