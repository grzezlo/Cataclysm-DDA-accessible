msgstr[1] "miecze dwuręczne z utwardzonej stali"
msgstr[2] "mieczy dwuręcznych z utwardzonej stali"
msgstr[3] "miecza dwuręcznego z utwardzonej stali"

#. ~ Description of "hardened steel zweihänder"
#: data/json/items/melee/swords_and_blades.json
