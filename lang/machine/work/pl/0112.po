#. ~ Response to NPC dialogue
#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_anchor_seller.json
msgid "Offer to buy the anchor for 1 HGC."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_anchor_seller.json
msgid "Well, what's that thing for anyways?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_anchor_seller.json
