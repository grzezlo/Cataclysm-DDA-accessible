msgstr ""

#. ~ Description of terrain "Security: black zone card reader"
#: data/json/furniture_and_terrain/terrain-mechanisms.json
msgid ""
"A smartcard reader.  It sports the stylized symbol of an atom and a rifle on "
"a black background.  You could swipe a security employee badge near it to "
"unlock the gates."
msgstr ""

#. ~ Terrain name
#: data/json/furniture_and_terrain/terrain-mechanisms.json
