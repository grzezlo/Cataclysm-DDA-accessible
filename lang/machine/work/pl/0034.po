msgstr[1] "tabletki antyhistaminowe"
msgstr[2] "tabletek antyhistaminowych"
msgstr[3] "tabletki antyhistaminowej"

#. ~ Description of "antihistamine pill"
#: data/json/items/comestibles/med.json
msgid ""
"Over-the-counter allergy medication.  These are meant to be taken once a day "
"and can cause drowsiness."
msgstr ""
"Lek przeciwalergiczny dostępny bez recepty. Należy go przyjmować raz "
"dziennie; może powodować senność."

#. ~ "activation_message" action message of item "antihistamine pill"
#: data/json/items/comestibles/med.json
msgid "You take an antihistamine pill."
msgstr "Zażywasz tabletkę antyhistaminową."

