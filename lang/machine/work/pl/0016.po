#. ~ Description of "tabi (pair)"
#: data/json/items/armor/boots.json
msgid ""
"A pair of split toe black tabi socks.  Usually worn as a part of traditional "
"Japanese clothing.  The big toe is separated from the others by the fabric to"
" be comfortably worn with thonged footwear."
msgstr ""
"Para czarnych skarpet tabi z oddzielonym dużym palcem. Zwykle noszone jako "
"część tradycyjnego japońskiego stroju. Duży palec jest oddzielony od "
"pozostałych materiałem, aby wygodnie nosić je z obuwiem z rzemykiem między "
"palcami."

#. ~ Item name
#: data/json/items/armor/boots.json
msgid "gi tabi (pair)"
msgid_plural "gi tabi (pair)"
msgstr[0] "para gi tabi"
msgstr[1] "pary gi tabi"
msgstr[2] "par gi tabi"
msgstr[3] "pary gi tabi"

#. ~ Description of "gi tabi (pair)"
#: data/json/items/armor/boots.json
msgid ""
"A pair of split toe white tabi socks, as used by martial arts practitioners."
"  Usually worn as a part of traditional Japanese clothing.  The big toe is "
"separated from the others by the fabric to be comfortably worn with thonged "
"footwear."
msgstr ""
"Para białych skarpet tabi z oddzielonym dużym palcem, używanych przez adeptów"
" sztuk walki. Zwykle noszone jako część tradycyjnego japońskiego stroju. Duży"
" palec jest oddzielony od pozostałych materiałem, aby wygodnie nosić je z "
"obuwiem z rzemykiem między palcami."

