msgstr[2] "słabych tarcz energetycznych"
msgstr[3] "słabej tarczy energetycznej"

#. ~ Description of "weak energy shield"
#: data/json/items/armor/cloaks.json
msgid "A weak energy shield that protects against ballistic damage."
msgstr "Słaba tarcza energetyczna chroniąca przed obrażeniami balistycznymi."

#. ~ Item name
#. ~ Variant name of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid "pride flag"
msgid_plural "pride flags"
msgstr[0] "tęczowa flaga"
msgstr[1] "tęczowe flagi"
msgstr[2] "tęczowych flag"
msgstr[3] "tęczowej flagi"

#. ~ Description of "pride flag"
#. ~ Description of variant "pride flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A large rainbow flag, The colors reflect the diversity of the LGBT community "
"and the spectrum of human sexuality and gender."
msgstr ""
"Duża tęczowa flaga. Kolory odzwierciedlają różnorodność społeczności LGBT "
"oraz spektrum ludzkiej seksualności i płci."

#. ~ Variant name of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid "progress pride flag"
msgid_plural "progress pride flags"
msgstr[0] "flaga Progress Pride"
msgstr[1] "flagi Progress Pride"
msgstr[2] "flag Progress Pride"
msgstr[3] "flagi Progress Pride"

#. ~ Description of variant "progress pride flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A large rainbow flag, The colors reflect the diversity of the LGBT community "
"and the spectrum of human sexuality and gender.  On the left side you can see"
" a chevron that features black, brown, light blue, pink, and white stripes to"
" bring those communities to the forefront; \"the arrow points to the right to"
" show forward movement, while being along the left edge shows that progress "
"still needs to be made\"."
msgstr ""
"Duża tęczowa flaga. Kolory odzwierciedlają różnorodność społeczności LGBT "
"oraz spektrum ludzkiej seksualności i płci. Po lewej stronie widać szewron z "
"czarnym, brązowym, jasnoniebieskim, różowym i białym pasem, który wysuwa te "
"społeczności na pierwszy plan; „strzałka wskazuje w prawo, pokazując ruch "
"naprzód, a jej położenie przy lewej krawędzi pokazuje, że wciąż potrzeba "
"postępu”."

#. ~ Variant name of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid "agender flag"
msgid_plural "agender flags"
msgstr[0] "flaga agender"
msgstr[1] "flagi agender"
msgstr[2] "flag agender"
msgstr[3] "flagi agender"

#. ~ Description of variant "agender flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A large green gray and black agender flag.  The black and white stripes "
"represent complete absence of gender, gray represents being semi-genderless, "
"and green represents non-binary gender."
msgstr ""
"Duża zielono-szaro-czarna flaga agender. Czarne i białe pasy oznaczają "
"całkowity brak płci, szary oznacza bycie częściowo bezpłciowym, a zielony "
"płeć niebinarną."

#. ~ Variant name of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid "bisexual flag"
msgid_plural "bisexual flags"
msgstr[0] "biseksualna flaga"
msgstr[1] "biseksualne flagi"
msgstr[2] "biseksualnych flag"
msgstr[3] "biseksualnej flagi"

#. ~ Description of variant "bisexual flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A large pink and blue bisexual flag.  The pink stripe represents "
"homosexuality, while the blue stripe represents heterosexuality.  The purple "
"stripe, the \"overlap\" of the blue and pink stripes, purple represents "
"attraction regardless of sex or gender a.k.a bisexuality."
msgstr ""
"Duża różowo-niebieska flaga biseksualna. Różowy pas oznacza homoseksualność, "
"a niebieski heteroseksualność. Fioletowy pas, „nakładanie się” niebieskiego i"
" różowego, oznacza pociąg niezależny od płci, czyli biseksualność."

#. ~ Variant name of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid "pansexual flag"
msgid_plural "pansexual flags"
msgstr[0] "panseksualna flaga"
msgstr[1] "panseksualne flagi"
msgstr[2] "panseksualnych flag"
msgstr[3] "panseksualnej flagi"

#. ~ Description of variant "pansexual flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A large pink, blue and yellow pansexual flag.  The pan-pride flag uses pink "
"for people on the female-spectrum, blue for people on the male-spectrum, and "
"yellow for non-binary or genderqueer people."
msgstr ""
"Duża różowo-niebiesko-żółta flaga panseksualna. Flaga dumy panseksualnej "
"używa różowego dla osób z kobiecej części spektrum, niebieskiego dla osób z "
"męskiej części spektrum, a żółtego dla osób niebinarnych lub genderqueer."

#. ~ Variant name of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid "labrys lesbian flag"
msgid_plural "labrys lesbian flags"
msgstr[0] "lesbijska flaga z labrysem"
msgstr[1] "lesbijskie flagi z labrysem"
msgstr[2] "lesbijskich flag z labrysem"
msgstr[3] "lesbijskiej flagi z labrysem"

#. ~ Description of variant "labrys lesbian flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A large black and purple labrys lesbian flag.  On the flag you can see a "
"labrys, a type of double-headed axe, superimposed on a downward-pointing "
"black triangle, set against a violet background."
msgstr ""
"Duża czarno-fioletowa lesbijska flaga z labrysem. Na fiołkowym tle widać "
"labrys, rodzaj obosiecznego topora, nałożony na czarny trójkąt skierowany "
"wierzchołkiem w dół."

#. ~ Variant name of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid "lesbian flag"
msgid_plural "lesbian flags"
msgstr[0] "lesbijska flaga"
msgstr[1] "lesbijskie flagi"
msgstr[2] "lesbijskich flag"
msgstr[3] "lesbijskiej flagi"

#. ~ Description of variant "lesbian flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A large pink, white and orange lesbian flag.  The dark orange representing "
"\"gender non-conformity\", orange for \"independence\", light orange for "
"\"community\", white for \"unique relationships to womanhood\", pink for "
"\"serenity and peace\", dusty pink for \"love and sex\", and dark rose for "
"\"femininity\"."
msgstr ""
"Duża różowo-biało-pomarańczowa flaga lesbijska. Ciemnopomarańczowy oznacza "
"„niezgodność z normami płciowymi”, pomarańczowy „niezależność”, "
"jasnopomarańczowy „wspólnotę”, biały „wyjątkowe relacje z kobiecością”, "
"różowy „spokój i pokój”, przygaszony róż „miłość i seks”, a ciemna róża "
"„kobiecość”."

#. ~ Variant name of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid "asexual flag"
msgid_plural "asexual flags"
msgstr[0] "aseksualna flaga"
msgstr[1] "aseksualne flagi"
msgstr[2] "aseksualnych flag"
msgstr[3] "aseksualnej flagi"

#. ~ Description of variant "asexual flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A large purple, white, gray and black asexual flag.  Black for asexuality "
"(feeling no sexual attraction), gray for gray-asexuality and demisexuality "
"(feeling sexual attraction only sometimes), white for non-asexual partners "
"and allies, and purple for community."
msgstr ""
"Duża fioletowo-biało-szaro-czarna flaga aseksualna. Czarny oznacza "
"aseksualność (brak pociągu seksualnego), szary szaroseksualność i "
"demiseksualność (odczuwanie pociągu seksualnego tylko czasami), biały "
"nieaseksualnych partnerów i sojuszników, a fioletowy wspólnotę."

#. ~ Variant name of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid "aromantic flag"
msgid_plural "aromantic flags"
msgstr[0] "aromantyczna flaga"
msgstr[1] "aromantyczne flagi"
msgstr[2] "aromantycznych flag"
msgstr[3] "aromantycznej flagi"

#. ~ Description of variant "aromantic flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A large black, gray, white and green aromantic flag.  The green and light "
"green stripes cover everyone under the aromantic spectrum, while represents "
"nonromantic forms of love and attraction, and the gray and black represent "
"all sexualities under the aromantic spectrum."
msgstr ""
"Duża czarno-szaro-biało-zielona flaga aromantyczna. Zielony i jasnozielony "
"pas obejmują wszystkich ze spektrum aromantycznego, biały oznacza "
"nieromantyczne formy miłości i pociągu, a szary i czarny wszystkie "
"seksualności w spektrum aromantycznym."

#. ~ Variant name of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid "transgender flag"
msgid_plural "transgender flags"
msgstr[0] "transpłciowa flaga"
msgstr[1] "transpłciowe flagi"
msgstr[2] "transpłciowych flag"
msgstr[3] "transpłciowej flagi"

#. ~ Description of variant "transgender flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A large white, pink, and blue transgender flag.  The stripes at the top and "
"bottom are light blue, the traditional color for baby boys.  The stripes next"
" to them are pink, the traditional color for baby girls.  The white stripe is"
" for people that are nonbinary, feel that they don't have a gender.  The "
"pattern is such that no matter which way you fly it, it is always correct, "
"signifying finding correctness in one's life."
msgstr ""
"Duża biało-różowo-niebieska flaga transpłciowa. Pasy na górze i na dole są "
"jasnoniebieskie, w tradycyjnym kolorze chłopców. Pasy obok nich są różowe, w "
"tradycyjnym kolorze dziewczynek. Biały pas jest dla osób niebinarnych, które "
"czują, że nie mają płci. Wzór jest taki, że niezależnie od tego, jak się ją "
"zawiesi, zawsze jest poprawna, co symbolizuje odnajdywanie poprawności we "
"własnym życiu."

#. ~ Variant name of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid "genderqueer flag"
msgid_plural "genderqueer flags"
msgstr[0] "flaga genderqueer"
msgstr[1] "flagi genderqueer"
msgstr[2] "flag genderqueer"
msgstr[3] "flagi genderqueer"

#. ~ Description of variant "genderqueer flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A large green, white, and purple genderqueer flag.  Lavender, a mixture of "
"blue and pink to represent androgynes and androgyny, white to represent "
"agender identity, and green, the inverse of lavender, to represent all those "
"who fall outside of the gender binary."
msgstr ""
"Duża zielono-biało-fioletowa flaga genderqueer. Lawendowy, mieszanka "
"niebieskiego i różowego, oznacza androgyniczne osoby i androgynię, biały "
"tożsamość agender, a zielony, odwrotność lawendowego, wszystkich, którzy "
"znajdują się poza binarnym podziałem płci."

#. ~ Variant name of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid "intersex flag"
msgid_plural "intersex flags"
msgstr[0] "interpłciowa flaga"
msgstr[1] "interpłciowe flagi"
msgstr[2] "interpłciowych flag"
msgstr[3] "interpłciowej flagi"

#. ~ Description of variant "intersex flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A large yellow, and purple intersex flag.  It displays a purple circle on a "
"yellow field.  Yellow and purple were chosen as colors as they were viewed as"
" free from gender associations and were historically used to represent "
"intersex people.  The circle is described as \"unbroken and unornamented, "
"symbolizing wholeness and completeness, and our potentialities\"."
msgstr ""
"Duża żółto-fioletowa flaga interpłciowa. Przedstawia fioletowy okrąg na "
"żółtym polu. Żółty i fioletowy wybrano, ponieważ uważano je za wolne od "
"skojarzeń z płcią i historycznie używano ich do reprezentowania osób "
"interpłciowych. Okrąg opisuje się jako „nieprzerwany i pozbawiony ozdób, "
"symbolizujący całość i kompletność oraz nasze możliwości”."

#. ~ Variant name of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid "genderfluid flag"
msgid_plural "genderfluid flags"
msgstr[0] "flaga genderfluid"
msgstr[1] "flagi genderfluid"
msgstr[2] "flag genderfluid"
msgstr[3] "flagi genderfluid"

#. ~ Description of variant "genderfluid flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A large blue, black, purple, white and pink genderfluid flag.  The "
"genderfluid flag has a pink stripe for femininity, a blue stripe for "
"masculinity, a purple stripe for both masculinity and femininity, a black "
"stripe for lack of gender, and a white stripe for all genders."
msgstr ""
"Duża niebiesko-czarno-fioletowo-biało-różowa flaga genderfluid. Ma różowy pas"
" oznaczający kobiecość, niebieski męskość, fioletowy zarówno męskość, jak i "
"kobiecość, czarny brak płci, a biały wszystkie płcie."

#. ~ Description of variant "agender flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A large green, white, gray and black agender flag.  The black and white "
"stripes represent complete absence of gender, gray represents being semi-"
"genderless, and green represents non-binary gender.  The symmetry of the "
"pattern makes it so that it's correct no matter how it flies."
msgstr ""
"Duża zielono-biało-szaro-czarna flaga agender. Czarne i białe pasy oznaczają "
"całkowity brak płci, szary oznacza bycie częściowo bezpłciowym, a zielony "
"płeć niebinarną. Symetria wzoru sprawia, że jest poprawna niezależnie od "
"tego, jak powiewa."

#. ~ Variant name of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid "non-binary flag"
msgid_plural "non-binary flags"
msgstr[0] "niebinarna flaga"
msgstr[1] "niebinarne flagi"
msgstr[2] "niebinarnych flag"
msgstr[3] "niebinarnej flagi"

#. ~ Description of variant "non-binary flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A large black, purple, white, and yellow non-binary flag.  Yellow for those "
"whose gender exists outside of and without reference to the binary, white for"
" those who have many or all genders, purple for those who feel their gender "
"is between or a mix of female and male, and black for those who feel they are"
" without gender."
msgstr ""
"Duża czarno-fioletowo-biało-żółta flaga niebinarna. Żółty oznacza osoby, "
"których płeć istnieje poza binarnym podziałem i bez odniesienia do niego, "
"biały osoby mające wiele płci lub wszystkie, fioletowy osoby czujące, że ich "
"płeć jest pomiędzy żeńską a męską lub stanowi ich mieszankę, a czarny osoby "
"czujące, że nie mają płci."

#. ~ Variant name of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid "polysexual flag"
msgid_plural "polysexual flags"
msgstr[0] "poliseksualna flaga"
msgstr[1] "poliseksualne flagi"
msgstr[2] "poliseksualnych flag"
msgstr[3] "poliseksualnej flagi"

#. ~ Description of variant "polysexual flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A large blue, green, and pink polysexual flag.  Pink for people on the "
"female-spectrum, blue for people on the male-spectrum, and green for non-"
"binary or genderqueer people."
msgstr ""
"Duża niebiesko-zielono-różowa flaga poliseksualna. Różowy oznacza osoby z "
"kobiecej części spektrum, niebieski osoby z męskiej części spektrum, a "
"zielony osoby niebinarne lub genderqueer."

#. ~ Description of variant "leather flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A horizontally striped black and blue leather flag with a white band in the "
"middle and red heart in a corner.  The black represents leather; the blue "
"represents devotion, loyalty, and community; the white represents purity and "
"innocence; and the red heart represents love for the community."
msgstr ""
"Skórzana flaga w poziome czarne i niebieskie pasy z białym pasem pośrodku i "
"czerwonym sercem w rogu. Czarny oznacza skórę, niebieski oddanie, lojalność i"
" wspólnotę, biały czystość i niewinność, a czerwone serce miłość do "
"społeczności."

#. ~ Variant name of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid "bear flag"
msgid_plural "bear flags"
msgstr[0] "flaga niedźwiedzi"
msgstr[1] "flagi niedźwiedzi"
msgstr[2] "flag niedźwiedzi"
msgstr[3] "flagi niedźwiedzi"

#. ~ Description of variant "bear flag" of item "pride flag"
#: data/json/items/armor/cloaks.json data/mods/CrazyCataclysm/crazy_items.json
msgid ""
"A large black and orange international bear brotherhood flag.  The flag "
"displays seven horizontal stripes of colors ranging from black to brown "
"representing the colors of different bear species, you can see a black bear "
"paw in the upper right corner."
msgstr ""
"Duża czarno-pomarańczowa flaga międzynarodowego bractwa niedźwiedzi. Ma "
"siedem poziomych pasów w kolorach od czarnego do brązowego, odpowiadających "
"barwom różnych gatunków niedźwiedzi, a w prawym górnym rogu widać czarną "
"niedźwiedzią łapę."

#. ~ Description of "national flag"
#: data/json/items/armor/cloaks.json
msgid "A large flag, made to fly in even the worst conditions."
msgstr "Duża flaga stworzona, by powiewać nawet w najgorszych warunkach."

#. ~ Description of variant "Afghan flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It has three vertical boxes of black, red, and green placed behind the royal "
"seal of Afghanistan."
msgstr ""
"Ma trzy pionowe pola: czarne, czerwone i zielone, na które nałożono królewską"
" pieczęć Afganistanu."

#. ~ Description of variant "Albanian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "It's a solid red, overlaid with the crest of Albania."
msgstr "Jest jednolicie czerwona, z nałożonym herbem Albanii."

#. ~ Description of variant "Algerian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It's divided by green and white halves, overlaid with a crescent moon and a "
"star in red."
msgstr ""
"Jest podzielona na zieloną i białą połowę, na które nałożono czerwony "
"półksiężyc i gwiazdę."

#. ~ Description of variant "Andorran flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It has three vertical lines navy blue, yellow, and red, overlaid with the "
"crest of Andorra."
msgstr ""
"Ma trzy pionowe pasy: granatowy, żółty i czerwony, z nałożonym herbem Andory."

#. ~ Description of variant "Angolan flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It's divided by red and black rectangles, overlaid by a gold machete, star, "
"and half of a gear."
msgstr ""
"Jest podzielona na czerwony i czarny prostokąt, na które nałożono złotą "
"maczetę, gwiazdę i połowę koła zębatego."

#. ~ Description of variant "Argentinian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It has three horizontal lines of baby blue and white, with a gold star in the"
" middle."
msgstr ""
"Ma trzy poziome pasy w kolorze jasnoniebieskim i białym, ze złotą gwiazdą "
"pośrodku."

#. ~ Description of variant "Armenian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "It has three stripes of red, navy blue, and orange."
msgstr "Ma trzy pasy: czerwony, granatowy i pomarańczowy."

#. ~ Description of variant "Australian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It's solid navy blue, with various white stars.  In the top left corner is a "
"miniature Union Jack."
msgstr ""
"Jest jednolicie granatowa, z różnymi białymi gwiazdami. W lewym górnym rogu "
"znajduje się miniaturowy Union Jack."

#. ~ Description of variant "Austrian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "It has three stripes of red and white."
msgstr "Ma trzy pasy w kolorze czerwonym i białym."

#. ~ Description of variant "Azerbaijanian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It has three stripes of light blue, red, and green.  In the middle is a white"
" crescent moon and star."
msgstr ""
"Ma trzy pasy: jasnoniebieski, czerwony i zielony. Pośrodku znajduje się biały"
" półksiężyc i gwiazda."

#. ~ Description of variant "Antiguan flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It has a black V-shape surrounded by red.  The bottom of the V is blue, with "
"a rising sun immediately above."
msgstr ""
"Ma czarny kształt litery V otoczony czerwienią. Dół litery V jest niebieski, "
"a tuż nad nim wschodzi słońce."

#. ~ Description of variant "Bahamanian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It has three stripes of light blue and yellow, with a black triangle on the "
"far-left side."
msgstr ""
"Ma trzy pasy w kolorze jasnoniebieskim i żółtym, z czarnym trójkątem przy "
"lewej krawędzi."

#. ~ Description of variant "Bahrainian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "It has a red background with a series of white spikes on the left."
msgstr "Ma czerwone tło z rzędem białych zębów po lewej stronie."

#. ~ Description of variant "Bangladeshi flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "It's solid dark green, with a red circle in the middle."
msgstr "Jest jednolicie ciemnozielona, z czerwonym kołem pośrodku."

#. ~ Description of variant "Barbadian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It has three vertical lines of navy blue and yellow, with a black trident in "
"the center."
msgstr ""
"Ma trzy pionowe pasy w kolorze granatowym i żółtym, z czarnym trójzębem "
"pośrodku."

#. ~ Description of variant "Belarusian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "It has a red and green background, with a checker pattern on the left."
msgstr "Ma czerwono-zielone tło ze wzorem w kratkę po lewej stronie."

#. ~ Description of variant "Belgian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "It has three vertical stripes of black, yellow, and red."
msgstr "Ma trzy pionowe pasy: czarny, żółty i czerwony."

#. ~ Description of variant "Belizean flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It has two small stripes of red, separated by a square of blue, with the "
"emblem of Belize in the center."
msgstr ""
"Ma dwa wąskie czerwone pasy rozdzielone niebieskim kwadratem, z godłem Belize"
" pośrodku."

#. ~ Description of variant "Beninian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "It is divided into squares of yellow, red, and light green."
msgstr "Jest podzielona na pola w kolorze żółtym, czerwonym i jasnozielonym."

#. ~ Description of variant "Bhutanese flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It is divided into triangles of red and dark yellow, with a dragon in the "
"center."
msgstr ""
"Jest podzielona na czerwony i ciemnożółty trójkąt, ze smokiem pośrodku."

#. ~ Description of variant "Bolivian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It has three stripes of red, yellow, and green, with the crest of Bolivia in "
"the center."
msgstr "Ma trzy pasy: czerwony, żółty i zielony, z herbem Boliwii pośrodku."

#. ~ Description of variant "Bosnian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It has a yellow triangle over a navy blue background, with white stars "
"running along one side."
msgstr ""
"Ma żółty trójkąt na granatowym tle, a wzdłuż jednego z jego boków biegną "
"białe gwiazdy."

#. ~ Description of variant "Brazilian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It has a yellow diamond on a light green base.  In the center of the diamond "
"sits a blue orb with a curved, white line."
msgstr ""
"Ma żółty romb na jasnozielonym tle. W środku rombu znajduje się niebieska "
"kula z zakrzywioną białą wstęgą."

#. ~ Description of variant "Botswanian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "It has a black and white line running through a baby blue background."
msgstr "Ma czarno-biały pas biegnący przez jasnoniebieskie tło."

#. ~ Description of variant "Bruneian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It has a diagonal black-and-white line through a yellow background, with a "
"red lamp in the center."
msgstr "Ma ukośny czarno-biały pas na żółtym tle, z czerwoną lampą pośrodku."

#. ~ Description of variant "Bulgarian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "It has three stripes of white, green, and yellow."
msgstr "Ma trzy pasy: biały, zielony i żółty."

#. ~ Description of variant "Burkina Faso flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "It's divided into red and green, with a yellow star at the center."
msgstr "Jest podzielona na czerwień i zieleń, z żółtą gwiazdą pośrodku."

#. ~ Description of variant "Burundian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It is divided into red and green triangles, with three stars at the center."
msgstr ""
"Jest podzielona na czerwone i zielone trójkąty, z trzema gwiazdami pośrodku."

#. ~ Description of variant "Ivory Coast flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "It has three vertical beige, white, and green stripes."
msgstr "Ma trzy pionowe pasy: beżowy, biały i zielony."

#. ~ Description of variant "Cabo Verde flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It has a thin red line in the center, surrounded by white and blue.  To the "
"left lies an oval of gold stars."
msgstr ""
"Ma pośrodku cienki czerwony pas otoczony bielą i błękitem. Po lewej stronie "
"znajduje się owal ze złotych gwiazd."

#. ~ Description of variant "Cambodian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It has three horizontal lines on navy blue and red, with a palace at the "
"center."
msgstr ""
"Ma trzy poziome pasy w kolorze granatowym i czerwonym, z pałacem pośrodku."

#. ~ Variant name of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "Cameroon flag"
msgid_plural "Cameroon flags"
msgstr[0] "flaga Kamerunu"
msgstr[1] "flagi Kamerunu"
msgstr[2] "flag Kamerunu"
msgstr[3] "flagi Kamerunu"

#. ~ Description of variant "Cameroon flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It's divided into three green, red, and yellow stripes, with a golden star in"
" the center."
msgstr ""
"Jest podzielona na trzy pasy: zielony, czerwony i żółty, ze złotą gwiazdą "
"pośrodku."

#. ~ Description of variant "Canadian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "It has three red and white stripes, with the iconic maple leaf in red."
msgstr ""
"Ma trzy czerwone i białe pasy, z charakterystycznym czerwonym liściem klonu."

#. ~ Description of variant "Chad flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "It has three stripes of navy blue, yellow, and red."
msgstr "Ma trzy pasy: granatowy, żółty i czerwony."

#. ~ Description of variant "Chilean flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It has a red and white backing, with a white star on blue in the upper left "
"corner."
msgstr ""
"Ma czerwono-białe tło, z białą gwiazdą na niebieskim polu w lewym górnym "
"rogu."

#. ~ Description of variant "Chinese flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "It has a solid red back, with five yellow stars in the top left."
msgstr ""
"Ma jednolicie czerwone tło, z pięcioma żółtymi gwiazdami w lewym górnym rogu."

#. ~ Description of variant "Colombian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "It has a yellow, navy blue, and red stripe running horizontally."
msgstr "Ma poziome pasy: żółty, granatowy i czerwony."

#. ~ Description of variant "Comoros flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"Four horizontal stripes of yellow, white, red, and blue serve as a backdrop "
"for a sideways green triangle on the far left, with a white crescent moon and"
" four stars in the center."
msgstr ""
"Cztery poziome pasy, żółty, biały, czerwony i niebieski, stanowią tło dla "
"zielonego trójkąta skierowanego w bok przy lewej krawędzi, z białym "
"półksiężycem i czterema gwiazdami pośrodku."

#. ~ Description of variant "Congo flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It has a diagonal tricolor of green, yellow and red radiating from the lower "
"hoist side corner."
msgstr ""
"Ma ukośny trójkolorowy podział na zieleń, żółć i czerwień, rozchodzący się od"
" dolnego rogu przy drzewcu."

#. ~ Description of variant "Costa Rican flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"Five horizontal stripes of white, blue, and red run across it, with the coat "
"of arms lying off-center."
msgstr ""
"Biegnie przez nią pięć poziomych pasów w kolorach białym, niebieskim i "
"czerwonym, a herb umieszczono poza środkiem."

#. ~ Description of variant "Croatian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag of three horizontal stripes of red, white, and blue and a checkered "
"red and white coat of arms shield, above which stands a crown of a dark and "
"light blue pattern."
msgstr ""
"Flaga z trzema poziomymi pasami: czerwonym, białym i niebieskim, oraz tarczą "
"herbową w czerwono-białą szachownicę, nad którą znajduje się korona o ciemno-"
" i jasnoniebieskim wzorze."

#. ~ Description of variant "Cuban flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"Blue and white stripes run horizontally across the flag, a red triangle forms"
" over the left side with a white star in its center."
msgstr ""
"Przez flagę biegną poziome pasy niebieskie i białe, a po lewej stronie "
"znajduje się czerwony trójkąt z białą gwiazdą pośrodku."

#. ~ Description of variant "Cypriot flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A white flag with a yellow emblem of the island stands in the center, two "
"green olive branches stand below it."
msgstr ""
"Biała flaga, pośrodku której znajduje się żółty zarys wyspy, a pod nim dwie "
"zielone gałązki oliwne."

#. ~ Description of variant "Central African flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag with horizontal stripes of blue, white, green and yellow coloration "
"and one vertical red stripe down the middle with a star in the upper left "
"corner."
msgstr ""
"Flaga z poziomymi pasami w kolorach niebieskim, białym, zielonym i żółtym "
"oraz jednym pionowym czerwonym pasem przez środek, z gwiazdą w lewym górnym "
"rogu."

#. ~ Description of variant "Czech flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag with a blue triangle at the hoist and a horizontal white and red color"
" on it."
msgstr ""
"Flaga z niebieskim trójkątem przy drzewcu oraz poziomymi pasami białym i "
"czerwonym."

#. ~ Description of variant "Democratic Republic Congo flag" of item "national
#. flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A sky blue flag with a yellow star in the upper left canton, diagonally "
"running across the flag is a red strip and yellow fimbriation."
msgstr ""
"Błękitna flaga z żółtą gwiazdą w lewym górnym rogu; przez całą flagę ukośnie "
"biegnie czerwony pas z żółtym obramowaniem."

#. ~ Description of variant "Danish flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "A flag of a red field with a white Nordic cross over it."
msgstr "Flaga z czerwonym polem, na które nałożono biały krzyż skandynawski."

#. ~ Description of variant "Djiboutian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that has a white triangle in the left portion with light blue and "
"green color running horizontally."
msgstr ""
"Flaga z białym trójkątem w lewej części oraz poziomymi pasami jasnoniebieskim"
" i zielonym."

#. ~ Description of variant "Dominica flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A green flag with a running tricolor cross of yellow, black, and white, in "
"the center stands a red circle with a parrot in the middle surrounded by "
"green stars."
msgstr ""
"Zielona flaga z trójbarwnym krzyżem w kolorach żółtym, czarnym i białym, "
"pośrodku której znajduje się czerwone koło z papugą otoczoną zielonymi "
"gwiazdami."

#. ~ Description of variant "Dominican flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag with a white cross and a coat of arms in the center with a pattern of "
"blue and red on the outside of the cross."
msgstr ""
"Flaga z białym krzyżem i herbem pośrodku, z niebieskimi i czerwonymi polami "
"na zewnątrz krzyża."

#. ~ Description of variant "Ecuadorian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A horizontal tricolor flag of yellow, blue, and red with its coat of arms in "
"the center."
msgstr ""
"Pozioma trójkolorowa flaga w kolorach żółtym, niebieskim i czerwonym, z "
"herbem pośrodku."

#. ~ Description of variant "Egyptian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A horizontal tricolor flag of red, white, and black with a yellow eagle in "
"the center."
msgstr ""
"Pozioma trójkolorowa flaga w kolorach czerwonym, białym i czarnym, z żółtym "
"orłem pośrodku."

#. ~ Description of variant "Salvadoran flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It is a horizontal pattern flag of blue, white, and blue with a coat of arms "
"in the center."
msgstr "Flaga w poziome pasy: niebieski, biały i niebieski, z herbem pośrodku."

#. ~ Description of variant "Equatorial Guinean flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A horizontal tricolor flag, with green, white and red stripes and a blue "
"triangle at the hoist with a coat of arms in the center."
msgstr ""
"Pozioma trójkolorowa flaga z pasami zielonym, białym i czerwonym oraz "
"niebieskim trójkątem przy drzewcu, z herbem pośrodku."

#. ~ Description of variant "Eritrean flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A tricolor flag of green, red, and blue with a golden wreath surrounding an "
"olive branch near the hoist."
msgstr ""
"Trójkolorowa flaga w kolorach zielonym, czerwonym i niebieskim, ze złotym "
"wieńcem otaczającym gałązkę oliwną w pobliżu drzewca."

#. ~ Description of variant "Estonian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "A horizontal tricolor flag of blue, black, and white."
msgstr "Pozioma trójkolorowa flaga w kolorach niebieskim, czarnym i białym."

#. ~ Description of variant "Swazi flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A triband flag of blue with a yellow outline and red in the middle, in the "
"center is a Nguni shield and two spears."
msgstr ""
"Flaga w trzy pasy: niebieskie z żółtym obramowaniem i czerwony pośrodku, na "
"którym znajduje się tarcza Nguni i dwie włócznie."

#. ~ Description of variant "Ethiopia flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A horizontally running tricolor flag of green, yellow, and red, in the center"
" is a blue circle and a yellow star."
msgstr ""
"Trójkolorowa flaga w poziome pasy: zielony, żółty i czerwony, pośrodku której"
" znajduje się niebieskie koło z żółtą gwiazdą."

#. ~ Description of variant "Fijian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A sky blue flag with a Union Jack in the hoist and a shield centered in the "
"outer half of it with the cross of Saint George within it."
msgstr ""
"Błękitna flaga z Union Jackiem przy drzewcu i tarczą umieszczoną pośrodku jej"
" zewnętrznej połowy, z krzyżem świętego Jerzego."

#. ~ Description of variant "Finnish flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "A white flag with a blue Nordic cross over it."
msgstr "Biała flaga z nałożonym niebieskim krzyżem skandynawskim."

#. ~ Description of variant "French flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "A tricolor flag of blue, white, and red."
msgstr "Trójkolorowa flaga w kolorach niebieskim, białym i czerwonym."

#. ~ Description of variant "Gabonese flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "A horizontal tricolor flag of green, yellow, and blue."
msgstr "Pozioma trójkolorowa flaga w kolorach zielonym, żółtym i niebieskim."

#. ~ Description of variant "Gambian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag consisting of horizontal red, blue, and green stripes separated by two"
" thin stripes of white."
msgstr ""
"Flaga z poziomymi pasami czerwonym, niebieskim i zielonym, rozdzielonymi "
"dwoma wąskimi białymi paskami."

#. ~ Description of variant "Georgian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"It is a white field flag with a red cross of Saint George and four "
"equilateral crosses."
msgstr ""
"Flaga z białym polem, czerwonym krzyżem świętego Jerzego i czterema krzyżami "
"równoramiennymi."

#. ~ Description of variant "German flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "A horizontal tricolor flag of black, red, and gold."
msgstr "Pozioma trójkolorowa flaga w kolorach czarnym, czerwonym i złotym."

#. ~ Description of variant "Ghanaian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A horizontal tricolor flag of red, gold, and green, a black star standing in "
"its center."
msgstr ""
"Pozioma trójkolorowa flaga w kolorach czerwonym, złotym i zielonym, z czarną "
"gwiazdą pośrodku."

#. ~ Description of variant "Greek flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A striped colored flag of four white and five blue alternating horizontal "
"stripes, with a white cross on the upper left corner."
msgstr ""
"Flaga z dziewięcioma naprzemiennymi poziomymi pasami, czterema białymi i "
"pięcioma niebieskimi, z białym krzyżem w lewym górnym rogu."

#. ~ Description of variant "Grenadian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that is diagonally divided field of yellow, green, yellow, green with "
"a red border, in addition to the six yellow stars in the border, there is a "
"central star in a red disk and, at the hoist, a nutmeg symbol."
msgstr ""
"Flaga z polem podzielonym ukośnie na żółte i zielone części, na przemian, z "
"czerwonym obramowaniem; oprócz sześciu żółtych gwiazd na obramowaniu ma "
"centralną gwiazdę w czerwonym kole, a przy drzewcu symbol gałki "
"muszkatołowej."

#. ~ Description of variant "Guatemalan flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A vertical triband flag that features a central band of white that holds the "
"nation's coat of arms nestled between two bands of light blue."
msgstr ""
"Pionowa flaga w trzy pasy z centralnym białym pasem, na którym znajduje się "
"herb kraju, umieszczonym między dwoma jasnoniebieskimi pasami."

#. ~ Description of variant "Guinean flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "A vertical triband flag of red, gold, and green."
msgstr "Pionowa flaga w trzy pasy: czerwony, złoty i zielony."

#. ~ Description of variant "Bissau Guinean flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that features two horizontal bands of gold and green with a red "
"vertical band charged with a black star on the hoist side."
msgstr ""
"Flaga z dwoma poziomymi pasami, złotym i zielonym, oraz pionowym czerwonym "
"pasem z czarną gwiazdą przy drzewcu."

#. ~ Description of variant "Guyanese flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag of a green field with the black edged red isosceles triangle based on "
"the hoist side superimposed on the larger white edged golden triangle, also "
"based on the hoist side, pointed toward the fly-side."
msgstr ""
"Flaga z zielonym polem, z czerwonym trójkątem równoramiennym z czarnym "
"obramowaniem, opartym o drzewce i nałożonym na większy złoty trójkąt z białym"
" obramowaniem, również oparty o drzewce i skierowany ku swobodnej krawędzi "
"flagi."

#. ~ Description of variant "Haitian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A bicolor horizontal flag of blue and red, with a white rectangle in the "
"center featuring a coat of arms."
msgstr ""
"Dwukolorowa pozioma flaga w kolorach niebieskim i czerwonym, z białym "
"prostokątem pośrodku, na którym znajduje się herb."

#. ~ Description of variant "Holy See flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag with a bicolor of gold and white with the crossed keys of Saint Peter "
"and the Papal Tiara centered in the white band."
msgstr ""
"Dwukolorowa flaga w kolorach złotym i białym, ze skrzyżowanymi kluczami "
"świętego Piotra i tiarą papieską pośrodku białego pasa."

#. ~ Description of variant "Honduran flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag with a horizontal triband of turquoise and white with five turquoise "
"five pointed stars arranged in an x pattern centered on the white band."
msgstr ""
"Flaga w trzy poziome pasy: turkusowy, biały i turkusowy, z pięcioma "
"turkusowymi pięcioramiennymi gwiazdami ułożonymi w kształt litery X pośrodku "
"białego pasa."

#. ~ Description of variant "Hungarian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "A tricolor flag consisting of horizontal red, white and green."
msgstr "Trójkolorowa flaga z poziomymi pasami czerwonym, białym i zielonym."

#. ~ Description of variant "Icelandic flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag of a blue field with the white edged red Nordic cross that extends to "
"the edges, the vertical part of the cross is shifted to the hoist side."
msgstr ""
"Flaga z niebieskim polem i czerwonym krzyżem skandynawskim z białym "
"obramowaniem, sięgającym krawędzi; pionowe ramię krzyża jest przesunięte w "
"stronę drzewca."

#. ~ Description of variant "Indian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that has a horizontal triband of saffron, white, and green with a navy"
" blue wheel with twenty four spokes in the center."
msgstr ""
"Flaga w trzy poziome pasy: szafranowy, biały i zielony, z granatowym kołem o "
"dwudziestu czterech szprychach pośrodku."

#. ~ Description of variant "Indonesian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "A flag with a horizontal bicolor of red and white."
msgstr "Flaga z dwoma poziomymi pasami: czerwonym i białym."

#. ~ Description of variant "Iranian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that has a horizontal tricolor of green, white and red with the "
"national emblem in red centered on the white band."
msgstr ""
"Flaga z trzema poziomymi pasami: zielonym, białym i czerwonym, z czerwonym "
"godłem państwowym pośrodku białego pasa."

#. ~ Description of variant "Iraqi flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A tricolor flag of horizontal stripes in red, white, and black with the "
"inscription in Kufic script in the center white band."
msgstr ""
"Trójkolorowa flaga z poziomymi pasami czerwonym, białym i czarnym, z napisem "
"pismem kufickim na środkowym białym pasie."

#. ~ Description of variant "Irish flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "A tricolor flag featuring vertical stripes of green, white, and orange."
msgstr ""
"Trójkolorowa flaga z pionowymi pasami: zielonym, białym i pomarańczowym."

#. ~ Description of variant "Israeli flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that has a white field bearing two horizontal blue stripes and a blue "
"central Shield of David."
msgstr ""
"Flaga z białym polem, dwoma poziomymi niebieskimi pasami i niebieską Gwiazdą "
"Dawida pośrodku."

#. ~ Description of variant "Italian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "A flag that has a tricolor vertical stripes of green, white, and red."
msgstr "Trójkolorowa flaga z pionowymi pasami: zielonym, białym i czerwonym."

#. ~ Description of variant "Jamaican flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that has a gold diagonal cross which divides the field into four "
"triangles of green and black."
msgstr ""
"Flaga ze złotym ukośnym krzyżem, który dzieli pole na cztery trójkąty, "
"zielone i czarne."

#. ~ Description of variant "Japanese flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "A flag of a white field with a red circle in the center piece."
msgstr "Flaga z białym polem i czerwonym kołem pośrodku."

#. ~ Description of variant "Jordanian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag of a horizontal triband of black, white and green; with a red chevron "
"based on the hoist side containing a white seven-pointed star."
msgstr ""
"Flaga w trzy poziome pasy: czarny, biały i zielony, z czerwonym klinem przy "
"drzewcu, na którym znajduje się biała siedmioramienna gwiazda."

#. ~ Description of variant "Kazakhstani flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that features a gold sun above a soaring golden steppe eagle, both "
"centered on a turquoise field."
msgstr ""
"Flaga ze złotym słońcem nad szybującym złotym orłem stepowym, umieszczonymi "
"pośrodku turkusowego pola."

#. ~ Description of variant "Kenyan flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that features a horizontal tricolor of black, white-edged red, and "
"green with two crossed white spears behind a red, white, and black Maasai "
"shield."
msgstr ""
"Flaga w trzy poziome pasy: czarny, czerwony z białym obramowaniem i zielony, "
"z dwiema skrzyżowanymi białymi włóczniami za czerwono-biało-czarną tarczą "
"Masajów."

#. ~ Description of variant "Kiribati flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that features a horizontal bicolor of red and blue with the yellow "
"frigate bird flying over the rising sun with seventeen rays centered on the "
"upper half and three white wavy horizontal stripes on the lower half."
msgstr ""
"Flaga z dwoma poziomymi polami, czerwonym i niebieskim, z żółtą fregatą "
"lecącą nad wschodzącym słońcem o siedemnastu promieniach pośrodku górnej "
"połowy i trzema białymi falistymi poziomymi pasami w dolnej połowie."

#. ~ Description of variant "Kuwaiti flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that features a horizontal triband of green, white and red; with a "
"black trapezium based on the hoist side."
msgstr ""
"Flaga w trzy poziome pasy: zielony, biały i czerwony, z czarnym trapezem przy"
" drzewcu."

#. ~ Description of variant "Kyrgyz flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that features a red field charged with a yellow sun with forty "
"uniformly spaced rays, the sun is crossed by two sets of three lines."
msgstr ""
"Flaga z czerwonym polem, na którym znajduje się żółte słońce z czterdziestoma"
" równomiernie rozmieszczonymi promieniami; słońce przecinają dwa zestawy po "
"trzy linie."

#. ~ Description of variant "Laotian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that features a horizontal triband of red, blue and red, charged in "
"the center a white circle."
msgstr ""
"Flaga w trzy poziome pasy: czerwony, niebieski i czerwony, z białym kołem "
"pośrodku."

#. ~ Description of variant "Latvian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that features a carmine red field bisected by a narrow white stripe."
msgstr "Flaga z karminowym polem przeciętym na pół wąskim białym pasem."

#. ~ Description of variant "Lebanese flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that features a horizontal triband of red, white, and red, charged in "
"the center is a green cedar tree."
msgstr ""
"Flaga w trzy poziome pasy: czerwony, biały i czerwony, z zielonym cedrem "
"pośrodku."

#. ~ Description of variant "Basotho flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A horizontal triband of blue, white and green charged with a black mokorotlo "
"centered on the white band."
msgstr ""
"Pozioma flaga w trzy pasy: niebieski, biały i zielony, z czarnym kapeluszem "
"mokorotlo pośrodku białego pasa."

#. ~ Description of variant "Liberian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that features eleven horizontal stripes alternating red and white, in "
"the canton is a white star on a blue field."
msgstr ""
"Flaga z jedenastoma naprzemiennymi poziomymi pasami, czerwonymi i białymi, z "
"białą gwiazdą na niebieskim polu w lewym górnym rogu."

#. ~ Description of variant "Libyan flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that features a horizontal triband of red, black, and green charged "
"with a white crescent and five pointed star centered on the black stripe."
msgstr ""
"Flaga w trzy poziome pasy: czerwony, czarny i zielony, z białym półksiężycem "
"i pięcioramienną gwiazdą pośrodku czarnego pasa."

#. ~ Description of variant "Liechtensteiner flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that features a horizontal bicolor of blue and red, charged with a "
"gold crown in the canton."
msgstr ""
"Flaga z dwoma poziomymi pasami, niebieskim i czerwonym, ze złotą koroną w "
"lewym górnym rogu."

#. ~ Description of variant "Lithuanian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "A flag that features a horizontal triband of yellow, green and red."
msgstr "Flaga w trzy poziome pasy: żółty, zielony i czerwony."

#. ~ Description of variant "Luxembourger flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid "A flag that features a horizontal triband of red, white and light blue."
msgstr "Flaga w trzy poziome pasy: czerwony, biały i jasnoniebieski."

#. ~ Description of variant "Madagascan flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that features two horizontal bands of red and green with a white "
"vertical band on the hoist side."
msgstr ""
"Flaga z dwoma poziomymi pasami, czerwonym i zielonym, oraz białym pionowym "
"pasem przy drzewcu."

#. ~ Description of variant "Malawian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that features a horizontal triband of black, red, and green; charged "
"with a red rising sun with rays centered on the black stripe."
msgstr ""
"Flaga w trzy poziome pasy: czarny, czerwony i zielony, z czerwonym "
"wschodzącym słońcem z promieniami pośrodku czarnego pasa."

#. ~ Description of variant "Malaysian flag" of item "national flag"
#: data/json/items/armor/cloaks.json
msgid ""
"A flag that features fourteen horizontal stripes alternating red and white, a"
" yellow crescent and fourteen-point star on a blue field in on the canton."
msgstr ""
"Flaga z czternastoma naprzemiennymi poziomymi pasami, czerwonymi i białymi, z"
" żółtym półksiężycem i czternastoramienną gwiazdą na niebieskim polu w lewym "
"górnym rogu."
