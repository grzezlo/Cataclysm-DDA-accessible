#. ~ Description of "jika-tabi (pair)"
#: data/json/items/armor/boots.json
msgid ""
"A pair of thin traditional Japanese split toed boots sewn out of leather."
msgstr ""
"Para cienkich, tradycyjnych japońskich butów z oddzielonym dużym palcem, "
"uszytych ze skóry."

#. ~ Item name
#: data/json/items/armor/boots.json
msgid "jika-tabi sneakers (pair)"
msgid_plural "jika-tabi sneakers (pair)"
msgstr[0] "para trampek jika-tabi"
msgstr[1] "pary trampek jika-tabi"
msgstr[2] "par trampek jika-tabi"
msgstr[3] "pary trampek jika-tabi"

#. ~ Description of "jika-tabi sneakers (pair)"
#: data/json/items/armor/boots.json
msgid ""
"A pair of comfortable modern split toed jika-tabi shoes with a rubber base.  "
"Also known as ninja shoes.  Though originally developed for laborers in "
"Japan, in the west they are usually found being used in outdoor martial arts "
"practice."
msgstr ""
"Para wygodnych, nowoczesnych butów jika-tabi z oddzielonym dużym palcem i "
"gumową podeszwą. Znane też jako buty ninja. Choć pierwotnie stworzono je dla "
"robotników w Japonii, na Zachodzie zwykle używa się ich do treningu sztuk "
"walki na świeżym powietrzu."

