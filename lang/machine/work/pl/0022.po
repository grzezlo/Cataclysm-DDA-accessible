msgid_plural "canvas throat guards"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "canvas throat guard"
#: data/json/items/armor/scarfs.json
msgid ""
"A common canvas throat guard commonly used for neck protection when playing "
"sports like hockey."
msgstr ""

#. ~ Item name
#: data/json/items/armor/scarfs.json
msgid "plastic throat guard"
msgid_plural "plastic throat guards"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "plastic throat guard"
#: data/json/items/armor/scarfs.json
msgid ""
"A rare variety of throat guard originally known as a gorget and used for neck"
" protection in HEMA.  It's made from thick rubber covered by nylon.  It "
"offers good protection for the throat, but it only covers a small portion of "
"the nape."
msgstr ""

#. ~ Item name
#: data/json/items/armor/scarfs.json
msgid "cut-resistant throat guard"
msgid_plural "cut-resistant throat guards"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "cut-resistant throat guard"
#: data/json/items/armor/scarfs.json
msgid ""
"A cut-resistant Kevlar throat guard, commonly used by welders, security "
"forces and in some sports."
msgstr ""

#. ~ Item name
#: data/json/items/armor/scarfs.json
msgid "mercenary throat guard"
msgid_plural "mercenary throat guards"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "mercenary throat guard"
#: data/json/items/armor/scarfs.json
msgid ""
"A ballistic collar modified to wear it as a standalone armor, carefully "
"combined with a regular nylon throat guard for extra protection."
msgstr ""

#. ~ Item name
#: data/json/items/armor/sheath.json
msgid "longsword scabbard"
msgid_plural "longsword scabbards"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "longsword scabbard"
#: data/json/items/armor/sheath.json
msgid ""
"A leather scabbard, big enough for anything up to a longsword, or even a bit "
"larger than that.  Designed to be worn at the waist, secured to the sturdy "
"leather belt.  Activate to sheath/draw a sword."
msgstr ""

#. ~ Description of "throwing knives leg sheath"
#: data/json/items/armor/sheath.json
msgid ""
"A nylon strap knife sheath worn on the thigh, made to hold 6 very thin "
"knives, such as throwing knives, close at hand.  Activate to sheathe/draw a "
"weapon."
msgstr ""

#. ~ Item name
#: data/json/items/armor/sheath.json
msgid "nylon scabbard"
msgid_plural "nylon scabbards"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "nylon scabbard"
#: data/json/items/armor/sheath.json
msgid ""
"A large, adjustable sheath for holding swords and other large blades, made "
"with nylon.  Activate to sheathe/draw a weapon."
msgstr ""

#. ~ Description of "hiking backpack"
#: data/json/items/armor/storage.json
msgid "A large hiking backpack with plenty of storage space."
msgstr ""

#. ~ Item name
