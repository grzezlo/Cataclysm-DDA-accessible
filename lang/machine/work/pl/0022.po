#. ~ Description of "nylon throat guard"
#: data/json/items/armor/scarfs.json
msgid ""
"A common nylon throat guard commonly used for neck protection when playing "
"sports."
msgstr ""

#. ~ Item name
#: data/json/items/armor/scarfs.json
