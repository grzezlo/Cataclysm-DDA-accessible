msgstr[2] ""
msgstr[3] ""

#. ~ Description of "Philaret Catechism"
#: data/json/items/book/spiritual.json
msgid ""
"A hardcover English translation of the Philaret Catechism, written by the "
"Metropolitan Philaret of Moscow in the 19th century.  This book serves as a "
"comprehensive guide to the teachings and beliefs of the Eastern Orthodox "
"Church, structured in a question-and-answer format and covers various aspects"
" of Christian doctrine, including theology, morality, sacraments, prayer, and"
" the Ten Commandments."
msgstr ""

#. ~ Item name
