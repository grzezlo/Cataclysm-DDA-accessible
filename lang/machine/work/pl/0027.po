msgstr[2] ""
msgstr[3] ""

#. ~ Description of variant "Miriam's Tambourine: Jewish Folktales from Around
#. the World" of item "Judaica softcover"
#: data/json/items/book/misc.json
msgid ""
"A collection of over fifty Jewish folktales, from classics like the story of "
"Miriam's well or Rabbi Loew and the golem or the life of the Baal Shem Tov, "
"to Jewish versions of modern cultural classics like Snow White or Sinbad."
msgstr ""

#. ~ Variant name of item "Judaica softcover"
#: data/json/items/book/misc.json
