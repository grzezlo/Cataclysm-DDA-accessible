msgstr[2] ""
msgstr[3] ""

#. ~ Description of variant "The Way of Humanity: According to Chasidic
#. Teachings" of item "Judaica softcover"
#: data/json/items/book/misc.json
msgid ""
"An English translation of lectures given by Martin Buber on six traditional "
"Chasidic stories from the 18th and 19th centuries."
msgstr ""

#. ~ Variant name of item "Judaica softcover"
#: data/json/items/book/misc.json
