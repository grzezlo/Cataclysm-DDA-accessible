#: data/mods/Xedra_Evolved/items/books_deduction.json
msgid "Rejoice, for you have no reason to read this book anymore."
msgstr ""

#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_DEDUCTION_FROM_BOOK_LIES"
#: data/mods/Xedra_Evolved/items/books_deduction.json
