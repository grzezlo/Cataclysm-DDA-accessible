msgstr[2] ""
msgstr[3] ""

#. ~ Description of "survivor dry duffel bag"
#: data/json/items/armor/bespoke_armor/custom_storage.json
msgid ""
"A modified large watertight duffel bag.  Durable and carefully crafted to "
"hold as much stuff as possible.  Capable of floating.  Provides plenty of "
"storage, but is severely encumbering."
msgstr ""

