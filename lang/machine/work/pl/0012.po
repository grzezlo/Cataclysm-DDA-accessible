msgid_plural "penguin plushies"
msgstr[0] "pluszowy pingwin"
msgstr[1] "pluszowe pingwiny"
msgstr[2] "pluszowych pingwinów"
msgstr[3] "pluszowego pingwina"

#. ~ Description of variant "penguin plushie" of item "plush toy"
#: data/json/items/toy.json
msgid "A velvety-soft plush penguin.  It makes a funny noise when you hug it."
msgstr ""
"Aksamitnie miękki pluszowy pingwin. Wydaje zabawny dźwięk, kiedy go "
"przytulasz."

#. ~ Variant name of item "plush toy"
#: data/json/items/toy.json
