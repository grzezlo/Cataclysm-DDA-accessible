#: data/mods/Magiclysm/effect_on_conditions/attunement_choices.json
msgid "<trait_name:BIOTEK>"
msgstr ""

#. ~ EOC option name in effect in EoC "EOC_CHECK_ATTUNEMENTS"
#: data/mods/Magiclysm/effect_on_conditions/attunement_choices.json
msgid "<trait_name:BLOOD_MAGE>"
msgstr ""

#. ~ EOC option name in effect in EoC "EOC_CHECK_ATTUNEMENTS"
#: data/mods/Magiclysm/effect_on_conditions/attunement_choices.json
msgid "<trait_name:BOREAL_MAGE>"
msgstr ""

#. ~ EOC option name in effect in EoC "EOC_CHECK_ATTUNEMENTS"
#: data/mods/Magiclysm/effect_on_conditions/attunement_choices.json
msgid "<trait_name:CLEANSING_FLAME>"
msgstr ""

#. ~ EOC option name in effect in EoC "EOC_CHECK_ATTUNEMENTS"
#: data/mods/Magiclysm/effect_on_conditions/attunement_choices.json
msgid "<trait_name:CRUSADER>"
msgstr ""

#. ~ EOC option name in effect in EoC "EOC_CHECK_ATTUNEMENTS"
#: data/mods/Magiclysm/effect_on_conditions/attunement_choices.json
