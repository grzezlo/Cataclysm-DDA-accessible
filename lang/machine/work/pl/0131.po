#: data/mods/aftershock_exoplanet/npcs/UICA/augustmoon_security.json
msgid "Augustmoon Security"
msgstr ""

#. ~ NPC dialogue line
#: data/mods/Aftershock/npcs/UICA/augustmoon_security.json
#: data/mods/Aftershock/npcs/UICA/ground_engineer.json
#: data/mods/Aftershock/npcs/UICA/ground_soldier.json
#: data/mods/aftershock_exoplanet/npcs/UICA/augustmoon_security.json
#: data/mods/aftershock_exoplanet/npcs/UICA/ground_engineer.json
#: data/mods/aftershock_exoplanet/npcs/UICA/ground_soldier.json
msgid "Keep it civil, salvor."
msgstr ""

#. ~ Name suffix of an NPC
#. ~ Name of an NPC class
#: data/mods/Aftershock/npcs/UICA/augustmoon_shipping_agent.json
#: data/mods/Aftershock/npcs/UICA/spaceport_portmaster.json
#: data/mods/aftershock_exoplanet/npcs/UICA/augustmoon_shipping_agent.json
#: data/mods/aftershock_exoplanet/npcs/UICA/spaceport_portmaster.json
msgid "Portmaster"
msgstr ""

#. ~ Job description of "Portmaster" NPC class
#: data/mods/Aftershock/npcs/UICA/augustmoon_shipping_agent.json
#: data/mods/aftershock_exoplanet/npcs/UICA/augustmoon_shipping_agent.json
msgid "I manage incoming and outgoing ships and shuttlecraft."
