msgstr[0] "ponadwymiarowe złożone kartonowe pudło"
msgstr[1] "ponadwymiarowe złożone kartonowe pudła"
msgstr[2] "ponadwymiarowych złożonych kartonowych pudeł"
msgstr[3] "ponadwymiarowego złożonego kartonowego pudła"

