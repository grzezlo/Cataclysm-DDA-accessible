msgstr[1] "pudła na strzelbę"
msgstr[2] "pudeł na strzelbę"
msgstr[3] "pudła na strzelbę"

#. ~ Description of variant "shotgun box" of item "longarm cardboard box"
#: data/json/items/containers/containers.json
msgid "Judging by the print on the packaging, this one is meant for a shotgun."
msgstr "Sądząc po nadruku na opakowaniu, to jest przeznaczone na strzelbę."

#. ~ Variant name of item "longarm cardboard box"
#: data/json/items/containers/containers.json
msgid "large handgun box"
msgid_plural "large handgun boxes"
msgstr[0] "duże pudło na broń krótką"
msgstr[1] "duże pudła na broń krótką"
msgstr[2] "dużych pudeł na broń krótką"
msgstr[3] "dużego pudła na broń krótką"

#. ~ Description of variant "large handgun box" of item "longarm cardboard box"
#: data/json/items/containers/containers.json
msgid ""
"Despite the size of the box, this one seems to be intended for an oversized "
"handgun."
msgstr ""
"Mimo rozmiarów pudła to wydaje się przeznaczone na ponadwymiarowy pistolet."

#. ~ Item name
#: data/json/items/containers/containers.json
msgid "handgun case"
msgid_plural "handgun cases"
msgstr[0] "walizka na broń krótką"
msgstr[1] "walizki na broń krótką"
msgstr[2] "walizek na broń krótką"
msgstr[3] "walizki na broń krótką"

#. ~ Description of "handgun case"
#: data/json/items/containers/containers.json
msgid ""
"A hard plastic case with a foam interior, meant to store handguns along with "
"any extra accessories."
msgstr ""
"Twarda plastikowa walizka z piankowym wnętrzem, przeznaczona do "
"przechowywania broni krótkiej wraz z dodatkowymi akcesoriami."

#. ~ Description of "tiny wooden box"
#: data/json/items/containers/containers.json
msgid "A small wooden box with a cap and two small handles."
msgstr "Małe drewniane pudełko z wieczkiem i dwoma małymi uchwytami."

#. ~ Description of "large wooden box"
#: data/json/items/containers/containers.json
msgid "A large wooden crate.  Sturdy, but still light enough to be moved."
msgstr ""
"Duża drewniana skrzynka. Solidna, ale wciąż na tyle lekka, że można ją "
"przenosić."

#. ~ Description of "large metal box"
#: data/json/items/containers/containers.json
msgid ""
"A small metal crate.  The slim profile makes storage a little bit easier."
msgstr "Mała metalowa skrzynka. Smukły kształt nieco ułatwia przechowywanie."

#. ~ Description of "oversize metal box"
#: data/json/items/containers/containers.json
msgid ""
"An oversize metal box, big enough to fit some longer items.  The slim profile"
" makes storage a little bit easier."
msgstr ""
"Ponadwymiarowe metalowe pudło, w którym zmieszczą się dłuższe przedmioty. "
"Smukły kształt nieco ułatwia przechowywanie."

#. ~ Description of "bucket"
#: data/json/items/containers/containers.json
msgid ""
"A galvanized bucket for peanuts, chilled wine, iced beer, lobster, crab legs,"
" French fries, animal feed, farm use, tailgating, crafts, planting flowers, "
"holding gift baskets, containing a fruit basket and herbs, loose item "
"storage, or as an ice bucket."
msgstr ""
"Ocynkowane wiadro na orzeszki ziemne, schłodzone wino, mrożone piwo, homara, "
"odnóża kraba, frytki, paszę dla zwierząt, do użytku w gospodarstwie, na "
"tailgate party, do rękodzieła, sadzenia kwiatów, trzymania koszy "
"prezentowych, na kosz owoców i zioła, do przechowywania drobiazgów albo jako "
"wiaderko na lód."

#. ~ Item name
#: data/json/items/containers/containers.json
msgid "large plastic bucket"
msgid_plural "large plastic buckets"
msgstr[0] "duże plastikowe wiadro"
msgstr[1] "duże plastikowe wiadra"
msgstr[2] "dużych plastikowych wiader"
msgstr[3] "dużego plastikowego wiadra"

#. ~ Description of "large plastic bucket"
#: data/json/items/containers/containers.json
msgid "A bright orange plastic bucket about the size of your torso."
msgstr ""
"Jaskrawopomarańczowe plastikowe wiadro, mniej więcej wielkości twojego "
"tułowia."

#. ~ Description of "wooden bucket"
#: data/json/items/containers/containers.json
msgid ""
"A wooden bucket.  Carefully chiseled out of a hardwood log section, almost "
"like a dugout canoe.  Holds 5 liters of water and has a wooden carrying "
"handle."
msgstr ""
"Drewniane wiadro. Starannie wydłubane z kawałka pnia twardego drewna, trochę "
"jak dłubanka. Mieści 5 litrów wody i ma drewniany uchwyt do noszenia."

#. ~ Description of "hydration pack"
#: data/json/items/containers/containers.json
msgid ""
"A slim and lightweight insulated plastic bladder worn on the back or within a"
" hydration pouch in a backpack.  It has a large pocket and a capped mouth for"
" filling with liquid, with a hose that allows the wearer to drink hands-free."
msgstr ""
"Smukły i lekki izolowany plastikowy bukłak noszony na plecach lub w kieszeni "
"na bukłak w plecaku. Ma duży otwór z zakrętką do napełniania płynem oraz "
"rurkę, która pozwala pić bez użycia rąk."

#. ~ Description of "paper carton"
#: data/json/items/containers/containers.json
msgid ""
"A half-gallon carton constructed of a paper, aluminum, and plastic laminate."
"  It has a threaded cap to keep liquid from leaking out."
msgstr ""
"Karton o pojemności pół galona wykonany z laminatu papieru, aluminium i "
"plastiku. Ma gwintowaną zakrętkę, która zapobiega wyciekaniu płynu."

#. ~ Description of "vacuum-packed bag"
#: data/json/items/containers/containers.json
msgid "A bag of vacuum-packed food."
msgstr "Torebka z żywnością zapakowaną próżniowo."

#. ~ Description of "thermos"
#: data/json/items/containers/containers.json
msgid ""
"A Thermos brand vacuum flask.  Built for temperature retention, helps keep "
"things hot or cold.  Contains 1 L of liquid."
msgstr ""
"Termos marki Thermos. Zaprojektowany do utrzymywania temperatury, pomaga "
"zachować gorące rzeczy gorącymi, a zimne zimnymi. Mieści 1 l płynu."

#. ~ Description of "clay canister"
#: data/json/items/containers/containers.json
msgid ""
"A fragile clay vessel with a waterproofed hide lid.  It can be used to make "
"crude impact grenades or to store liquid."
msgstr ""
"Kruche gliniane naczynie z wodoodporną pokrywką ze skóry. Może posłużyć do "
"zrobienia prymitywnych granatów uderzeniowych lub do przechowywania płynu."

#. ~ Item name
#: data/json/items/containers/containers.json
msgid "clay cup"
msgid_plural "clay cups"
msgstr[0] "gliniany kubek"
msgstr[1] "gliniane kubki"
msgstr[2] "glinianych kubków"
msgstr[3] "glinianego kubka"

#. ~ Description of "clay cup"
#: data/json/items/containers/containers.json
msgid "A simple clay cup used for holding liquid."
msgstr "Prosty gliniany kubek do trzymania płynów."

#. ~ Description of "clay hydria"
#: data/json/items/containers/containers.json
msgid ""
"A 15-liter clay pot with three handles for carrying and pouring.  It also has"
" a waterproofed hide lid."
msgstr ""
"Gliniany dzban o pojemności 15 litrów z trzema uchwytami do noszenia i "
"nalewania. Ma też wodoodporną pokrywkę ze skóry."

#. ~ Item name
#: data/json/items/containers/containers.json
msgid "large clay pot (no lid)"
msgid_plural "large clay pots (no lid)"
msgstr[0] "duży gliniany dzban (bez pokrywy)"
msgstr[1] "duże gliniane dzbany (bez pokrywy)"
msgstr[2] "dużych glinianych dzbanów (bez pokrywy)"
msgstr[3] "dużego glinianego dzbana (bez pokrywy)"

#. ~ Description of "large clay pot (no lid)"
#: data/json/items/containers/containers.json
msgid ""
"A bulky and heavy clay pot, meant to store water, but can carry other liquids"
" in a pinch."
msgstr ""
"Nieporęczny i ciężki gliniany dzban przeznaczony do przechowywania wody, ale "
"w razie potrzeby pomieści też inne płyny."

#. ~ Description of "plastic cup"
#: data/json/items/containers/containers.json
msgid "A small, vacuum-formed cup."
msgstr "Mały kubek formowany próżniowo."

#. ~ Description of "glass flask"
#: data/json/items/containers/containers.json
msgid "A 250 mL laboratory conical flask, with a rubber stopper."
msgstr "Laboratoryjna kolba stożkowa o pojemności 250 ml z gumowym korkiem."

#. ~ Description of "test tube"
#: data/json/items/containers/containers.json
msgid "A 10 mL laboratory cylindrical test tube, with a rubber stopper."
msgstr ""
"Laboratoryjna cylindryczna probówka o pojemności 10 ml z gumowym korkiem."

#. ~ Description of "beaker"
#: data/json/items/containers/containers.json
msgid ""
"A 250 mL laboratory beaker.  Basically a cup with delusions of grandeur."
msgstr ""
"Laboratoryjna zlewka o pojemności 250 ml. W zasadzie kubek z manią wielkości."

#. ~ Description of "graduated cylinder"
#: data/json/items/containers/containers.json
msgid ""
"A tall, narrow glass cylinder with precise markings for measuring fluid "
"quantities.  An important science tool, it is also useful for anal-retentive "
"chefs."
msgstr ""
"Wysoki, wąski szklany cylinder z precyzyjną podziałką do mierzenia ilości "
"płynów. Ważne narzędzie naukowe, przydatne też dla pedantycznych kucharzy."

#. ~ Description of "microcentrifuge tube"
#: data/json/items/containers/containers.json
msgid ""
"A plastic tube with a little built in snap-cap, a great way to store a tiny "
"amount of liquid.  Great for Jell-O shots if 1 mL is enough of a shot for "
"you.  Cool people call these \"eppies\"."
msgstr ""
"Plastikowa probówka z wbudowanym zatrzaskowym wieczkiem, świetny sposób na "
"przechowanie odrobiny płynu. Idealna na shoty z galaretki, jeśli 1 ml to dla "
"ciebie wystarczający shot. Fajni ludzie nazywają je „eppies”."
