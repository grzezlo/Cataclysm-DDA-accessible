msgstr ""
"Ponadwymiarowe kartonowe pudło, wzmocnione drugą warstwą kartonu i mnóstwem "
"taśmy klejącej. Nie da się go już złożyć."

#. ~ Item name
#: data/json/items/containers/containers.json
msgid "longarm cardboard box"
msgid_plural "longarm cardboard cardboard boxes"
msgstr[0] "kartonowe pudło na broń długą"
msgstr[1] "kartonowe pudła na broń długą"
msgstr[2] "kartonowych pudeł na broń długą"
