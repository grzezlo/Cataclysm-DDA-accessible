#: data/json/items/containers/containers.json
msgid ""
"This one reads \"Super Glue - All Purpose!\", with directions and cautions "
"below."
msgstr ""
"Na tej widnieje napis „Super Glue – uniwersalny!”, a pod nim instrukcja i "
"ostrzeżenia."

