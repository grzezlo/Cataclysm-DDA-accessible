msgstr[1] "wzmocnione ponadwymiarowe kartonowe pudła"
msgstr[2] "wzmocnionych ponadwymiarowych kartonowych pudeł"
msgstr[3] "wzmocnionego ponadwymiarowego kartonowego pudła"

#. ~ Description of "reinforced oversize cardboard box"
#: data/json/items/containers/containers.json
msgid ""
"An oversize cardboard box, doubled up with a second layer of cardboard and "
