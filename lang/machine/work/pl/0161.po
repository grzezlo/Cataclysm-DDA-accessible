msgstr ""

#. ~ Mutation name
#: data/mods/MindOverMatter/mod_interactions/bombastic_perks/perks.json
msgid "Efficient Slumber"
msgstr ""

#. ~ Description of mutation "Efficient Slumber"
#: data/mods/MindOverMatter/mod_interactions/bombastic_perks/perks.json
#, no-c-format
