msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "feral burner"
#: data/mods/MindOverMatter/monsters/feral_psychics.json
msgid ""
"This feral human looks a little more composed than most, but only a little.  "
"Their clothes are singed and the air around them shimmers like a summer heat "
"haze."
msgstr ""

#. ~ Monster attack message
#: data/mods/MindOverMatter/monsters/feral_psychics.json
#, c-format
msgid "%1$s gestures and your %2$s is engulfed in flames!"
msgstr ""

#. ~ Monster attack message
#: data/mods/MindOverMatter/monsters/feral_psychics.json
#, c-format
msgid "%1$s gestures and <npcname>'s %2$s is engulfed in flames!"
msgstr ""

#. ~ Monster attack message
#: data/mods/MindOverMatter/monsters/feral_psychics.json
#, c-format
