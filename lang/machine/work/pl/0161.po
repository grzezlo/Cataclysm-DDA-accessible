msgid_plural "Dr. Brains"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "Dr. Brain"
#: data/mods/MindOverMatter/monsters/feral_lab_psychics.json
msgid ""
"An ordinary-looking scientist lost amid the carnage, were it not for the "
"bloodshot eyes, the enlarged cranium, and the fact that the zombies ignore "
"them.  Bits of paper and chemistry equipment lazily float in the air near "
"them."
msgstr ""

