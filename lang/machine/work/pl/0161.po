#. ~ Monster attack message
#: data/mods/MindOverMatter/monsters/feral_psychics.json
#, c-format
msgid "%1$s gestures and <npcname> narrowly avoids a burst of flame!"
msgstr ""

#. ~ Monster attack message
#: data/mods/MindOverMatter/monsters/feral_psychics.json
#, c-format
msgid ""
"%1$s gestures and your %2$s is engulfed in flames, but they do not burn you."
msgstr ""

#. ~ Monster attack message
#: data/mods/MindOverMatter/monsters/feral_psychics.json
#, c-format
msgid ""
"%1$s gestures and <npcname>'s %2$s is engulfed in flames, but it does not "
"burn them."
