"Your Premonition ability has developed to such a level that you can sense "
"movement around you even when you sleep."
msgstr ""

#. ~ Mutation name
#: data/mods/MindOverMatter/mod_interactions/bombastic_perks/perks.json
msgid "Burning Bright"
msgstr ""

#. ~ Description of mutation "Burning Bright"
#: data/mods/MindOverMatter/mod_interactions/bombastic_perks/perks.json
