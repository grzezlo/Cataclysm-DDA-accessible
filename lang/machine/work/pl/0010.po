msgid "collapsible butterfly net"
msgid_plural "collapsible butterfly nets"
msgstr[0] "składana siatka na motyle"
msgstr[1] "składane siatki na motyle"
msgstr[2] "składanych siatek na motyle"
msgstr[3] "składanej siatki na motyle"

#. ~ Description of "collapsible butterfly net"
#: data/json/items/fluff.json
msgid ""
"A piece of canvas on a collapsible aluminum frame.  Used to catch bugs or "
"fish, but might not be as useful for the mutated ones.  It must be extended "
"to use."
msgstr ""
"Kawałek płótna na składanej aluminiowej ramie. Służy do łapania owadów lub "
"ryb, ale może nie być zbyt przydatny w przypadku zmutowanych okazów. Przed "
"użyciem trzeba ją rozłożyć."

#. ~ "msg" action message of item "collapsible butterfly net"
#: data/json/items/fluff.json
msgid "You snap open your butterfly net."
msgstr "Rozkładasz siatkę na motyle."

#. ~ Item name
#: data/json/items/fluff.json
msgid "collapsible butterfly net (extended)"
msgid_plural "collapsible butterfly nets (extended)"
msgstr[0] "składana siatka na motyle (rozłożona)"
msgstr[1] "składane siatki na motyle (rozłożone)"
msgstr[2] "składanych siatek na motyle (rozłożonych)"
msgstr[3] "składanej siatki na motyle (rozłożonej)"

#. ~ Description of "collapsible butterfly net (extended)"
#: data/json/items/fluff.json
msgid ""
"A piece of canvas on a collapsible aluminum frame.  Used to catch bugs or "
"fish, but might not be as useful for the mutated ones."
msgstr ""
"Kawałek płótna na składanej aluminiowej ramie. Służy do łapania owadów lub "
"ryb, ale może nie być zbyt przydatny w przypadku zmutowanych okazów."

#. ~ "msg" action message of item "collapsible butterfly net (extended)"
#: data/json/items/fluff.json
msgid "You collapse your butterfly net."
msgstr "Składasz siatkę na motyle."

#. ~ Item name
#: data/json/items/fluff.json
