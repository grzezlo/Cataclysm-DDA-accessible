msgstr ""

#. ~ Description of mutation "Cold Aura"
#: data/mods/Magiclysm/mutations/spell_triggering_mutations.json
msgid ""
"Your presence is so dangerous you can freeze everything around yourself.  You"
" are currently suppressing this power."
msgstr ""

#. ~ Message when transforming from mutation  "Cold Aura" to "COLD_AURA_ON"
#: data/mods/Magiclysm/mutations/spell_triggering_mutations.json
