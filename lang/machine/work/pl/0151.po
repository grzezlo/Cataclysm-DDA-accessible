#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombies.json
msgid "leyspark zombie"
msgid_plural "leyspark zombies"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "leyspark zombie"
#: data/mods/Magiclysm/monsters/zombies.json
msgid ""
"This zombie's ley lines are visibly glowing beneath its skin, casting a blue "
"light on its surroundings.  A stronger burst of light, almost blinding, "
"occasionally flashes from one of the ley lines."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombies.json
msgid "levinbolt zombie"
msgid_plural "levinbolt zombies"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "levinbolt zombie"
#: data/mods/Magiclysm/monsters/zombies.json
msgid ""
"A strong blue glow surrounds this zombie, frequently letting off bright "
"sparks.  Occasionally, it makes an awkward gesture and a series of magical "
"bolts flash from its fingers into the scenery."
msgstr ""

#. ~ Monster message of special attack of monster "levinbolt zombie"
#. ~ Monster message of special attack of monster "manastorm zombie"
#: data/mods/Magiclysm/monsters/zombies.json
#, c-format
msgid "%1$s flings its arms out and glowing bolts erupt from them."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombies.json
msgid "manastorm zombie"
msgid_plural "manastorm zombies"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "manastorm zombie"
#: data/mods/Magiclysm/monsters/zombies.json
msgid ""
"This zombie is barely visible behind the bright blue glow and constantly "
"flashes of light.  When it can be seen, its body is covered in a bright "
"tracery of active ley lines."
msgstr ""

#. ~ Monster message of special attack of monster "manastorm zombie"
#: data/mods/Magiclysm/monsters/zombies.json
#, c-format
msgid "%1$s makes a jerky motion and eldritch blue fire explodes from its arm."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombies.json
msgid "zombie queller"
msgid_plural "zombie quellers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "zombie queller"
#: data/mods/Magiclysm/monsters/zombies.json
msgid ""
"This zombie's ley lines are glowing beneath its skin, but very dimly.  They "
"seem to absorb nearby light."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombies.json
msgid "zombie disruptor"
msgid_plural "zombie disruptors"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "zombie disruptor"
#: data/mods/Magiclysm/monsters/zombies.json
msgid ""
"The light seems to grow dim around this zombie's hands, in contrast to the "
"blue glow of its eyes.  Barely-visible blue paths on its visible skin, like "
"traceries of veins, mark the site of its ley lines."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombies.json
msgid "magebreaker"
msgid_plural "magebreakers"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "magebreaker"
#: data/mods/Magiclysm/monsters/zombies.json
msgid ""
"The air continuously wavers around this zombie's hands and its eyes are a "
"luminous shining blue.  It occasionally gestures at some of the nearby "
"scenery and light warps, like you're looking at it through a kaleidoscope.  "
"You can't tell a difference after it turns to normal, but you still don't "
"want to end up inside it."
msgstr ""

#. ~ Monster message of special attack of monster "magebreaker"
#: data/mods/Magiclysm/monsters/zombies.json
#, c-format
msgid "%1$s raises both of its hands toward %3$s."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_fantasy_species.json
msgid "zombie dwarf"
msgid_plural "zombie dwarves"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "zombie dwarf"
#: data/mods/Magiclysm/monsters/zombified_fantasy_species.json
msgid ""
"Once a dwarf, this zombie now has rent flesh and a beard in tatters.  Its "
"face is twisted in an expression of rage."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_fantasy_species.json
msgid "zombie dwarven miner"
msgid_plural "zombie dwarven miners"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "zombie dwarven miner"
#: data/mods/Magiclysm/monsters/zombified_fantasy_species.json
msgid ""
"Once a dwarven miner, this zombie now has rent flesh and a beard in tatters."
"  Its face is twisted in an expression of rage."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_fantasy_species.json
msgid "zombie elf"
msgid_plural "zombie elves"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "zombie elf"
#: data/mods/Magiclysm/monsters/zombified_fantasy_species.json
msgid ""
"Its face twisted in an expression of pure rage and with glassy eyes, this elf"
" looks nothing like the ethereal elves from before the Cataclysm.  Though it "
"also lacks the elves' characteristic grace, its movements are quieter than "
"the other dead."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_fantasy_species.json
msgid "zombie goblin"
msgid_plural "zombie goblins"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "zombie goblin"
#: data/mods/Magiclysm/monsters/zombified_fantasy_species.json
msgid ""
"With bared teeth and black eyes filled with rage, this formerly-living goblin"
" is now a walking nightmare.  While small, unlike the human zombies it was "
"born with teeth and claws."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_fantasy_species.json
msgid "zombie ravenfolk"
msgid_plural "zombie ravenfolk"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "zombie ravenfolk"
#: data/mods/Magiclysm/monsters/zombified_fantasy_species.json
msgid ""
"With bedraggled wings, dull eyes, and beak hanging open, this ravenfolk body "
"still walks, a slight sway as it moves."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_fantasy_species.json
msgid "zombie lizardfolk"
msgid_plural "zombie lizardfolk"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "zombie lizardfolk"
#: data/mods/Magiclysm/monsters/zombified_fantasy_species.json
msgid ""
"A proud servant of dragons reduced to a walking corpse, this lizardfolk's "
"scales are streaked with grime and its black eyes burn with rage.  It has not"
" lost its teeth and claws in the transition to undeath."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid "rotting wolf man"
msgid_plural "rotting wolf men"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "rotting wolf man"
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid ""
"The classic half man half wolf of the movies, but with a new twist: UNDEATH!"
"  This monster lopes along alternating between two and four legged gaits.  "
"It's jet black eyes seething with insatiable hunger.  Now you will know why "
"you fear the night."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid "zorc"
msgid_plural "zorcs"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid "zowlbear"
msgid_plural "zowlbears"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid "zowlbear predator"
msgid_plural "zowlbear predators"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "zowlbear predator"
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid ""
"A once zombified owlbear, now faster and much bigger in size.  Its thick skin"
" protects the monster from harm, a sharp beak capable of rending through "
"metal and a fury in its eyes warns you to stay away."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid "undying"
msgid_plural "undying"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid "zombified Yule cat"
msgid_plural "zombified Yule cats"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "zombified Yule cat"
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid ""
"A magical beast from Icelandic folklore, known for their catlike appearance "
"and their hobby of eating Workshop Elves.  It creepily stumbles on its 4 legs"
" with its squirming uneven body after meeting demise and being reborn just to"
" eat you."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid "Tod cat"
msgid_plural "Tod cats"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "Tod cat"
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid ""
"Once used to its decomposed body, this nightmarish cat with thick teeth and "
"razor-sharp claws seems to be looking around for things to \"play\" with.  "
"Though its head is of a feline, it grins at you sadistically with a glint in "
"its cold demonic eyes."
msgstr ""

#. ~ Monster name
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid "zombified catoblepas"
msgid_plural "zombified catoblepases"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "zombified catoblepas"
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid ""
"Already foul in life, this catoblepas now has oozing sores on its body and an"
" even more rank odor.  At least whatever was odd about its eyes is gone, now "
"that they're black and filled with rage."
msgstr ""

#. ~ Monster name
#. ~ Word is invented: meaning is given as 'white-striders'
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid "zombified aenor"
msgid_plural "zombified aenóren"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "zombified aenor"
#: data/mods/Magiclysm/monsters/zombified_monsters.json
msgid ""
"With bedraggled feathers and rent skin, stumbling as it walks, this formerly-"
"living aenor is in a sad state."
msgstr ""

#. ~ Dream of mutation category "DRAGON_BLACK"
#: data/mods/Magiclysm/mutations/dreams.json
msgid "You have a strange dream about dragons."
msgstr ""

#. ~ Dream of mutation category "DRAGON_BLACK"
#: data/mods/Magiclysm/mutations/dreams.json
msgid "You have a disturbing dream of rampaging in a village."
msgstr ""

#. ~ Dream of mutation category "DRAGON_BLACK"
#: data/mods/Magiclysm/mutations/dreams.json
msgid ""
"While dreaming, you see a distinctively dragon-like reflection of yourself."
msgstr ""

#. ~ Dream of mutation category "DRAGON_BLACK"
#: data/mods/Magiclysm/mutations/dreams.json
msgid ""
"You blissfully dream of soaring over a human village.  The thought of "
"destroying it and abducting the chiefs daughter is somewhat disturbing."
msgstr ""

#. ~ Dream of mutation category "DRAGON_BLACK"
#: data/mods/Magiclysm/mutations/dreams.json
msgid "You have a disturbingly lifelike dream of living as a dragon."
msgstr ""

#. ~ Dream of mutation category "DRAGON_BLACK"
#: data/mods/Magiclysm/mutations/dreams.json
msgid "In your dream you are the nightmare of a human."
msgstr ""

#. ~ Dream of mutation category "DRAGON_BLACK"
#: data/mods/Magiclysm/mutations/dreams.json
msgid "You have a disturbingly satisfying dream of ravaging a human village."
msgstr ""

#. ~ Dream of mutation category "DRAGON_BLACK"
#: data/mods/Magiclysm/mutations/dreams.json
msgid "You dream of raiding a castle and abducting the princess."
msgstr ""

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Human Magic"
msgstr ""

#. ~ Description of mutation "Human Magic"
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Your body is depressingly mundane."
msgstr ""

#. ~ Description of mutation "Wildshape: Fish"
#: data/mods/Magiclysm/mutations/mutations.json
msgid "You are fish-like.  Just keep swimming!"
msgstr ""

#. ~ Description of mutation "Wildshape: Bear"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"You are bear-like, granting you raw bestial power in exchange for "
"intelligence."
msgstr ""

#. ~ Description of mutation "Wildshape: Deer"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"You are deer-like, giving you the ability to move quickly and escape danger."
"  It is hard to use your arms in combat, however."
msgstr ""

#. ~ Description of mutation "Empty"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"You are one of the Empty, the rare few unable to cast even the simplest "
"spells.  Your complete lack of mana prevents you from ever casting any magic,"
" no matter how well you know it.  At least it doesn't prevent the use of "
"magical items and potions."
msgstr ""

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Mana-Shackled"
msgstr ""

#. ~ Description of mutation "Mana-Shackled"
#: data/mods/Magiclysm/mutations/mutations.json
msgid ""
"For a reason or another you are wearing a mana-leech shackle, leaving you "
"constantly empty of mana.  Should you get rid of it you will regain the "
"ability to use your mana, but this is much easier said than done.  You know "
"that these shackles are often used in prisons, so maybe you could find a way "
"to remove it in there?"
msgstr ""

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
msgid "Mana-Shackled effect"
msgstr ""

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/mutations.json
#: data/mods/Xedra_Evolved/mutations/mutations.json
msgid "Iron Intolerance"
msgstr ""

#. ~ Description of mutation "Iron Intolerance"
#: data/mods/Magiclysm/mutations/mutations.json
#: data/mods/Xedra_Evolved/mutations/mutations.json
msgid ""
"You were born with an allergy to iron and, to a lesser extent, steel.  "
"Wearing or touching anything made of iron or steel will cause you pain and "
"discomfort."
msgstr ""

#. ~ Mutation name
#: data/mods/Magiclysm/mutations/school_deficiencies.json
msgid "School Deficiency: Channeling"
msgstr ""

#. ~ Description of mutation "School Deficiency: Channeling"
#: data/mods/Magiclysm/mutations/school_deficiencies.json
