#. ~ Response to NPC dialogue
#: data/json/npcs/refugee_center/surface_refugees/NPC_Draco_Dune.json
msgid "Just a sec, got something I need to do first."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/refugee_center/surface_refugees/NPC_Draco_Dune.json
