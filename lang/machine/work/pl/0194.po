msgstr ""

#. ~ NPC dialogue line
#: data/mods/Xedra_Evolved/npc/boann.json
msgid "Greetings, elder cousin."
msgstr ""

#. ~ NPC dialogue line
#: data/mods/Xedra_Evolved/npc/boann.json
msgid "Greetings, nightwalker."
msgstr ""

#. ~ NPC dialogue line
#: data/mods/Xedra_Evolved/npc/boann.json
msgid "Greetings, child of the moon."
msgstr ""

#. ~ NPC dialogue line
#: data/mods/Xedra_Evolved/npc/boann.json
