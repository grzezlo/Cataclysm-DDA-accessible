msgid ""
"I give you this necklace as a gift for your services.  May it serve you well."
msgstr ""

#. ~ NPC dialogue line
#: data/mods/Xedra_Evolved/npc/boann.json
msgid ""
"Are you certain?  Leaving this world is a one-way trip.  There is still a "
"very long time before it becomes urgent to do so and many things to gain from"
" staying here a little longer."
msgstr ""

#. ~ Response to NPC dialogue
#: data/mods/Xedra_Evolved/npc/boann.json
msgid "I changed my mind.  I'll stay for now"
msgstr ""

#. ~ Response to NPC dialogue
#: data/mods/Xedra_Evolved/npc/boann.json
msgid "I am sure.  Bring me out of here.  (This will end the game)"
msgstr ""

