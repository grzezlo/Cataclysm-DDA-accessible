#: data/mods/Xedra_Evolved/npc/boann.json
msgid "Begone, slayer.  I will have no dealings with you."
msgstr ""

#. ~ NPC dialogue line
#: data/mods/Xedra_Evolved/npc/boann.json
msgid "Greetings, kinsman."
msgstr ""

