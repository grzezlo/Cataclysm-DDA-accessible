#. ~ Description of "tactical infovisor"
#: data/mods/Aftershock/items/armor/headsets.json
#: data/mods/aftershock_exoplanet/items/armor/headsets.json
msgid ""
"An armored black headset that coalesces the feeds of several sensors into a "
"single screen display.  It provides generalized assistance in combat, "
"including targeting assistance for thrown and ranged weaponry, threat "
"identification, conditional NV and thermal vision and protection against high"
" intensity light sources.  It must be active to function."
msgstr ""

#. ~ "menu_text" action message of item "tactical infovisor"
#: data/mods/Aftershock/items/armor/headsets.json
#: data/mods/aftershock_exoplanet/items/armor/headsets.json
msgid "activate the infovisor"
msgstr ""

#. ~ "msg" action message of item "tactical infovisor"
#: data/mods/Aftershock/items/armor/headsets.json
#: data/mods/aftershock_exoplanet/items/armor/headsets.json
msgid "You lower the visor and flick the control dial to active."
msgstr ""

