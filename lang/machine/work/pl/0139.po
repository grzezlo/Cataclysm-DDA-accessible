msgid "Something is crawling under your skin."
msgstr ""

#. ~ Snippet in category "<arm_itch>"
#: data/mods/Limb_WIP/mutation_snippets.json
msgid "You pause for a moment.  The movement under your skin doesn't."
msgstr ""

#. ~ Snippet in category "<arm_pain>"
#: data/mods/Limb_WIP/mutation_snippets.json
msgid "Your arms hurt!"
msgstr ""

#. ~ Snippet in category "<arm_pain>"
#: data/mods/Limb_WIP/mutation_snippets.json
msgid "Your arms cramp!"
msgstr ""

#. ~ Snippet in category "<arm_pain>"
#: data/mods/Limb_WIP/mutation_snippets.json
msgid "Something shifts in your arm, painfully."
msgstr ""

#. ~ Snippet in category "<arm_drop>"
#: data/mods/Limb_WIP/mutation_snippets.json
