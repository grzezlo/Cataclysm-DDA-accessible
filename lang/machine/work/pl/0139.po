#. ~ Description of skill "sorcery"
#: data/mods/Isolation-Protocol/Player/skills.json
msgid "Your ability to control the hidden forces behind reality."
msgstr ""

#. ~ Name of spell "iso_eldritch_basic_attack"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid "Baleful Flames of Abhorrach"
msgstr ""

#. ~ Description of spell "iso_eldritch_basic_attack ( Baleful Flames of
#. Abhorrach )"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid ""
"Summon up a bolt of black flame from the Outer Dark that alternately burns "
"and freezes its target."
msgstr ""

#. ~ Name of spell "iso_eldritch_stun_blind_deaf"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid "Inescapable Tesseract of Thought"
msgstr ""

#. ~ Description of spell "iso_eldritch_stun_blind_deaf ( Inescapable Tesseract
#. of Thought )"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid ""
"Lock the target's mind away from its senses, leaving it incapable of "
"perceiving the outside world in any way."
msgstr ""

#. ~ Name of spell "iso_eldritch_summon_hindering_darkness"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid "The Crawling Tendrils of Utternight"
msgstr ""

#. ~ Description of spell "iso_eldritch_summon_hindering_darkness ( The
#. Crawling Tendrils of Utternight )"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid ""
"Summon a darkness so thick as to be tangible, wrapping around the limbs of "
"those in the target area and hindering their movements."
msgstr ""

#. ~ Name of spell "iso_eldritch_line_biting_acid"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid "The Thousandfold Maws of the Black Goat"
msgstr ""

#. ~ Description of spell "iso_eldritch_line_biting_acid ( The Thousandfold
#. Maws of the Black Goat )"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid ""
"Weaken the fabric of reality in a small area, allowing the Black Goat to "
"smell any prey within.  Its terrible mouths will manifest, biting and "
"slavering its caustic juices over all unfortunate targets."
msgstr ""

#. ~ Name of spell "iso_eldritch_cone_lightning"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid "Stormtenders' Fulminating Fury"
msgstr ""

#. ~ Description of spell "iso_eldritch_cone_lightning ( Stormtenders'
#. Fulminating Fury )"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid ""
"Unleash a cone of lashing lightnings that scourge your enemies.  This "
"enchantment also briefly stuns robotic enemies."
msgstr ""

#. ~ Name of spell "iso_eldritch_cold_damage_blast"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid "The Frozen Heart of R'shothai"
msgstr ""

#. ~ Description of spell "iso_eldritch_cold_damage_blast ( The Frozen Heart of
#. R'shothai )"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid ""
"Summon the pure chill of the Outer Dark into a target location, freezing and "
"slowing all enemies within.  Be careful not to be caught in the blast.  This "
"enchantment has no effects on the creatures of the Nether."
msgstr ""

#. ~ Name of spell "iso_eldritch_blink"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid "The Transportations of Immenar"
msgstr ""

#. ~ Description of spell "iso_eldritch_blink ( The Transportations of Immenar
#. )"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid "Discorporates your body and reconstitutes it a short distance nearby."
msgstr ""

#. ~ Name of spell "iso_eldritch_damage_shield"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid "Impenetrable Coruscating Scales of Vishkan"
msgstr ""

#. ~ Description of spell "iso_eldritch_damage_shield ( Impenetrable
#. Coruscating Scales of Vishkan )"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid ""
"Summon the power of an elder wyrm, creating a shell of impenetrable dragon "
"scales around your body.  The scales will withstand a number of blows before "
"the enchant collapse, though their lambent glow will give away your position "
"in the dark.  The enchantment will last several blows before collapsing, and "
"may be canceled at any time."
msgstr ""

#. ~ Name of spell "iso_eldritch_destroy_nether"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid "Thricefold Abjuration of the Outside"
msgstr ""

#. ~ Description of spell "iso_eldritch_destroy_nether ( Thricefold Abjuration
#. of the Outside )"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid ""
"Sever the bonds that tie a single Nether creature to this world, instantly "
"forcing it back from whence it came."
msgstr ""

#. ~ Name of spell "iso_eldritch_polymorph"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid "Tsath's Horrific Metamorphosis"
msgstr ""

#. ~ Description of spell "iso_eldritch_polymorph ( Tsath's Horrific
#. Metamorphosis )"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid ""
"Twist the target's body, mutating them into a stumbling mass of flesh whose "
"many mouths can only keen out the song of their suffering."
msgstr ""

#. ~ Name of spell "iso_eldritch_imprisonment"
#. ~ Name of effect type id "effect_iso_eldritch_imprisonment"
#: data/mods/Isolation-Protocol/Player/sorcery.json
#: data/mods/Isolation-Protocol/Player/sorcery_effects.json
msgid "The Adamantine Gaol of Emthys"
msgstr ""

#. ~ Description of spell "iso_eldritch_imprisonment ( The Adamantine Gaol of
#. Emthys )"
#: data/mods/Isolation-Protocol/Player/sorcery.json
msgid ""
"Create an impenetrable shell of force around the target, preventing them from"
" moving or acting for the enchantment's duration.  The shell works in two "
"directions and the target is also immune to all harm."
msgstr ""

#. ~ Name of effect type id "effect_iso_eldritch_damage_shield"
#: data/mods/Isolation-Protocol/Player/sorcery_effects.json
msgid "Coruscating Scales"
msgstr ""

#. ~ Remove message of effect type "Coruscating Scales"
#: data/mods/Isolation-Protocol/Player/sorcery_effects.json
msgid "The glowing scales protecting you collapse."
msgstr ""

#. ~ Name of effect type id "effect_iso_eldritch_cold_damage_blast"
#: data/mods/Isolation-Protocol/Player/sorcery_effects.json
msgid "Void-chilled"
msgstr ""

#. ~ Description of effect type "Void-chilled"
#: data/mods/Isolation-Protocol/Player/sorcery_effects.json
msgid "You are frozen to the bone."
msgstr ""

#. ~ Remove message of effect type "Void-chilled"
#: data/mods/Isolation-Protocol/Player/sorcery_effects.json
msgid "The chill fades away."
msgstr ""

#. ~ Description of effect type "The Adamantine Gaol of Emthys"
#. ~ Description of effect type "Adamantine Gaol"
#: data/mods/Isolation-Protocol/Player/sorcery_effects.json
#: data/mods/Magiclysm/effects/effects.json
msgid "You are totally immobile and invulnerable."
msgstr ""

