msgstr[2] ""
msgstr[3] ""

#. ~ Description of magazine "Lewis gun 47-round magazine"
#. ~ Description of "Lewis gun 47-round magazine"
#: data/mods/Isolation-Protocol/unique_items.json
msgid ""
"The top mounted pan magazine of a Lewis machine gun.  It's a bit of a hassle "
"to reload, but it's a lot of firepower in a relatively portable package."
msgstr ""

#. ~ Description of gun "repeating crossbow"
#. ~ Description of "repeating crossbow"
#: data/mods/Isolation-Protocol/unique_items.json
msgid ""
"A crossbow fit with an automatic spanning mechanism that allows for the rapid firing of up to 4 bolts.\n"
"\n"
"In an age long past, these weapons were issued to expeditions sent to contain a cursing plague in the northern reaches."
msgstr ""

#. ~ Firing mode of gun
#: data/mods/Isolation-Protocol/unique_items.json
msgid "repeat fire"
msgstr ""

