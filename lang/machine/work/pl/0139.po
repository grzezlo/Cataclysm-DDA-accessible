msgstr[2] ""
msgstr[3] ""

#. ~ Description of gun "ancient plasma rifle (fan)"
#. ~ Description of "ancient plasma rifle (fan)"
#: data/mods/Generic_Guns/firearms/energy.json
msgid ""
"Even a second of exposure to the plasma fan generated by this weapon is "
"enough to flash-incinerate anything, but its state of disrepair limits the "
"amount of time its destructive power can be sustained."
msgstr ""

