msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "Blackstaff"
#: data/mods/Isolation-Protocol/unique_items.json
#, no-c-format
msgid ""
"An enchanted ebony staff, with diamonds and starmetal on the end to "
"facilitate the channeling of arcane energies.  If lost, it will always return"
" to you.  While wielding the staff, the cost of your enchantments is reduced "
"by 33% and their casting time is reduced by 50%."
msgstr ""

