msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of gun "ancient plasma rifle (projectile)"
#. ~ Description of "ancient plasma rifle (projectile)"
#: data/mods/Generic_Guns/firearms/energy.json
msgid ""
"A single discharge from this plasma rifle easily melts through conventional "
"armor and flash-incinerates anything behind it, but its state of disrepair "
"limits the number of shots it can fire in quick succession."
msgstr ""

#. ~ Item name
#. ~ Name of a gun
#: data/mods/Generic_Guns/firearms/energy.json
