#. ~ Message of spell "XAEA_heal ( Artifact Heal )"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "Your flesh quickly rots and regenerates like in timelapse."
msgstr ""

#. ~ Message of spell "XAEA_pain ( Artifact Pain )"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "All your feelings numb for a second, and all pain is gone now."
msgstr ""

#. ~ Message of spell "XAEA_stamina ( Artifact Stamina )"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid ""
"The energy stream into your muscle, and you feel you can run a marathon right"
" now."
msgstr ""

#. ~ Message of spell "XAEA_mana ( Artifact Mana )"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid ""
"You feel your body become energized, and you are ready to change the world."
msgstr ""

#. ~ Message of spell "XAEA_map ( Artifact Map )"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "You feel like you know this place."
msgstr ""

#. ~ Name of effect type id "xe_str"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "Enormous power"
msgstr ""

#. ~ Description of effect type "Enormous power"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "Your muscles scream with force."
msgstr ""

#. ~ Apply message of effect type "Enormous power"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "Unleash the power."
msgstr ""

#. ~ Remove message of effect type "Enormous power"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "The power fades away."
msgstr ""

#. ~ Name of effect type id "xe_int"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "The Knowledge"
msgstr ""

#. ~ Description of effect type "The Knowledge"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid ""
"You know for sure - right now you are the smartest human on this side of the "
"planet."
msgstr ""

#. ~ Apply message of effect type "The Knowledge"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "With some effort you can outsmart reality."
msgstr ""

#. ~ Remove message of effect type "The Knowledge"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "You feel yourself much less smarter than before."
msgstr ""

#. ~ Name of effect type id "xe_sight_elec"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "Sparks"
msgstr ""

#. ~ Description of effect type "Sparks"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "You feel sparks dancing in your eyes."
msgstr ""

#. ~ Apply message of effect type "Sparks"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "Tiny electrical joints jump in your cornea."
msgstr ""

#. ~ Remove message of effect type "Sparks"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "The sparks in your eyes are finally gone."
msgstr ""

#. ~ Message of spell "XAEA_line ( Artifact Line )"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "Silently, a part of the world nearby just disappears."
msgstr ""

#. ~ Message of spell "XAEA_hologram_summon ( Artifact Hologram Summon )"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "It is you.  And this is you.  And that is you.  You are everywhere."
msgstr ""

#. ~ Name of effect type id "xaea_electric_emit"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "Shocker"
msgstr ""

#. ~ Description of effect type "Shocker"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "Your body emit enough energy to power some small city."
msgstr ""

#. ~ Apply message of effect type "Shocker"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "Shocking clouds fly everywhere!"
msgstr ""

#. ~ Remove message of effect type "Shocker"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "Electric clouds are gone."
msgstr ""

#. ~ Message of spell "XAEA_mod_moves ( Artifact Add Moves )"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "The world around you silently stops."
msgstr ""

#. ~ Name of effect type id "xe_motion_vision"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "Extra Senses"
msgstr ""

#. ~ Description of effect type "Extra Senses"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "Somehow you can feel any motion around with your spine."
msgstr ""

#. ~ Apply message of effect type "Extra Senses"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "You feel unusual sensation in your spine."
msgstr ""

#. ~ Remove message of effect type "Extra Senses"
#: data/mods/Xedra_Evolved/spells/XAEA.json
msgid "The sensation in your spine gone."
msgstr ""

#. ~ Description of spell "changeling_autumn_touch_of_frailty_spell ( Touch of
#. Frailty )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid ""
"Like the fading of plantlife in the end of the year, afflict your target with"
" the ravages of age, reducing their physical abilities for a brief period.  "
"The duration is <color_green>greatly increased</color> in autumn."
msgstr ""

#. ~ Name of spell "changeling_autumn_scare_animals_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid "Eyes Amid the Leaves"
msgstr ""

#. ~ Description of spell "changeling_autumn_scare_animals_spell ( Eyes Amid
#. the Leaves )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid ""
"Gaze at a nearby animal with the eyes of a stalking predator, sending them "
"fleeing.  Repeated gazes in a short period of time have no additional effect."
"  The glamour has <color_yellow>reduced effect</color> in spring."
msgstr ""

#. ~ Description of spell "changeling_autumn_detect_magic_user_spell ( Witch's
#. Warning )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid ""
"Weaving this glamour will allow you to sense the presence of nearby "
"sorcerers.  The glamour has <color_yellow>reduced duration</color> in spring."
msgstr ""

#. ~ Message of spell "changeling_autumn_detect_magic_user_spell ( Witch's
#. Warning )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid ""
"You mutter a charm under your breath and open your senses up to nearby "
"enchanters."
msgstr ""

#. ~ Name of spell "changeling_autumn_damage_plants_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid "Withering Glare"
msgstr ""

#. ~ Description of spell "changeling_autumn_damage_plants_spell ( Withering
#. Glare )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid ""
"With a forceful gaze projecting the energies of the dying of the year, you "
"can wither plantlife in moments.  This also applies to mobile or even sapient"
" plants.  The glamour <color_yellow>does less damage</color> in spring."
msgstr ""

#. ~ Name of spell "changeling_autumn_call_mists_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid "Autumn Mists"
msgstr ""

#. ~ Description of spell "changeling_autumn_call_mists_spell ( Autumn Mists )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid ""
"You can draw on the mystery of misty autumn mornings and condense a thick fog"
" out of the air, reducing the vision of everyone and hiding your movements.  "
"Reweave the glamour to dispel it. The glamour is <color_yellow>quicker to "
"expire</color> in spring."
msgstr ""

#. ~ Description of spell "changeling_autumn_scare_humans_spell ( Scarecrow's
#. Mien )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid ""
"Spin an illusion around yourself, making those who look on you see their "
"greatest fear, increase your ability to intimidate them, though with a "
"corresponding loss of persuasive ability.  The glamour is <color_yellow>less "
"effective</color> in spring."
msgstr ""

#. ~ Description of spell "changeling_autumn_protection_from_ranged_spell (
#. Swirl of Autumn Leaves )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid ""
"Whip up a wind and a swirl of autumn leaves around yourself, giving ranged "
"attacks a chance to go awry.  The glamour also makes you <color_green>harder "
"to spot</color> if used in autumn."
msgstr ""

#. ~ Message of spell "changeling_autumn_protection_from_ranged_spell ( Swirl
#. of Autumn Leaves )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid "A spray of colored leaves whirl around you."
msgstr ""

#. ~ Name of spell "changeling_autumn_plants_to_harvest_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid "Branches Laden and Heavy"
msgstr ""

#. ~ Description of spell "changeling_autumn_plants_to_harvest_spell ( Branches
#. Laden and Heavy )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid ""
"You can bring a growing plant to full ripeness, allowing you to harvest it "
"immediately.  The glamour <color_red>cannot be used</color> in the spring."
msgstr ""

#. ~ Name of spell "changeling_autumn_freeze_in_place_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid "Balor's Gaze"
msgstr ""

#. ~ Description of spell "changeling_autumn_freeze_in_place_spell ( Balor's
#. Gaze )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid ""
"It is said that Balor could kill with a glance.  While this glamour is not "
"quite so powerful, you can freeze your target in place, as long as you also "
"take no action but to fix them with your stare."
msgstr ""

#. ~ Name of spell "changeling_autumn_create_confusion_mist_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid "Lost in the Mists"
msgstr ""

#. ~ Description of spell "changeling_autumn_create_confusion_mist_spell ( Lost
#. in the Mists )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid ""
"Call up an obscuring mist, rendering anything inside insensate and incapable "
"of navigating or determining their location.  Those inside the fog will "
"wander, blind and deaf, until the glamour fades or they somehow find their "
"way outside of its area.  The affected area is <color_yellow>reduced</color> "
"in the spring."
msgstr ""

#. ~ Message of spell "changeling_autumn_create_confusion_mist_spell ( Lost in
#. the Mists )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_autumn.json
msgid "With a gesture, a mist begins to rise."
msgstr ""

#. ~ Description of spell "changeling_spring_summon_grass_field_spell (
#. Commanding the Grasses )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid ""
"Your command over plants allows you to cause grass to grow in profusion from "
"the soil, making the terrain very difficult for enemies to traverse.  The "
"glamour is much more difficult to use in the winter."
msgstr ""

#. ~ Description of spell "changeling_spring_reduce_scent_spell ( Scent of
#. Fresh Flowers )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid ""
"Cover your own scent with the scent of fresh-blooming flowers, marking it "
"harder for animals (or the dead) to track you.  The glamour's is "
"<color_yellow>less effective</color> in the autumn."
msgstr ""

#. ~ Message of spell "changeling_spring_reduce_scent_spell ( Scent of Fresh
#. Flowers )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid "A pleasant scent fills the air"
msgstr ""

#. ~ Name of spell "changeling_spring_minor_restore_stamina_and_pain_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid "Verdant Vitality"
msgstr ""

#. ~ Description of spell
#. "changeling_spring_minor_restore_stamina_and_pain_spell ( Verdant Vitality
#. )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid ""
"You can draw some of the energy inherent in nearby plants into yourself, "
"restoring a bit of your stamina and easing your pain.  However, the energy is"
" drawn from nearby foliage and cannot be accessed if you are not standing on "
"verdant ground."
msgstr ""

#. ~ Description of spell "changeling_spring_growing_plants_spell ( Nurturing
#. the Green )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid ""
"You can greatly speed plant growth.  Grass can grow from seed in moments, "
"crops can shoot towards the sky, and even young trees can put forth mighty "
"limbs.  You cannot, however, bring a plant to ripeness or fruiting.  The "
"glamour <color_red>cannot be used</color> in the winter."
msgstr ""

#. ~ Description of spell "changeling_spring_prevent_bad_conditions_spell (
#. Spring Cleansing )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid ""
"Like a house after a long winter, this glamour removes impurities in the "
"target's body, curing them of poison or disease and preventing them from "
"reoccurring while it lasts.  The glamour's duration is <color_yellow>greatly "
"reduced</color> in the autumn."
msgstr ""

#. ~ Name of spell "changeling_spring_summon_flower_warriors_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid "War of the Flowers"
msgstr ""

#. ~ Description of spell "changeling_spring_summon_flower_warriors_spell ( War
#. of the Flowers )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid ""
"Endless fields of daffodil warriors fight and die at the pleasure of their "
"overlords in the battles constantly waging in the Bright Lands.  While this "
"is a simpler glamour that that which creates those armies, you can still spin"
" up a small group of daffodil warriors from some nearby foliage."
msgstr ""

#. ~ Description of spell "changeling_spring_protective_plant_armor_spell (
#. Viridian Cuirass )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid ""
"Grow a set of enchanted living armor around yourself or an ally, providing "
"protection and resistance to chill temperatures.  The glamour offers "
"<color_yellow>no protection from cold</color> in autumn."
msgstr ""

#. ~ Name of spell
#. "changeling_spring_remove_fatigue_and_sleep_deprivation_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid "Ending the Long Slumber"
msgstr ""

#. ~ Description of spell
#. "changeling_spring_remove_fatigue_and_sleep_deprivation_spell ( Ending the
#. Long Slumber )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid ""
"Like a hibernating animal shaking off the last remnants of sleep when the "
"snow melts, you can shed sleepiness and fatigue.  The glamour requires that "
"you be <color_yellow>outdoors in sunlight</color> if used in autumn."
msgstr ""

#. ~ Name of spell "changeling_spring_summon_rain_shower_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid "Spring Shower"
msgstr ""

#. ~ Description of spell "changeling_spring_summon_rain_shower_spell ( Spring
#. Shower )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid ""
"Cause the sky to cloud over and a soft spring rain to fall.  Reweave the "
"glamour to dispel it.  You cannot summon the rains if the weather is below "
"freezing."
msgstr ""

#. ~ Name of spell "changeling_spring_summon_smashing_plants_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid "Gwydion's Wrath"
msgstr ""

#. ~ Description of spell "changeling_spring_summon_smashing_plants_spell (
#. Gwydion's Wrath )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid ""
"Summon the wrath of nature upon a single target, causing thorny vines to grow"
" from the ground and attack them mercilessly.  The target must be outside and"
" on natural ground for the glamour to take effect.  The glamour has "
"<color_yellow>reduced duration</color> if used in autumn."
msgstr ""

#. ~ Description of spell
#. "changeling_spring_healing_increase_while_outside_spell ( New Growth )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid ""
"Draw on the power of growth and new sprouts to speed the healing of yourself "
"or one of your allies, as long as you are outside.  The healing rate is "
"<color_yellow>reduced</color> in autumn."
msgstr ""

#. ~ Description of spell "changeling_spring_charm_control_target_spell (
#. Ishtar's Folly )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid ""
"By spinning the energy of desire into a group of human or fae targets, you "
"can fill them with so overpowering a love for you that they will furiously "
"defend you against all threats.  This glamour is <color_yellow>less likely to"
" succeed</color> in the autumn."
msgstr ""

#. ~ Message of spell "changeling_spring_charm_control_target_spell ( Ishtar's
#. Folly )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring.json
msgid "With a whispered hymn, you weave a glamour over your targets."
msgstr ""

#. ~ Player message in false effect in EoC
#. "EOC_CHANGELING_SPRING_MINOR_RESTORE_STAMINA_AND_PAIN"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring_eocs.json
msgid "You need to be standing on vegetation to drawn on its vitality."
msgstr ""

#. ~ Message in effect in EoC "EOC_CHANGELING_SPRING_SUMMON_FLOWER_WARRIORS"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring_eocs.json
msgid "Select foliage."
msgstr ""

#. ~ Player sees monster spawns in nested effect in then statement in nested
#. effect in then statement in effect in EoC
#. "EOC_CHANGELING_SPRING_SUMMON_FLOWER_WARRIORS"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring_eocs.json
msgid ""
"The foliage grows and sprouts in a flash and a daffodil warrior steps forth."
msgstr ""

#. ~ Player sees monsters spawn in nested effect in then statement in nested
#. effect in then statement in effect in EoC
#. "EOC_CHANGELING_SPRING_SUMMON_FLOWER_WARRIORS"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring_eocs.json
msgid ""
"The foliage grows and sprouts in a flash and a group of daffodil warriors "
"step forth."
msgstr ""

#. ~ Player message in nested effect in else statement in nested effect in then
#. statement in effect in EoC "EOC_CHANGELING_SPRING_SUMMON_FLOWER_WARRIORS"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring_eocs.json
msgid "You must spin the daffodil warriors out of greenery."
msgstr ""

#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_CHANGELING_SPRING_HEALING_INCREASE_WHILE_OUTSIDE_APPLY_EFFECT" in
#. nested EOCs in effect in EoC
#. "EOC_CHANGELING_SPRING_HEALING_INCREASE_WHILE_OUTSIDE_INITIATE"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring_eocs.json
msgid "You feel a warm sensation spread over your entire body."
msgstr ""

#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_CHANGELING_SPRING_REMOVE_FATIGUE_AND_SLEEP_DEPRIVATION_INITIATE_REMOVAL"
#. in nested EOCs in effect in EoC
#. "EOC_CHANGELING_SPRING_REMOVE_FATIGUE_AND_SLEEP_DEPRIVATION_INITIATE"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring_eocs.json
msgid "Your tiredness just seems to fall away."
msgstr ""

#. ~ Player message in nested effect in else statement in false effect in EoC
#. "EOC_CHANGELING_SPRING_REMOVE_FATIGUE_AND_SLEEP_DEPRIVATION_INITIATE"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring_eocs.json
msgid ""
"During the autumn, you must be outdoors and in sunlight to shed your "
"tiredness"
msgstr ""

#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_CHANGELING_SPRING_SUMMON_RAIN_SHOWER"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring_eocs.json
msgid "You unweave the glamour controlling the weather."
msgstr ""

#. ~ Player message in nested effect in else statement in effect in EoC
#. "EOC_CHANGELING_SPRING_SUMMON_RAIN_SHOWER"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring_eocs.json
msgid "You spin some glamour into the skies."
msgstr ""

#. ~ Player message in false effect in EoC
#. "EOC_CHANGELING_SPRING_SUMMON_RAIN_SHOWER"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_spring_eocs.json
msgid ""
"You must be outside and the temperature must be above freezing to call the "
"rains."
msgstr ""

#. ~ Description of spell "changeling_summer_light_spell ( Bonefire's Light )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid ""
"Conjure up a flickering ball of orange and red light that hovers nearby and "
"sheds a dim glow on your surroundings.  The glamour is <color_yellow>quicker "
"to expire</color> in winter."
msgstr ""

#. ~ Name of spell "changeling_summer_light_fire_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid "Quick-Kindle"
msgstr ""

#. ~ Description of spell "changeling_summer_light_fire_spell ( Quick-Kindle )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid ""
"With a quick gesture, summon up a burst of heat sufficient to ignite "
"flammable material.  The glamour <color_red>cannot be used</color> in winter."
msgstr ""

#. ~ Description of spell "changeling_summer_sun_glasses_spell ( Shading Your
#. Eyes )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid ""
"The true initiate of summer can gaze directly at the sun without flinching.  "
"The glamour protects your eyes from the light of the noonday sun, as well as "
"other sources of bright light such as flashbangs or welding torches."
msgstr ""

#. ~ Description of spell "changeling_summer_protect_from_hot_weather_spell (
#. Gift of Warm Blood )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid ""
"A quick chant infuses the power of summer into your or your ally's blood, "
"providing resistance against hot weather.  The glamour also provides some "
"<color_green>protection against fire</color> in summer."
msgstr ""

#. ~ Message of spell "changeling_summer_protect_from_hot_weather_spell ( Gift
#. of Warm Blood )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid "A refreshing breeze picks up as you chant."
msgstr ""

#. ~ Name of spell "changeling_summer_jump_distance_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid "Salmon Leap"
msgstr ""

#. ~ Description of spell "changeling_summer_jump_distance_spell ( Salmon Leap
#. )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid ""
"Like a salmon leaping over obstacles in a river, you can make prodigious "
"jumps."
msgstr ""

#. ~ Message of spell "changeling_summer_jump_distance_spell ( Salmon Leap )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid "You gather yourself and leap."
msgstr ""

#. ~ Description of spell "changeling_summer_fire_melee_damage_spell ( Burning
#. Solar Grasp )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid ""
"Surround your hands in ethereal flames, doing additional fire damage to "
"targets you strike in melee.  This damage is greater when unarmed, but still "
"transfers to any weapons you wield.  The glamour is <color_yellow>quicker to "
"expire</color> in winter."
msgstr ""

#. ~ Name of spell "changeling_summer_slow_and_sweat_debuff_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid "Punishing Summer Heat"
msgstr ""

#. ~ Description of spell "changeling_summer_slow_and_sweat_debuff_spell (
#. Punishing Summer Heat )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid ""
"Concentrate the heat of the sun on a small area, inflicting all within with a"
" mystical tiredness that will slow their movements.  In the winter the "
"glamour <color_red>does not work</color> indoors or at night."
msgstr ""

#. ~ Message of spell "changeling_summer_slow_and_sweat_debuff_spell (
#. Punishing Summer Heat )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid "The sunlight shines a little brighter."
msgstr ""

#. ~ Description of spell "changeling_summer_run_for_long_periods_spell (
#. Outracing the Sun )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid ""
"After using this glamour, begin running.  As long as you continue running, "
"you will not run out of stamina.  Weaving another glamour or attacking breaks"
" the effect.  In the winter the glamour <color_red>does not work</color> if "
"you are indoors."
msgstr ""

#. ~ Name of spell "changeling_summer_lightning_bolt_from_storm_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid "Fist of Taranis"
msgstr ""

#. ~ Description of spell "changeling_summer_lightning_bolt_from_storm_spell (
#. Fist of Taranis )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid ""
"Summon a massive lightning bolt onto a target location.  This glamour may "
"only be used outside during a storm."
msgstr ""

#. ~ Message of spell "changeling_summer_lightning_bolt_from_storm_spell ( Fist
#. of Taranis )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid "You call down a bolt of thunder!"
msgstr ""

#. ~ Description of spell "changeling_summer_bonus_stamina_near_enemies_spell (
#. A Fire in the Blood )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid ""
"Infuse the energy of the summer sun into your yourself, preparing for battle."
"  Your stamina will regenerate faster in proportion to the number of adjacent"
" enemies, and you will have an easier time dodging enemy attacks.  In the "
"winter the glamour <color_yellow>is less effective</color>."
msgstr ""

#. ~ Name of spell "changeling_summer_create_thunderstorm_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid "Summer Thunder"
msgstr ""

#. ~ Description of spell "changeling_summer_create_thunderstorm_spell ( Summer
#. Thunder )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid ""
"Conjure up a thunderstorm, causing the sky to cloud over, rain to fall, and "
"eventually lightning to flash.  You have no control over the storm once you "
"set it in motion.  This glamour <color_red>will not work</color> if you are "
"indoors or if the temperature is below freezing."
msgstr ""

#. ~ Name of spell "changeling_summer_ring_of_flames_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid "Ring of Champions"
msgstr ""

#. ~ Description of spell "changeling_summer_ring_of_flames_spell ( Ring of
#. Champions )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid ""
"Summon up a circle of flames around yourself and a nearby enemy, allowing you"
" to fight undisturbed.  You will be immune to the heat of the flames while "
"they last, though stepping into them will end this protection.  The death of "
"the chosen enemy will end the glamour.  You must be "
"<color_yellow>outdoors</color> for this glamour to have any effect.  In the "
"summer, the flames are <color_green>even hotter</color>.  Reweave the glamour"
" to dispel it."
msgstr ""

#. ~ Description of spell "changeling_summer_powerful_sunlight_spell ( Helios's
#. Wrath )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer.json
msgid ""
"Blaze with the blinding light of the sun, blinding anyone nearby capable of "
"seeing you.  This is real sunlight and affects creatures harmed by it "
"accordingly."
msgstr ""

#. ~ Player message in effect in EoC "EOC_CHANGELING_SUMMER_LIGHT_INITIATE"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer_eocs.json
msgid "A flickering red-orange wisp of light kindles near your shoulder."
msgstr ""

#. ~ Player message in effect in EoC
#. "EOC_CHANGELING_SUMMER_LIGHT_FIRE_INITIATE"
#. ~ Player message in nested effect in then statement in false effect in EoC
#. "EOC_CHANGELING_SUMMER_LIGHT_FIRE_INITIATE"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer_eocs.json
msgid "You gesture and summon up a burst of fiery heat."
msgstr ""

#. ~ Player message in nested effect in else statement in false effect in EoC
#. "EOC_CHANGELING_SUMMER_LIGHT_FIRE_INITIATE"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer_eocs.json
msgid "You gesture but nothing happens."
msgstr ""

#. ~ Player message in effect in EoC
#. "EOC_CHANGELING_SUMMER_SUN_GLASSES_INITIATE"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer_eocs.json
msgid "The intensity of nearby light grows muted."
msgstr ""

#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_CHANGELING_SUMMER_CREATE_THUNDERSTORM_INITIATE"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer_eocs.json
msgid ""
"You have already enchanted the weather.  Now you must wait until it runs its "
"course."
msgstr ""

#. ~ Player message in false effect in EoC
#. "EOC_CHANGELING_SUMMER_CREATE_THUNDERSTORM_INITIATE"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer_eocs.json
msgid ""
"You must be outside and the temperature must be above freezing to summon a "
"thunderstorm."
msgstr ""

#. ~ NPC message in nested effect in then statement in effect in EoC
#. "EOC_CHANGELING_SUMMER_RING_OF_FLAMES_INITIATE"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer_eocs.json
msgid "A ring of flames springs up around you!"
msgstr ""

#. ~ NPC message in nested effect in else statement in effect in EoC
#. "EOC_CHANGELING_SUMMER_RING_OF_FLAMES_INITIATE"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer_eocs.json
msgid "You must be outside to call up the ring of champions."
msgstr ""

#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_CHANGELING_SUMMER_RING_OF_FLAMES_KILL_TARGET_NPC"
#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_CHANGELING_SUMMER_RING_OF_FLAMES_KILL_TARGET_MONSTER"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer_eocs.json
msgid "As your enemy collapses, the ring of flames gutters and dies."
msgstr ""

#. ~ Player message in effect in EoC
#. "EOC_CHANGELING_SUMMER_POWERFUL_SUNLIGHT_INITIATE"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer_eocs.json
msgid "You blaze with brilliant light."
msgstr ""

#. ~ Message in nested effect in then statement in effect in EoC
#. "EOC_CHANGELING_SUMMER_POWERFUL_SUNLIGHT_AURA_EFFECTS"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_summer_eocs.json
msgid "The <u_name> is seared by the brilliant light!"
msgstr ""

#. ~ Description of spell "changeling_winter_walk_in_silence ( Footsteps in the
#. Snow )"
#. ~ Description of spell "changeling_winter_feign_death_spell ( Stillness of
#. the Tomb )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid ""
"You and your nearby allies' footsteps make almost no sound when you move, "
"like the footsteps of an animal traveling across new-fallen snow.  If used in"
" winter, your footsteps are <color_green>totally silent</color>.  The glamour"
" is <color_yellow>quicker to expire</color> in summer."
msgstr ""

#. ~ Description of spell "changeling_winter_freeze_target_in_place_spell (
#. Grip of Winter )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid ""
"Summon up thick ice around the target's lower limbs, freezing them in place."
"  Larger targets require more sorcerous might to affect.  If used in winter, "
"the ice covers all of the target's limbs and they also <color_green>cannot "
"attack</color> for the glamour's duration.  The glamour is "
"<color_yellow>quicker to expire</color> in summer."
msgstr ""

#. ~ Description of spell "changeling_winter_walk_on_water_spell ( Path of Rime
#. )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid ""
"You can create ice under your feet, allowing you to walk across water or "
"other liquids without sinking into them.  The glamour is "
"<color_yellow>quicker to expire</color> in summer."
msgstr ""

#. ~ Name of spell "changeling_winter_silence_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid "The Rime-Stilled Tongue"
msgstr ""

#. ~ Description of spell "changeling_winter_silence_spell ( The Rime-Stilled
#. Tongue )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid ""
"Instill ice into a single target's tongue, rendering it heavy and unwieldy in"
" their mouth, and silence their voice with it.  The affected target will not "
"be able to speak or make any noise at all.  The glamour <color_green>lasts "
"much longer</color> in winter."
msgstr ""

#. ~ Message of spell "changeling_winter_silence_spell ( The Rime-Stilled
#. Tongue )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid "Snow forms around your hand as you gesture at your target."
msgstr ""

#. ~ Name of spell "changeling_winter_blinding_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid "Snow-Blindness"
msgstr ""

#. ~ Description of spell "changeling_winter_blinding_spell ( Snow-Blindness )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid ""
"Call up the essence of an endless snow field, shining a moment of brilliant "
"light into your target's eyes and blinding them.  The glamour only works "
"outdoors during the day.  The glamour's duration <color_yellow>is "
"reduced</color> in summer."
msgstr ""

#. ~ Message of spell "changeling_winter_blinding_spell ( Snow-Blindness )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid "You gesture and your target blinks."
msgstr ""

#. ~ Name of spell "changeling_winter_frozen_breath_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid "Jack's Breath"
msgstr ""

#. ~ Description of spell "changeling_winter_frozen_breath_spell ( Jack's
#. Breath )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid ""
"Draw in the chill air of winter and breathe out a cone of freezing air and "
"ice, damaging and slowing your opponents."
msgstr ""

#. ~ Message of spell "changeling_winter_frozen_breath_spell ( Jack's Breath )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid "You breathe out a cone of freezing air."
msgstr ""

#. ~ Name of spell "changeling_winter_neutralize_morale_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid "The Frozen Heart"
msgstr ""

#. ~ Description of spell "changeling_winter_neutralize_morale_spell ( The
#. Frozen Heart )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid ""
"Freeze out all emotion in your heart, rendering you perfectly calm.  This "
"will cancel extremes of both positive and negative emotion and prevent you "
"from feeling anything for the glamour's duration.  This latter effect "
"<color_red>does not occur</color> in summer."
msgstr ""

#. ~ Name of spell "changeling_winter_see_craft_darkness_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid "By Moon or by Starlight"
msgstr ""

#. ~ Description of spell "changeling_winter_see_craft_darkness_spell ( By Moon
#. or by Starlight )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid ""
"Become at home in darkness, allowing you to read and perform normal crafting "
"actions as long as there is even a bit of light available.  This glamour "
"<color_yellow>only works outdoors</color> in summer."
msgstr ""

#. ~ Message of spell "changeling_winter_see_craft_darkness_spell ( By Moon or
#. by Starlight )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid "You open your eyes to the dark and the cold."
msgstr ""

#. ~ Name of spell "changeling_winter_hail_attack_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid "Tears of the Cailleach"
msgstr ""

#. ~ Description of spell "changeling_winter_hail_attack_spell ( Tears of the
#. Cailleach )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid ""
"Cause a short but furious winter storm in a target location, dropping fist-"
"sized hailstones and ice on your enemies.  The glamour leaves behind a field "
"of ice that makes movement very treacherous.  This ice <color_red>melts "
"immediately</color> in the summer."
msgstr ""

#. ~ Description of spell "changeling_winter_cut_off_fey_nature_spell ( The
#. Soul of Iron )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid ""
"Infuse yourself with the cold and the stasis of iron, cutting off your fey "
"powers.  You will no longer to be able to use any glamours, but can touch "
"iron and steel without penalty.  This glamour's duration is "
"<color_green>extended</color> in winter."
msgstr ""

#. ~ Message of spell "changeling_winter_cut_off_fey_nature_spell ( The Soul of
#. Iron )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid "You feel an dull cold fill your entire body."
msgstr ""

#. ~ Name of spell "changeling_winter_pure_area_darkness_spell"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid "The Long Dark"
msgstr ""

#. ~ Description of spell "changeling_winter_pure_area_darkness_spell ( The
#. Long Dark )"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter.json
msgid ""
"Draw on the power of winter to recreate the polar night, blotting out the sun"
" and plunging the nearby area into darkness.  This glamour's duration is "
"<color_yellow>greatly reduced</color> in summer."
msgstr ""

#. ~ NPC message in nested effect in else statement in effect in EoC
#. "EOC_CHANGELING_WINTER_FREEZE_TARGET_IN_PLACE"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter_eocs.json
msgid "The target easily shatters the ice!"
msgstr ""

#. ~ Player message in nested effect in then statement in effect in EoC
#. "EOC_CHANGELING_WINTER_FEIGN_DEATH"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter_eocs.json
msgid "You collapse to the ground as your chest ceases its movements."
msgstr ""

#. ~ Player message in nested effect in else statement in effect in EoC
#. "EOC_CHANGELING_WINTER_FEIGN_DEATH"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter_eocs.json
msgid "You collapse to the ground, but nothing seems fooled!"
msgstr ""

#. ~ Message in effect in EoC "EOC_CHANGELING_WINTER_HAIL_ATTACK"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter_eocs.json
msgid "Select target."
msgstr ""

#. ~ Player message in nested effect in then statement in nested effect in then
#. statement in effect in EoC "EOC_CHANGELING_WINTER_HAIL_ATTACK"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter_eocs.json
msgid "Ice and hail fall from the sky!"
msgstr ""

#. ~ Player message in nested effect in else statement in nested effect in then
#. statement in effect in EoC "EOC_CHANGELING_WINTER_HAIL_ATTACK"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter_eocs.json
msgid "The Tears of the Cailleach must fall outdoors."
msgstr ""

#. ~ Player message in effect in EoC "EOC_CHANGELING_WINTER_PURE_AREA_DARKNESS"
#: data/mods/Xedra_Evolved/spells/changeling_seasonal_magic_winter_eocs.json
msgid "All light dies away."
msgstr ""

#. ~ Name of spell "changeling_research_new_seasonal_spells"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "Develop New Glamours"
msgstr ""

#. ~ Description of spell "changeling_research_new_seasonal_spells ( Develop
#. New Glamours )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"Using the power of human dreams, unlock the secrets of new seasonal magicks."
"  It requires a large amount of dreamdross and time to perform this research."
msgstr ""

#. ~ Name of spell "changeling_gain_dreamsparks"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "Extract Dreamsparks"
msgstr ""

#. ~ Description of spell "changeling_gain_dreamsparks ( Extract Dreamsparks )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"Pull the power of creativity and enchantment from dreamdross and condense it "
"into dreamsparks, so you can use them to power fae magicks."
msgstr ""

#. ~ Name of spell "changeling_disguise_as_nature_spell"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "None Here But the Stones"
msgstr ""

#. ~ Description of spell "changeling_disguise_as_nature_spell ( None Here But
#. the Stones )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"Disguise yourself within nature, as a rock or tree or part of a babbling "
"brook.  You must be outdoors and on natural terrain for the glamour to take "
"hold, and the glamour <color_red>ends instantly</color> if you move or "
"attack."
msgstr ""

#. ~ Description of spell "changeling_invisibility_spell ( Hidden from Mortal
#. Eyes )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"Lord, what fools these mortals be, especially when they cannot see what's "
"right in front of them.  You will be invisible for a time, as long as you do "
"not take hostile action."
msgstr ""

#. ~ Message of spell "changeling_invisibility_spell ( Hidden from Mortal Eyes
#. )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "With a laugh and a wink, you disappear."
msgstr ""

#. ~ Name of spell "changeling_summon_will_o_the_wisps_spell"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "Call Wills-o'-the-Wisp"
msgstr ""

#. ~ Description of spell "changeling_summon_will_o_the_wisps_spell ( Call
#. Wills-o'-the-Wisp )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "Summon the ignes fatui to lead your enemies astray."
msgstr ""

#. ~ Message of spell "changeling_summon_will_o_the_wisps_spell ( Call
#. Wills-o'-the-Wisp )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "At your command, distant lights appear."
msgstr ""

#. ~ Description of spell "changeling_noble_cure_bad_conditions_spell ( Lights
#. of Imbolc )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"Purify yourself or an ally, removing a wide variety of debilitating "
"conditions such as disease or poison.  However, doing so will fatigue the "
"target; too many problems will lead to a long period of recovery afterwards."
msgstr ""

#. ~ Message of spell "changeling_noble_cure_bad_conditions_spell ( Lights of
#. Imbolc )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "You wave your hand at your target."
msgstr ""

#. ~ Description of spell "changeling_noble_burning_weapon_spell ( Fires of
#. Bealtaine )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"Set a weapon to burn with the purifying light of Bealtaine's bonfires, "
"illuminating your surroundings and causing the weapon to burn anything it "
"strikes.  It does additional damage to creatures of the Nether.  The glamour "
"will not work without a weapon to affect."
msgstr ""

#. ~ Description of spell "changeling_noble_movement_buffs_spell ( Deeds of
#. Lughnasadh )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"Enhance yourself or an ally with the athleticism and prowess of the dancers, "
"runners, and hurlers of Lughnasadh.  This increases movement and attack "
"speed, dodging ability, and allows the target to leap to a rooftop from a "
"standing start."
msgstr ""

#. ~ Description of spell "changeling_noble_summon_ghosts_spell ( Hosts of
#. Samhain )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"Summon the hosts of Samhain, the spirits of the victorious dead, to defeat "
"your enemies.  The hosts of Samhain are mighty in battle but cannot abide the"
" light of the sun."
msgstr ""

#. ~ Message of spell "changeling_noble_summon_ghosts_spell ( Hosts of Samhain
#. )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "As you gesture, shadowy figures appear around your target."
msgstr ""

#. ~ Description of spell "changeling_noble_command_commoners_spell (
#. Sovereign's Command )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"With a stern word of command, you can glamour one of the common fae, the "
"redcaps or brownies or pooka or bannermen, into defending you from your "
"enemies."
msgstr ""

#. ~ Message of spell "changeling_noble_command_commoners_spell ( Sovereign's
#. Command )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "You snap out an order to your target."
msgstr ""

#. ~ Description of spell "changeling_noble_charm_humans_spell ( Come Away, O
#. Human Child )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"With a stern word of command or a whispered entreaty, you can glamour a human"
" into defending you from your enemies."
msgstr ""

#. ~ Message of spell "changeling_noble_charm_humans_spell ( Come Away, O Human
#. Child )"
#. ~ Message of spell "selkie_beguilement_spell ( Beguilement )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "You cast your glamour over your target."
msgstr ""

#. ~ Description of spell "changeling_brownie_blink_indoors_spell ( Slip
#. Through the Cracks )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"When in danger of being discovered, brownies can slip away in moments.  This "
"glamour allows you to vanish and reappear elsewhere in the house.  It cannot "
"be used outdoors."
msgstr ""

#. ~ Description of spell "changeling_teleport_home_spell ( Hurry Home )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"You always know your home and can return to it at need.  When standing in a "
"doorway, you can use this glamour to return to the last place you slept, as "
"long as you spent at least a day at that place previously and as long as you "
"are unobserved."
msgstr ""

#. ~ Description of spell "changeling_pooka_charm_animals_spell ( Friend to
#. Birds and Beasts )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"You have learned to speak the secret tongues of birds and beasts and may use "
"it to ask them for aid.  Casting this spell on a mammal or a bird will ally "
"them with you, causing them to defend you against your enemies."
msgstr ""

#. ~ Message of spell "changeling_pooka_charm_animals_spell ( Friend to Birds
#. and Beasts )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "You whisper a few words in the language of beasts."
msgstr ""

#. ~ Description of spell "selkie_beguilement_spell ( Beguilement )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"With a wink and a bit of fae glamour, you can enchant a target to defend you "
"for a brief time.  This glamour only <color_yellow>only works</color> on "
"humans."
msgstr ""

#. ~ Description of spell "selkie_fog_cloak_spell ( Cloak of Fog )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"Call a thick fog from the surrounding air, breaking line of sight with your "
"enemies and obscuring your presence.  Weave the glamour again to dispel it."
msgstr ""

#. ~ Message of spell "selkie_fog_cloak_spell ( Cloak of Fog )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "Thick fog billows up around you."
msgstr ""

#. ~ Name of spell "selkie_change_weather_dense_fog_spell"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "Chant of Obscuring Mists"
msgstr ""

#. ~ Description of spell "selkie_change_weather_dense_fog_spell ( Chant of
#. Obscuring Mists )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"Manipulate the weather, pulling the water from the air and cause a thick fog "
"to form and blanket the countryside.  Weave the glamour again to dispel it."
msgstr ""

#. ~ Description of spell "selkie_change_weather_rains_spell ( Aria of the
#. Droplets )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"Manipulate the weather, causing the sky to cloud over and rain to fall.  "
"Weave the glamour again to dispel it.  You cannot control the weather if the "
"temperature is too cold."
msgstr ""

#. ~ Description of spell "selkie_change_weather_rainstorm_spell ( Canticle of
#. Rainstorms )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"Manipulate the weather, causing the sky to cloud over and heavy rains to "
"fall.  Weave the glamour again to dispel it.  You cannot control the weather "
"if the temperature is too cold."
msgstr ""

#. ~ Description of spell "selkie_change_weather_lightningstorm_spell (
#. Symphony of Levin )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"Manipulate the weather, transforming a rainstorm into a violent lightning "
"storm.  It must already be raining heavily to transform the weather into a "
"lightning storm, and a lightning storm cannot be controlled after the glamour"
" is woven."
msgstr ""

#. ~ Description of spell "trow_make_noise_spell ( The One Who Knocks )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "Make a distant knocking sound, leading others astray."
msgstr ""

#. ~ Message of spell "trow_make_noise_spell ( The One Who Knocks )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid "A loud thump resounds."
msgstr ""

#. ~ Description of spell "selkie_cultivate_goblin_fruit ( Cultivate Goblin
#. Fruit )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"You may spin a bit of fae magic into water, bringing forth a goblin fruit.  "
"Goblin fruit have a variety of effects, never predictable but always at least"
" somewhat beneficial.  This spell may only be cast near water or under the "
"rain."
msgstr ""

#. ~ Description of spell "brownie_cultivate_goblin_fruit ( Cultivate Goblin
#. Fruit )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"You may spin a bit of fae magic into the air, bringing forth a goblin fruit."
"  Goblin fruit have a variety of effects, never predictable but always at "
"least somewhat beneficial.  This spell may only be cast indoors, when nobody "
"is watching."
msgstr ""

#. ~ Description of spell "pooka_cultivate_goblin_fruit ( Cultivate Goblin
#. Fruit )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"You may spin a bit of fae magic into the air, bringing forth a goblin fruit."
"  Goblin fruit have a variety of effects, never predictable but always at "
"least somewhat beneficial.  This spell may only be cast near an animal."
msgstr ""

#. ~ Description of spell "trow_cultivate_goblin_fruit ( Cultivate Goblin Fruit
#. )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"You may spin a bit of fae magic into the earth, bringing forth a goblin "
"fruit.  Goblin fruit have a variety of effects, never predictable but always "
"at least somewhat beneficial.  This spell may only be cast underground or at "
"night."
msgstr ""

#. ~ Description of spell "noble_cultivate_goblin_fruit ( Cultivate Goblin
#. Fruit )"
#: data/mods/Xedra_Evolved/spells/changeling_spells.json
msgid ""
"You may spin a bit of fae magic into the air, bringing forth a goblin fruit."
"  Goblin fruit have a variety of effects, never predictable but always at "
"least somewhat beneficial.  This spell may only be cast near a human or a "
"Fae."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_time_freeze_target"
#. ~ Name of spell "xedra_dreamsmith_time_trap_freeze"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
#: data/mods/Xedra_Evolved/spells/item_spells.json
msgid "Time Freeze"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_time_freeze_target ( Time Freeze
#. )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Freeze your target in time, preventing them from acting but also preventing "
"them from suffering harm."
msgstr ""

#. ~ Message of spell "xedra_chronomancer_time_freeze_target ( Time Freeze )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "You freeze your target in time!"
msgstr ""

#. ~ Name of spell "xedra_chronomancer_normalize_time"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Normalize Time"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_normalize_time ( Normalize Time
#. )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Fix the target area's timestream, unfreezing frozen targets and ending any "
"active timeloops."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_normalize_time_loop"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Unfreeze Time - Loop"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_normalize_time_loop ( Unfreeze
#. Time - Loop )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Remove a time loop.  Part of the main unfreeze spell.  Having this spell is a"
" bug."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_normalize_time_terrain"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Unfreeze Time - Terrain"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_normalize_time_terrain ( Unfreeze
#. Time - Terrain )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Unfreeze terrain from frozen time.  Part of the main unfreeze spell.  Having "
"this spell is a bug."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_entropic_burst"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Entropic Burst"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_entropic_burst ( Entropic Burst
#. )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Dangerously destabilize local time in an area, flooding everything within "
"with entropy.  This will destroy any areas of frozen time and steadily erode "
"any creatures caught within."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_entropic_burst_field"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Entropic Burst - Fields"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_entropic_burst_field ( Entropic
#. Burst - Fields )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Remove fields of frozen time.  Part of the Entropic Burst spell.  Having this"
" spell is a bug."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_entropic_burst_effect"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Entropic Burst - Effect"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_entropic_burst_effect ( Entropic
#. Burst - Effect )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Unfreeze target from frozen time.  Part of the main entropic burst spell.  "
"Having this spell is a bug."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_time_bubble"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Time Bubble"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_time_bubble ( Time Bubble )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Create an impenetrable bubble of frozen time at your chosen location, "
"freezing everything within."
msgstr ""

#. ~ Message of spell "xedra_chronomancer_time_bubble ( Time Bubble )"
#. ~ Message of spell "xedra_dreamer_time_bubble ( Summon Time Bubble )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "You create a bubble of frozen time!"
msgstr ""

#. ~ Name of spell "xedra_chronomancer_revert_wound"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Revert Wound"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_revert_wound ( Revert Wound )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Rewind the last injury you have taken, erasing the effects it has had on your"
" person."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_time_loop"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Time Loop"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_time_loop ( Time Loop )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Loop time around your person for a short duration, repeatedly resetting any "
"changes to your person every few seconds."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_time_stop"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Time Stop"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_time_stop ( Time Stop )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Temporarily halt the progression of time for everything but yourself.  Lasts "
"roughly 2 seconds per level."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_revert_location"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Revert Location"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_revert_location ( Revert Location
#. )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Revert yourself to a location you have previously memorized."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_revert_location_attune"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Memorize Location"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_revert_location_attune ( Memorize
#. Location )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Spend time memorizing an area so you can revert your physical location to "
"that spot."
msgstr ""

#. ~ Message after transforming to "xedra_chronomancer_memorized_terrain"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "You don't think you'd forget this spot."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_cement_time"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Cement Time"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_cement_time ( Cement Time )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Stabilize a zone of disjointed time, preventing it from decaying."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_cement_time_terrain"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Cement Time - Target"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_cement_time_terrain ( Cement Time
#. - Target )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Stabilize target of frozen time.  Part of the main cement spell.  Having this"
" spell is a bug."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_paradox"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Paradox"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_paradox ( Paradox )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Create a minute incision in your target's personal timestream, separating "
"their present from their past and thus deleting them from reality in a "
"temporal paradox.  This technique is harder to perform on more powerful foes,"
" and may result in backlash if you are not prepared.  Luckily, this time "
"anomaly is significant enough that merely observing it will give you "
"significant temporal insights based on its strength."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_stable_loop"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Stable Time Loop (T)"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_stable_loop ( Stable Time Loop
#. (T) )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Create a long-lasting time loop around yourself which you can end at any "
"time.  Ending the loop will return you to the state you were in at the start "
"of it."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_chronal_acceleration"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Chronal Acceleration (T)"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_chronal_acceleration ( Chronal
#. Acceleration (T) )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"You speed up the flow of your personal timestream, allowing you to act "
"quicker relative to everything else.  This power will remain active until "
"toggled off."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_destabilizing_strikes"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Destabilizing Strikes (T)"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_destabilizing_strikes (
#. Destabilizing Strikes (T) )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"By maintaining a field of destabilized time around your body, you can "
"effortlessly cause your attacks to erode your target over time.  This power "
"will remain active until toggled off."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_destabilizing_strikes_attack"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Destabilizing Strikes (T) - Attack"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_destabilizing_strikes_attack (
#. Destabilizing Strikes (T) - Attack )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"This causes the dot when attacking targets with the destabilizing strikes "
"buff.  Having the spell is a bug."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_stabilize_timeline"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Stabilize Timeline (T)"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_stabilize_timeline ( Stabilize
#. Timeline (T) )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Stabilize your personal timeline, making yourself immune to adverse changes "
"to time around you.  This power will remain active until toggled off."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_reverse_entropy"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Reverse Entropy (T)"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_reverse_entropy ( Reverse Entropy
#. (T) )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Reverse the entropy on your equipment, repairing any damage it has taken or "
"energy it has spent over time.  This power will remain active until toggled "
"off."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_rewrite_wound_causality"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Rewrite Wound Causality (M)"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_rewrite_wound_causality ( Rewrite
#. Wound Causality (M) )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Sink into a mediative trance where you steadily rewrite the causality of your"
" current wounds, effectively healing yourself of injury.  This power will "
"remain active until you run out of mana or your wounds are healed."
msgstr ""

#. ~ Name of spell "xedra_chronomancer_rewrite_equipment_causality"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid "Rewrite Equipment Causality (M)"
msgstr ""

#. ~ Description of spell "xedra_chronomancer_rewrite_equipment_causality (
#. Rewrite Equipment Causality (M) )"
#: data/mods/Xedra_Evolved/spells/chronomancer.json
msgid ""
"Sink into a mediative trance where you steadily rewrite the causality of your"
" carried items, efficiently repairing any faults they may have.  This power "
"will remain active until you run out of mana or your wounds are healed."
msgstr ""

#. ~ Message of spell "night_sight ( Night Sight )"
#: data/mods/Xedra_Evolved/spells/classless_spells.json
msgid ""
"Your eyes glow lavender for a moment.  Now your sight can pierce the darkest "
"shadows."
msgstr ""

#. ~ Name of spell "dread_weight"
#: data/mods/Xedra_Evolved/spells/classless_spells.json
msgid "Weight of Dread"
msgstr ""

#. ~ Description of spell "dread_weight ( Weight of Dread )"
#: data/mods/Xedra_Evolved/spells/classless_spells.json
msgid ""
"Everything around you faces an existential crisis and moves slower as a "
"result.  Including things that you wouldn't expect to suffer from existential"
" crises, like the undead.  The air around the targets' extremities chills "
"dramatically.  Higher levels allow a bigger AoE, and longer effect."
msgstr ""

#. ~ Name of spell "blur"
#: data/mods/Xedra_Evolved/spells/classless_spells.json
msgid "Blur"
msgstr ""

#. ~ Description of spell "blur ( Blur )"
#: data/mods/Xedra_Evolved/spells/classless_spells.json
msgid ""
"The edges of your form seem to blur and distort, increasing the amount of "
"attacks you might dodge in a given turn."
msgstr ""

#. ~ Name of spell "damage_transfer"
#: data/mods/Xedra_Evolved/spells/classless_spells.json
msgid "Damage Transfer"
msgstr ""

#. ~ Description of spell "damage_transfer ( Damage Transfer )"
#: data/mods/Xedra_Evolved/spells/classless_spells.json
msgid ""
"Allows you to move some damage from your body to someone else.  Usually "
"people don't like it, but who cares now?"
msgstr ""

#. ~ Name of spell "fire_teleport"
#: data/mods/Xedra_Evolved/spells/classless_spells.json
msgid "Pyroportation"
msgstr ""

#. ~ Description of spell "fire_teleport ( Pyroportation )"
#: data/mods/Xedra_Evolved/spells/classless_spells.json
msgid ""
"Transports you from one place to another, creating a huge fire explosion in "
"the end."
msgstr ""

#. ~ Name of spell "call_daffodil"
#: data/mods/Xedra_Evolved/spells/classless_spells.json
msgid "Call Daffodil"
msgstr ""

#. ~ Description of spell "call_daffodil ( Call Daffodil )"
#: data/mods/Xedra_Evolved/spells/classless_spells.json
msgid ""
"A few daffodil warriors appear near you.  They will fight for you, but they "
"will fade away after a day."
msgstr ""

#. ~ NPC message in effect in EoC "EOC_BOANN_RETALIATION_REAL"
#: data/mods/Xedra_Evolved/spells/classless_spells.json
msgid ""
"Boann waves her hands as you strike her, and you are enveloped by a swirl of "
"multicolored lights."
msgstr ""

#. ~ NPC message in effect in EoC "EOC_BOANN_RETALIATION_NON_PLAYER_REAL"
#: data/mods/Xedra_Evolved/spells/classless_spells.json
msgid ""
"Boann waves her hands as her opponent strikes her, and they vanish in a swirl"
" of multicolored lights."
msgstr ""

#. ~ Name of spell "return_critters"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Return Critters"
msgstr ""

#. ~ Description of spell "return_critters ( Return Critters )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Summons your critters back to you, if they got lost."
msgstr ""

#. ~ Name of spell "dream_blade"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Dream Blade"
msgstr ""

#. ~ Description of spell "dream_blade ( Dream Blade )"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid ""
"This ephemeral blade allows you to defend yourself with dreams brought out of"
" your mind!"
msgstr ""

#. ~ Name of spell "dream_dagger"
#: data/mods/Xedra_Evolved/spells/dreamer_spells.json
msgid "Dream Dagger"
msgstr ""
