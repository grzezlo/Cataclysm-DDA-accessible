#: data/json/npcs/lumbermill_employees/TALK_lumbermill_fabricate.json
msgid ""
"We offer various specialty cuts direct to our customers.  Here's a list of "
"available materials.  Order waiting time depends on the amount of lumber "
"ordered.  So, what would you like?"
msgstr ""

