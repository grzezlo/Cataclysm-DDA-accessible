"Come back in that time to pick up your lumber."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/lumbermill_employees/TALK_lumbermill_fabricate.json
msgid "Actually, I don't want to place an order."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/lumbermill_employees/TALK_lumbermill_fabricate.json
