#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "cubic goblin fruit"
msgid_plural "cubic goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "cubic goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This pale blue goblin fruit is a cube, and the edges are fine enough to leave"
" a line in your thumb when you press on them.  It smells incredibly sour."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "smoky goblin fruit"
msgid_plural "smoky goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "smoky goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This sharply-curved goblin fruit is an off-white color turning red toward the"
" ends.  It smells like the alley outside a club."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "inky goblin fruit"
msgid_plural "inky goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "inky goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This large goblin fruit is such a deep black color you can't actually tell "
"exactly what shape it is.  It's roundish, but when you hold it, it seems more"
" like you're holding a hole in the fabric of the world.  It smells like an "
"apple."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "toroid goblin fruit"
msgid_plural "toroid goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "toroid goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This yellow-green goblin fruit is shaped like a donut, with six reddish stems"
" spaced equidistantly around its circumference.  You can't imagine what the "
"plant that grew this one looks like."
msgstr ""

#. ~ Item name
#. ~ Dolm is a fictional color from the 1920 book "A Voyage to Arcturus" that's
#. a mix of infrared and blue.
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "dolm goblin fruit"
msgid_plural "dolm goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "dolm goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This teardrop-shaped goblin fruit hurts to look at.  Sometimes it's a dark "
"blue, sometimes it's a feverish red, and sometimes it's a mix of the two that"
" you would previously have sworn could not exist.  It smells faintly peppery "
"with a hint of lemon."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "spikey goblin fruit"
msgid_plural "spikey goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "spikey goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This dark-colored goblin fruit is covered in spikes like a pineapple.  Unlike"
" a pineapple, the spikes are yielding and seem part of the fruit, not a rind."
"  It smells of freshly-cut grass."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "sanguine goblin fruit"
msgid_plural "sanguine goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "sanguine goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"A dark red goblin fruit with a heavy iron smell.  It feels warm to the touch."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "translucent goblin fruit"
msgid_plural "translucent goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "translucent goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This goblin fruit looks like a globe of water with seeds and a stem suspended"
" within it.  Despite that, it feels like kiwi, with a slight fuzz and no "
"moisture left on your fingers when you touch it.  It smells like roses."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "inconspicuous goblin fruit"
msgid_plural "inconspicuous goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "inconspicuous goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This goblin fruit looks like a pear and feels like a pear and smells exactly "
"like a pear.  You have no idea how it tastes because the instant you put your"
" tongue to it, your entire mouth goes numb."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "crumbly goblin fruit"
msgid_plural "crumbly goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "crumbly goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This large, curved goblin fruit is a dark blue color and feels like it's "
"already on the verge of rotting.  It takes very little pressure for your "
"fingers to bruise the skin and the flesh inside flakes off when you touch it."
"  It smells like sun-ripened strawberries."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "star-shaped goblin fruit"
msgid_plural "star-shaped goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "star-shaped goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This greenish-white goblin fruit is shaped like a star in a much more literal"
" way than a starfruit.  It's almost like if a starfish was an apple.  It "
"smells like freshly-laundered clothing."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "shadowy goblin fruit"
msgid_plural "shadowy goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "shadowy goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This greyish goblin fruit is shaped like a pear, if pears had scales like a "
"pinecone.  There is a pulpy meat underneath the scales."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "shiny goblin fruit"
msgid_plural "shiny goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "shiny goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This round blue goblin fruit glows bright enough to read by.  The light "
"flickers like firelight, even when the fruit is simply placed on the table.  "
"It smells like pine needles soaked in strong alcohol."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_GOBLIN_FRUIT_GIANT_GROWTH"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "You eat the goblin fruit but nothing happens.  Oh well."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "fizzy goblin fruit"
msgid_plural "fizzy goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "fizzy goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This small brown goblin fruit constantly forms bubbles that erupt from its "
"skin.  Despite that, its surface remains smooth at all times.  It has a "
"subtle, sugary smell."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "unnoticeable goblin fruit"
msgid_plural "unnoticeable goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "unnoticeable goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This goblin fruit is hard to perceive.  You think it's black, you believe "
"it's small and you're certain it's near you, but all its other details slip "
"from your memory the instant you stop looking at this fruit."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "heavy goblin fruit"
msgid_plural "heavy goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "heavy goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This green goblin fruit is much heavier than it should be.  Its scent is "
"heavy, pressing down your nose and throat as you smell it."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "soothing goblin fruit"
msgid_plural "soothing goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "soothing goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This sky blue fruit slows the thoughts racing in your mind a little as you "
"stare at it, making you feel sightly more calm until you put it away."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "melodious goblin fruit"
msgid_plural "melodious goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "melodious goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This sinewy, beak-shaped fruit produces a faint melody.  This melody grows a "
"little louder when you bring the fruit next to your mouth."
msgstr ""

#. ~ Player message in effect in EoC "EOC_GOBLIN_FRUIT_MUSIC"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "The fruit's melody fills your head."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_GOBLIN_FRUIT_MUSIC"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"Another song is already struck in your head and won't share its space with "
"another."
msgstr ""

#. ~ Player message in effect in EoC "EOC_GOBLIN_FRUIT_MUSIC_REMOVE"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "The song in your head fades."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "mirror goblin fruit"
msgid_plural "mirror goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "mirror goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"You can see your reflection in the mirror-like surface of this fruit.  This "
"reflection of you seems angrier, closer to a feral human than to your own "
"image."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "camouflaged goblin fruit"
msgid_plural "camouflaged goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "camouflaged goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"The many colors of this oblong fruit shift to mimic what's behind it, trying "
"to imitate other things with the best of its ability."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "bitter goblin fruit"
msgid_plural "bitter goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "bitter goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This fruit wrapped in barbed vines fills you with bitterness as you hold it."
"  It slightly resists inertia as you move it, as if it moved through "
"molasses."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "evasive goblin fruit"
msgid_plural "evasive goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "evasive goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This yellow half-liquid fruit is hard to hold, as it actively tries to escape"
" your grasp.  You hope it won't try to escape your innards after you eat it."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "vein-filled goblin fruit"
msgid_plural "vein-filled goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "vein-filled goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This translucent fruit is filled with a network of tubes not unlike veins and"
" arteries.  Judging by the way its brown surface turns blue when bruised, it "
"probably contains a fluid similar to blood."
msgstr ""

#. ~ Player message in effect in EoC "EOC_GOBLIN_FRUIT_BLOOD_GAIN"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "This isn't the blood you need."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_GOBLIN_FRUIT_BLOOD_GAIN"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "You feel a pressure in your veins, then it passes."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "dazzling goblin fruit"
msgid_plural "dazzling goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "dazzling goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This fruit shines a light bright enough to be painful to look at.  From the "
"little you can see, it appears to be a purple ovoid fruit."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "rotating goblin fruit"
msgid_plural "rotating goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "rotating goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This spiraled fruit ceaselessly spins on itself.  No matter how tight your "
"grasp, you cannot stop its spinning."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "pulsating goblin fruit"
msgid_plural "pulsating goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "pulsating goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This fruit pulses at regular intervals like a beating heart.  As you hold it "
"its rhythm changes, mimicking your own heart."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "understandable goblin fruit"
msgid_plural "understandable goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "understandable goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"You understand everything about this pale green fruit.  You know that it will"
" taste like an apple and you know that it will have the inner structure of a "
"kiwi, the texture of a durian, the smell of a dragon fruit and the colors of "
"an orange.  you also know that eating it will help you understand anything "
"you could try to learn for a few hours."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "pupating goblin fruit"
msgid_plural "pupating goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "pupating goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This dark red half-liquid fruit fills you with dread and sadness as it "
"endlessly tries to split but fails to do so.  You sense that it wants you to "
"eat it, but you're not sure if it would be worth it."
msgstr ""

#. ~ Player message in effect in EoC "EOC_GOBLIN_FRUIT_SPAWN_MORE_FRUITS"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"Some hard chunks of that horrible fruit jump from your mouth and turn into "
"fresh goblin fruits."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "patchwork goblin fruit"
msgid_plural "patchwork goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "patchwork goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This fruit is closer to an art project than to a fruit.  Numerous stitches "
"hold together red-tinted parts of many different fruits so tightly it acts as"
" a single, consistent whole."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "pristine goblin fruit"
msgid_plural "pristine goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "pristine goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This fruit has a perfectly unblemished surface that cannot be tarnished or "
"dirtied, no matter what happens to it."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "numbing goblin fruit"
msgid_plural "numbing goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "numbing goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This gray dented fruit numbs your fingers as you hold it and its smell numbs "
"your nose the same way."
msgstr ""

#. ~ Player message in effect in EoC "EOC_GOBLIN_FRUIT_NUMB"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "Everything goes numb."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_GOBLIN_FRUIT_NUMB"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "You don't feel more numb than you currently are."
msgstr ""

#. ~ Player message in effect in EoC "EOC_GOBLIN_FRUIT_NUMB_REMOVE"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "The numbness goes away."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "whispering goblin fruit"
msgid_plural "whispering goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "whispering goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This fruit is similar to a sphere of smoke.  Faint sounds come from this "
"fruit.  They almost sound like whispers."
msgstr ""

#. ~ Player message in effect in EoC "EOC_GOBLIN_FRUIT_SPAWN_SHADOWS"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "A few shadows emerge from the ground near you."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "recoloring goblin fruit"
msgid_plural "recoloring goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "recoloring goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This rectangle fruit smells of lavender and has a mushy texture.  Its colors "
"grow more vibrant for a second when you blink."
msgstr ""

#. ~ Player message in effect in EoC
#. "EOC_GOBLIN_FRUIT_HEAL_AFTER_SLEEP_HEALING"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "Some of the aches of yesterday are gone."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "fractal goblin fruit"
msgid_plural "fractal goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "fractal goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This spherical fruit is made of smaller versions of itself, which are also "
"made of smaller versions of themselves.  Should you have a microscope, you "
"could look at the fractal as it becomes smaller and smaller."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "sticky goblin fruit"
msgid_plural "sticky goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "sticky goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"Reeking of glass cleaner, this disk-shaped fruit sticks to anything it "
"touches.  Despite this, you have no issue removing any dust sticking to it."
msgstr ""

#. ~ Item name
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid "pressurized goblin fruit"
msgid_plural "pressurized goblin fruits"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "pressurized goblin fruit"
#: data/mods/Xedra_Evolved/items/comestibles/goblin_fruits.json
msgid ""
"This capsule-shaped goblin fruit behaves as a pressurized tank when you press"
