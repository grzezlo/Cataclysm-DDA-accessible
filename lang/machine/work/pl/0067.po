msgid ""
"Reality twists and deforms as a wriggling chunk of it falls on the ground."
msgstr ""

#. ~ Player sees monster spawns in effect in EoC "EOC_PORTAL_ARTIFACT_STRONG"
#: data/json/effects_on_condition/nether_eocs/portal_storm_effect_on_condition.json
