#. ~ Variant name of item "Desert Eagle pistol"
#: data/json/items/gun/44.json
msgid "Desert Eagle Mark XIX pistol"
msgid_plural "Desert Eagle Mark XIX pistols"
msgstr[0] "pistolet Desert Eagle Mark XIX"
msgstr[1] "pistolety Desert Eagle Mark XIX"
msgstr[2] "pistoletów Desert Eagle Mark XIX"
