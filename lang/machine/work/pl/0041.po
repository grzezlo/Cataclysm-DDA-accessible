#: data/json/items/gun/458wm.json
msgid "Winchester Model 70 Safari rifle"
msgid_plural "Winchester Model 70 Safari rifles"
msgstr[0] "karabin Winchester Model 70 Safari"
msgstr[1] "karabiny Winchester Model 70 Safari"
msgstr[2] "karabinów Winchester Model 70 Safari"
msgstr[3] "karabinu Winchester Model 70 Safari"

#. ~ Description of variant "Safari rifle" of gun "Winchester Model 70 Safari
#. rifle"
#. ~ Description of variant "Winchester Model 70 Safari rifle" of item "Safari
#. rifle"
#: data/json/items/gun/458wm.json
msgid ""
"This is a Winchester Model 70 Safari Express chambered in .458 Winchester "
"Magnum, a fine bolt-action rifle for hunting dangerous game.  A fixture of "
"American gun culture, the Model 70 has been held in high regard by shooters "
"since it was introduced in 1936."
msgstr ""
"Winchester Model 70 Safari Express w kalibrze .458 Winchester Magnum, "
"znakomity karabin z zamkiem czterotaktowym do polowania na niebezpieczną "
"zwierzynę. Stały element amerykańskiej kultury strzeleckiej, Model 70 cieszy "
"się uznaniem strzelców od czasu wprowadzenia w 1936 roku."

