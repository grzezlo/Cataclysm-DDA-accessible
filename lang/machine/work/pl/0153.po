msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "American zebra"
#: data/mods/Megafauna/monsters/mf_wild.json
msgid "A hooved grazing mammal with a brown-and-white striped coat."
msgstr ""

#. ~ Description of monster "Scott's horse foal"
#: data/mods/Megafauna/monsters/mf_wild.json
msgid ""
"A juvenile American zebra.  It gallops around its parent excitedly, throwing "
"around its head joyously."
msgstr ""

