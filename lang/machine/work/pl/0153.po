#. ~ Description of monster "mastodon"
#: data/mods/Megafauna/monsters/mf_wild.json
msgid ""
"Shorter, but more massive than a woolly mammoth, and - crucially - much less "
"hairy.  Its trunk lazily swings around its two massive, upward-curving tusks."
msgstr ""

#. ~ Monster name
#: data/mods/Megafauna/monsters/mf_wild.json
msgid "mastodon cub"
msgid_plural "mastodon cubs"
