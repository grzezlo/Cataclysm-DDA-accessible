#: src/handle_action.cpp
msgid "Disable autohaul"
msgstr "Wyłącz automatyczne ciągnięcie"

#: src/handle_action.cpp
msgid "Enable autohaul"
msgstr "Włącz automatyczne ciągnięcie"

#: src/handle_action.cpp
msgid "Edit autohaul filter"
msgstr "Edytuj filtr automatycznego ciągnięcia"

#: src/handle_action.cpp
msgid "Select items to haul"
msgstr "Wybierz przedmioty do ciągnięcia"

#: src/handle_action.cpp
msgid "Keep smashing until destroyed?"
msgstr "Rozbijać aż do zniszczenia?"

#: src/handle_action.cpp
msgid "Wait 20 heartbeats"
msgstr "Zaczekaj 20 uderzeń serca"

#: src/handle_action.cpp
msgid "Wait 60 heartbeats"
msgstr "Zaczekaj 60 uderzeń serca"

#: src/handle_action.cpp
msgid "You can't sleep while controlling a vehicle."
msgstr "Nie możesz spać, kierując pojazdem."

#: src/handle_action.cpp
msgid "You cannot sleep while airborne."
msgstr "Nie możesz spać w powietrzu."

#: src/handle_action.cpp
msgid "Unload nearby containers"
msgstr "Rozładuj pobliskie pojemniki"

#: src/handle_action.cpp
msgid "Unloads any corpses or containers that are in their respective zones."
msgstr ""
"Rozładowuje wszystkie zwłoki i pojemniki znajdujące się w odpowiednich "
"strefach."

#: src/handle_action.cpp
msgid "You refuse to use ranged weapons."
msgstr "Odmawiasz używania broni dystansowej."

#: src/handle_action.cpp
msgid "You refuse to use firearms."
msgstr "Odmawiasz używania broni palnej."

#: src/handle_action.cpp
msgid "You cannot cast spells at this moment."
msgstr "W tej chwili nie możesz rzucać zaklęć."

#: src/handle_action.cpp
msgid "Cast a spell first"
msgstr "Najpierw rzuć zaklęcie"

#: src/handle_action.cpp
msgid "You can't drop things while you're in your shell."
msgstr "Nie możesz upuszczać rzeczy, będąc w swojej skorupie."

#: src/handle_action.cpp
msgid "You can't disassemble while you're in your shell."
msgstr "Nie możesz demontować rzeczy, będąc w swojej skorupie."

#: src/handle_action.cpp
#, c-format
msgid "Your %s has only one firing mode."
msgstr "Przedmiot %s ma tylko jeden tryb strzelania."

#: src/handle_action.cpp
msgid "You have no idea where you are."
msgstr "Nie masz pojęcia, gdzie jesteś."

#. ~ %1$s: liquid name, %2$s: container name
#: src/handle_liquid.cpp
#, c-format
msgctxt "liquid"
msgid ""
"The %1$s would spill.\n"
"What to do with the %2$s inside it?"
msgstr ""
"Zawartość pojemnika %1$s by się rozlała.\n"
"Co zrobić z płynem %2$s w środku?"

#. ~ %1$s: liquid name, %2$s: container name
#: src/handle_liquid.cpp
#, c-format
msgctxt "liquid"
msgid "What to do with the %1$s in the %2$s?"
msgstr "Co zrobić z płynem %1$s w pojemniku %2$s?"

#: src/handle_liquid.cpp
msgid "Select a container"
msgstr "Wybierz pojemnik"

#: src/handle_liquid.cpp
#, c-format
msgid "Select an adjacent keg (%s)"
msgstr "Wybierz pobliski keg (%s)"

#. ~ EOC option name in nested effect in then statement in effect in EoC
#. "EOC_WARPED_POND_CREATION"
#: src/help.cpp data/mods/Sky_Island/EOCs.json
msgid "Northwest"
msgstr "Północny zachód"

#. ~ EOC option name in nested effect in then statement in effect in EoC
#. "EOC_WARPED_POND_CREATION"
#: src/help.cpp data/mods/Sky_Island/EOCs.json
msgid "Northeast"
msgstr "Północny wschód"

#. ~ EOC option name in nested effect in then statement in effect in EoC
#. "EOC_WARPED_POND_CREATION"
#: src/help.cpp data/mods/Sky_Island/EOCs.json
msgid "Southwest"
msgstr "Południowy zachód"

#. ~ EOC option name in nested effect in then statement in effect in EoC
#. "EOC_WARPED_POND_CREATION"
#: src/help.cpp data/mods/Sky_Island/EOCs.json
msgid "Southeast"
msgstr "Południowy wschód"

#: src/iexamine.cpp
msgid "Select Genetic Treatment"
msgstr "Wybierz terapię genetyczną"

#: src/iexamine.cpp
msgid "You aren't carrying have any genetic treatments."
msgstr "Nie masz przy sobie żadnych terapii genetycznych."

#: src/iexamine.cpp
msgid "Trait will be reverted to base human morphology."
msgstr "Cecha zostanie przywrócona do bazowej ludzkiej morfologii."

#: src/iexamine.cpp
msgid "Conflicts with installed:"
msgstr "Koliduje z zainstalowanymi:"

#: src/iexamine.cpp
msgid "Requires any of the following traits:"
msgstr "Wymaga dowolnej z następujących cech:"

#: src/iexamine.cpp
msgid ""
"As you wake, you find yourself much more attuned to your new form than "
"before."
msgstr ""
"Po przebudzeniu czujesz się znacznie bardziej zżyty ze swoją nową postacią "
"niż wcześniej."

#: src/iexamine.cpp
msgid ""
"As you wake, you feel like if you have lost a once important part of "
"yourself."
msgstr ""
"Po przebudzeniu czujesz się tak, jakbyś utracił niegdyś ważną część siebie."

#: src/iexamine.cpp
msgid "Translocate"
msgstr "Translokuj"

#: src/iexamine.cpp
msgid "Adjust activation status"
msgstr "Zmień stan aktywacji"

#: src/iexamine.cpp
msgid "Select destination floor"
msgstr "Wybierz piętro docelowe"

#: src/iexamine.cpp
msgid " (this floor)"
msgstr " (to piętro)"

#: src/iexamine.cpp
msgid "You must stand inside the elevator to use it."
msgstr "Musisz stać wewnątrz windy, aby z niej skorzystać."

#: src/iexamine.cpp
#, c-format
msgid "The %s is blocking the elevator"
msgstr "Pojazd %s blokuje windę"

#: src/iexamine.cpp
#, c-format
msgid "Pull up the %s?"
msgstr "Wciągnąć do góry: %s?"

#: src/iexamine.cpp
#, c-format
msgid "You pull up the %s."
msgstr "Wciągasz do góry: %s."

#: src/iexamine.cpp
msgid "You carefully dial a combination… and it opens!"
msgstr "Ostrożnie wybierasz kombinację… i otwiera się!"

#: src/iexamine.cpp
msgid "You carefully dial a combination."
msgstr "Ostrożnie wybierasz kombinację."

#: src/iexamine.cpp
#, c-format
msgid "There's nobody here to protect %s.  Do you want to claim ownership?"
msgstr ""
"Nie ma tu nikogo, kto by bronił obozu %s. Chcesz go przejąć na własność?"

#: src/iexamine.cpp
#, c-format
msgid ""
"Take whatever you can find from the stores?  This may anger %s and their "
"allies."
msgstr ""
"Zabrać wszystko, co znajdziesz w magazynach? Może to rozgniewać frakcję %s i "
"jej sojuszników."

#: src/iexamine.cpp
msgid "You don't run this camp, the board is useless to you."
msgstr "Nie zarządzasz tym obozem, ta tablica jest dla ciebie bezużyteczna."

#: src/iexamine.cpp
msgid "This bulletin board is not inside a camp."
msgstr "Ten słup ogłoszeniowy nie znajduje się w obozie."

#: src/iexamine.cpp
msgid "This type of seed can not be planted in this location."
msgstr "Tego rodzaju nasion nie można zasadzić w tym miejscu."

#: src/iexamine.cpp
msgid "You pull up what's left of the planted crop and trample the rest."
msgstr "Wyrywasz to, co zostało z posadzonej uprawy, a resztę rozdeptujesz."

#: src/iexamine.cpp
msgid "You will need a grass-cutting tool to harvest this plant."
msgstr "Do zebrania tej rośliny potrzebujesz narzędzia do ścinania trawy."

#: src/iexamine.cpp
msgid "You harvest the plant."
msgstr "Zbierasz roślinę."

#: src/iexamine.cpp
#, c-format
msgid "This %s is ready to be fired, but you have no fire source."
msgstr "Można rozpalić: %s, ale nie masz źródła ognia."

#: src/iexamine.cpp
#, c-format
msgid "Fire the %s?"
msgstr "Rozpalić ogień w: %s?"

#: src/iexamine.cpp
#, c-format
msgid "This pile contains %s, which can't be dried here!"
msgstr "Ta sterta zawiera %s, czego nie da się tu wysuszyć!"

#: src/iexamine.cpp
msgid "Place some fresh grain here and try again."
msgstr "Połóż tu trochę świeżego zboża i spróbuj ponownie."

#: src/iexamine.cpp
msgid "The stook will need to be set up outside to dry."
msgstr "Mendel trzeba ustawić na zewnątrz, żeby wysechł."

#: src/iexamine.cpp
msgid "This pile contains grain that is ready to be left out for drying."
msgstr "Ta sterta zawiera zboże gotowe do pozostawienia do wyschnięcia."

#: src/iexamine.cpp
msgid "Stand the grain up to dry?"
msgstr "Ustawić zboże w mendel do wyschnięcia?"

#: src/iexamine.cpp
msgid "You set up the stook and leave it to dry."
msgstr "Ustawiasz mendel i zostawiasz go do wyschnięcia."

#: src/iexamine.cpp
msgid "Examined furniture is stook_full but doesn't contain any grain."
msgstr "Badany mebel to stook_full, ale nie zawiera zboża."

#: src/iexamine.cpp
msgid "There's a grain stook there."
msgstr "Stoi tu mendel zboża."

#: src/iexamine.cpp
#, c-format
msgid "The stook will finish drying in %s."
msgstr "Mendel skończy schnąć za %s."

#: src/iexamine.cpp
msgid "You take down the stook as the drying process is now finished."
msgstr "Rozkładasz mendel, bo proces suszenia już się zakończył."

#: src/iexamine.cpp
#, c-format
msgid "You remove the %s from the vat."
msgstr "Wyjmujesz z kadzi: %s."

#: src/iexamine.cpp
msgid "This tank is empty."
msgstr "Ten zbiornik jest pusty."

#: src/iexamine.cpp
msgid "You have nothing that could be used as biomass to ferment."
msgstr ""
"Nie masz niczego, co dałoby się wykorzystać jako biomasę do fermentacji."

#: src/iexamine.cpp
msgid "What do you want to use as biomass?"
msgstr "Czego chcesz użyć jako biomasy?"

#: src/iexamine.cpp
#, c-format
msgid "Set %s in the tank?"
msgstr "Umieścić w zbiorniku: %s?"

#: src/iexamine.cpp
#, c-format
msgid "This tank contains %s (%d), %0.f%% full."
msgstr "Ten zbiornik zawiera %s (%d), zapełnienie %0.f%%."

#: src/iexamine.cpp
#, c-format
msgid "Add more %s to the tank"
msgstr "Dodaj do zbiornika więcej: %s"

#: src/iexamine.cpp
#, c-format
msgid "Remove %s from the tank"
msgstr "Wyjmij ze zbiornika: %s"

#: src/iexamine.cpp
msgid "Start anaerobic digestion"
msgstr "Rozpocznij fermentację beztlenową"

#: src/iexamine.cpp
#, c-format
msgid "Set %s in the tank."
msgstr "Umieszczasz w zbiorniku: %s."

#: src/iexamine.cpp
#, c-format
msgid "The tank now contains %s (%d), %0.f%% full."
msgstr "Zbiornik zawiera teraz %s (%d), zapełnienie %0.f%%."

#: src/iexamine.cpp
msgid "Start anaerobic digestion?"
msgstr "Rozpocząć fermentację beztlenową?"

#: src/iexamine.cpp
msgid "The tank is full, so you close the lid and start anaerobic digestion."
msgstr ""
"Zbiornik jest pełny, więc zamykasz pokrywę i rozpoczynasz fermentację "
"beztlenową."

#: src/iexamine.cpp
msgid "You close the lid and start anaerobic digestion."
msgstr "Zamykasz pokrywę i rozpoczynasz fermentację beztlenową."

#: src/iexamine.cpp
#, c-format
msgid "You remove %s from the tank."
msgstr "Wyjmujesz ze zbiornika: %s."

#: src/iexamine.cpp
#, c-format
msgid "There's a tank of %s set to ferment there."
msgstr "Stoi tu zbiornik z fermentującym: %s."

#: src/iexamine.cpp
msgid "It will finish fermenting in less than an hour."
msgstr "Fermentacja zakończy się za mniej niż godzinę."

#: src/iexamine.cpp
#, c-format
msgid "It will finish fermenting in about %d hour."
msgid_plural "It will finish fermenting in about %d hours."
msgstr[0] "Fermentacja zakończy się za około %d godzinę."
msgstr[1] "Fermentacja zakończy się za około %d godziny."
msgstr[2] "Fermentacja zakończy się za około %d godzin."
msgstr[3] "Fermentacja zakończy się za około %d godziny."

#: src/iexamine.cpp
#, c-format
msgid "It will finish fermenting in about %d day."
msgid_plural "It will finish fermenting in about %d days."
msgstr[0] "Fermentacja zakończy się za około %d dzień."
msgstr[1] "Fermentacja zakończy się za około %d dni."
msgstr[2] "Fermentacja zakończy się za około %d dni."
msgstr[3] "Fermentacja zakończy się za około %d dnia."

#: src/iexamine.cpp
msgid "Gather biogas?  Can't stop once releasing started."
msgstr "Zebrać biogaz? Po rozpoczęciu uwalniania nie da się go przerwać."

#: src/iexamine.cpp
msgid "No biogas gathered."
msgstr "Nie zebrano biogazu."

#: src/iexamine.cpp
msgid "You released some biogas from the tank."
msgstr "Wypuszczasz trochę biogazu ze zbiornika."

#: src/iexamine.cpp
#, c-format
msgid "Gathered %s units of biogas."
msgstr "Zebrano jednostki biogazu: %s."

#: src/iexamine.cpp
#, c-format
msgid "Biogas generating process started for about %d day."
msgid_plural "Biogas generating process started for about %d days."
msgstr[0] "Rozpoczęto proces wytwarzania biogazu na około %d dzień."
msgstr[1] "Rozpoczęto proces wytwarzania biogazu na około %d dni."
msgstr[2] "Rozpoczęto proces wytwarzania biogazu na około %d dni."
msgstr[3] "Rozpoczęto proces wytwarzania biogazu na około %d dnia."

#: src/iexamine.cpp
msgid "Finish fermenting?"
msgstr "Zakończyć fermentację?"

#: src/iexamine.cpp
#, c-format
msgid "The %s is now ready for use."
msgstr "Gotowe do użycia: %s."

#: src/iexamine.cpp
#, c-format
msgid "You removed the %s from the tank."
msgstr "Wyjąłeś ze zbiornika: %s."

#: src/iexamine.cpp
#, c-format
msgid "There's a tank of %s there."
msgstr "Stoi tu zbiornik z zawartością: %s."

#. ~ $1 - furniture name, $2 - liquid name, $3 - liquid charges, $4 - liquid
#. volume, $5 - liquid capacity
#: src/iexamine.cpp
#, c-format
msgid "%1$s with %2$s (%3$d)    %4$s / %5$s"
msgstr "%1$s z: %2$s (%3$d)    %4$s / %5$s"

#: src/iexamine.cpp
msgid "You don't have a container at hand."
msgstr "Nie masz pod ręką pojemnika."

#: src/iexamine.cpp
msgid "Use which tapping tool?"
msgstr "Którego narzędzia do nacinania użyć?"

#: src/iexamine.cpp
msgid "You don't have a tapping tool at hand."
msgstr "Nie masz pod ręką narzędzia do nacinania drzew."

#: src/iexamine.cpp
#, c-format
msgid "You drill the maple tree crust and tap a %s into the prepared hole."
msgstr "Nawiercasz korę klonu i wbijasz w przygotowany otwór przedmiot %s."

#: src/iexamine.cpp
#, c-format
msgid "You hang the %s under the %s to collect sap."
msgstr "Wieszasz przedmiot %s pod: %s, aby zbierać sok."

#: src/iexamine.cpp
#, c-format
msgid "You need a hammering tool to remove the %s from the crust."
msgstr "Potrzebujesz narzędzia do wbijania, aby wyjąć przedmiot %s z kory."

#: src/iexamine.cpp
#, c-format
msgid "You remove %1$s from the %2$s."
msgstr "Wyjmujesz z: %2$s przedmiot %1$s."

#: src/iexamine.cpp
#, c-format
msgid "The %s is full, cannot reload."
msgstr "%s ma pełny zapas, nie można przeładować."

#: src/iexamine.cpp
#, c-format
msgid "This %s is already loaded with %s!"
msgstr "%s: już załadowano %s!"

#: src/iexamine.cpp
#, c-format
msgid "How many liters of %s to buy?  Max: %d L."
msgstr "Ile litrów kupić: %s? Maks.: %d l."

#: src/iexamine.cpp
msgid "Peek down."
msgstr "Zajrzyj w dół."

#: src/iexamine.cpp
#, c-format
msgid "Reach for the %s below."
msgstr "Sięgnij do: %s poniżej."

#: src/iexamine.cpp
msgid "Can't jump across (need a small gap)."
msgstr "Nie da się przeskoczyć (potrzebna mała szczelina)."

#: src/iexamine.cpp
msgid "Jump across."
msgstr "Przeskocz."

#: src/iexamine.cpp
msgid "Fall down."
msgstr "Spadnij."

#: src/iexamine.cpp
msgid "Glide away."
msgstr "Odleć szybując."

#: src/iexamine.cpp
msgid "You can't glide in your current state"
msgstr "Nie możesz szybować w obecnym stanie"

#: src/iexamine.cpp
msgid "You can't peek down there."
msgstr "Nie możesz tam zajrzeć w dół."

#: src/iexamine.cpp
msgid "You peek over the ledge."
msgstr "Zaglądasz przez krawędź."

#: src/iexamine.cpp
msgid "You soar away from the ledge."
msgstr "Odlatujesz szybując znad krawędzi."

#: src/iexamine.cpp
msgid "Your glide is aided by a tailwind."
msgstr "Twojemu lotowi pomaga wiatr w plecy."

#: src/iexamine.cpp
msgid "Your glide is hindered by a headwind."
msgstr "Twój lot utrudnia wiatr w twarz."

#: src/iexamine.cpp
msgid "Climbing might be safer.  Really fall from the ledge?"
msgstr "Wspinaczka może być bezpieczniejsza. Na pewno chcesz spaść z krawędzi?"

#: src/iexamine.cpp
#, c-format
msgid ""
"The Autodoc detected ongoing blood loss from your %s and administered you "
"hemostatic drugs to stop it."
msgstr ""
"Autodok wykrył trwającą utratę krwi (%s) i podał ci leki hemostatyczne, aby "
"ją zatamować."

#: src/iexamine.cpp
#, c-format
msgid ""
"The Autodoc detected ongoing blood loss from <npcname>'s %s and administered "
"them hemostatic drugs to stop it."
msgstr ""
"Autodok wykrył trwającą utratę krwi u <npcname> (%s) i podał leki "
"hemostatyczne, aby ją zatamować."

#: src/iexamine.cpp
#, c-format
msgid ""
"The Autodoc detected an open wound on your %s and applied disinfectant to "
"sterilize it."
msgstr ""
"Autodok wykrył otwartą ranę (%s) i zastosował środek dezynfekujący, aby ją "
"wysterylizować."

#: src/iexamine.cpp
#, c-format
msgid ""
"The Autodoc detected an open wound on <npcname>'s %s and applied disinfectant"
" to sterilize it."
msgstr ""
"Autodok wykrył otwartą ranę u <npcname> (%s) i zastosował środek "
"dezynfekujący, aby ją wysterylizować."

#: src/iexamine.cpp
msgid ""
"The Autodoc detected an anti-radiation drug in your bloodstream, so it "
"decided not to administer you another dose right now."
msgstr ""
"Autodok wykrył w twoim krwiobiegu lek antyradiacyjny, więc postanowił na "
"razie nie podawać ci kolejnej dawki."

#: src/iexamine.cpp
msgid ""
"The Autodoc detected an anti-radiation drug in <npcname>'s bloodstream, so it"
" decided not to administer them another dose right now."
msgstr ""
"Autodok wykrył lek antyradiacyjny w krwiobiegu <npcname>, więc postanowił na "
"razie nie podawać kolejnej dawki."

#: src/iexamine.cpp src/item.cpp
#, c-format
msgid "Failed to find milling recipe for %s."
msgstr "Nie znaleziono przepisu mielenia dla: %s."

#: src/iexamine.cpp src/item.cpp
#, c-format
msgid "Failed to find milling recipe for %s. It can't be milled."
msgstr "Nie znaleziono przepisu mielenia dla: %s. Nie można tego zmielić."

#: src/iexamine.cpp
#, c-format
msgid "This mill contains too little of %s, which requires a batch size of %d."
msgstr "Ten młyn zawiera za mało: %s, wymagana wielkość partii to %d."

#: src/iexamine.cpp
#, c-format
msgid ""
"This mill doesn't contain a full last batch of %s, which requires a batch "
"size of %d."
msgstr ""
"Ten młyn nie zawiera pełnej ostatniej partii: %s, wymagana wielkość partii to"
" %d."

#: src/iexamine.cpp
#, c-format
msgid "You remove the excess %s from the mill."
msgstr "Wyjmujesz z młyna nadmiar: %s."

#: src/iexamine.cpp
#, c-format
msgid "Failed to find milling recipe for %s. It wasn't milled."
msgstr "Nie znaleziono przepisu mielenia dla: %s. Nic nie zmielono."

#: src/iexamine.cpp
#, c-format
msgid "Failed to find milling recipe for %s. Milling of it failed."
msgstr "Nie znaleziono przepisu mielenia dla: %s. Mielenie się nie powiodło."

#: src/iexamine.cpp
#, c-format
msgid "%s is milled in batches of %d, so none was processed."
msgstr "Przedmiot %s jest mielony w partiach po %d, więc nic nie przetworzono."

#: src/iexamine.cpp
#, c-format
msgid "%s is milled in batches of %d, so %d remained unprocessed."
msgstr ""
"Przedmiot %s jest mielony w partiach po %d, więc %d pozostało "
"nieprzetworzone."

#: src/iexamine.cpp
#, c-format
msgid ""
"Failed to find milling recipe for %s. It can't be inserted into the mill."
msgstr ""
"Nie znaleziono przepisu mielenia dla: %s. Nie można tego włożyć do młyna."

#: src/iexamine.cpp
#, c-format
msgid "Failed to find milling recipe for %s. Cannot be placed into the mill."
msgstr ""
"Nie znaleziono przepisu mielenia dla: %s. Nie można tego umieścić w młynie."

#: src/iexamine_actors.cpp
msgid "This card-reader cannot be hacked."
msgstr "Tego czytnika kart nie da się zhakować."

#: src/iexamine_actors.cpp
msgid "Pick a projectile to be used."
msgstr "Wybierz pocisk do użycia."

#: src/iexamine_actors.cpp
