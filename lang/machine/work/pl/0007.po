#: src/scenario.cpp
msgid ""
"\n"
"This scenario can only be unlocked through achievements."
msgstr ""
"\n"
"Ten scenariusz można odblokować tylko poprzez osiągnięcia."

#: src/scores_ui.cpp
msgid "Your scores"
msgstr "Twoje wyniki"

#: src/scores_ui.cpp
msgid "Achievements and conducts are disabled for debug characters."
msgstr "Osiągnięcia i postępki są wyłączone dla postaci debugowania."

#: src/scores_ui.cpp
msgid "This game has no valid conducts."
msgstr "Ta gra nie ma żadnych prawidłowych postępków."

#: src/scores_ui.cpp
msgid "This game has no valid achievements."
msgstr "Ta gra nie ma żadnych prawidłowych osiągnięć."

#: src/scores_ui.cpp
msgid ""
"Note that only conducts that existed when you started this game and still "
"exist now will appear here."
msgstr ""
"Uwaga: widoczne są tu tylko postępki, które istniały w chwili rozpoczęcia tej"
" gry i nadal istnieją."

#: src/scores_ui.cpp
msgid ""
"Note that only achievements that existed when you started this game and still"
" exist now will appear here."
msgstr ""
"Uwaga: widoczne są tu tylko osiągnięcia, które istniały w chwili rozpoczęcia "
"tej gry i nadal istnieją."

#: src/scores_ui.cpp
msgid "This game has no valid scores."
msgstr "Ta gra nie ma żadnych prawidłowych wyników."

#: src/scores_ui.cpp
msgid ""
"Note that only scores that existed when you started this game and still exist"
" now will appear here."
msgstr ""
"Uwaga: widoczne są tu tylko wyniki, które istniały w chwili rozpoczęcia tej "
"gry i nadal istnieją."

#: src/scores_ui.cpp
msgid "Stats through kills:"
msgstr "Statystyki z zabójstw:"

#: src/scores_ui.cpp
#, c-format
