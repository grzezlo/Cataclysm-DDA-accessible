msgstr "(Efektywna siła podnoszenia: %d)"

#: src/veh_interact.cpp
#, c-format
msgid "Cargo: <color_light_blue>%s</color> / <color_light_blue>%s</color> %s"
msgstr ""
"Ładunek: <color_light_blue>%s</color> / <color_light_blue>%s</color> %s"

