#: src/ranged.cpp
#, c-format
msgid "You shoot your %1$s.  %2$s"
msgstr "Strzelasz z: %1$s. %2$s"

#: src/ranged.cpp
msgid "swoosh!"
msgstr "świst!"

#: src/ranged.cpp
msgid "No hostile creature in reach."
msgstr "Brak wrogiego stworzenia w zasięgu."

#: src/ranged.cpp
msgid "Really attack yourself?"
msgstr "Naprawdę zaatakować samego siebie?"

#: src/ranged.cpp
#, c-format
msgid "[%s] to unload the %s after quitting."
msgstr "[%s], aby rozładować po wyjściu: %s."

#: src/ranged.cpp
#, c-format
msgid "[%s] to keep the %s loaded after quitting."
msgstr "[%s], aby pozostawić załadowane po wyjściu: %s."

#: src/ranged.cpp
#, c-format
msgid "Pfft.  You are a brawler; using this %s is beneath you."
msgstr ""
"Pff. Jesteś zabijaką; używanie czegoś takiego jak %s jest poniżej twojej "
"godności."

#: src/ranged.cpp
msgid "You're too gun-shy to use this."
msgstr "Za bardzo boisz się broni palnej, żeby tego użyć."

#: src/ranged.cpp
#, c-format
msgid "You need at least %2$d kJ of bionic power to fire the %1$s!"
msgstr ""
"Potrzebujesz co najmniej %2$d kJ energii bionicznej, by wystrzelić z: %1$s!"

#: src/ranged.cpp
#, c-format
msgid "You need a UPS with at least %2$d kJ to fire the %1$s!"
msgstr "Potrzebujesz UPS-a z co najmniej %2$d kJ, by wystrzelić z: %1$s!"

