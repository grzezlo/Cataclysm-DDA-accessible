#. ~ Name for an array of electronic power grid appliances, like batteries and
#. solar panels
#: src/vehicle.cpp
msgid "power grid"
msgstr "sieć energetyczna"

#: src/vehicle.cpp
#, c-format
msgid ""
"the %s emitting a beep and saying \"Autonomous driving protocols suspended!\""
msgstr ""
"pikanie i komunikat „Zawieszono protokoły jazdy autonomicznej!” z pojazdu: %s"

#: src/vehicle.cpp
msgid "There's no structure to support it."
msgstr "Nie ma konstrukcji, która by to podtrzymała."

#: src/vehicle.cpp
#, c-format
msgid "%s is in the way."
msgstr "Przeszkadza: %s."

#: src/vehicle.cpp
#, c-format
msgid "%s is already installed here."
msgstr "Już tu zamontowano: %s."

#. ~ %1$s - already installed part name, %2$s - part location name
#: src/vehicle.cpp
#, c-format
msgid "The installed %1$s already occupies the '%2$s' location."
msgstr "Zamontowana część %1$s zajmuje już miejsce „%2$s”."

#: src/vehicle.cpp
#, c-format
msgid ""
"There can't be two cargo parts on the same tile.  Part conflicts with "
"existing %1$s."
msgstr ""
"Na jednym polu nie mogą być dwie części ładunkowe. Część koliduje z "
"istniejącą: %1$s."

#: src/vehicle.cpp
msgid "Mirrors cannot be mounted on opaque parts."
msgstr "Lustra nie mogą być montowane na nieprzezroczystych częściach."

#: src/vehicle.cpp
msgid "Opaque parts cannot be mounted on mirror parts."
msgstr "Nieprzezroczyste części nie mogą być montowane na lustrach."

#: src/vehicle.cpp
msgid "Only one turret mount can be installed."
msgstr "Można zamontować tylko jedno mocowanie wieżyczki."

#: src/vehicle.cpp
msgid "Part needs to be adjacent to or on existing structure."
msgstr ""
"Część musi przylegać do istniejącej konstrukcji lub być na niej zamontowana."

#: src/vehicle.cpp
#, c-format
msgid "Engine conflict: %s."
msgstr "Konflikt silników: %s."

#: src/vehicle.cpp
#, c-format
msgid "Part requires %s."
msgstr "Część wymaga: %s."

#: src/vehicle.cpp
#, c-format
msgid "Part requires any of: %s."
msgstr "Część wymaga dowolnego z: %s."

#: src/vehicle.cpp
msgid "Unracking is required before removing this part."
msgstr "Przed usunięciem tej części trzeba zdjąć pojazd ze stelaża."

#: src/vehicle.cpp
msgid "Unlock this part first."
msgstr "Najpierw odblokuj tę część."

#: src/vehicle.cpp
msgid "Remove other parts before removing last structure part."
msgstr "Usuń inne części przed usunięciem ostatniej części konstrukcji."

#: src/vehicle.cpp
#, c-format
msgid "Can't merge into %s, the resulting grid would be too big."
msgstr "Nie można połączyć z: %s, powstała sieć byłaby zbyt duża."

#: src/vehicle.cpp
