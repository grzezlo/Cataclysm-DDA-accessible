msgstr "Twój wierzchowiec (%1$s) łapie się w: %2$s!"

#: src/trapfunc.cpp
#, c-format
msgid "%1$s is caught by a %2$s!"
msgstr "%1$s łapie się w: %2$s!"

#: src/trapfunc.cpp
#, c-format
