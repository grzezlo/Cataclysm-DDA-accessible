#: data/json/furniture_and_terrain/furniture-storage.json
msgid "packed pallet"
msgstr ""

#. ~ Description of furniture "packed pallet"
#: data/json/furniture_and_terrain/furniture-storage.json
msgid ""
"A wooden pallet loaded with cargo, wrapped with a watertight cover, and "
"belted to secure the contents."
msgstr ""

#. ~ Bashing sound
