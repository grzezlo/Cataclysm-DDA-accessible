msgid "rip!"
msgstr ""

#. ~ Furniture name
#: data/json/furniture_and_terrain/furniture-storage.json
msgid "damaged pallet"
msgstr ""

#. ~ Description of furniture "damaged pallet"
#: data/json/furniture_and_terrain/furniture-storage.json
msgid ""
"A wooden pallet, containing cargo and possessing a torn cover.  You can reach"
" the contents, but it's awfully hard due to the belts still being in place."
msgstr ""

