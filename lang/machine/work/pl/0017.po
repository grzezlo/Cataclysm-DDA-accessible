#. ~ Description of "ferraiolo"
#: data/json/items/armor/cloaks.json
msgid ""
"A long, crimson cape that reaches the ankles.  Worn by Catholic priests for "
"ceremonious occasions."
msgstr ""

#. ~ Item name
#: data/json/items/armor/cloaks.json
msgid "denim cloak"
msgid_plural "denim cloaks"
