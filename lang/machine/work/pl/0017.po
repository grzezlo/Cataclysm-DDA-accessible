msgstr[0] "krótka kurtka św. Mikołaja"
msgstr[1] "krótkie kurtki św. Mikołaja"
msgstr[2] "krótkich kurtek św. Mikołaja"
msgstr[3] "krótkiej kurtki św. Mikołaja"

#. ~ Description of "sleeveless trenchcoat"
#: data/json/items/armor/coats.json
msgid ""
"A thick canvas trenchcoat that leaves your arms unencumbered.  Has plenty of "
"storage space due to its many pockets."
msgstr ""
"Gruby płócienny płaszcz, który nie krępuje rąk. Ma mnóstwo miejsca dzięki "
"licznym kieszeniom."

#. ~ Description of "trenchcoat"
#: data/json/items/armor/coats.json
msgid "A thick canvas trenchcoat, lined with pockets.  Great for storage."
msgstr ""
"Gruby płócienny płaszcz pełen kieszeni. Świetny do przechowywania rzeczy."

#. ~ Description of "rag tunic"
#: data/json/items/armor/coats.json
msgid ""
"A poorly-made long tunic with a string tied around the waist to keep it all "
"in place."
msgstr ""
"Kiepsko wykonana długa tunika przewiązana w pasie sznurkiem, który utrzymuje "
"ją na miejscu."

#. ~ Description of "waistcoat"
#: data/json/items/armor/coats.json
msgid ""
"An elegant waistcoat.  Ideal for those occasions when wearing only a shirt "
"would be too casual and a suit would be overdoing it."
msgstr ""
"Elegancka kamizelka. Idealna na okazje, gdy sama koszula byłaby zbyt "
"swobodna, a garnitur byłby przesadą."

#. ~ Item name
#: data/json/items/armor/coats.json
msgid "steampunk trenchcoat"
msgid_plural "steampunk trenchcoats"
msgstr[0] "płaszcz steampunkowy"
msgstr[1] "płaszcze steampunkowe"
msgstr[2] "płaszczy steampunkowych"
msgstr[3] "płaszcza steampunkowego"

#. ~ Description of "steampunk trenchcoat"
#: data/json/items/armor/coats.json
msgid ""
"A thick black leather steampunk themed trenchcoat.  Unlike a regular "
"trenchcoat, this one has no pockets."
msgstr ""
"Gruby płaszcz z czarnej skóry w stylu steampunkowym. W przeciwieństwie do "
"zwykłego płaszcza ten nie ma kieszeni."

#. ~ Item name
#: data/json/items/armor/coats.json
msgid "plague robe"
msgid_plural "plague robes"
msgstr[0] "szata dżumowa"
msgstr[1] "szaty dżumowe"
msgstr[2] "szat dżumowych"
msgstr[3] "szaty dżumowej"

#. ~ Description of "plague robe"
#: data/json/items/armor/coats.json
msgid "A dark robbed cassock worn by plague doctors."
msgstr "Ciemna sutanna noszona przez lekarzy dżumowych."

#. ~ Item name
#: data/json/items/armor/coats.json
msgid "nun habit"
msgid_plural "nun habits"
msgstr[0] "habit zakonnicy"
