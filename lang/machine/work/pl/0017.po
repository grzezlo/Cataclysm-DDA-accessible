msgstr[2] "policyjnych kurtek motocyklowych"
msgstr[3] "policyjnej kurtki motocyklowej"

#. ~ Description of variant "motorcycle police jacket" of item "motorcycle
#. jacket"
#: data/json/items/armor/coats.json
msgid "It is emblazoned with the insignia of the local police force."
msgstr "Widnieją na niej insygnia miejscowej policji."

