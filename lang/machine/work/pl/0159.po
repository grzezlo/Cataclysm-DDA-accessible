"You can tell this CBM is meant to be installed around your eyes, but what "
"exactly it will do, you have no idea."
msgstr ""

#. ~ Item name
#: data/mods/MindOverMatter/items/bionics.json
msgid "Ohuicatlachiyaliztimeh CBM"
msgid_plural "Ohuicatlachiyaliztimeh CBMs"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "Ohuicatlachiyaliztimeh CBM"
#: data/mods/MindOverMatter/items/bionics.json
