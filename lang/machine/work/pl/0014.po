#. ~ Description of "84x245mm HE"
#: data/json/items/ammo/84x246mm.json
msgid ""
"An 84x245mm High Explosive anti-personnel cartridge for the Carl Gustaf M3 "
"and other 84mm recoilless rifles.  Designed to be highly effective against "
"personnel."
msgstr ""
"Odłamkowo-burzący nabój przeciwpiechotny 84 x 245 mm do Carl Gustaf M3 i "
"innych bezodrzutowych dział 84 mm. Zaprojektowany z myślą o wysokiej "
"skuteczności przeciwko sile żywej."

#. ~ Item name
#: data/json/items/ammo/84x246mm.json
msgid "84x245mm HEDP"
msgid_plural "84x245mm HEDP"
