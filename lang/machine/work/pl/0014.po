msgstr[0] "breneka kal. 12, reelaborowana"
msgstr[1] "breneki kal. 12, reelaborowane"
msgstr[2] "brenek kal. 12, reelaborowanych"
msgstr[3] "breneki kal. 12, reelaborowanej"

#. ~ Item name
#: data/json/items/ammo/shot.json
