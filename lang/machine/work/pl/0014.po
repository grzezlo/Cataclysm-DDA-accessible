#: data/json/items/ammo/77mm_arisaka.json
msgid "7.7x58mm Japanese JSP"
msgid_plural "7.7x58mm Japanese JSP"
msgstr[0] "7,7 x 58 mm japoński JSP"
msgstr[1] "7,7 x 58 mm japońskie JSP"
