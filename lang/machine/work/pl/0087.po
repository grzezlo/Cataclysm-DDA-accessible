msgstr ""

#. ~ Snippet in category "addict_opiate_mild_asleep"
#: data/json/snippets/addiction.json
msgid "♪It is not a habit, it is cool, I feel alive, I feel♪"
msgstr ""

#. ~ Snippet in category "addict_opiate_mild_asleep"
#: data/json/snippets/addiction.json
msgid "That warm rush fills your body in your dream, oxy's hug enveloping you."
msgstr ""

#. ~ Snippet in category "addict_opiate_strong_awake"
#: data/json/snippets/addiction.json
