#. ~ Description of monster "greater rhea"
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid ""
"A distant relative of emus and African ostriches.  Found in the grasslands "
"and various other open regions of South America."
msgstr ""

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid "greater rhea chick"
msgid_plural "greater rhea chicks"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "greater rhea chick"
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid ""
"A miniature rhea.  The appearance of it is distinct enough to easily "
"identify."
msgstr ""

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid "toco toucan"
msgid_plural "toco toucans"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "toco toucan"
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid ""
"The largest species of toucan sporting dark plumage and a bright colored "
"beak.  This bird can be found pretty much all over South America, feeding on "
"fruits and seeds."
msgstr ""

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid "white-eyed parakeet"
msgid_plural "white-eyed parakeets"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "white-eyed parakeet"
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid ""
"A small bird with bright green-colored plumage and a short hooked beak.  This"
" species is widespread throughout all of South America, on top of being quite"
" intelligent and sometimes kept as pets."
msgstr ""

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid "blue-and-yellow macaw"
msgid_plural "blue-and-yellow macaws"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "blue-and-yellow macaw"
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid ""
"A large parrot sporting beautiful blue plumage.  Intelligent and often kept "
"as a pet."
msgstr ""

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid "saffron finch"
msgid_plural "saffron finches"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "saffron finch"
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid ""
"A tiny, golden bird bopping around in the canopy of trees.  Its cone-shaped "
"bill tells you it s a seed eater."
msgstr ""

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid "great kiskadee"
msgid_plural "great kiskadees"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "great kiskadee"
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid ""
"This large flycatcher has a black crown, prominent white eye stripe and a "
"dominantly yellow body.  At almost a foot long, it swoops up a variety of "
"flying insects."
msgstr ""

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid "rufous hornero"
msgid_plural "rufous horneros"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "rufous hornero"
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid ""
"A drab, robin-sized ground bird with startling red eyes.  More often spotted "
"are their odd oven shaped nests."
msgstr ""

#. ~ Monster name
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid "small-billed tinamou"
msgid_plural "small-billed tinamous"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "small-billed tinamou"
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid ""
"One of several species of tinamous present in Brazil.  Although these birds "
"converged into shapes similar to domestic fowl, they are more closely related"
" to the extinct moas, though unlike them, tinamous are capable of flight."
msgstr ""

