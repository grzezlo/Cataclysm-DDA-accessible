msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "dusky-legged guan"
#: data/mods/TropiCataclysm/monsters/tropical_bird.json
msgid ""
"A medium-sized speckled bird.  Its bright orange wattle contrasts sharply "
"with the rest of its brown body."
msgstr ""

#. ~ Monster name
