#: data/mods/TropiCataclysm/monsters/tropical_reptile_amphibian.json
msgid ""
"A huge axolotl grown almost the size of a small croc.  It swims and ambushes "
"prey on the murky depths like some distant paleozoic amphibian."
msgstr ""

