#. ~ Name of spell "biokin_sealed_system"
#: data/mods/MindOverMatter/powers/biokinesis.json
msgid "[Ψ]Sealed System"
msgstr ""

#. ~ Description of spell "biokin_sealed_system ( [Ψ]Sealed System )"
#: data/mods/MindOverMatter/powers/biokinesis.json
msgid ""
"With a deep breath, you lock your body off from the outside world.  Gas, poison, blood, bile, electricity--nothing gets in, nothing gets out.\n"
"\n"
"Sealed System <color_red>cannot be active</color> with either Temperature Adaptability or Oxygen Absorption."
msgstr ""

#. ~ Message of spell "biokin_sealed_system ( [Ψ]Sealed System )"
#: data/mods/MindOverMatter/powers/biokinesis.json
msgid "You take a deep breath and seal your lips."
msgstr ""

#. ~ Name of spell "biokin_metabolism_enhance"
#: data/mods/MindOverMatter/powers/biokinesis.json
msgid "[Ψ]Metabolic Hyperefficiency (C)"
msgstr ""

#. ~ Description of spell "biokin_metabolism_enhance ( [Ψ]Metabolic
#. Hyperefficiency (C) )"
#: data/mods/MindOverMatter/powers/biokinesis.json
msgid ""
"You can supercharge your metabolism, allowing you to eat, drink, and sleep much less than normal.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>.  It is <color_red>canceled by engaging in combat</color>."
msgstr ""

#. ~ Name of spell "biokin_vitaminosis"
#: data/mods/MindOverMatter/powers/biokinesis.json
msgid "[Ψ]Vitaminosis"
msgstr ""

#. ~ Description of spell "biokin_vitaminosis ( [Ψ]Vitaminosis )"
#: data/mods/MindOverMatter/powers/biokinesis.json
msgid ""
"Enter a trance and hyper focus on a narrow segment of your metabolism, "
"supercharging your body's ability to create vitamins and expanding it beyond "
"its normal range.  These vitamins will be created directly from your stored "
"calories."
msgstr ""

#. ~ Message of spell "biokin_vitaminosis ( [Ψ]Vitaminosis )"
#. ~ Message of spell "vita_healing_trance ( [Ψ]Revitalizing Meditation )"
#: data/mods/MindOverMatter/powers/biokinesis.json
#: data/mods/MindOverMatter/powers/vitakinesis.json
msgid "You enter a trance and submerge your awareness into your body."
msgstr ""

#. ~ Name of spell "biokin_guided_evolution"
#: data/mods/MindOverMatter/powers/biokinesis.json
msgid "[Ψ]Guided Evolution (C)"
msgstr ""

#. ~ Description of spell "biokin_guided_evolution ( [Ψ]Guided Evolution (C) )"
#: data/mods/MindOverMatter/powers/biokinesis.json
msgid ""
"With a large amount of focus, you can maintain a targeted control over any alterations to your body.  Whenever you mutate, you will have additional options to select from.  This power does not cause you to mutate on its own.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>.  It is <color_red>canceled by engaging in combat</color>.  It requires <color_yellow>even more concentration</color> than usual."
msgstr ""

#. ~ Name of spell "biokin_combat_dance"
#: data/mods/MindOverMatter/powers/biokinesis.json
msgid "[Ψ]Combat Dance (C)"
msgstr ""

#. ~ Description of spell "biokin_combat_dance ( [Ψ]Combat Dance (C) )"
#: data/mods/MindOverMatter/powers/biokinesis.json
msgid ""
"You can flood your body with psionic power to enhance your combat prowess."
msgstr ""

#. ~ Name of spell "biokin_perfected_motion"
#: data/mods/MindOverMatter/powers/biokinesis.json
msgid "[Ψ]Perfected Motion (C)"
msgstr ""

#. ~ Description of spell "biokin_perfected_motion ( [Ψ]Perfected Motion (C) )"
#: data/mods/MindOverMatter/powers/biokinesis.json
msgid ""
"Your control over your body allows you to move incredibly quickly.  While this does not allow you to attack more quickly, you can cross distances in the blink of an eye and outrun a cheetah.  You could even run on water, though not walk on it.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>.  It requires <color_yellow>even more concentration</color> than usual.\n"
"\n"
"Perfected Motion <color_red>cannot be active</color> with Hurricane Blows."
msgstr ""

#. ~ Name of spell "biokin_hurricane_blows"
#: data/mods/MindOverMatter/powers/biokinesis.json
msgid "[Ψ]Hurricane Blows"
msgstr ""

#. ~ Description of spell "biokin_hurricane_blows ( [Ψ]Hurricane Blows )"
#: data/mods/MindOverMatter/powers/biokinesis.json
msgid ""
"You can now strike so quickly that you don't even seem to move at all.  Before an opponent can even finish blinking, you can strike them multiple times, executing your final blow before they feel the pain of the first.  Moving while using Hurricane Blows will disrupt your concentration, ending the effect.\n"
"\n"
"Hurricane Blows <color_red>cannot be active</color> with Perfected Motion."
msgstr ""

#. ~ Message of spell "biokin_hurricane_blows ( [Ψ]Hurricane Blows )"
#: data/mods/MindOverMatter/powers/biokinesis.json
msgid "The world around you slows down to a stop."
msgstr ""

#. ~ Player message in effect in EoC "EOC_BIOKIN_PAIN_INITIATE"
#: data/mods/MindOverMatter/powers/biokinesis_concentration_eocs.json
msgid "You breathe deeply and your pain lessens."
msgstr ""

#. ~ Player message in effect in EoC "EOC_BIOKIN_PHYSICAL_ENHANCE_INITIATE"
#: data/mods/MindOverMatter/powers/biokinesis_concentration_eocs.json
msgid "You enhance your physical prowess."
msgstr ""

#. ~ Player message in effect in EoC "EOC_BIOKIN_BREATHE_SKIN_INITIATE"
#: data/mods/MindOverMatter/powers/biokinesis_concentration_eocs.json
msgid "As you seal your lips, your chest still rises and falls."
msgstr ""

#. ~ Player message in effect in EoC "EOC_BIOKIN_HARDENED_SKIN_INITIATE"
#: data/mods/MindOverMatter/powers/biokinesis_concentration_eocs.json
msgid "Your skin itches slightly and takes on a waxy appearance."
msgstr ""

#. ~ Player message in effect in EoC "EOC_BIOKIN_CLIMATE_CONTROL_INITIATE"
#: data/mods/MindOverMatter/powers/biokinesis_concentration_eocs.json
msgid "You feel much more comfortable."
msgstr ""

#. ~ Player message in effect in EoC "EOC_BIOKIN_ENHANCE_MOBILITY_INITIATE"
#: data/mods/MindOverMatter/powers/biokinesis_concentration_eocs.json
msgid "Your gear doesn't seem to encumber you as much."
msgstr ""

#. ~ Player message in effect in EoC "EOC_BIOKIN_HAMMERHAND_INITIATE"
#: data/mods/MindOverMatter/powers/biokinesis_concentration_eocs.json
msgid "You flex your fingers."
msgstr ""

#. ~ Player message in effect in EoC "EOC_BIOKIN_REFLEX_ENHANCE_INITIATE"
#: data/mods/MindOverMatter/powers/biokinesis_concentration_eocs.json
msgid "You enhance your speed and sensory prowess."
msgstr ""

#. ~ Player message in effect in EoC "EOC_BIOKIN_METABOLISM_ENHANCE_INITIATE"
#: data/mods/MindOverMatter/powers/biokinesis_concentration_eocs.json
msgid "You supercharge your metabolism."
msgstr ""

#. ~ Player message in effect in EoC "EOC_BIOKIN_GUIDED_EVOLUTION_INITIATE"
#: data/mods/MindOverMatter/powers/biokinesis_concentration_eocs.json
msgid "You begin targeting your future mutations."
msgstr ""

#. ~ Player message in effect in EoC "EOC_BIOKIN_COMBAT_DANCE_INITIATE"
#: data/mods/MindOverMatter/powers/biokinesis_concentration_eocs.json
msgid ""
"A surge of power fills your body and you begin moving with terrible purpose!"
msgstr ""

#. ~ Player message in effect in EoC "EOC_BIOKIN_PERFECTED_MOTION_INITIATE"
#: data/mods/MindOverMatter/powers/biokinesis_concentration_eocs.json
msgid "The world around you slows down to a crawl"
msgstr ""

#. ~ Player message in effect in EoC "EOC_BIOKIN_DASH_CHECKER"
#: data/mods/MindOverMatter/powers/biokinesis_eoc.json
msgid "You move almost faster than the eye can see."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_BIOKIN_DASH_CHECKER"
#: data/mods/MindOverMatter/powers/biokinesis_eoc.json
msgid "Your circumstances prevent you from moving freely right now."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_BIOKIN_ADRENALINE_TRIGGER"
#: data/mods/MindOverMatter/powers/biokinesis_eoc.json
msgid "You already have a surge of adrenaline in your system!"
msgstr ""

#. ~ Player message in effect in EoC
#. "EOC_PERFECTED_MOTION_WATER_RUN_CONTINUANCE" in nested EOCs in effect in EoC
#. "EOC_PERFECTED_MOTION_WATER_RUN"
#: data/mods/MindOverMatter/powers/biokinesis_eoc.json
msgid "You are moving too slowly and fall into the water."
msgstr ""

#. ~ Player message in effect in EoC "EOC_BIOKIN_VITAMINOSIS_REMOVE"
#: data/mods/MindOverMatter/powers/biokinesis_eoc.json
msgid "You exit your trance and feel somehow fuller"
msgstr ""

#. ~ Name of spell "clair_better_senses"
#: data/mods/MindOverMatter/powers/clairsentience.json
msgid "[Ψ]Heightened Senses (C)"
msgstr ""

#. ~ Description of spell "clair_better_senses ( [Ψ]Heightened Senses (C) )"
#: data/mods/MindOverMatter/powers/clairsentience.json
msgid ""
"All of your senses are heightened, allowing you to see further and hear better, and at higher levels even see in murky water or use minor vibrations and small sounds to determine moving creatures nearby.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>."
msgstr ""

#. ~ Name of spell "clair_speed_reading"
#: data/mods/MindOverMatter/powers/clairsentience.json
msgid "[Ψ]Speed Reader (C)"
msgstr ""

#. ~ Description of spell "clair_speed_reading ( [Ψ]Speed Reader (C) )"
#: data/mods/MindOverMatter/powers/clairsentience.json
msgid ""
"Your powers make words fairly leap off the page directly into your mind, allowing you to read much faster and better absorb what you read.\n"
"\n"
"This power <color_yellow>is maintained by concentration</color> and <color_red>may fail</color> if <color_yellow>concentration is interrupted</color>.  It is <color_red>canceled by engaging in combat</color>."
msgstr ""
