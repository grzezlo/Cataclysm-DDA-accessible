msgstr ""

#. ~ NPC dialogue line
#: data/mods/Xedra_Evolved/npc/talk_computers.json
msgid ""
"&After one too many failed attempts, you're greeted with a message informing "
"you that you're locked out and need to see your systems administrator to "
"regain access, and a loud clang from the other side of the door.  You "
"certainly haven't made it any easier to get inside."
msgstr ""

#. ~ NPC dialogue line
#: data/mods/Xedra_Evolved/npc/talk_computers.json
msgid ""
"&This computer still has power, but the screen displays a simple message: "
"\"ERROR, access denied.  Raw materials access requires appropriate clearance."
"  Please contact your supervisor if you have received this message in "
"error.\"  A panel below the screen seems ready to accept some sort of id."
msgstr ""

#. ~ Response to NPC dialogue
#: data/mods/Xedra_Evolved/npc/talk_computers.json
msgid "Unlock raw materials storage doors."
msgstr ""

#. ~ NPC dialogue line
