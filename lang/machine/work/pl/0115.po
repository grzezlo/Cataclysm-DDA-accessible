#. ~ General chit chat messages
#: data/json/npcs/snippets/talk_tags_chat.json
msgid "Hey, <name_g>, what's been on your mind?"
msgstr ""

#. ~ Snippet in category "<neutralchitchat>"
#. ~ General chit chat messages
