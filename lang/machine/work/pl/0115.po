msgstr ""

#. ~ Snippet in category "<neutralchitchat>"
#. ~ General chit chat messages
#: data/json/npcs/snippets/talk_tags_chat.json
msgid "Let's swap stories.  What's yours?"
msgstr ""

#. ~ Snippet in category "<neutralchitchat>"
#. ~ General chit chat messages
#: data/json/npcs/snippets/talk_tags_chat.json
msgid "Let's take a breather.  Anything interesting going on?"
msgstr ""

#. ~ Snippet in category "<neutralchitchat>"
#. ~ General chit chat messages
#: data/json/npcs/snippets/talk_tags_chat.json
msgid "Let's take a mental break.  Got anything fun to share?"
msgstr ""

#. ~ Snippet in category "<neutralchitchat>"
#. ~ General chit chat messages
#: data/json/npcs/snippets/talk_tags_chat.json
msgid "Life's a mess, huh?  How're you holding up?"
msgstr ""

#. ~ Snippet in category "<neutralchitchat>"
#. ~ General chit chat messages
#: data/json/npcs/snippets/talk_tags_chat.json
msgid "Life's been rough.  What's keeping you going?"
msgstr ""

#. ~ Snippet in category "<neutralchitchat>"
#. ~ General chit chat messages
#: data/json/npcs/snippets/talk_tags_chat.json
msgid "So, tell me something good."
msgstr ""

#. ~ Snippet in category "<neutralchitchat>"
#. ~ General chit chat messages
#: data/json/npcs/snippets/talk_tags_chat.json
