#: data/json/items/book/spiritual.json
msgid ""
"This is volume 4 of 51, containing Tractate Demai.  It discusses rules for "
"dubiously-tithed produce."
msgstr ""
"To tom 4 z 51, zawierający traktat Demaj. Omawia zasady dotyczące płodów "
"rolnych, z których dziesięcina mogła nie zostać oddana."

#. ~ Variant name of item "Talmud"
#: data/json/items/book/spiritual.json
msgid "Talmud, Vol. 5, Tractate Kilayim"
msgid_plural "copies of the Talmud, Vol. 5, Tractate Kilayim"
msgstr[0] "Talmud, tom 5, traktat Kilajim"
