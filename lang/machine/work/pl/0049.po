#: data/json/items/resources/metal.json
msgid "Some small pieces of scrap tin, usable for crafting or repairs."
msgstr ""
"Kilka małych kawałków złomu cynowego, nadających się do wytwarzania lub "
"napraw."

#. ~ Description of "tin powder"
#: data/json/items/resources/metal.json
msgid ""
"A handful of fine gray tin powder, usable for making solder and lining "
"containers to prevent corrosion."
msgstr ""
"Garść drobnego, szarego proszku cyny, nadającego się do robienia lutu i "
"powlekania pojemników w celu ochrony przed korozją."

#. ~ Description of "solder"
#: data/json/items/resources/metal.json
msgid "A small spool of solder, useful for electronics crafting."
msgstr "Mała szpula lutu, przydatna przy wytwarzaniu elektroniki."

