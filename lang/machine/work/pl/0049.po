msgstr[0] "duża replika kości"
msgstr[1] "duże repliki kości"
msgstr[2] "dużych replik kości"
msgstr[3] "dużej repliki kości"

#. ~ Description of "large bone replica"
#: data/json/items/resources/stone.json
msgid "A plaster replica of a huge bone."
msgstr "Gipsowa replika ogromnej kości."

#. ~ Item name
#: data/json/items/resources/stone.json
msgid "bone fossil"
msgid_plural "bone fossils"
msgstr[0] "skamieniała kość"
msgstr[1] "skamieniałe kości"
msgstr[2] "skamieniałych kości"
msgstr[3] "skamieniałej kości"

#. ~ Description of "bone fossil"
#: data/json/items/resources/stone.json
msgid "A fossilized bone.  Not good to eat."
msgstr "Skamieniała kość. Nie nadaje się do jedzenia."

#. ~ Description of "large bone replica"
#: data/json/items/resources/stone.json
msgid "A huge fossilized bone.  Not good to eat."
msgstr "Ogromna skamieniała kość. Nie nadaje się do jedzenia."

#. ~ Description of "grass yarn"
#: data/json/items/resources/tailoring.json
msgid ""
"Primitive yarn made from coarse plant fibers like straw or grass.  Too thick "
"to sew with, but could be woven into a crude sheet of fabric."
msgstr ""
"Prymitywna przędza zrobiona z grubych włókien roślinnych, takich jak słoma "
"czy trawa. Zbyt gruba do szycia, ale można z niej utkać prosty arkusz "
"tkaniny."

#. ~ Description of "cotton scraps"
#: data/json/items/resources/tailoring.json
msgid ""
"A handful of oddly-shaped smallish bits of cotton, waste material from "
"tailoring projects.  Not useful for much and usually disposed of, but they "
"can be recycled into some thread if you really want."
msgstr ""
"Garść dziwnie ukształtowanych, niewielkich skrawków bawełny, odpadów z prac "
"krawieckich. Do niczego się szczególnie nie przydają i zwykle się je wyrzuca,"
" ale jeśli bardzo chcesz, możesz przerobić je na trochę nici."

#. ~ Description of "faux fur scraps"
#: data/json/items/resources/tailoring.json
msgid ""
"A handful of oddly-shaped smallish bits of faux fur, waste material from "
"tailoring projects.  Not useful for much and usually disposed of."
msgstr ""
"Garść dziwnie ukształtowanych, niewielkich skrawków sztucznego futra, odpadów"
" z prac krawieckich. Do niczego się szczególnie nie przydają i zwykle się je "
"wyrzuca."

#. ~ Description of "felt scraps"
#: data/json/items/resources/tailoring.json
msgid ""
"A handful of oddly-shaped smallish bits of felt, waste material from "
"tailoring projects.  Not useful for much and usually disposed of, but they "
"can be recycled into some wool fiber if you really want."
msgstr ""
"Garść dziwnie ukształtowanych, niewielkich skrawków filcu, odpadów z prac "
"krawieckich. Do niczego się szczególnie nie przydają i zwykle się je wyrzuca,"
" ale jeśli bardzo chcesz, możesz przerobić je na trochę włókna wełnianego."

#. ~ Description of "fur scraps"
#: data/json/items/resources/tailoring.json
msgid ""
"A handful of oddly-shaped smallish bits of fur, waste material from tailoring"
" projects.  Not useful for much and usually disposed of."
msgstr ""
"Garść dziwnie ukształtowanych, niewielkich skrawków futra, odpadów z prac "
"krawieckich. Do niczego się szczególnie nie przydają i zwykle się je wyrzuca."

#. ~ Description of "Kevlar scraps"
#: data/json/items/resources/tailoring.json
msgid ""
"A handful of oddly-shaped smallish bits of Kevlar fabric, waste material from"
" tailoring projects.  Normally it would be disposed of, but since Kevlar is "
"very difficult to make in a post-apocalyptic world, it might be worth "
"recycling it for Kevlar thread."
msgstr ""
"Garść dziwnie ukształtowanych, niewielkich skrawków tkaniny kevlarowej, "
"odpadów z prac krawieckich. Normalnie by się je wyrzuciło, ale ponieważ w "
"postapokaliptycznym świecie bardzo trudno wyprodukować kevlar, warto chyba "
"przerobić je na nić kevlarową."

#. ~ Description of "leather scraps"
#: data/json/items/resources/tailoring.json
msgid ""
"A handful of oddly-shaped smallish bits of leather, waste material from "
"tailoring projects.  Not useful for much and usually disposed of."
msgstr ""
"Garść dziwnie ukształtowanych, niewielkich skrawków skóry, odpadów z prac "
"krawieckich. Do niczego się szczególnie nie przydają i zwykle się je wyrzuca."

#. ~ Description of "Lycra scraps"
#: data/json/items/resources/tailoring.json
msgid ""
"A handful of oddly-shaped smallish bits of Lycra, waste material from "
"tailoring projects.  Not useful for much and usually disposed of."
msgstr ""
"Garść dziwnie ukształtowanych, niewielkich skrawków Lycry, odpadów z prac "
"krawieckich. Do niczego się szczególnie nie przydają i zwykle się je wyrzuca."

#. ~ Description of "neoprene scraps"
#: data/json/items/resources/tailoring.json
msgid ""
"A handful of oddly-shaped smallish bits of neoprene, waste material from "
"tailoring projects.  Not useful for much and usually disposed of."
msgstr ""
"Garść dziwnie ukształtowanych, niewielkich skrawków neoprenu, odpadów z prac "
"krawieckich. Do niczego się szczególnie nie przydają i zwykle się je wyrzuca."

#. ~ Description of "synthetic fabric scraps"
#: data/json/items/resources/tailoring.json
msgid ""
"A handful of oddly-shaped smallish bits of synthetic fabric, waste material "
"from tailoring projects.  Not useful for much and usually disposed of."
msgstr ""
"Garść dziwnie ukształtowanych, niewielkich skrawków tkaniny syntetycznej, "
"odpadów z prac krawieckich. Do niczego się szczególnie nie przydają i zwykle "
"się je wyrzuca."

#. ~ Description of "Nomex scraps"
#: data/json/items/resources/tailoring.json
msgid ""
"A handful of oddly-shaped smallish bits of heat-resistant Nomex fabric, waste"
" material from tailoring projects.  Normally it would be disposed of, but "
"since Nomex is very difficult to make in a post-apocalyptic world, it might "
"be worth recycling it for Nomex thread."
msgstr ""
"Garść dziwnie ukształtowanych, niewielkich skrawków żaroodpornej tkaniny "
"Nomex, odpadów z prac krawieckich. Normalnie by się je wyrzuciło, ale "
"ponieważ w postapokaliptycznym świecie bardzo trudno wyprodukować Nomex, "
"warto chyba przerobić je na nić z Nomeksu."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "scraps of carpet"
msgid_plural "scraps of carpet"
msgstr[0] "skrawki wykładziny"
msgstr[1] "skrawki wykładziny"
msgstr[2] "skrawków wykładziny"
msgstr[3] "skrawków wykładziny"

#. ~ Description of "scraps of carpet"
#: data/json/items/resources/tailoring.json
msgid ""
"A misshapen section of loose carpet.  Not useful for much on its own and can "
"be discarded."
msgstr ""
"Nieforemny kawałek luźnej wykładziny. Sam w sobie do niczego się szczególnie "
"nie przydaje i można go wyrzucić."

#. ~ Description of "wool staple"
#: data/json/items/resources/tailoring.json
msgid ""
"A natural cluster of wool fibers.  Could be processed into felt patches or "
"yarn."
msgstr ""
"Naturalny pęk włókien wełny. Można go przerobić na łaty filcu lub przędzę."

#. ~ Description of "fur patch"
#: data/json/items/resources/tailoring.json
msgid ""
"A small bolt of fur from an animal, roughly six inches square.  Can be made "
"into patchwork fur sheets or used to repair fur fabric."
msgstr ""
"Mały płat zwierzęcego futra, kwadrat o boku około piętnastu centymetrów. "
"Można go zszyć w patchworkowe arkusze futra albo użyć do naprawy futrzanej "
"tkaniny."

#. ~ Description of "faux fur patch"
#: data/json/items/resources/tailoring.json
msgid ""
"A small bolt of garishly-colored faux fur, roughly six inches square.  Can be"
" made into patchwork faux fur sheets or used to repair faux fur fabric."
msgstr ""
"Mały płat jaskrawego sztucznego futra, kwadrat o boku około piętnastu "
"centymetrów. Można go zszyć w patchworkowe arkusze sztucznego futra albo użyć"
" do naprawy tkaniny ze sztucznego futra."

#. ~ Description of "leather patch"
#: data/json/items/resources/tailoring.json
msgid ""
"A roughly six-inch square patch of leather, could be used to repair clothing "
"and make smaller leather crafts."
msgstr ""
"Kwadratowa łata skóry o boku około piętnastu centymetrów, której można użyć "
"do naprawy odzieży i wytwarzania mniejszych wyrobów skórzanych."

#. ~ Description of "felt patch"
#: data/json/items/resources/tailoring.json
msgid "A small, six-inch square patch of felt."
msgstr "Mała, kwadratowa łata filcu o boku piętnastu centymetrów."

#. ~ Description of "Nomex patch"
#: data/json/items/resources/tailoring.json
msgid "A six-inch square patch of Nomex fire-resistant fabric."
msgstr ""
"Kwadratowa łata ognioodpornej tkaniny Nomex o boku piętnastu centymetrów."

#. ~ Description of "cured hide"
#: data/json/items/resources/tailoring.json
msgid ""
"A rolled-up animal hide which has been scraped of extraneous hair and flesh "
"and treated to prevent decay.  It still requires tanning to become usable "
"leather."
msgstr ""
"Zwinięta zwierzęca skóra, oczyszczona ze zbędnej sierści i tkanki oraz "
"zabezpieczona przed rozkładem. Wciąż wymaga garbowania, by stać się użyteczną"
" skórą."

#. ~ Description of "tanned hide"
#: data/json/items/resources/tailoring.json
msgid ""
"A folded 12-inch by 24-inch sheet of leather made from carefully tanned "
"animal hide.  Can be cut up or used as is."
msgstr ""
"Złożony arkusz skóry o wymiarach 30 na 60 cm, zrobiony ze starannie "
"wygarbowanej zwierzęcej skóry. Można go pociąć lub użyć w całości."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "leather sheet"
msgid_plural "leather sheets"
msgstr[0] "arkusz skóry"
msgstr[1] "arkusze skóry"
msgstr[2] "arkuszy skóry"
msgstr[3] "arkusza skóry"

#. ~ Description of "leather sheet"
#: data/json/items/resources/tailoring.json
msgid "A 12-inch by 24-inch sheet of leather.  Can be cut up or used as is."
msgstr ""
"Arkusz skóry o wymiarach 30 na 60 cm. Można go pociąć lub użyć w całości."

#. ~ Description of "patchwork leather sheet"
#: data/json/items/resources/tailoring.json
msgid ""
"A folded 12-inch by 24-inch sheet of leather sewn together from patches.  Can"
" be cut up or used as is."
msgstr ""
"Złożony arkusz skóry o wymiarach 30 na 60 cm, zszyty z łat. Można go pociąć "
"lub użyć w całości."

#. ~ Description of "cured pelt"
#: data/json/items/resources/tailoring.json
msgid ""
"A rolled-up animal hide which has been scraped of extraneous hair and flesh "
"and treated to prevent decay.  It still requires tanning to become usable "
"fur."
msgstr ""
"Zwinięta zwierzęca skóra, oczyszczona ze zbędnej sierści i tkanki oraz "
"zabezpieczona przed rozkładem. Wciąż wymaga garbowania, by stać się "
"użytecznym futrem."

#. ~ Description of "tanned pelt"
#: data/json/items/resources/tailoring.json
msgid ""
"A folded sheet of fur made from carefully tanned animal pelt.  Can be cut up "
"or used as is."
msgstr ""
"Złożony arkusz futra, zrobiony ze starannie wygarbowanej zwierzęcej skóry z "
"sierścią. Można go pociąć lub użyć w całości."

#. ~ Description of "patchwork fur sheet"
#: data/json/items/resources/tailoring.json
msgid ""
"A 12-inch by 24-inch sheet of fur sewn together from patches.  Can be cut up "
"or used as is."
msgstr ""
"Arkusz futra o wymiarach 30 na 60 cm, zszyty z łat. Można go pociąć lub użyć "
"w całości."

#. ~ Description of "cotton sheet"
#: data/json/items/resources/tailoring.json
msgid ""
"A 12-inch by 24-inch sheet of cotton fabric, suitable for making clothing.  "
"You can use it to stop bleeding, but it is very wasteful."
msgstr ""
"Arkusz tkaniny bawełnianej o wymiarach 30 na 60 cm, nadający się do szycia "
"odzieży. Możesz nim zatamować krwawienie, ale to wielkie marnotrawstwo."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "patchwork cotton sheet"
msgid_plural "patchwork cotton sheets"
msgstr[0] "patchworkowy arkusz bawełny"
msgstr[1] "patchworkowe arkusze bawełny"
msgstr[2] "patchworkowych arkuszy bawełny"
msgstr[3] "patchworkowego arkusza bawełny"

#. ~ Description of "patchwork cotton sheet"
#: data/json/items/resources/tailoring.json
msgid ""
"A 12-inch by 24-inch sheet of cotton sewn together from patches of various "
"clothing parts.  Suitable for making clothing if you lack proper material "
"sheets."
msgstr ""
"Arkusz bawełny o wymiarach 30 na 60 cm, zszyty z łat z różnych części "
"odzieży. Nadaje się do szycia odzieży, jeśli brakuje ci porządnych arkuszy "
"materiału."

#. ~ Description of "faux fur sheet"
#: data/json/items/resources/tailoring.json
msgid ""
"A 12-inch by 24-inch sheet of colorful faux fur, suitable for making "
"clothing."
msgstr ""
"Arkusz kolorowego sztucznego futra o wymiarach 30 na 60 cm, nadający się do "
"szycia odzieży."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "patchwork faux fur sheet"
msgid_plural "patchwork faux fur sheets"
msgstr[0] "patchworkowy arkusz sztucznego futra"
msgstr[1] "patchworkowe arkusze sztucznego futra"
msgstr[2] "patchworkowych arkuszy sztucznego futra"
msgstr[3] "patchworkowego arkusza sztucznego futra"

#. ~ Description of "patchwork faux fur sheet"
#: data/json/items/resources/tailoring.json
msgid ""
"A 12-inch by 24-inch sheet of faux fur sewn together from mismatched patches."
"  Suitable for making clothing if you lack proper material sheets, but the "
"bright, clashing colors might end up making you look like a diseased Muppet."
msgstr ""
"Arkusz sztucznego futra o wymiarach 30 na 60 cm, zszyty z niedopasowanych "
"łat. Nadaje się do szycia odzieży, jeśli brakuje ci porządnych arkuszy "
"materiału, ale jaskrawe, gryzące się kolory mogą sprawić, że będziesz "
"wyglądać jak chory Muppet."

#. ~ Description of "felt sheet"
#: data/json/items/resources/tailoring.json
msgid "A 12-inch by 24-inch sheet of felt, suitable for making clothing."
msgstr "Arkusz filcu o wymiarach 30 na 60 cm, nadający się do szycia odzieży."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "patchwork felt sheet"
msgid_plural "patchwork felt sheets"
msgstr[0] "patchworkowy arkusz filcu"
msgstr[1] "patchworkowe arkusze filcu"
msgstr[2] "patchworkowych arkuszy filcu"
msgstr[3] "patchworkowego arkusza filcu"

#. ~ Description of "patchwork felt sheet"
#: data/json/items/resources/tailoring.json
msgid ""
"A 12-inch by 24-inch sheet of felt sewn together from patches.  Suitable for "
"making clothing if you lack proper material sheets."
msgstr ""
"Arkusz filcu o wymiarach 30 na 60 cm, zszyty z łat. Nadaje się do szycia "
"odzieży, jeśli brakuje ci porządnych arkuszy materiału."

#. ~ Description of "Kevlar sheet"
#: data/json/items/resources/tailoring.json
msgid ""
"A 12-inch by 24-inch sheet of loose-woven Kevlar synthetic fabric, suitable "
"for making durable cut and stab resistant clothing.  While protective, this "
"kind of Kevlar is not suitable for making ballistic gear due to the "
"difference in weave tightness."
msgstr ""
"Arkusz luźno tkanej syntetycznej tkaniny kevlarowej o wymiarach 30 na 60 cm, "
"nadający się do szycia wytrzymałej odzieży odpornej na cięcia i pchnięcia. "
"Choć zapewnia ochronę, ten rodzaj kevlaru nie nadaje się do wyrobu sprzętu "
"balistycznego ze względu na różnicę w gęstości splotu."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "patchwork Kevlar sheet"
msgid_plural "patchwork Kevlar sheets"
msgstr[0] "patchworkowy arkusz kevlaru"
msgstr[1] "patchworkowe arkusze kevlaru"
msgstr[2] "patchworkowych arkuszy kevlaru"
msgstr[3] "patchworkowego arkusza kevlaru"

#. ~ Description of "patchwork Kevlar sheet"
#: data/json/items/resources/tailoring.json
msgid ""
"A 12-inch by 24-inch sheet of fabric sewn together from Kevlar patches, "
"suitable for making durable cut and stab resistant clothing.  This would be "
"out of the question for ballistic Kevlar but the simpler, looser weave of "
"this variety means it is fine to use if you lack proper material sheets."
msgstr ""
"Arkusz tkaniny o wymiarach 30 na 60 cm, zszyty z łat kevlaru, nadający się do"
" szycia wytrzymałej odzieży odpornej na cięcia i pchnięcia. W przypadku "
"kevlaru balistycznego nie wchodziłoby to w grę, ale prostszy, luźniejszy "
"splot tej odmiany sprawia, że można go użyć, jeśli brakuje ci porządnych "
"arkuszy materiału."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "Kevlar patch"
msgid_plural "Kevlar patches"
msgstr[0] "łata kevlaru"
msgstr[1] "łaty kevlaru"
msgstr[2] "łat kevlaru"
msgstr[3] "łaty kevlaru"

#. ~ Description of "Kevlar patch"
#: data/json/items/resources/tailoring.json
msgid ""
"A 6-inch square patch of loose-woven Kevlar, suitable for repairing cut and "
"stab resistant clothing or reassembling into a patchwork sheet for sewing."
msgstr ""
"Kwadratowa łata luźno tkanego kevlaru o boku 15 cm, nadająca się do naprawy "
"odzieży odpornej na cięcia i pchnięcia albo do zszycia w patchworkowy arkusz "
"do szycia."

#. ~ Description of "Lycra sheet"
#: data/json/items/resources/tailoring.json
msgid ""
"A sheet of synthetic fabric blended with stretchy Lycra fibers, suitable for "
"making flexible, yet strong clothing."
msgstr ""
"Arkusz tkaniny syntetycznej z domieszką rozciągliwych włókien Lycry, nadający"
" się do szycia elastycznej, a zarazem mocnej odzieży."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "ballistic Kevlar panel"
msgid_plural "ballistic Kevlar panels"
msgstr[0] "balistyczny panel kevlarowy"
msgstr[1] "balistyczne panele kevlarowe"
msgstr[2] "balistycznych paneli kevlarowych"
msgstr[3] "balistycznego panelu kevlarowego"

#. ~ Description of "ballistic Kevlar panel"
#: data/json/items/resources/tailoring.json
msgid ""
"A small, 16-layer thick ballistic Kevlar panel.  This kind of Kevlar is "
"precision-made by machine and features an extremely tight weave which cannot "
"be replicated by hand.  Due to this, any damage incurred to your ballistic "
"armor will necessitate complete replacement with a new panel.  It is not as "
"effective as loose-woven Kevlar at stopping stab wounds, but it has no equal "
"against the threat posed by firearms."
msgstr ""
"Mały, szesnastowarstwowy balistyczny panel kevlarowy. Ten rodzaj kevlaru jest"
" precyzyjnie wytwarzany maszynowo i ma niezwykle gęsty splot, którego nie da "
"się odtworzyć ręcznie. Z tego powodu każde uszkodzenie pancerza balistycznego"
" wymaga całkowitej wymiany na nowy panel. Nie zatrzymuje pchnięć tak "
"skutecznie jak luźno tkany kevlar, ale nie ma sobie równych w ochronie przed "
"bronią palną."

#. ~ Description of "rigid Kevlar plate"
#: data/json/items/resources/tailoring.json
msgid ""
"A compressed panel of Kevlar treated with epoxy or other adhesive.  It could "
"be used to repair items made of rigid Kevlar, and makes a decent substitute "
"for damaged carbon fiber and the like even if it isn't exactly the same."
msgstr ""
"Sprasowany panel kevlaru nasycony żywicą epoksydową lub innym klejem. Można "
"go użyć do naprawy przedmiotów ze sztywnego kevlaru, a także jako całkiem "
"dobry zamiennik uszkodzonego włókna węglowego i podobnych materiałów, nawet "
"jeśli nie jest dokładnie tym samym."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "patchwork Lycra sheet"
msgid_plural "patchwork Lycra sheets"
msgstr[0] "patchworkowy arkusz Lycry"
msgstr[1] "patchworkowe arkusze Lycry"
msgstr[2] "patchworkowych arkuszy Lycry"
msgstr[3] "patchworkowego arkusza Lycry"

#. ~ Description of "patchwork Lycra sheet"
#: data/json/items/resources/tailoring.json
msgid ""
"A 12-inch by 24-inch sheet of fabric sewn together from Lycra patches.  "
"Suitable for making flexible, yet strong clothing if you lack proper material"
" sheets."
msgstr ""
"Arkusz tkaniny o wymiarach 30 na 60 cm, zszyty z łat Lycry. Nadaje się do "
"szycia elastycznej, a zarazem mocnej odzieży, jeśli brakuje ci porządnych "
"arkuszy materiału."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "patchwork neoprene sheet"
msgid_plural "patchwork neoprene sheets"
msgstr[0] "patchworkowy arkusz neoprenu"
msgstr[1] "patchworkowe arkusze neoprenu"
msgstr[2] "patchworkowych arkuszy neoprenu"
msgstr[3] "patchworkowego arkusza neoprenu"

#. ~ Description of "patchwork neoprene sheet"
#: data/json/items/resources/tailoring.json
msgid ""
"A sheet of neoprene sewn together from patches, with waterproofed seams.  "
"Suitable for making underwater gear if you lack proper material sheets."
msgstr ""
"Arkusz neoprenu zszyty z łat, z uszczelnionymi szwami. Nadaje się do szycia "
"sprzętu do nurkowania, jeśli brakuje ci porządnych arkuszy materiału."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "patchwork Nomex sheet"
msgid_plural "patchwork Nomex sheets"
msgstr[0] "patchworkowy arkusz Nomeksu"
msgstr[1] "patchworkowe arkusze Nomeksu"
msgstr[2] "patchworkowych arkuszy Nomeksu"
msgstr[3] "patchworkowego arkusza Nomeksu"

#. ~ Description of "patchwork Nomex sheet"
#: data/json/items/resources/tailoring.json
msgid ""
"A sheet of Nomex synthetic fabric, sewn together from patches using Nomex "
"thread.  Suitable for making heat-resistant clothing if you lack proper "
"material sheets."
msgstr ""
"Arkusz syntetycznej tkaniny Nomex, zszyty z łat nicią z Nomeksu. Nadaje się "
"do szycia odzieży żaroodpornej, jeśli brakuje ci porządnych arkuszy "
"materiału."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "patchwork synthetic fabric sheet"
msgid_plural "patchwork synthetic fabric sheet"
msgstr[0] "patchworkowy arkusz tkaniny syntetycznej"
msgstr[1] "patchworkowe arkusze tkaniny syntetycznej"
msgstr[2] "patchworkowych arkuszy tkaniny syntetycznej"
msgstr[3] "patchworkowego arkusza tkaniny syntetycznej"

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "gambeson batting"
msgid_plural "clumps of gambeson batting"
msgstr[0] "wypełnienie przeszywanicy"
msgstr[1] "kłęby wypełnienia przeszywanicy"
msgstr[2] "kłębów wypełnienia przeszywanicy"
msgstr[3] "kłębu wypełnienia przeszywanicy"

#. ~ Description of "gambeson batting"
#: data/json/items/resources/tailoring.json
msgid ""
"A pile of shredded fabric, dry grass, hair or other cheap materials which "
"could be used to stuff the fabric layers of a gambeson to create armor more "
"cheaply and easily than properly layering and quilting the entire product."
msgstr ""
"Stos postrzępionej tkaniny, suchej trawy, włosów lub innych tanich "
"materiałów, którymi można wypchać warstwy tkaniny przeszywanicy, by stworzyć "
"pancerz taniej i łatwiej niż przez porządne układanie warstw i pikowanie "
"całości."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "Kevlar thread"
msgid_plural "Kevlar thread"
msgstr[0] "nić kevlarowa"
msgstr[1] "nici kevlarowe"
msgstr[2] "nici kevlarowych"
msgstr[3] "nici kevlarowej"

#. ~ Description of "Kevlar thread"
#: data/json/items/resources/tailoring.json
msgid ""
"Very durable Kevlar thread that would be particularly useful for making "
"ballistic armor, though it's fine to use in place of normal thread too, in "
"most cases.  Making armor-grade Kevlar sheets from this would need a "
"particularly tight weave, and so would require some specialized machinery."
msgstr ""
"Bardzo wytrzymała nić kevlarowa, szczególnie przydatna do szycia pancerzy "
"balistycznych, choć w większości przypadków można jej też używać zamiast "
"zwykłej nici. Wykonanie z niej arkuszy kevlaru klasy pancernej wymagałoby "
"szczególnie gęstego splotu, a więc i specjalistycznych maszyn."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "Nomex thread"
msgid_plural "Nomex thread"
msgstr[0] "nić z Nomeksu"
msgstr[1] "nici z Nomeksu"
msgstr[2] "nici z Nomeksu"
msgstr[3] "nici z Nomeksu"

#. ~ Description of "Nomex thread"
#: data/json/items/resources/tailoring.json
msgid ""
"Heat-resistant Nomex thread that would be particularly useful for making heat"
" protection gear, though it's fine to use in place of normal thread too, in "
"most cases."
msgstr ""
"Żaroodporna nić z Nomeksu, szczególnie przydatna do szycia sprzętu "
"chroniącego przed wysoką temperaturą, choć w większości przypadków można jej "
"też używać zamiast zwykłej nici."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "denim sheet"
msgid_plural "denim sheets"
msgstr[0] "arkusz dżinsu"
msgstr[1] "arkusze dżinsu"
msgstr[2] "arkuszy dżinsu"
msgstr[3] "arkusza dżinsu"

#. ~ Description of "denim sheet"
#: data/json/items/resources/tailoring.json
msgid ""
"A 12 inch by 24 inch sheet of durable blue denim, suitable for making jeans, "
"jorts, or jirts."
msgstr ""
"Arkusz wytrzymałego niebieskiego dżinsu o wymiarach 30 na 60 cm, nadający się"
" do szycia dżinsów, dżinsowych szortów albo dżinsowych koszul."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "denim scraps"
msgid_plural "denim scraps"
msgstr[0] "skrawki dżinsu"
msgstr[1] "skrawki dżinsu"
msgstr[2] "skrawków dżinsu"
msgstr[3] "skrawków dżinsu"

#. ~ Description of "denim scraps"
#: data/json/items/resources/tailoring.json
msgid ""
"Oddly-shaped smallish denim patches, waste material from tailoring projects."
msgstr ""
"Dziwnie ukształtowane, niewielkie łatki dżinsu, odpady z prac krawieckich."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "denim patch"
msgid_plural "denim patches"
msgstr[0] "łata dżinsu"
msgstr[1] "łaty dżinsu"
msgstr[2] "łat dżinsu"
msgstr[3] "łaty dżinsu"

#. ~ Description of "denim patch"
#: data/json/items/resources/tailoring.json
msgid ""
"A small, 6 inch square patch of blue denim.  It could be used to repair items"
" made of denim or stitched into patchwork sheets for tailoring projects."
msgstr ""
"Mała, kwadratowa łata niebieskiego dżinsu o boku 15 cm. Można jej użyć do "
"naprawy przedmiotów z dżinsu albo zszyć w patchworkowe arkusze do prac "
"krawieckich."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "patchwork denim sheet"
msgid_plural "patchwork denim sheets"
msgstr[0] "patchworkowy arkusz dżinsu"
msgstr[1] "patchworkowe arkusze dżinsu"
msgstr[2] "patchworkowych arkuszy dżinsu"
msgstr[3] "patchworkowego arkusza dżinsu"

#. ~ Description of "patchwork denim sheet"
#: data/json/items/resources/tailoring.json
msgid ""
"A selection of various sections of denim, sewn together in a patchwork "
"fashion.  Suitable for tailoring, though it's much less time-efficient than "
"if using proper material sheets."
msgstr ""
"Zestaw różnych kawałków dżinsu, zszytych na wzór patchworku. Nadaje się do "
"prac krawieckich, choć praca z nim zajmuje znacznie więcej czasu niż z "
"porządnymi arkuszami materiału."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "canvas sheet"
msgid_plural "canvas sheets"
msgstr[0] "arkusz płótna"
msgstr[1] "arkusze płótna"
msgstr[2] "arkuszy płótna"
msgstr[3] "arkusza płótna"

#. ~ Description of "canvas sheet"
#: data/json/items/resources/tailoring.json
msgid ""
"A 12 inch by 24 inch sheet of durable and waterproof waxed canvas fabric, "
"suitable for making tough bags and clothing."
msgstr ""
"Arkusz wytrzymałego i wodoodpornego woskowanego płótna o wymiarach 30 na 60 "
"cm, nadający się do szycia mocnych toreb i odzieży."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "heavy duty thread"
msgid_plural "heavy duty thread"
msgstr[0] "wzmocniona nić"
msgstr[1] "wzmocnione nici"
msgstr[2] "wzmocnionych nici"
msgstr[3] "wzmocnionej nici"

#. ~ Description of "heavy duty thread"
#: data/json/items/resources/tailoring.json
msgid ""
"Some tough canvas-weight thread, sturdier than ordinary thread.  You could "
"meticulously weave this into a sheet of canvas cloth.  It would also be "
"useful for stitching such sheets together, though it's fine to use for normal"
" tailoring projects too."
msgstr ""
"Trochę mocnej nici o grubości odpowiedniej do płótna, solidniejszej niż "
"zwykła nić. Mozolnie można by z niej utkać arkusz płótna. Przydałaby się też "
"do zszywania takich arkuszy, choć można jej używać również w zwykłych pracach"
" krawieckich."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "canvas scraps"
msgid_plural "canvas scraps"
msgstr[0] "skrawki płótna"
msgstr[1] "skrawki płótna"
msgstr[2] "skrawków płótna"
msgstr[3] "skrawków płótna"

#. ~ Description of "canvas scraps"
#: data/json/items/resources/tailoring.json
msgid ""
"Oddly-shaped smallish bits of canvas, waste material from tailoring projects."
"  Not useful for much and usually disposed of, but can be recycled into some "
"tough thread."
msgstr ""
"Dziwnie ukształtowane, niewielkie skrawki płótna, odpady z prac krawieckich. "
"Do niczego się szczególnie nie przydają i zwykle się je wyrzuca, ale można je"
" przerobić na trochę mocnej nici."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "canvas patch"
msgid_plural "canvas patches"
msgstr[0] "łata płótna"
msgstr[1] "łaty płótna"
msgstr[2] "łat płótna"
msgstr[3] "łaty płótna"

#. ~ Description of "canvas patch"
#: data/json/items/resources/tailoring.json
msgid ""
"A small, 6 inch square patch of tough canvas.  It could be used to repair "
"items made of canvas or stitched into patchwork sheets for tailoring "
"projects."
msgstr ""
"Mała, kwadratowa łata mocnego płótna o boku 15 cm. Można jej użyć do naprawy "
"przedmiotów z płótna albo zszyć w patchworkowe arkusze do prac krawieckich."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "patchwork canvas sheet"
msgid_plural "patchwork canvas sheets"
msgstr[0] "patchworkowy arkusz płótna"
msgstr[1] "patchworkowe arkusze płótna"
msgstr[2] "patchworkowych arkuszy płótna"
msgstr[3] "patchworkowego arkusza płótna"

#. ~ Description of "patchwork canvas sheet"
#: data/json/items/resources/tailoring.json
msgid ""
"A selection of various sections of canvas, sewn together in a patchwork "
"fashion.  Suitable for tailoring, though it's much less time-efficient than "
"if using proper material sheets."
msgstr ""
"Zestaw różnych kawałków płótna, zszytych na wzór patchworku. Nadaje się do "
"prac krawieckich, choć praca z nim zajmuje znacznie więcej czasu niż z "
"porządnymi arkuszami materiału."

#. ~ Item name
#: data/json/items/resources/tailoring.json
msgid "fabric strap"
msgid_plural "fabric straps"
msgstr[0] "pasek z tkaniny"
msgstr[1] "paski z tkaniny"
msgstr[2] "pasków z tkaniny"
msgstr[3] "paska z tkaniny"

#. ~ Description of "fabric strap"
#: data/json/items/resources/tailoring.json
msgid ""
"A strip of broad, flat cotton, 42 inches in length, with a metal adjustment "
"buckle threaded in the center.  Normally used as a shoulder strap for bags, "
"its ends are usually sown about a corresponding container's D-rings."
msgstr ""
"Szeroki, płaski pas bawełny o długości 107 cm z metalową klamrą regulacyjną "
"przewleczoną pośrodku. Zwykle służy jako pasek na ramię do toreb; jego końce "
"przyszywa się zazwyczaj wokół półkółek odpowiedniego pojemnika."

#. ~ Description of "log"
#: data/json/items/resources/wood.json
msgid ""
"A large log of wood, cut from a tree.  (a)ctivate a wood axe or wood saw to "
"cut it into planks."
msgstr ""
"Duża kłoda drewna, ścięta z drzewa. Aktywuj (a) siekierę do drewna lub piłę "
"do drewna, by pociąć ją na deski."

#. ~ Item name
#: data/json/items/resources/wood.json
msgid "soaking long pole"
msgid_plural "soaking long poles"
msgstr[0] "nasiąkająca długa tyczka"
msgstr[1] "nasiąkające długie tyczki"
msgstr[2] "nasiąkających długich tyczek"
msgstr[3] "nasiąkającej długiej tyczki"

#. ~ Description of "soaking long pole"
#: data/json/items/resources/wood.json
msgid ""
"A stout, ten-foot pole.  Could be used similarly to a spear.  It's currently "
"soaked with oil and quite slippery.  Once the oil penetrates the wood it can "
"be wiped down and used for further projects."
msgstr ""
"Tęga, trzymetrowa tyczka. Można jej używać podobnie jak włóczni. Obecnie jest"
" nasączona olejem i dość śliska. Gdy olej wsiąknie w drewno, będzie można ją "
"wytrzeć i użyć do dalszych prac."

#. ~ "msg" action message of item "soaking long pole"
#: data/json/items/resources/wood.json
msgid "You wipe down the long pole."
msgstr "Wycierasz długą tyczkę."

#. ~ "not_ready_msg" action message of item "soaking long pole"
#: data/json/items/resources/wood.json
msgid "The long pole is still soaking."
msgstr "Długa tyczka wciąż nasiąka."

#. ~ Item name
#: data/json/items/resources/wood.json
msgid "soaking spear shaft"
msgid_plural "soaking spear shafts"
msgstr[0] "nasiąkające drzewce włóczni"
msgstr[1] "nasiąkające drzewca włóczni"
msgstr[2] "nasiąkających drzewc włóczni"
msgstr[3] "nasiąkającego drzewca włóczni"

#. ~ Description of "soaking spear shaft"
#: data/json/items/resources/wood.json
msgid ""
"A long stick carved and sanded into a smooth staff with a slight taper, for "
"use in making spears.  It's currently soaked with oil and quite slippery.  "
"Once the oil penetrates the wood it can be wiped down and used for further "
"projects."
msgstr ""
"Długi kij wystrugany i wygładzony na gładki, lekko zwężający się drążek, do "
"wyrobu włóczni. Obecnie jest nasączony olejem i dość śliski. Gdy olej "
"wsiąknie w drewno, będzie można go wytrzeć i użyć do dalszych prac."

#. ~ "msg" action message of item "soaking spear shaft"
#: data/json/items/resources/wood.json
msgid "You wipe down the spear shaft."
msgstr "Wycierasz drzewce włóczni."

#. ~ "not_ready_msg" action message of item "soaking spear shaft"
#: data/json/items/resources/wood.json
msgid "The spear shaft is still soaking."
msgstr "Drzewce włóczni wciąż nasiąka."

#. ~ Item name
#: data/json/items/resources/wood.json
msgid "spear shaft"
msgid_plural "spear shafts"
msgstr[0] "drzewce włóczni"
msgstr[1] "drzewca włóczni"
msgstr[2] "drzewc włóczni"
msgstr[3] "drzewca włóczni"

#. ~ Description of "spear shaft"
#: data/json/items/resources/wood.json
msgid ""
"A long stick, sanded and treated with oil for integrity and carved into a "
"smooth staff with a slight taper, for use in making spears.  It can also be "
"used as a makeshift quarterstaff as-is, but is too thin to be very effective "
"for just hitting people."
msgstr ""
"Długi kij, wygładzony i zaimpregnowany olejem dla wytrzymałości, wystrugany "
"na gładki, lekko zwężający się drążek do wyrobu włóczni. W obecnej postaci "
"może też posłużyć jako prowizoryczna laska bojowa, ale jest zbyt cienki, by "
"skutecznie okładać nim ludzi."

#. ~ Description of "plank"
#: data/json/items/resources/wood.json
msgid ""
"A flat, thick plank of wood, like a 2 by 4 or similar piece of dimensional "
"lumber.  Makes a decent melee weapon if you're desperate, and can be used for"
" all kinds of construction projects."
msgstr ""
"Płaska, gruba deska drewniana, jak kantówka 5 x 10 cm lub podobna tarcica "
"wymiarowa. W desperacji całkiem dobra broń do walki w zwarciu, a do tego "
"przydaje się w najróżniejszych pracach budowlanych."

#. ~ Item name
#: data/json/items/resources/wood.json
msgid "tonewood"
msgid_plural "blocks of tonewood"
msgstr[0] "drewno rezonansowe"
msgstr[1] "klocki drewna rezonansowego"
msgstr[2] "klocków drewna rezonansowego"
msgstr[3] "klocka drewna rezonansowego"

#. ~ Description of "tonewood"
#: data/json/items/resources/wood.json
msgid ""
"A block of tonally appropriate wood that has been air dried for a year in "
"preparation for being turned into a musical instrument."
msgstr ""
"Klocek drewna o odpowiednich właściwościach akustycznych, suszony na "
"powietrzu przez rok w ramach przygotowania do zrobienia z niego instrumentu "
"muzycznego."

#. ~ Item name
#: data/json/items/resources/wood.json
msgid "tuning peg"
msgid_plural "tuning pegs"
msgstr[0] "kołek stroikowy"
msgstr[1] "kołki stroikowe"
msgstr[2] "kołków stroikowych"
msgstr[3] "kołka stroikowego"

#. ~ Description of "tuning peg"
#: data/json/items/resources/wood.json
msgid ""
"Tuning pegs go on stringed instruments to both provide an anchor for the "
"strings and to control the tightness of the wire which in turn controls the "
"tune of the notes produced."
msgstr ""
"Kołki stroikowe montuje się w instrumentach strunowych; służą zarówno jako "
"zaczep dla strun, jak i do regulacji ich naprężenia, które z kolei decyduje o"
" wysokości wydobywanych dźwięków."

#. ~ Item name
#: data/json/items/resources/wood.json
#: data/mods/Xedra_Evolved/items/weapon_copy_extensions.json
msgid "short plank"
msgid_plural "short planks"
msgstr[0] "krótka deska"
msgstr[1] "krótkie deski"
msgstr[2] "krótkich desek"
msgstr[3] "krótkiej deski"

#. ~ Description of "short plank"
#: data/json/items/resources/wood.json
msgid ""
"A short 2 by 4 plank of wood.  While less common and smaller than its 4 foot "
"cousin it can still be very useful in carpentry."
msgstr ""
"Krótka deska 5 x 10 cm. Choć rzadsza i mniejsza od swojej 120-centymetrowej "
"kuzynki, wciąż może bardzo się przydać w ciesielstwie."

#. ~ Item name
#: data/json/items/resources/wood.json
msgid "long plank"
msgid_plural "long planks"
msgstr[0] "długa deska"
msgstr[1] "długie deski"
msgstr[2] "długich desek"
msgstr[3] "długiej deski"
