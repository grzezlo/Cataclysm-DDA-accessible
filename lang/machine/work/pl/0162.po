#. ~ Description of monster "feral mender"
#: data/mods/MindOverMatter/monsters/feral_psychics.json
msgid ""
"Other than the intense expression, this feral human looks to be the picture "
"of health.  They could have starred in a healthcare advertisement before the "
"Cataclysm.  Only the jagged bit of wood clutched like a club indicates "
"something is wrong."
msgstr ""

#. ~ Monster attack message
#: data/mods/MindOverMatter/monsters/feral_psychics.json
#: data/mods/MindOverMatter/monsters/monster_overrides.json
#, c-format
msgid "%1$s touches you but only hits your armor."
msgstr ""

#. ~ Monster attack message
#: data/mods/MindOverMatter/monsters/feral_psychics.json
#: data/mods/MindOverMatter/monsters/monster_overrides.json
#, c-format
