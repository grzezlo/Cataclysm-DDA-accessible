msgstr[3] "stelaża nośnego"

#. ~ Description of "pack frame"
#: data/json/items/armor/storage.json
msgid "An L-shaped wooden frame with straps to secure a large item to it."
msgstr ""
"Drewniany stelaż w kształcie litery L z paskami do przymocowania dużego "
"przedmiotu."

