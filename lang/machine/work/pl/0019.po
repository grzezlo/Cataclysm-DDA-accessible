#. ~ Variant name of item "baseball cap"
#: data/json/items/armor/hats.json
msgid "Lone Pine cap"
msgid_plural "Lone Pine caps"
msgstr[0] "czapka Lone Pine"
msgstr[1] "czapki Lone Pine"
msgstr[2] "czapek Lone Pine"
msgstr[3] "czapki Lone Pine"

#. ~ Description of variant "Lone Pine cap" of item "baseball cap"
#: data/json/items/armor/hats.json
msgid ""
"A snapback baseball cap displaying the shape of a single pine tree at the "
"front.  It shields your eyes from the sun and provides a little bit of "
"warmth."
msgstr ""
"Baseballówka z paskiem do regulacji, z sylwetką pojedynczej sosny z przodu. "
"Chroni oczy przed słońcem i daje odrobinę ciepła."

#. ~ Variant name of item "baseball cap"
#: data/json/items/armor/hats.json
