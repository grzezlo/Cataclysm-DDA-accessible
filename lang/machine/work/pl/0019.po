#. ~ Item name
#: data/json/items/armor/hats.json
msgid "summer hard hat"
msgid_plural "summer hard hats"
msgstr[0] "letni kask"
msgstr[1] "letnie kaski"
msgstr[2] "letnich kasków"
msgstr[3] "letniego kasku"

#. ~ Description of "summer hard hat"
#: data/json/items/armor/hats.json
msgid ""
"A hard plastic hat worn at construction and industrial sites, with a sun "
"shield tucked on top to keep the glare out of your eyes.  Protects your eyes "
"from the harsh sun, although it makes ear muffs unattachable to the hard hat "
"itself."
msgstr ""
"Twardy plastikowy kask noszony na budowach i w zakładach przemysłowych, z "
"osłoną przeciwsłoneczną zamocowaną na górze, która chroni oczy przed "
"oślepiającym blaskiem. Chroni oczy przed ostrym słońcem, ale uniemożliwia "
"zamocowanie nauszników do samego kasku."

#. ~ Variant name of item "summer hard hat"
#: data/json/items/armor/hats.json
msgid "yellow summer hard hat"
msgid_plural "yellow summer hard hats"
msgstr[0] "żółty letni kask"
msgstr[1] "żółte letnie kaski"
