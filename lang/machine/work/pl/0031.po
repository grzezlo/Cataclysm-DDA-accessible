msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "eggplant parmigiana"
#: data/json/items/comestibles/casseroles.json
msgid "A good portion of tasty eggplant parmigiana."
msgstr ""

#. ~ Description of "milk"
#: data/json/items/comestibles/dairy.json
msgid "Baby cow food, appropriated for human consumption.  Spoils rapidly."
msgstr ""

#. ~ Description of "chocolate milk"
#: data/json/items/comestibles/dairy.json
msgid ""
"Baby cow food, with chocolate added for human enjoyment.  Spoils rapidly."
msgstr ""

#. ~ Description of "reconstituted milk"
#: data/json/items/comestibles/dairy.json
