#: data/json/items/comestibles/carnivore.json
msgid "cooked poultry"
msgid_plural "cooked poultry"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "cooked poultry"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A chunk of bird meat that has been cooked.  Nutritious and safe to eat, but a"
" bit bland."
msgstr ""

