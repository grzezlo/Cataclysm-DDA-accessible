msgid "cooked pepper poultry"
msgid_plural "cooked pepper poultry"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "cooked pepper poultry"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A cut of bird meat that has been cooked with salt and pepper.  The simple "
"addition of spices has made it much more palatable."
msgstr ""

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "cooked scrap of poultry"
msgid_plural "cooked scraps of poultry"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "cooked scrap of poultry"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A tiny scrap of cooked meat from a bird.  Not very filling, and a bit bland."
msgstr ""

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "cooked pepper scrap of poultry"
msgid_plural "cooked pepper scraps of poultry"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "cooked pepper scrap of poultry"
#: data/json/items/comestibles/carnivore.json
msgid ""
"A tiny scrap of cooked bird meat, seasoned with simple spices.  Makes for a "
"nice high-protein snack."
msgstr ""

#. ~ Item name
#: data/json/items/comestibles/carnivore.json
msgid "chicken jerky"
msgid_plural "chicken jerky"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "chicken jerky"
#: data/json/items/comestibles/carnivore.json
