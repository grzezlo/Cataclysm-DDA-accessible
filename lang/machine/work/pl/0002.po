#: src/crafting.cpp
msgid "Ugh, this should be EASY with how smart you are!"
msgstr "Ugh, przy twoim intelekcie to powinno być ŁATWE!"

#: src/crafting.cpp
msgid "<npcname> seems to get really upset over this."
msgstr "<npcname> wydaje się tym bardzo przejmować."

#: src/crafting.cpp
#, c-format
msgid "%1s crafts %2s using a reference."
msgstr "%1s wytwarza %2s, korzystając z materiałów pomocniczych."

#: src/crafting.cpp
#, c-format
msgid "You have insufficient %s charges and can't continue crafting."
msgstr "Brakuje ci ładunków: %s i nie możesz kontynuować wytwarzania."

#: src/crafting.cpp
#, c-format
msgid "<npcname> has insufficient %s charges and can't continue crafting."
msgstr ""
"<npcname> nie ma wystarczająco ładunków: %s i nie może kontynuować "
"wytwarzania."

#: src/crafting_gui.cpp
#, c-format
msgid "Minor Failure Chance: <color_%s>%2.2f%%</color>"
msgstr "Szansa drobnego niepowodzenia: <color_%s>%2.2f%%</color>"

#: src/crafting_gui.cpp
#, c-format
msgid "Catastrophic Failure Chance: <color_%s>%2.2f%%</color>"
msgstr "Szansa katastrofalnego niepowodzenia: <color_%s>%2.2f%%</color>"

#: src/crafting_gui.cpp
#, c-format
msgid "Crafter: %s\n"
msgstr "Wytwórca: %s\n"

#: src/crafting_gui.cpp
msgid ""
"<color_red>Crafter cannot practice this because they lack the theoretical "
"knowledge for it.</color>\n"
msgstr ""
"<color_red>Wytwórca nie może tego ćwiczyć, ponieważ brakuje mu wiedzy "
"teoretycznej.</color>\n"

#: src/crafting_gui.cpp
msgid ""
"<color_red>Crafter cannot craft this because they lack the theoretical "
"knowledge to understand the recipe.</color>\n"
msgstr ""
"<color_red>Wytwórca nie może tego wytworzyć, ponieważ brakuje mu wiedzy "
"teoretycznej, by zrozumieć przepis.</color>\n"

#: src/crafting_gui.cpp
msgid ""
"<color_red>Cannot be crafted because the same item is needed for multiple "
"components.</color>\n"
msgstr ""
"<color_red>Nie można wytworzyć, ponieważ ten sam przedmiot jest potrzebny do "
"kilku komponentów.</color>\n"

#: src/crafting_gui.cpp
#, c-format
msgid ""
"<color_green>This recipe will be %.2fx faster than normal, and your effective"
" skill will be %.2f levels higher than normal, because of the proficiencies "
"the crafter has.</color>\n"
msgstr ""
"<color_green>Ten przepis będzie wykonywany %.2fx szybciej niż normalnie, a "
"twoja efektywna umiejętność będzie o %.2f poziomu wyższa niż normalnie dzięki"
" biegłościom wytwórcy.</color>\n"

#: src/crafting_gui.cpp
#, c-format
msgid ""
"<color_green>This recipe will be %.2fx faster than normal, because of the "
"proficiencies the crafter has.</color>\n"
msgstr ""
"<color_green>Ten przepis będzie wykonywany %.2fx szybciej niż normalnie "
"dzięki biegłościom wytwórcy.</color>\n"

#: src/crafting_gui.cpp
#, c-format
msgid ""
"<color_green>Your effective skill will be %.2f levels higher than normal, "
"because of the proficiencies the crafter has.</color>\n"
msgstr ""
"<color_green>Twoja efektywna umiejętność będzie o %.2f poziomu wyższa niż "
"normalnie dzięki biegłościom wytwórcy.</color>\n"

#: src/crafting_gui.cpp
msgid ""
"<color_red>Cannot be crafted because the crafter lacks the required "
"proficiencies.</color>\n"
msgstr ""
"<color_red>Nie można wytworzyć, ponieważ wytwórcy brakuje wymaganych "
"biegłości.</color>\n"

#: src/crafting_gui.cpp
#, c-format
msgid ""
"The crafter does not possess the minimum <color_cyan>%s</color> skill level "
"required to practice this."
msgstr ""
"Wytwórca nie ma minimalnego poziomu umiejętności <color_cyan>%s</color> "
"wymaganego, by to ćwiczyć."

#: src/crafting_gui.cpp
msgid ""
"<bold>Note:</bold> If crafted from poorly-fitting components, the resulting "
"item may also be poorly-fitted."
msgstr ""
"<bold>Uwaga:</bold> Jeśli wytworzysz przedmiot ze źle dopasowanych "
"komponentów, wynikowy przedmiot również może być źle dopasowany."

