msgid_plural "pairs of jungle-camo pants"
msgstr[0] "para spodni w kamuflażu dżunglowym"
msgstr[1] "pary spodni w kamuflażu dżunglowym"
msgstr[2] "par spodni w kamuflażu dżunglowym"
msgstr[3] "pary spodni w kamuflażu dżunglowym"

