msgstr[1] "pary dżinsowych szortów"
msgstr[2] "par dżinsowych szortów"
msgstr[3] "pary dżinsowych szortów"

#. ~ Snippet of item "jorts"
#: data/json/items/armor/legs_clothes.json
msgid "An old pair of denim jeans that have been cut down into shorts."
msgstr "Stara para dżinsów obciętych do długości szortów."

#. ~ Description of "jean skirt"
#: data/json/items/armor/legs_clothes.json
msgid "A blue skirt made from denim."
msgstr "Niebieska spódniczka z dżinsu."

