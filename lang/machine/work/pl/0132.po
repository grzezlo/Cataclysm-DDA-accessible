"Someday I will\""
msgstr ""

#. ~ Snippet in category "backrooms_note"
#: data/mods/Backrooms/snippets.json
msgid "\"eat the walls\""
msgstr ""

#. ~ Snippet in category "backrooms_note"
#: data/mods/Backrooms/snippets.json
