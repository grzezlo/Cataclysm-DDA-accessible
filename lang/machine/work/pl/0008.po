msgid_plural "quill ink"
msgstr[0] "atrament do pióra"
msgstr[1] "porcje atramentu do pióra"
msgstr[2] "porcji atramentu do pióra"
msgstr[3] "porcji atramentu do pióra"

#. ~ Description of "quill ink"
#: data/json/items/ammo.json
msgid "Ink made from a variety of sources for use in quill style pens."
