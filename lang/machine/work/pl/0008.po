msgid_plural "chunks of bronze"
msgstr[0] "kawałek brązu"
msgstr[1] "kawałki brązu"
msgstr[2] "kawałków brązu"
msgstr[3] "kawałka brązu"

#. ~ Description of "chunk of bronze"
#: data/json/items/ammo.json
msgid ""
"Some decent-sized chunks of scrap bronze, for fashioning some old-school "
