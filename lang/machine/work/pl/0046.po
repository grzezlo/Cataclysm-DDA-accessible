msgid_plural "studded kanabō"
msgstr[0] "kanabō z ćwiekami"
msgstr[1] "kanabō z ćwiekami"
msgstr[2] "kanabō z ćwiekami"
msgstr[3] "kanabō z ćwiekami"

#. ~ Description of "studded kanabō"
#: data/json/items/melee/bludgeons.json
msgid ""
"A two-handed war club used in feudal Japan by samurai against armored "
"opponents.  Made from hardwood with metal stud inlays."
msgstr ""
"Dwuręczna maczuga bojowa, której w feudalnej Japonii używali samuraje "
"przeciwko opancerzonym przeciwnikom. Wykonana z twardego drewna z "
"wpuszczonymi metalowymi ćwiekami."

#. ~ Item name
#: data/json/items/melee/bludgeons.json
#: data/mods/Xedra_Evolved/items/weapon_copy_extensions.json
