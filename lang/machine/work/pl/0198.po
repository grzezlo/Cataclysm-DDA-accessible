msgstr ""

#. ~ Snippet in category "museum_plaques_items"
#: data/mods/Xedra_Evolved/snippets/museum.json
msgid ""
"Found in a Boston pawn shop, the owner claimed that late one night a strange "
"person entered the establishment and handed over this collection of items for"
" 'whatever is in the register'."
