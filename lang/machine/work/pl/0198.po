#. ~ Snippet in category "XE_CHANGELING_COMMONER_SELKIE"
#: data/mods/Xedra_Evolved/snippets/playable_changeling_dreams.json
msgid ""
"You dream of looking up at the sun from beneath the surface of the water."
msgstr ""

#. ~ Snippet in category "XE_CHANGELING_COMMONER_SELKIE"
#: data/mods/Xedra_Evolved/snippets/playable_changeling_dreams.json
msgid "You dream of frolicking in the seafoam."
msgstr ""

#. ~ Snippet in category "XE_CHANGELING_COMMONER_SELKIE"
#: data/mods/Xedra_Evolved/snippets/playable_changeling_dreams.json
msgid ""
"You dream of slipping on your skin and the shiver as your skin turns to fur "
"and your hands to flippers."
msgstr ""

#. ~ Snippet in category "XE_CHANGELING_COMMONER_SELKIE"
#: data/mods/Xedra_Evolved/snippets/playable_changeling_dreams.json
msgid ""
"You dream of bumping a fishing boat and giggling as the rod falls in the "
"water."
msgstr ""

#. ~ Snippet in category "XE_CHANGELING_COMMONER_TROW"
#: data/mods/Xedra_Evolved/snippets/playable_changeling_dreams.json
msgid "Your dreams are filled with the round of pickaxes striking rock."
msgstr ""

#. ~ Snippet in category "XE_CHANGELING_COMMONER_TROW"
