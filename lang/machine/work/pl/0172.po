#: data/mods/Sky_Island/missions_and_mapgen.json
msgid "Find the warp shards!"
msgstr ""

#. ~ Description of mission "Find the warp shards!"
#: data/mods/Sky_Island/missions_and_mapgen.json
msgid ""
"A very small cluster of warp energy has left shards behind at this location."
