#: data/mods/BombasticPerks/corefiles/config_menu.json
msgid "Current Setting"
msgstr ""

#. ~ NPC dialogue line
#: data/mods/BombasticPerks/corefiles/config_menu.json
msgid ""
"Set exp required per level.  Does not affect levels already gained, or "
"current level."
msgstr ""

#. ~ NPC dialogue line
#: data/mods/BombasticPerks/corefiles/config_menu.json
msgid "Should there be requirements to get perks?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/mods/BombasticPerks/corefiles/config_menu.json
