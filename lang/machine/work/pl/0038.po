msgid_plural "gallon cans"
msgstr[0] "galonowy kanister"
msgstr[1] "galonowe kanistry"
msgstr[2] "galonowych kanistrów"
msgstr[3] "galonowego kanistra"

#. ~ Description of "gallon can"
#: data/json/items/containers/containers.json
msgid ""
"A large tin with a handle and a cap, meant for holding camp fuel or some "
"other oil.  Looks like it could store just over a gallon."
msgstr ""
"Duża blaszana puszka z uchwytem i zakrętką, przeznaczona na paliwo "
"turystyczne lub inny olej. Wygląda na to, że zmieści nieco ponad galon."

