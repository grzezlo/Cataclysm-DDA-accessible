msgid ""
"Suddenly, there are some vague, but threatening shapes in the distance you do"
" not recognize."
msgstr ""

#. ~ Snippet in category "Shadow_Warnings_Snippets_late"
#: data/json/monsters/singularities.json
msgid "For a moment, the wind picks up and whistles an eerie song."
msgstr ""

#. ~ Snippet in category "Shadow_Warnings_Snippets_late"
#: data/json/monsters/singularities.json
msgid "The darkness makes you anxious."
msgstr ""

