msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "Canada goose"
#: data/json/monsters/bird.json
msgid "A common type of waterfowl that regrets leaving Canada."
msgstr ""

