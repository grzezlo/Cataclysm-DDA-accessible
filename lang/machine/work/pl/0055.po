msgid_plural "black-capped chickadees"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "black-capped chickadee"
#: data/json/monsters/bird.json
msgid ""
"A tiny species of tit native to North America, with a distinctive black cap "
"on its head."
msgstr ""

#. ~ Monster name
#: data/json/monsters/bird.json
msgid "cedar waxwing"
msgid_plural "cedar waxwings"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "cedar waxwing"
#: data/json/monsters/bird.json
msgid ""
"A small species of waxwing with a distinctive feathered crest and a black "
"mask pattern on its face."
msgstr ""

#. ~ Monster name
#: data/json/monsters/bird.json
msgid "mallard"
msgid_plural "mallards"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "mallard"
#: data/json/monsters/bird.json
msgid ""
"A common species of duck often seen around rivers and other bodies of water."
"  It feeds primarily on insects, seeds, roots, and, pre-Cataclysm, bread "
"scraps."
msgstr ""

#. ~ Monster name
#: data/json/monsters/bird.json
msgid "domestic duck"
msgid_plural "domestic ducks"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of monster "domestic duck"
#: data/json/monsters/bird.json
msgid "A domestic variety of the common mallard sporting while plumage."
msgstr ""

