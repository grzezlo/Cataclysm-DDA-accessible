#: data/mods/Magiclysm/items/alchemy_items.json
msgid "silver circlet"
msgid_plural "silver circlets"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of "silver circlet"
#: data/mods/Magiclysm/items/alchemy_items.json
msgid ""
"A wooden band with silver trimmings to be worn on the head.  Touching your "
"temples with it on makes you feel very calm."
msgstr ""

