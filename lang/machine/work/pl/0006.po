#: src/monattack.cpp
#, c-format
msgid "\"Drop your %s!  Now!\""
msgstr "„Rzuć to: %s! Już!”"

#: src/monattack.cpp
#, c-format
msgid "The %1$s loudly blows their whistle!"
msgstr "%1$s głośno dmie w gwizdek!"

#: src/monattack.cpp
msgid "\"Stop it please.\""
msgstr "„Proszę, przestań”."

#: src/monattack.cpp
msgid "\"Let us help you.\""
msgstr "„Pozwól nam sobie pomóc”."

#: src/monattack.cpp
msgid "\"We wish you no harm.\""
msgstr "„Nie chcemy cię skrzywdzić”."

#: src/monattack.cpp
msgid "\"Do not fear.\""
msgstr "„Nie bój się”."

#: src/monattack.cpp
msgid "\"We can help you.\""
msgstr "„Możemy ci pomóc”."

#: src/monattack.cpp
msgid "\"We are friendly.\""
msgstr "„Jesteśmy przyjaźni”."

#: src/monattack.cpp
msgid "\"Please don't.\""
msgstr "„Proszę, nie rób tego”."

#: src/monattack.cpp
msgid "The robot orders you to present your hands and be cuffed."
msgstr "Robot każe ci wyciągnąć ręce do skucia."

#: src/monattack.cpp
msgid ""
"You fall to the ground and feign a sudden convulsive attack.  Though you're "
"obviously still alive, the robot cannot tell the difference between your "
"'attack' and a potentially fatal medical condition.  It backs off, signaling "
"for medical help."
msgstr ""
"Padasz na ziemię i udajesz nagły atak drgawek. Choć wyraźnie wciąż żyjesz, "
"robot nie potrafi odróżnić twojego „ataku” od potencjalnie śmiertelnego stanu"
" medycznego. Wycofuje się, wzywając pomoc medyczną."

#: src/monattack.cpp
msgid "Your awkward movements do not fool the robot."
msgstr "Twoje niezdarne ruchy nie zwiodą robota."

#: src/monattack.cpp
#, c-format
msgid "The %s dissipates and reforms itself from the angles in the corner."
msgstr "%s rozprasza się i odtwarza z kątów pomieszczenia."

