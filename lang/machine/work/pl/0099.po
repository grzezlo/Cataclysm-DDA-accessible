msgid ""
"Your mind is open.  More than most.  Perhaps one day, you too will feel the "
"power of the song and become Kindred.  For now, traveler, listen, listen and "
"feel the song."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/Kindred/NPC_Brigitte_LaCroix.json
msgid "Thank you for sharing.  <done_conversation_section>"
msgstr ""

#. ~ Dialogue line in mission "Brigitte LaCroix asked you to collect clean,
#. untainted bones in order to better understand her beliefs.  8 bones should
#. be sufficient."
#. ~ NPC dialogue line
#: data/json/npcs/Kindred/NPC_Brigitte_LaCroix.json
msgid ""
"I understand your reluctance.  Feel free to return when you see the way."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/Kindred/NPC_Brigitte_LaCroix.json
msgid ""
"That's good, but I need to go at it alone right now.  <end_talking_later>"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/Kindred/NPC_Darren_Cooper.json
msgid "Hello again, traveler."
msgstr ""

#. ~ NPC dialogue line
