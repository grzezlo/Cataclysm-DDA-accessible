#. ~ Unique name of an NPC
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "balthazar"
msgstr ""

#. ~ Name of an NPC class
#. ~ trading will be implemented later
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "bunker voice"
msgstr ""

#. ~ Job description of "bunker voice" NPC class
#. ~ trading will be implemented later
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "Locked in a bunker."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "As soon as you walk up to the intercom it turns on"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "Once you get close enough, the intercom crackles on"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "The wiring on this intercom is out for anyone to see"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "You hear some static come through the tinny speaker"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar.json
msgid ""
"After some brief static you hear a voice coming through with a crackle and a "
"pop \"..llo?  Hello?  Is someone there?\""
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "[Clear your throat.]"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "I'm here."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "Who is this?"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "Hmm?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "Can we trade?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "Tell me your story."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar.json
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "Why don't these robots attack me?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "Here are the solar panels."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "You brought solar panels?!"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "Here you go."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "On second thought, I need a bit longer."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "Thank you so much, I'll send some bullets and a gun over."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "Thank you so much, I'll give you all I have to give right now."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar.json
msgid "Thank you so much.  As promised, all I can spare and a bot."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar.json
msgid ""
"I'll first need to gather up some supplies before I can even consider "
"trading."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid ""
"I'm Balthazar and have been stuck in this bunker ever since the sky ruptured!"
"  I don't really know what's happening out there and need someone to help me."
"  The power to the bunker has been running low and the air & water filtration"
" are failing intermittently."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "What do you need help with?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "What's in it for me?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "Hold on, why are you locked in here?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
#: data/json/npcs/balthazar_fac/balthazar_smalltalk.json
msgid "So who are you?"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid ""
"The bunker has a field of solar panels nearby but some of the staff damaged "
"them badly when they turned into those… things.  I need you to gather at "
"least 12 panels so I can stabilize my power output."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "Alright, I'll see what I can gather."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid ""
"You'll help me?!  Thank you so, so much.  I really wasn't looking forward to "
"dying a slow death in here.  I think the power will be enough for a while but"
" please hurry up."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "What should I do once I bring them to you?"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid ""
"I can remotely control a few of the maintenance bots.  All I need you to do "
"is drop them off at the intercom I've managed to set up and I'll get to work "
"installing them."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid ""
"I don't have much.  All I have in here is some MREs, bullets and a few guns "
"so I'll let you take your pick when you bring some panels."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "You're locked in there, right?  How would I get them?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "That doesn't sound too promising…"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid ""
"The airlock is the only part that is malfunctioning, luckily it's connected "
"to the ventilation systems so I made a bot that can traverse them."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid ""
"W-Wait no, n- no, I- I'll give you all I have.  All I request to keep is some"
" food, a gun, and a bullet for if things get bad."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "How about a little more, huh?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "That's better."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "I-I-What?  It's all I have, I can't give you more."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "Surely you have something more exotic in there."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "So you also don't have anything else in the \"control center\"?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
#: data/json/npcs/robofac/robofac_ancilla_npcs/BAR_ENCOUNTER_MERCENARIES/BEM_human_sample.json
msgid "No deal."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "Y- You know what?  Fuck you, I'll just wait for someone else."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
#: data/json/npcs/balthazar_fac/balthazar_smalltalk.json
msgid ""
"This bunker has a control center for the local bots so I made them only "
"attack when attacked first."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
#: data/json/npcs/balthazar_fac/balthazar_smalltalk.json
msgid "Sounds useful."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "So you do have some tech you can give me."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid ""
"Wh- Alright, you got me, I can offer you a bot from the control center as "
"well, but that is truly all I have."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "I knew you had more."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "Surely you have some more in there."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
#: data/json/npcs/balthazar_fac/balthazar_smalltalk.json
msgid ""
"When the riots were getting bad, we were assigned to hold this bunker for "
"some eggheads.  Then when the skies broke some of my comrades just started "
"shooting all around, so I fled into this bunker.  Something messed with the "
"doors and I've been locked in here since."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
#: data/json/npcs/balthazar_fac/balthazar_smalltalk.json
msgid "That sounds rough."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
#: data/json/npcs/balthazar_fac/balthazar_smalltalk.json
msgid "Just gotta keep my head down and focus on the now."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
#: data/json/npcs/balthazar_fac/balthazar_smalltalk.json
msgid "Good luck."
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
#: data/json/npcs/balthazar_fac/balthazar_smalltalk.json
msgid ""
"I'm a combat engineer who got sent here to hold this bunker.  I guess I'm "
"still accomplishing that, huh."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
#: data/json/npcs/balthazar_fac/balthazar_smalltalk.json
msgid "How come you're locked up?"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_first_meeting.json
msgid "I have no need for you right now."
msgstr ""

#. ~ Mission name
#: data/json/npcs/balthazar_fac/balthazar_missions.json
msgid "Gather solar panels for Balthazar"
msgstr ""

#. ~ Description of mission "Gather solar panels for Balthazar"
#: data/json/npcs/balthazar_fac/balthazar_missions.json
msgid ""
"Balthazar needs some solar panels to stabilize the power to their bunker."
msgstr ""

#. ~ Dialogue line in mission "Gather solar panels for Balthazar"
#: data/json/npcs/balthazar_fac/balthazar_missions.json
msgid ""
"The power in my bunker is failing and I need 12 solar panels to stabilize "
"them."
msgstr ""

#. ~ Dialogue line in mission "Gather solar panels for Balthazar"
#: data/json/npcs/balthazar_fac/balthazar_missions.json
msgid ""
"Most commercial buildings have some solar panels or, if we're lucky, you "
"might find a solar farm."
msgstr ""

#. ~ Dialogue line in mission "Gather solar panels for Balthazar"
#: data/json/npcs/balthazar_fac/balthazar_missions.json
msgid "Power is holding for now but I need those panels soon."
msgstr ""

#. ~ Dialogue line in mission "Gather solar panels for Balthazar"
#: data/json/npcs/balthazar_fac/balthazar_missions.json
msgid "Where are the panels??"
msgstr ""

#. ~ Dialogue line in mission "Gather solar panels for Balthazar"
#: data/json/npcs/balthazar_fac/balthazar_missions.json
msgid "You shouldn't fail me, human."
msgstr ""

#. ~ Mission name
#: data/json/npcs/balthazar_fac/balthazar_missions.json
msgid "Reach source of mysterious transmission"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_smalltalk.json
msgid "Something forced me to hide in here.  Will you help me now?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_smalltalk.json
msgid "Fine, what do you need help with?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_smalltalk.json
msgid "Not until I know who you are."
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_smalltalk.json
msgid "I wanted to know something else first…"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_smalltalk.json
msgid ""
"I'm a combat engineer who got sent here to hold this bunker.  Can we get down"
" to business now?"
msgstr ""

#. ~ NPC dialogue line
#: data/json/npcs/balthazar_fac/balthazar_smalltalk.json
msgid "I got a control center.  Anything else or will you hear me out now?"
msgstr ""

#. ~ Response to NPC dialogue
#: data/json/npcs/balthazar_fac/balthazar_smalltalk.json
msgid "There was something else…"
msgstr ""

#. ~ Job description of "Merchant" NPC class
#: data/json/npcs/bunker_shop/classes.json
msgid "I sell things to make a living."
msgstr ""

#. ~ Mission name
#: data/json/npcs/cabin_chemist/chemist_missions.json
msgid "Find A Basic Analysis Kit"
msgstr ""

#. ~ Description of mission "Find A Basic Analysis Kit"
#: data/json/npcs/cabin_chemist/chemist_missions.json
msgid "Obtain a basic laboratory analysis kit for the chemist."
msgstr ""

#. ~ Dialogue line in mission "Find A Basic Analysis Kit"
#: data/json/npcs/cabin_chemist/chemist_missions.json
msgid "I need a basic laboratory analysis kit."
msgstr ""

#. ~ Dialogue line in mission "Find A Basic Analysis Kit"
#: data/json/npcs/cabin_chemist/chemist_missions.json
msgid ""
"I've checked the stock here at this house, and it turns out there's a few "
"pieces of equipment I need.  Firstly, I need a reliable way to take "
"measurements and verify results.  If you could get me a basic laboratory "
"analysis kit just to get started, I'd be grateful.  That's the first step "
"towards making everything I brought with me useful."
msgstr ""

