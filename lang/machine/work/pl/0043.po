msgid "rifle shotgun"
msgid_plural "rifle shotguns"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description of gun "rifle shotgun"
#. ~ Description of "rifle shotgun"
#: data/json/items/gun/shot.json
msgid ""
"Despite looking like a military-issued rifle, this is, in fact, a shotgun.  "
"It can accept a variety of magazines."
msgstr ""

