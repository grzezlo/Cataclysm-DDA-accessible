msgid "Kel-Tec KSG shotgun"
msgid_plural "Kel-Tec KSG shotguns"
msgstr[0] "strzelba Kel-Tec KSG"
msgstr[1] "strzelby Kel-Tec KSG"
msgstr[2] "strzelb Kel-Tec KSG"
msgstr[3] "strzelby Kel-Tec KSG"

