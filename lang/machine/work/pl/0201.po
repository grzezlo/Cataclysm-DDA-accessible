#. ~ Description of spell "lilin_aoe_line_disease_spell ( Unleash the Night-
#. Wind )"
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
msgid ""
"Summon a miasma filled with pestilence to infect your enemies.  This "
"supernatural disease can even strike zombies or stranger creatures."
msgstr ""

#. ~ Description of spell "lilin_disease_enhancement_damage_spell ( Devoured by
#. Pestilence )"
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
msgid ""
"Enhance the power of the miasma from Unleash the Night-Wind, doing serious "
"damage and crippling your target."
msgstr ""

#. ~ Description of spell "lilin_avoid_sleep_spell ( Neither Sleep Nor Slumber
#. )"
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
msgid "Spend ruach to alleviate your sleepiness."
msgstr ""

#. ~ Description of spell "lilin_change_weather_fog_spell ( Thick Clouds A
#. Covering )"
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
msgid ""
"Manipulate the weather, pulling the water from the air and cause a thick fog "
"to form and blanket the countryside.  Activate again to release your hold on "
"the weather."
msgstr ""

#. ~ Description of spell "lilin_speed_dodge_boost_spell ( Reaping the
#. Whirlwind )"
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
msgid ""
"Spend some ruach to greatly enhance your speed for a short period of time."
msgstr ""

#. ~ Name of spell "lilin_strix_leap_spell"
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
msgid "Strix Leap"
msgstr ""

#. ~ Description of spell "lilin_instant_heal_spell ( The Moon to Rule the
#. Night )"
#: data/mods/Xedra_Evolved/spells/lilin_spells.json
msgid ""
"At night under the moon, you can greatly speed your healing, knitting "
"together grievous wounds in moments.  This requires direct moonlight; clouds,"
" rain, or being indoors will prevent this power from working."
msgstr ""

#. ~ Player message in effect in EoC "EOC_DREAMER_ARTIFACT_SPAWN"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid ""
"You pull your power into this world, and something outside of it places an "
"object in your hand."
msgstr ""

#. ~ Player message in nested effect in switch statement in effect in EoC
#. "EOC_DREAMER_ARTIFACT_FAIL_MESSAGE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid ""
"Your impatience is apparently a defining feature.  You're going to need a lot"
" more time connecting with the universe to make this happen."
msgstr ""

#. ~ Player message in nested effect in switch statement in effect in EoC
#. "EOC_DREAMER_ARTIFACT_FAIL_MESSAGE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid ""
"You try to connect the item with another dimension, but everything goes wrong"
" from the very beginning.  You feel you need much more patience to finish "
"this."
msgstr ""

#. ~ Player message in nested effect in switch statement in effect in EoC
#. "EOC_DREAMER_ARTIFACT_FAIL_MESSAGE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid ""
"You try to connect the item with another dimension, but something interrupts "
"you in the middle of your attempt.  You need just a bit more time to make "
"this work."
msgstr ""

#. ~ Player message in nested effect in switch statement in effect in EoC
#. "EOC_DREAMER_ARTIFACT_FAIL_MESSAGE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid ""
"You try to connect the item with another dimension, but in the end it fails."
"  It was close though, so you think you need to try it again tomorrow."
msgstr ""

#. ~ Player message in effect in EoC "EOC_GENERATE_ACCELERATED_TIME_INITIATE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid ""
"<color_light_gray>Grey</color> fields of time start seeping from your body."
msgstr ""

#. ~ Player message in false effect in EoC
#. "EOC_GENERATE_ACCELERATED_TIME_INITIATE"
#. ~ Player message in false effect in EoC
#. "EOC_GENERATE_ACCELERATED_TIME_CONTINUE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid "The world regains color as it speeds up."
msgstr ""

#. ~ Player message in effect in EoC "EOC_GENERATE_ACCELERATED_TIME_CONTINUE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid ""
"The grayscale starts to recede from your vision before it quickly reverts."
msgstr ""

#. ~ Player message in effect in EoC "EOC_ETHEREAL_WINGS_INITIATE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid "<color_white>Ethereal</color> wings grow from your back."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_ETHEREAL_WINGS_INITIATE"
#. ~ Player message in false effect in EoC "EOC_ETHEREAL_WINGS_CONTINUE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid "The wings behind you fade out of existence."
msgstr ""

#. ~ Player message in effect in EoC "EOC_ETHEREAL_WINGS_CONTINUE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid ""
"The wings behind you grow slightly more transparent, but they quickly revert "
"back to normal."
msgstr ""

#. ~ Player message in effect in EoC "EOC_KARMA_ARMS_INITIATE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid ""
"Ethereal, transparent arms appear behind your shoulders and "
"<color_cyan>glow</color>."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_KARMA_ARMS_INITIATE"
#. ~ Player message in false effect in EoC "EOC_KARMA_ARMS_CONTINUE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid "The cyan arms grow dim and finally disappear."
msgstr ""

#. ~ Player message in effect in EoC "EOC_KARMA_ARMS_CONTINUE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid ""
"The floating arms behind you slightly flicker, but they soon resume their "
"steady glow."
msgstr ""

#. ~ Player message in effect in EoC "EOC_DEVIL_TAIL_INITIATE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid "You feel like your spine stretched enormously."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_DEVIL_TAIL_INITIATE"
#. ~ Player message in false effect in EoC "EOC_DEVIL_TAIL_CONTINUE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid "Your devil tail fades away."
msgstr ""

#. ~ Player message in effect in EoC "EOC_DEVIL_TAIL_CONTINUE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid "Your devilish tail stretches and twists playfully."
msgstr ""

#. ~ Player message in effect in EoC "EOC_STALKER_EYES_INITIATE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid ""
"Your vision grows dark for a moment, but a second later a whole new world is "
"revealed under your eyes."
msgstr ""

#. ~ Player message in false effect in EoC "EOC_STALKER_EYES_INITIATE"
#. ~ Player message in false effect in EoC "EOC_STALKER_EYES_CONTINUE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid "The great new world visible to your eyes disappears."
msgstr ""

#. ~ Player message in effect in EoC "EOC_STALKER_EYES_CONTINUE"
#: data/mods/Xedra_Evolved/spells/spell_eocs.json
msgid "Your sight darkens for a second, but it quickly turns back."
msgstr ""

#. ~ Name of spell "vampire_smell_nearby_blood_spell"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid "Scent of Blood"
msgstr ""

#. ~ Description of spell "vampire_smell_nearby_blood_spell ( Scent of Blood )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid ""
"You can smell even the faintest traces of living human, or nearly-human, blood.\n"
"\n"
"<color_light_red>Blood Cost:</color> 0 ml."
msgstr ""

#. ~ Name of spell "vampire_drink_blood_with_fangs_spell"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid "Drink Blood"
msgstr ""

#. ~ Description of spell "vampire_drink_blood_with_fangs_spell ( Drink Blood
#. )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid ""
"Your fangs allow you to drink blood from an incapacitated or sleeping target."
msgstr ""

#. ~ Description of spell "vampire_stamina_for_blood_spell ( Unholy Endurance
#. )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid ""
"You focus on sending the blood in your veins to where it can do the most good for your immediate stamina.\n"
"\n"
"<color_light_red>Blood Cost:</color> 100 ml (<u_val:blood_amount_for_graph> ml current)."
msgstr ""

#. ~ Description of spell "vampire_commune_with_night_spell ( Learn from the
#. Children of the Night )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid ""
"Speak to nearby night-creatures; rats, bats, wolves, and so on.  They will tell you the layout of your surrounding area.\n"
"\n"
"<color_light_red>Blood Cost:</color> 100 ml (<u_val:blood_amount_for_graph> ml current)."
msgstr ""

#. ~ Description of spell "vampire_magic_for_blood_spell ( Blood-Fueled Magic
#. )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid ""
"You consume some of the blood in your veins, turning it into magical power.\n"
"\n"
"<color_light_red>Blood Cost:</color> 200 ml (<u_val:blood_amount_for_graph> ml current)."
msgstr ""

#. ~ Description of spell "spell_blood_heal ( Sanguine Restoration )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid ""
"Heal your wounds with the power of stolen blood.\n"
"\n"
"<color_light_red>Blood Cost:</color> 750 ml (<u_val:blood_amount_for_graph> ml current)."
msgstr ""

#. ~ Description of spell "vampire_fear_gaze_spell ( Predator's Mien )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid ""
"With a bit of stolen blood and a savage expression, you can send your enemies fleeing.  This power only works on enemies capable of feeling fear.\n"
"\n"
"<color_light_red>Blood Cost:</color> 150 ml (<u_val:blood_amount_for_graph> ml current)."
msgstr ""

#. ~ Description of spell "spell_hypnotic_gaze ( Hypnotic Gaze )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid ""
"Stare into the eyes of your victim and wills them to pause.  This power does not work on unliving targets.\n"
"\n"
"<color_light_red>Blood Cost:</color> 150 ml (<u_val:blood_amount_for_graph> ml current)."
msgstr ""

#. ~ Description of spell "vampire_command_beast_spell ( Cowing the Beast )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid ""
"Exert command over a predatory wild animal like a wolf or a rat, making it your ally for a time.\n"
"\n"
"<color_light_red>Blood Cost:</color> 500 ml (<u_val:blood_amount_for_graph> ml current)."
msgstr ""

#. ~ Description of spell "vampire_earth_slumber_spell ( Earthen Slumber )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid ""
"You can sleep within the earth itself, avoiding the hateful light of the sun.  This power must be used on diggable soil.\n"
"\n"
"<color_light_red>Blood Cost:</color> 0 ml."
msgstr ""

#. ~ Description of spell "vampire_torpor ( Torpor )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid ""
"Enter a deathlike slumber and recover from your wounds and fatigue.  "
"Preferably while somewhere nobody could attack you while you sleep."
msgstr ""

#. ~ Message of spell "vampire_torpor ( Torpor )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid "You enter torpor."
msgstr ""

#. ~ Description of spell "vampire_dominate ( Dominating Gaze )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid ""
"Take control of a mind.  Only works on targets that have weak minds.\n"
"\n"
"<color_light_red>Blood Cost:</color> 700 ml (<u_val:blood_amount_for_graph> ml current)."
msgstr ""

#. ~ Message of spell "vampire_dominate ( Dominating Gaze )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid "You look for a mind to control."
msgstr ""

#. ~ Name of spell "vampire_mist_form_pass_through_doors_and_windows"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid "(Mist Form) Pass Through Barrier"
msgstr ""

#. ~ Description of spell "vampire_mist_form_pass_through_doors_and_windows (
#. (Mist Form) Pass Through Barrier )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid "Seep through a door or a window."
msgstr ""

#. ~ Name of spell "vampire_summon_blood_container"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid "Create blood-storing sphere."
msgstr ""

#. ~ Description of spell "vampire_summon_blood_container ( Create blood-
#. storing sphere. )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid ""
"Create a magical sphere that will contain any blood you will put in it until "
"the spell ends."
msgstr ""

#. ~ Message of spell "vampire_summon_blood_container ( Create blood-storing
#. sphere. )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid "You conjure a magical sphere to store blood."
msgstr ""

#. ~ Name of spell "vampire_invisible_in_dark"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid "Shrouded by the Shadowed Path."
msgstr ""

#. ~ Description of spell "vampire_invisible_in_dark ( Shrouded by the Shadowed
#. Path. )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid ""
"Surround yourself in shadows, becoming invisible for a while.  This power will fail if you stand outside under the sun.\n"
"\n"
"<color_light_red>Blood Cost:</color> 300 ml (<u_val:blood_amount_for_graph> ml current)."
msgstr ""

#. ~ Message of spell "vampire_invisible_in_dark ( Shrouded by the Shadowed
#. Path. )"
#: data/mods/Xedra_Evolved/spells/vampire_spells.json
msgid "You gather as many shadows as you can."
msgstr ""

#. ~ Message after transforming to "t_tree_birch, t_tree_elm,
#. t_tree_cottonwood, t_tree_basswood, t_tree_alder, t_tree_pine, t_tree_maple,
#. t_tree_willow, t_tree_hickory, t_tree_walnut, t_tree_tupelo,
#. t_tree_nannyberry, t_tree_butternut, t_tree_chestnut, t_tree_hazelnut,
#. t_tree_beech, t_tree_blackjack, t_tree_apple, t_tree_cherry, t_tree_juniper,
#. t_tree_pear, t_tree_plum, t_tree_elderberry, t_tree_mulberry,
#. t_tree_sassafras"
#. ~ Message after transforming to "t_tree_birch, t_tree_elm,
#. t_tree_cottonwood, t_tree_basswood, t_tree_alder, t_tree_pine, t_tree_maple,
#. t_tree_willow, t_tree_hickory, t_tree_walnut_harvested,
#. t_tree_tupelo_harvested, t_tree_nannyberry_harvested,
#. t_tree_butternut_harvested, t_tree_chestnut_harvested,
#. t_tree_hazelnut_harvested, t_tree_beech, t_tree_blackjack,
#. t_tree_apple_harvested, t_tree_cherry_harvested, t_tree_juniper_harvested,
#. t_tree_pear_harvested, t_tree_plum_harvested, t_tree_elderberry_harvested,
#. t_tree_mulberry_harvested, t_tree_sassafras_harvested"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
#: data/mods/Xedra_Evolved/ter_transforms/changeling_seasonal_ter_transforms.json
msgid ""
"The young tree creaks as its limbs begin growing, first slowly and then with "
"increasing speed.  Roots churn through the soil and leaves stretch toward the"
" sun, and in moments, before you is a tree that could have stood for a human "
"lifetime."
msgstr ""

#. ~ Message after transforming to "t_grass_long"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
#: data/mods/Xedra_Evolved/ter_transforms/changeling_seasonal_ter_transforms.json
msgid ""
"Fresh green grass grows longer and longer until it stands as tall as your "
"knees."
msgstr ""

#. ~ Message after transforming to "t_grass_tall"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
#: data/mods/Xedra_Evolved/ter_transforms/changeling_seasonal_ter_transforms.json
msgid ""
"The tall grass grows and grows until a child could easily hide themselves "
"within it."
msgstr ""

#. ~ Message after transforming to "f_plant_harvest"
#. ~ Message after transforming to "f_dirtmound_shallow_harvest"
#. ~ Message after transforming to "f_dirtmound_pile_harvest"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
msgid ""
"The plant grows in moments, leaves unfurling, roots churning the soil, and "
"flowers opening toward the sun.  Before you even lower your hands, it's ripe "
"and ready for the harvest."
msgstr ""

#. ~ Message after transforming to "t_grass_tall"
#. ~ Message after transforming to "t_grass_long, t_grass_tall"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
#: data/mods/Xedra_Evolved/ter_transforms/changeling_seasonal_ter_transforms.json
msgid "The grass grows tall, reaching toward the sky."
msgstr ""

#. ~ Message after transforming to "t_grass, t_grass_long, t_grass_tall"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
#: data/mods/Xedra_Evolved/ter_transforms/changeling_seasonal_ter_transforms.json
msgid "The ground churns as blades of grass push out of the soil."
msgstr ""

#. ~ Message after transforming to "t_triffid_bark_wall"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
msgid ""
"The bark surges upward as the roots below grow into a heavy, solid wall "
"covered in bark."
msgstr ""

#. ~ Message after transforming to "t_triffid_wood_wall"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
msgid ""
"The wooden wall shudders as the bark peels off in sheets, eventually becoming"
" a solid expanse of bare wood."
msgstr ""

#. ~ Message after transforming to "t_triffid_bark_wall"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
msgid ""
"The bare wooden wall shudders as bark sprouts and spreads over it, covering "
"the entire surface in moments."
msgstr ""

#. ~ Message after transforming to "t_barkfloor_no_roof"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
msgid ""
"The ground churns as bark-covered roots erupt from it and form into a solid "
"bark-covered floor."
msgstr ""

#. ~ Message after transforming to "t_barkfloor"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
msgid ""
"The ground churns as bark-covered roots quest upward, forming an intertwining"
" roof."
msgstr ""

#. ~ Message after transforming to "t_barkfloor_no_roof"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
msgid ""
"The wooden wall spasms and recedes into the ground, leaving only a bark-"
"covered floor in its place."
msgstr ""

#. ~ Message after transforming to "t_triffid_leaves"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
msgid ""
"The bark floor shudders as thin branches sprout from it, leaves already "
"growing and unfurling, and soon a thicket of dense leaves covers the area."
msgstr ""

#. ~ Message after transforming to "t_triffid_leaves"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
msgid ""
"The ground shudders as thin branches sprout from it, leaves already growing "
"and unfurling, and soon a thicket of dense leaves covers the area."
msgstr ""

#. ~ Message after transforming to "t_bramble_door_c"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
msgid ""
"The wall trembles and splits apart into a tangle of gnarled roots, waving in "
"the air like monstrous tentacles.  They weave together into a sturdy door "
"before ceasing their motion."
msgstr ""

#. ~ Message after transforming to "t_triffid_bark_wall"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
msgid ""
"The roots surge into motion, growing together thicker and more tangled until "
"a bark-covered wall of solid wood is all that remains."
msgstr ""

#. ~ Message after transforming to "t_dirt_barren"
#. ~ Message after transforming to "f_null"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
msgid "The fungus withers and dies!"
msgstr ""

#. ~ Message after transforming to "f_arvore_translocator_ground"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
msgid "You meditate within the depths of the forest."
msgstr ""

#. ~ Message after transforming to "t_arvore_climbing_vine"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
msgid "A vine bursts out of the ground and grows in moments!"
msgstr ""

#. ~ Message after transforming to "t_tree_birch, t_tree_elm,
#. t_tree_cottonwood, t_tree_basswood, t_tree_alder, t_tree_pine, t_tree_maple,
#. t_tree_willow, t_tree_hickory, t_tree_walnut, t_tree_tupelo,
#. t_tree_nannyberry, t_tree_butternut, t_tree_chestnut, t_tree_hazelnut,
#. t_tree_beech, t_tree_blackjack, t_tree_apple, t_tree_cherry, t_tree_juniper,
#. t_tree_pear, t_tree_plum, t_tree_elderberry, t_tree_mulberry,
#. t_tree_sassafras"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
msgid ""
"The target's limbs begin stretching and spreading toward the sky as their "
"body elongates, and in moments, a tree that could have stood for a hundred "
"years stands in their place."
msgstr ""

#. ~ Message after transforming to "t_arvore_living_tent"
#: data/mods/Xedra_Evolved/ter_transforms/arvore_ter_transforms.json
msgid "Vines and brambles rapidly grow from the ground into a small shelter."
msgstr ""

#. ~ Message after transforming to "t_grass_dead"
#: data/mods/Xedra_Evolved/ter_transforms/changeling_seasonal_ter_transforms.json
msgid "The grass wilts."
msgstr ""

#. ~ Message after transforming to "f_plant_mature"
#. ~ Message after transforming to "f_dirtmound_shallow_mature"
#. ~ Message after transforming to "f_dirtmound_pile_mature"
#: data/mods/Xedra_Evolved/ter_transforms/changeling_seasonal_ter_transforms.json
msgid ""
"The plant grows in moments, leaves unfurling, roots churning the soil, and "
"flowers opening toward the sun.  Before you even lower your hands, it's fully"
" grown, though not yet ready for the harvest."
msgstr ""

#. ~ Message after transforming to "f_plant_harvest"
#. ~ Message after transforming to "f_dirtmound_shallow_harvest"
#. ~ Message after transforming to "f_dirtmound_pile_harvest"
#: data/mods/Xedra_Evolved/ter_transforms/changeling_seasonal_ter_transforms.json
msgid ""
"The plant's buds swell, fruiting and growing.  Before you even lower your "
"hands, it's ripe and ready for the harvest."
