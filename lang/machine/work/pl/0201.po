#: data/mods/aftershock_exoplanet/items/lore_items.json
msgid ""
"Identity codes for Nyssia, Aztlan, Luzhan, and many other polities in the "
"spinward frontier, all forgeries.  You fathom most of them would still work."
msgstr ""

